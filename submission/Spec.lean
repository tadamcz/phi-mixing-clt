theorem IbragimovIosifescuConjectureForMixingSequences.ibragimov_iosifescu_conjecture_for_mixing_sequences.parts.i.disproof : ¬ (type_of% @IbragimovIosifescuConjectureForMixingSequences.ibragimov_iosifescu_conjecture_for_mixing_sequences.parts.i) := by
  exact IbragimovIosifescuConjectureForMixingSequences.not_unrestricted_clt_of_counterexample
    Cascade.explicit_counterexample
