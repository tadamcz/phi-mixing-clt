import FormalConjecturesUtil

/-!
# Ibragimov–Iosifescu conjecture for φ-mixing sequences

Let $(X_n)_{n \in \mathbb{N}}$ be a strictly stationary, centered, $\phi$-mixing sequence of
real random variables with $\mathbb{E}(X_0^2) < \infty$ and
$\sigma_n^2 := \operatorname{Var}(S_n) \to +\infty$, where $S_n$ denotes the $n$-th partial sum.
Then, per Ibragimov, $S_n / \sigma_n$ converges in distribution to $N(0, 1)$
(a central limit theorem), and, per Iosifescu, the partial-sum process
$t \mapsto S_{[nt]} / \sigma_n$, $t \in [0, 1]$, converges weakly to standard Brownian motion
(a weak invariance principle).

Here the sequence is indexed by $\mathbb{N} = \{0, 1, 2, \dots\}$ and $S_n := \sum_{j < n} X_j$;
by strict stationarity this agrees in law with the convention $S_n = \sum_{j = 1}^n X_j$ used in
the sources. The weak invariance principle is stated in $C([0, 1], \mathbb{R})$ for the polygonal
(linearly interpolated) partial-sum process, which is equivalent to the formulation for the step
process $S_{[nt]} / \sigma_n$ in the Skorokhod space $D[0, 1]$.

*References:*
- [Wikipedia](https://en.wikipedia.org/wiki/Ibragimov%E2%80%93Iosifescu_conjecture_for_%CF%86-mixing_sequences)
- [IL71] I. A. Ibragimov and Yu. V. Linnik, _Independent and Stationary Sequences of Random
  Variables_, Wolters-Noordhoff, Groningen, 1971, p. 393, problem 3.
- [Io77] M. Iosifescu, _Limit theorems for φ-mixing sequences, a survey_. In: Proceedings of the
  Fifth Conference on Probability Theory, Brașov, 1974, pp. 51-57. Publishing House of the Romanian
  Academy, Bucharest, 1977.
- [Pe90] M. Peligrad, _On Ibragimov–Iosifescu conjecture for φ-mixing sequences_.
  Stochastic Processes and their Applications 35 (1990), 293-308.
  [doi:10.1016/0304-4149(90)90008-G](https://doi.org/10.1016/0304-4149(90)90008-G)
-/

section OriginalStatement

open MeasureTheory ProbabilityTheory Filter Topology
open scoped unitInterval

namespace IbragimovIosifescuConjectureForMixingSequences

variable {Ω : Type*} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ) (μ : Measure Ω)

/-
### Strict stationarity and φ-mixing
-/

/-- The $\sigma$-algebra $\sigma(X_j, j \in s)$ generated by the random variables $X_j$,
$j \in s$. -/
def sigmaGen (s : Set ℕ) : MeasurableSpace Ω :=
  ⨆ j ∈ s, MeasurableSpace.comap (X j) inferInstance

/-- A sequence $(X_n)_{n \in \mathbb{N}}$ of random variables is *strictly stationary* if, for
every $k$, the shifted sequence $(X_{n + k})_{n \in \mathbb{N}}$ has the same joint distribution as
$(X_n)_{n \in \mathbb{N}}$. -/
def IsStrictlyStationary : Prop :=
  ∀ k : ℕ, IdentDistrib (fun ω n ↦ X (n + k) ω) (fun ω n ↦ X n ω) μ μ

/-- The $\phi$-mixing coefficients of a sequence $X = (X_n)_{n \in \mathbb{N}}$:
$$\phi_X(n) := \sup\{|\mu(B \mid A) - \mu(B)| :
  A \in \mathcal{F}^m,\ \mu(A) > 0,\ B \in \mathcal{F}_{m + n},\ m \in \mathbb{N}\},$$
where $\mathcal{F}^m = \sigma(X_j, j \le m)$ and $\mathcal{F}_{m + n} = \sigma(X_j, j \ge m + n)$.
The supremum is taken over the sets $A$ of positive probability, so that the conditional
probability $\mu(B \mid A)$ is defined. -/
noncomputable def phiMixingCoeff (n : ℕ) : ℝ :=
  sSup {r | ∃ (m : ℕ) (A B : Set Ω), MeasurableSet[sigmaGen X (Set.Iic m)] A ∧ 0 < μ A ∧
    MeasurableSet[sigmaGen X (Set.Ici (m + n))] B ∧ r = |(μ[|A]).real B - μ.real B|}

/-- A sequence of random variables is *$\phi$-mixing* if its $\phi$-mixing coefficients satisfy
$\phi_X(n) \to 0$ as $n \to \infty$. -/
def IsPhiMixing : Prop :=
  Tendsto (phiMixingCoeff X μ) atTop (𝓝 0)

/-
### Partial sums and the partial-sum process
-/

/-- The partial sums $S_n := \sum_{j < n} X_j$. -/
def partialSum (n : ℕ) (ω : Ω) : ℝ :=
  ∑ j ∈ Finset.range n, X j ω

/-- The standard deviation $\sigma_n := \sqrt{\operatorname{Var}(S_n)}$ of the partial sum $S_n$. -/
noncomputable def partialSumStdDev (n : ℕ) : ℝ :=
  √(variance (partialSum X n) μ)

/-- The normalized partial sum $S_n / \sigma_n$. -/
noncomputable def normalizedPartialSum (n : ℕ) (ω : Ω) : ℝ :=
  partialSum X n ω / partialSumStdDev X μ n

/-- The normalized partial sum is a real random variable. -/
lemma measurable_normalizedPartialSum (hX : ∀ n, Measurable (X n)) (n : ℕ) :
    Measurable (normalizedPartialSum X μ n) := by
  unfold normalizedPartialSum partialSum
  fun_prop

/-- The (linearly interpolated) partial-sum process $W_n : [0, 1] \to \mathbb{R}$,
$$W_n(t) := \frac{1}{\sigma_n} \sum_{j < n} X_j \min(1, \max(0, nt - j))
  = \frac{S_{[nt]} + (nt - [nt]) X_{[nt]}}{\sigma_n},$$
that is, the polygonal path through the points $(k / n, S_k / \sigma_n)$, $0 \le k \le n$, viewed
as a random element of $C([0, 1], \mathbb{R})$. -/
noncomputable def partialSumProcess (n : ℕ) (ω : Ω) : C(I, ℝ) where
  toFun t :=
    (∑ j ∈ Finset.range n, X j ω * min 1 (max 0 (n * (t : ℝ) - j))) / partialSumStdDev X μ n
  continuous_toFun := by fun_prop

/-- The Borel $\sigma$-algebra on the path space $C([0, 1], \mathbb{R})$. -/
local instance : MeasurableSpace C(I, ℝ) := borel _

local instance : BorelSpace C(I, ℝ) := ⟨rfl⟩

/-
### Brownian motion
-/

/-- A measure $W$ on $C([0, 1], \mathbb{R})$ is the *Wiener measure* (the law of standard Brownian
motion on $[0, 1]$) if it is a probability measure under which the coordinate process
$w \mapsto w(t)$ starts at $0$ almost surely, has independent increments, and has Gaussian
increments $w(t) - w(s) \sim N(0, t - s)$ for $s \le t$. -/
structure IsWienerMeasure (W : Measure C(I, ℝ)) : Prop where
  isProbabilityMeasure : IsProbabilityMeasure W
  ae_zero : ∀ᵐ w ∂W, w 0 = 0
  iIndepFun_increments : ∀ (k : ℕ) (t : Fin (k + 1) → I), StrictMono t →
    iIndepFun (fun i : Fin k ↦ fun w : C(I, ℝ) ↦ w (t i.succ) - w (t i.castSucc)) W
  map_increment_eq : ∀ s t : I, s ≤ t →
    W.map (fun w : C(I, ℝ) ↦ w t - w s) = gaussianReal 0 (Real.toNNReal (t - s))

/-
### The conjectures
-/

variable [IsProbabilityMeasure μ]

/-- **Ibragimov's conjecture** (central limit theorem for $\phi$-mixing sequences).

Let $(X_n)_{n \in \mathbb{N}}$ be a strictly stationary, centered, $\phi$-mixing sequence of
real random variables such that $\mathbb{E}(X_0^2) < \infty$ and
$\sigma_n^2 := \operatorname{Var}(S_n) \to +\infty$, where $S_n := \sum_{j < n} X_j$.
Then $S_n / \sigma_n$ converges in distribution to the standard normal law $N(0, 1)$. -/
theorem ibragimov_iosifescu_conjecture_for_mixing_sequences.parts.i
    (hX : ∀ n, Measurable (X n))
    (h_stat : IsStrictlyStationary X μ) (h_mix : IsPhiMixing X μ)
    (h_L2 : MemLp (X 0) 2 μ) (h_mean : μ[X 0] = 0)
    (h_var : Tendsto (fun n ↦ variance (partialSum X n) μ) atTop atTop) :
    Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) := by
  sorry

end IbragimovIosifescuConjectureForMixingSequences

end OriginalStatement


/- Supporting development: Cascade.Basic -/
section
set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Topology
open scoped BoundedContinuousFunction ENNReal NNReal

namespace Cascade

abbrev Past := ℕ → ℝ
abbrev NoisePath := ℤ → ℝ

/-- Drop the most recent `n` entries of a backwards-indexed history. -/
def dropPast (n : ℕ) (x : Past) : Past := fun k ↦ x (k + n)

/-- The full backwards-indexed innovation history at time `t`, including time `t`. -/
def history (t : ℤ) (ω : NoisePath) : Past := fun k ↦ ω (t - (k : ℤ))

/-- Two-sided time shift. -/
def shiftPath (t : ℤ) (ω : NoisePath) : NoisePath := fun k ↦ ω (k + t)

/-- Iid product law. -/
noncomputable def iidLaw (I : Type*) (ν : Measure ℝ) : Measure (I → ℝ) :=
  Measure.infinitePi (fun _ : I ↦ ν)

/-- A bounded continuous correction depending on the strict past. -/
abbrev Correction := Past →ᵇ ℝ

/-- A causal factor with a bounded correction to its current innovation. -/
def factor (K : Correction) (x : Past) : ℝ := x 0 + K (dropPast 1 x)

/-- Stationary realization of a history factor on a two-sided innovation path. -/
def atTime (F : Past → ℝ) (t : ℤ) (ω : NoisePath) : ℝ := F (history t ω)

/-- A finite consecutive sum, with time zero as its first time. -/
def sumProcess (F : Past → ℝ) (n : ℕ) (ω : NoisePath) : ℝ :=
  ∑ t ∈ Finset.range n, atTime F (t : ℤ) ω

/-- A history function is insensitive to all but its first `M` entries. -/
def HasMemory (F : Past → ℝ) (M : ℕ) : Prop :=
  ∀ x y : Past, (∀ i < M, x i = y i) → F x = F y

/-- Uniform-coordinate Lipschitz bound (histories themselves need not be bounded). -/
def UniformLip (F : Past → ℝ) (L : ℝ) : Prop :=
  ∀ c : ℝ, 0 ≤ c → ∀ x y : Past,
    (∀ i, |x i - y i| ≤ c) → |F x - F y| ≤ L * c

/-- A deterministic one-coordinate influence envelope. -/
def HasInfluence (F : Past → ℝ) (d : ℕ → ℝ) : Prop :=
  ∀ (x : Past) (j : ℕ) (z : ℝ),
    |F (Function.update x j z) - F x| ≤ d j * |z - x j|

/-- Symmetry of a real probability law. -/
def SymmetricLaw (ν : Measure ℝ) : Prop := ν.map (fun x : ℝ ↦ -x) = ν

end Cascade
end


/- Supporting development: Cascade.Clamp -/
section
set_option autoImplicit false

/-
# Symmetric clamping and its saturation residual

All estimates in this file are deterministic and pointwise. In particular the
residual estimate uses no differentiability or moment assumptions.
-/

namespace Cascade

/-- Symmetric clamping to `[-s, s]`. The useful range is `0 ≤ s`. -/
def clip (s x : ℝ) : ℝ := max (-s) (min s x)

/-- The part of a real input discarded by symmetric clamping. -/
def clipResidual (s x : ℝ) : ℝ := x - clip s x

/-- Clamping is nonexpansive, even without a sign assumption on `s`. -/
theorem lipschitzWith_clip (s : ℝ) : LipschitzWith 1 (clip s) :=
  (LipschitzWith.id.const_min s).const_max (-s)

@[fun_prop] theorem continuous_clip (s : ℝ) : Continuous (clip s) :=
  (lipschitzWith_clip s).continuous

theorem abs_clip_sub_clip_le (s u v : ℝ) : |clip s u - clip s v| ≤ |u - v| := by
  simpa only [Real.dist_eq, NNReal.coe_one, one_mul] using
    (lipschitzWith_clip s).dist_le_mul u v

theorem monotone_clip (s : ℝ) : Monotone (clip s) := by
  intro u v huv
  exact max_le_max_left (-s) (min_le_min_left s huv)

theorem neg_le_clip (s x : ℝ) : -s ≤ clip s x := le_max_left _ _

theorem clip_le {s : ℝ} (hs : 0 ≤ s) (x : ℝ) : clip s x ≤ s :=
  max_le (by linarith) (min_le_left _ _)

theorem abs_clip_le {s : ℝ} (hs : 0 ≤ s) (x : ℝ) : |clip s x| ≤ s :=
  abs_le.mpr ⟨neg_le_clip s x, clip_le hs x⟩

theorem clip_eq_self {s x : ℝ} (hx : |x| ≤ s) : clip s x = x := by
  obtain ⟨hlo, hhi⟩ := abs_le.mp hx
  simp only [clip, min_eq_right hhi, max_eq_right hlo]

@[simp] theorem clip_zero {s : ℝ} (hs : 0 ≤ s) : clip s 0 = 0 :=
  clip_eq_self (by simpa using hs)

theorem clip_of_le_neg {s x : ℝ} (hx : x ≤ -s) : clip s x = -s :=
  max_eq_left ((min_le_right s x).trans hx)

theorem clip_of_ge {s x : ℝ} (hs : 0 ≤ s) (hx : s ≤ x) : clip s x = s := by
  simp only [clip, min_eq_left hx, max_eq_right (show -s ≤ s by linarith)]

/-- Clamping commutes with sign reversal. -/
theorem clip_neg {s : ℝ} (hs : 0 ≤ s) (x : ℝ) : clip s (-x) = -clip s x := by
  by_cases hlo : x ≤ -s
  · rw [clip_of_le_neg hlo, clip_of_ge hs (by linarith)]
    simp
  · by_cases hhi : s ≤ x
    · rw [clip_of_ge hs hhi, clip_of_le_neg (by linarith)]
    · have hx : |x| ≤ s := abs_le.mpr ⟨by linarith, by linarith⟩
      rw [clip_eq_self hx, clip_eq_self (by simpa only [abs_neg] using hx)]

theorem clip_odd {s : ℝ} (hs : 0 ≤ s) : Function.Odd (clip s) := clip_neg hs

@[fun_prop] theorem continuous_clipResidual (s : ℝ) : Continuous (clipResidual s) :=
  continuous_id.sub (continuous_clip s)

theorem clipResidual_neg {s : ℝ} (hs : 0 ≤ s) (x : ℝ) :
    clipResidual s (-x) = -clipResidual s x := by
  simp only [clipResidual, clip_neg hs]
  ring

theorem clipResidual_odd {s : ℝ} (hs : 0 ≤ s) : Function.Odd (clipResidual s) :=
  clipResidual_neg hs

theorem clipResidual_eq_zero {s x : ℝ} (hx : |x| ≤ s) : clipResidual s x = 0 := by
  simp only [clipResidual, clip_eq_self hx, sub_self]

@[simp] theorem clipResidual_zero {s : ℝ} (hs : 0 ≤ s) : clipResidual s 0 = 0 :=
  clipResidual_eq_zero (by simpa using hs)

/-- Monotonicity together with nonexpansiveness of the clamp also makes its
residual nonexpansive (the naive triangle inequality would give constant two). -/
theorem abs_clipResidual_sub_le (s u v : ℝ) :
    |clipResidual s u - clipResidual s v| ≤ |u - v| := by
  have hlip := abs_clip_sub_clip_le s u v
  rcases le_total u v with huv | hvu
  · have hm := monotone_clip s huv
    rw [abs_of_nonpos (sub_nonpos.mpr hm),
      abs_of_nonpos (sub_nonpos.mpr huv)] at hlip
    rw [abs_of_nonpos (sub_nonpos.mpr huv)]
    apply abs_le.mpr
    dsimp only [clipResidual]
    constructor <;> linarith
  · have hm := monotone_clip s hvu
    rw [abs_of_nonneg (sub_nonneg.mpr hm),
      abs_of_nonneg (sub_nonneg.mpr hvu)] at hlip
    rw [abs_of_nonneg (sub_nonneg.mpr hvu)]
    apply abs_le.mpr
    dsimp only [clipResidual]
    constructor <;> linarith

theorem lipschitzWith_clipResidual (s : ℝ) : LipschitzWith 1 (clipResidual s) := by
  apply LipschitzWith.of_dist_le_mul
  intro u v
  simpa only [Real.dist_eq, NNReal.coe_one, one_mul] using
    abs_clipResidual_sub_le s u v

theorem abs_clipResidual_le {s : ℝ} (hs : 0 ≤ s) (x : ℝ) :
    |clipResidual s x| ≤ |x| := by
  simpa only [clipResidual_zero hs, sub_zero] using abs_clipResidual_sub_le s x 0

/-- The saturation residual vanishes when both inputs are small, and otherwise
its Lipschitz estimate is enough. This is the pointwise estimate used to split
large innovation replacements from the small-replacement contribution. -/
theorem abs_clipResidual_sub_le_min {s : ℝ} (hs : 0 < s) (u v : ℝ) :
    |clipResidual s u - clipResidual s v| ≤
      |u - v| * min 1 ((|u| + |v|) / s) := by
  by_cases huv : |u| + |v| ≤ s
  · have hu : |u| ≤ s := le_trans (le_add_of_nonneg_right (abs_nonneg v)) huv
    have hv : |v| ≤ s := le_trans (le_add_of_nonneg_left (abs_nonneg u)) huv
    rw [clipResidual_eq_zero hu, clipResidual_eq_zero hv, sub_self, abs_zero]
    exact mul_nonneg (abs_nonneg _) (le_min (by norm_num)
      (div_nonneg (add_nonneg (abs_nonneg _) (abs_nonneg _)) hs.le))
  · have hratio : 1 ≤ (|u| + |v|) / s := by
      apply (le_div_iff₀ hs).mpr
      simpa only [one_mul] using (le_of_lt (lt_of_not_ge huv))
    rw [min_eq_left hratio, mul_one]
    exact abs_clipResidual_sub_le s u v

/-- A convenient version without the `min`, for the small-replacement term. -/
theorem abs_clipResidual_sub_le_mul {s : ℝ} (hs : 0 < s) (u v : ℝ) :
    |clipResidual s u - clipResidual s v| ≤ |u - v| * ((|u| + |v|) / s) :=
  (abs_clipResidual_sub_le_min hs u v).trans
    (mul_le_mul_of_nonneg_left (min_le_right _ _) (abs_nonneg _))

end Cascade
end


/- Supporting development: Cascade.Controller -/
section
set_option autoImplicit false

/-
# A law-independent weak controller

The controller is a contraction on the Banach space of bounded continuous
corrections, not on a space of equivalence classes of random variables. Its
recurrence, bounds and symmetry therefore hold at every history.
-/

open scoped BoundedContinuousFunction NNReal
open Filter Topology

namespace Cascade.Controller

/-- Parameters of one finite-window weak controller. Its gain is `a * N < 1`
and its pointwise perturbation budget is `a * s`. -/
structure Params where
  N : ℕ
  N_pos : 0 < N
  a : ℝ
  a_nonneg : 0 ≤ a
  s : ℝ
  s_pos : 0 < s
  gain_lt_one : a * (N : ℝ) < 1

namespace Params

/-- The contraction constant, as a nonnegative real. -/
def gain (c : Params) : ℝ≥0 := ⟨c.a * (c.N : ℝ), mul_nonneg c.a_nonneg (Nat.cast_nonneg _)⟩

@[simp] theorem coe_gain (c : Params) : (c.gain : ℝ) = c.a * (c.N : ℝ) := rfl

theorem gain_lt_one' (c : Params) : c.gain < 1 := c.gain_lt_one

theorem one_sub_gain_pos (c : Params) : 0 < 1 - (c.gain : ℝ) :=
  sub_pos.mpr c.gain_lt_one

/-- The amplitude bound `b = a * s`. -/
def budget (c : Params) : ℝ := c.a * c.s

theorem budget_nonneg (c : Params) : 0 ≤ c.budget := mul_nonneg c.a_nonneg c.s_pos.le

end Params

/-- The sum of the last `N` outputs encoded by a strict innovation past `p`.
Here `p 0` is the innovation one step before the output being controlled. -/
def window (N : ℕ) (K : Correction) (p : Past) : ℝ :=
  ∑ j ∈ Finset.range N, (p j + K (dropPast (j + 1) p))

@[fun_prop] theorem continuous_window (N : ℕ) (K : Correction) :
    Continuous (window N K) := by
  unfold window
  exact continuous_finset_sum _ fun j _ ↦
    (continuous_apply j).add (K.continuous.comp
      (continuous_pi fun k ↦ continuous_apply (k + (j + 1))))

/-- Sup-norm sensitivity of the finite output window to its correction. -/
theorem abs_window_sub_le (N : ℕ) (K L : Correction) (p : Past) :
    |window N K p - window N L p| ≤ (N : ℝ) * ‖K - L‖ := by
  calc
    |window N K p - window N L p| =
        |∑ j ∈ Finset.range N, (K (dropPast (j + 1) p) - L (dropPast (j + 1) p))| := by
      congr 1
      simp only [window, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ ≤ ∑ j ∈ Finset.range N, |K (dropPast (j + 1) p) - L (dropPast (j + 1) p)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _j ∈ Finset.range N, ‖K - L‖ := by
      apply Finset.sum_le_sum
      intro j _
      exact (K - L).norm_coe_le_norm (dropPast (j + 1) p)
    _ = (N : ℝ) * ‖K - L‖ := by simp

/-- The bounded feedback evaluated with a trial correction. -/
noncomputable def feedback (c : Params) (K : Correction) : Correction :=
  BoundedContinuousFunction.ofNormedAddCommGroup
    (fun p ↦ c.a * clip c.s (window c.N K p))
    (continuous_const.mul ((continuous_clip c.s).comp (continuous_window c.N K)))
    c.budget (fun p ↦ by
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg c.a_nonneg]
      exact mul_le_mul_of_nonneg_left (abs_clip_le c.s_pos.le _) c.a_nonneg)

@[simp] theorem feedback_apply (c : Params) (K : Correction) (p : Past) :
    feedback c K p = c.a * clip c.s (window c.N K p) := rfl

theorem abs_feedback_le (c : Params) (K : Correction) (p : Past) :
    |feedback c K p| ≤ c.budget := by
  rw [feedback_apply, abs_mul, abs_of_nonneg c.a_nonneg]
  exact mul_le_mul_of_nonneg_left (abs_clip_le c.s_pos.le _) c.a_nonneg

theorem norm_feedback_le (c : Params) (K : Correction) : ‖feedback c K‖ ≤ c.budget :=
  (BoundedContinuousFunction.norm_le c.budget_nonneg).mpr (abs_feedback_le c K)

/-- One Picard step of the implicit controller equation. -/
noncomputable def step (c : Params) (oldK K : Correction) : Correction := oldK - feedback c K

@[simp] theorem step_apply (c : Params) (oldK K : Correction) (p : Past) :
    step c oldK K p = oldK p - c.a * clip c.s (window c.N K p) := rfl

theorem step_norm_sub_le (c : Params) (oldK K : Correction) :
    ‖step c oldK K - oldK‖ ≤ c.budget := by
  simpa only [step, sub_sub_cancel_left, norm_neg] using norm_feedback_le c K

/-- The Picard operator has sup-norm Lipschitz constant `g = a * N`. -/
theorem step_norm_sub_step_le (c : Params) (oldK K L : Correction) :
    ‖step c oldK K - step c oldK L‖ ≤ (c.gain : ℝ) * ‖K - L‖ := by
  apply (BoundedContinuousFunction.norm_le
    (mul_nonneg c.gain.coe_nonneg (norm_nonneg _))).mpr
  intro p
  change |(oldK p - c.a * clip c.s (window c.N K p)) -
    (oldK p - c.a * clip c.s (window c.N L p))| ≤ _
  calc
    _ = c.a * |clip c.s (window c.N K p) - clip c.s (window c.N L p)| := by
      rw [show (oldK p - c.a * clip c.s (window c.N K p)) -
        (oldK p - c.a * clip c.s (window c.N L p)) =
        -(c.a * (clip c.s (window c.N K p) - clip c.s (window c.N L p))) by ring,
        abs_neg, abs_mul, abs_of_nonneg c.a_nonneg]
    _ ≤ c.a * |window c.N K p - window c.N L p| :=
      mul_le_mul_of_nonneg_left (abs_clip_sub_clip_le _ _ _) c.a_nonneg
    _ ≤ c.a * ((c.N : ℝ) * ‖K - L‖) :=
      mul_le_mul_of_nonneg_left (abs_window_sub_le _ _ _ _) c.a_nonneg
    _ = (c.gain : ℝ) * ‖K - L‖ := by rw [Params.coe_gain, mul_assoc]

theorem step_lipschitz (c : Params) (oldK : Correction) :
    LipschitzWith c.gain (step c oldK) := by
  apply LipschitzWith.of_dist_le_mul
  intro K L
  simpa only [dist_eq_norm] using step_norm_sub_step_le c oldK K L

theorem step_contracting (c : Params) (oldK : Correction) :
    ContractingWith c.gain (step c oldK) := ⟨c.gain_lt_one', step_lipschitz c oldK⟩

/-- The updated bounded continuous correction. This definition involves no law
and gives an actual value at every innovation history. -/
noncomputable def update (c : Params) (oldK : Correction) : Correction :=
  (step_contracting c oldK).fixedPoint (step c oldK)

theorem update_isFixedPt (c : Params) (oldK : Correction) :
    Function.IsFixedPt (step c oldK) (update c oldK) :=
  (step_contracting c oldK).fixedPoint_isFixedPt

/-- The exact, everywhere implicit controller recurrence. -/
theorem update_eq (c : Params) (oldK : Correction) (p : Past) :
    update c oldK p = oldK p - c.a * clip c.s
      (∑ j ∈ Finset.range c.N, (p j + update c oldK (dropPast (j + 1) p))) := by
  have h := congrArg (fun K : Correction ↦ K p) (update_isFixedPt c oldK)
  exact h.symm

/-- Uniqueness holds among all bounded continuous corrections satisfying the
pointwise recurrence, without any probabilistic qualifications. -/
theorem update_unique (c : Params) (oldK K : Correction)
    (hK : ∀ p, K p = oldK p - c.a * clip c.s (window c.N K p)) : K = update c oldK := by
  apply (step_contracting c oldK).fixedPoint_unique
  ext p
  exact (hK p).symm

theorem update_abs_sub_le (c : Params) (oldK : Correction) (p : Past) :
    |update c oldK p - oldK p| ≤ c.budget := by
  rw [update_eq]
  simpa only [sub_sub_cancel_left, abs_neg] using abs_feedback_le c (update c oldK) p

theorem update_norm_sub_le (c : Params) (oldK : Correction) :
    ‖update c oldK - oldK‖ ≤ c.budget :=
  (BoundedContinuousFunction.norm_le c.budget_nonneg).mpr (update_abs_sub_le c oldK)

theorem norm_update_le (c : Params) (oldK : Correction) :
    ‖update c oldK‖ ≤ ‖oldK‖ + c.budget := by
  calc
    ‖update c oldK‖ = ‖(update c oldK - oldK) + oldK‖ := by rw [sub_add_cancel]
    _ ≤ ‖update c oldK - oldK‖ + ‖oldK‖ := norm_add_le _ _
    _ ≤ c.budget + ‖oldK‖ := add_le_add (update_norm_sub_le c oldK) le_rfl
    _ = ‖oldK‖ + c.budget := add_comm _ _

@[fun_prop] theorem continuous_update (c : Params) (oldK : Correction) :
    Continuous (update c oldK : Past → ℝ) := (update c oldK).continuous

/-- The window at the strict past of `x` is precisely the last `N` factor
outputs, with lags `1, ..., N`. -/
theorem window_dropPast_one (N : ℕ) (K : Correction) (x : Past) :
    window N K (dropPast 1 x) =
      ∑ j ∈ Finset.range N, factor K (dropPast (j + 1) x) := by
  unfold window
  apply Finset.sum_congr rfl
  intro j _
  congr 1
  · simp only [dropPast, Nat.zero_add]
  · congr 1
    funext k
    simp only [dropPast]
    congr 1
    omega

/-- The controller law in terms of output factors. -/
theorem factor_update (c : Params) (oldK : Correction) (x : Past) :
    factor (update c oldK) x = factor oldK x - c.a * clip c.s
      (∑ j ∈ Finset.range c.N, factor (update c oldK) (dropPast (j + 1) x)) := by
  change x 0 + update c oldK (dropPast 1 x) = _
  rw [update_eq]
  change x 0 + (oldK (dropPast 1 x) - c.a * clip c.s
    (window c.N (update c oldK) (dropPast 1 x))) = _
  rw [window_dropPast_one]
  simp only [factor]
  ring

theorem factor_update_abs_sub_le (c : Params) (oldK : Correction) (x : Past) :
    |factor (update c oldK) x - factor oldK x| ≤ c.budget := by
  simpa only [factor, add_sub_add_left_eq_sub] using
    update_abs_sub_le c oldK (dropPast 1 x)

/-- Simultaneous reversal of the input and output signs of a correction. -/
noncomputable def reflect (K : Correction) : Correction :=
  -(K.compContinuous ⟨fun p : Past ↦ -p, continuous_neg⟩)

@[simp] theorem reflect_apply (K : Correction) (p : Past) : reflect K p = -K (-p) := rfl

@[simp] theorem reflect_reflect (K : Correction) : reflect (reflect K) = K := by
  ext p
  simp only [reflect_apply, neg_neg]

theorem window_reflect (N : ℕ) (K : Correction) (p : Past) :
    window N (reflect K) p = -window N K (-p) := by
  unfold window
  rw [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro j _
  change p j + -K (dropPast (j + 1) (-p)) =
    -(-p j + K (dropPast (j + 1) (-p)))
  ring

/-- Sign reversal conjugates the two Picard operators. -/
theorem step_reflect (c : Params) (oldK K : Correction) :
    step c (reflect oldK) (reflect K) = reflect (step c oldK K) := by
  ext p
  simp only [step_apply, reflect_apply, window_reflect, clip_neg c.s_pos.le]
  ring

theorem update_reflect (c : Params) (oldK : Correction) :
    update c (reflect oldK) = reflect (update c oldK) := by
  symm
  apply (step_contracting c (reflect oldK)).fixedPoint_unique
  change step c (reflect oldK) (reflect (update c oldK)) = reflect (update c oldK)
  rw [step_reflect, update_isFixedPt c oldK]

/-- Oddness is preserved by the controller, at every history. -/
theorem update_odd (c : Params) (oldK : Correction)
    (hodd : Function.Odd (oldK : Past → ℝ)) :
    Function.Odd (update c oldK : Past → ℝ) := by
  have hold : reflect oldK = oldK := by
    ext p
    simp only [reflect_apply, hodd p, neg_neg]
  have hnew : reflect (update c oldK) = update c oldK := by
    rw [← update_reflect, hold]
  intro p
  have h := congrArg (fun K : Correction ↦ K p) hnew
  change -update c oldK (-p) = update c oldK p at h
  linarith

theorem factor_update_odd (c : Params) (oldK : Correction)
    (hodd : Function.Odd (oldK : Past → ℝ)) : Function.Odd (factor (update c oldK)) := by
  intro x
  change -x 0 + update c oldK (-(dropPast 1 x)) =
    -(x 0 + update c oldK (dropPast 1 x))
  rw [update_odd c oldK hodd]
  ring

/-- Changing the old correction costs at most the usual resolvent factor
`1 / (1 - g)` in sup norm. -/
theorem update_norm_sub_update_le (c : Params) (K L : Correction) :
    ‖update c K - update c L‖ ≤ ‖K - L‖ / (1 - (c.gain : ℝ)) := by
  have h := (step_contracting c K).fixedPoint_lipschitz_in_map (step_contracting c L)
    (C := ‖K - L‖) (fun trial ↦ by
      rw [dist_eq_norm]
      have heq : step c K trial - step c L trial = K - L := by
        unfold step
        abel
      rw [heq])
  simpa only [update, dist_eq_norm] using h

/-- Picard iteration converges in the space of bounded continuous functions,
so the convergence is in sup norm, not merely almost everywhere. -/
theorem tendsto_iterate_update (c : Params) (oldK start : Correction) :
    Tendsto (fun n ↦ (step c oldK)^[n] start) atTop (𝓝 (update c oldK)) :=
  (step_contracting c oldK).tendsto_iterate_fixedPoint start

/-- An explicit uniform error bound for Picard iteration started from `oldK`. -/
theorem norm_iterate_sub_update_le (c : Params) (oldK : Correction) (n : ℕ) :
    ‖(step c oldK)^[n] oldK - update c oldK‖ ≤
      c.budget * (c.gain : ℝ) ^ n / (1 - (c.gain : ℝ)) := by
  have hzero : dist oldK (step c oldK oldK) ≤ c.budget := by
    rw [dist_comm, dist_eq_norm]
    exact step_norm_sub_le c oldK oldK
  calc
    _ ≤ dist oldK (step c oldK oldK) * (c.gain : ℝ) ^ n / (1 - (c.gain : ℝ)) := by
      simpa only [dist_eq_norm, update] using
        (step_contracting c oldK).apriori_dist_iterate_fixedPoint_le oldK n
    _ ≤ c.budget * (c.gain : ℝ) ^ n / (1 - (c.gain : ℝ)) :=
      div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right hzero (pow_nonneg c.gain.coe_nonneg _))
        c.one_sub_gain_pos.le

section Inverse

/-- The finite-memory kernel of the inverse controller: it is a function of
output histories, not of innovation histories. -/
noncomputable def inverseKernel (c : Params) : Correction := feedback c 0

@[simp] theorem inverseKernel_apply (c : Params) (p : Past) :
    inverseKernel c p = c.a * clip c.s (∑ j ∈ Finset.range c.N, p j) := by
  simp only [inverseKernel, feedback_apply, window, BoundedContinuousFunction.coe_zero,
    Pi.zero_apply, add_zero]

theorem inverseKernel_abs_le (c : Params) (p : Past) : |inverseKernel c p| ≤ c.budget :=
  abs_feedback_le c 0 p

theorem inverseKernel_norm_le (c : Params) : ‖inverseKernel c‖ ≤ c.budget :=
  norm_feedback_le c 0

theorem inverseKernel_hasMemory (c : Params) :
    HasMemory (inverseKernel c : Past → ℝ) c.N := by
  intro p q hpq
  have hsum : (∑ j ∈ Finset.range c.N, p j) = ∑ j ∈ Finset.range c.N, q j :=
    Finset.sum_congr rfl fun j hj ↦ hpq j (Finset.mem_range.mp hj)
  simp only [inverseKernel_apply, hsum]

theorem inverseKernel_odd (c : Params) : Function.Odd (inverseKernel c : Past → ℝ) := by
  intro p
  simp only [inverseKernel_apply, Pi.neg_apply, Finset.sum_neg_distrib,
    clip_neg c.s_pos.le, mul_neg]

theorem inverseKernel_abs_sub_le (c : Params) (p q : Past) :
    |inverseKernel c p - inverseKernel c q| ≤
      c.a * ∑ j ∈ Finset.range c.N, |p j - q j| := by
  rw [inverseKernel_apply, inverseKernel_apply, ← mul_sub, abs_mul,
    abs_of_nonneg c.a_nonneg]
  apply mul_le_mul_of_nonneg_left _ c.a_nonneg
  calc
    _ ≤ |(∑ j ∈ Finset.range c.N, p j) - ∑ j ∈ Finset.range c.N, q j| :=
      abs_clip_sub_clip_le _ _ _
    _ ≤ ∑ j ∈ Finset.range c.N, |p j - q j| := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.abs_sum_le_sum_abs _ _

theorem inverseKernel_uniformLip (c : Params) :
    UniformLip (inverseKernel c : Past → ℝ) c.gain := by
  intro C _hC p q hpq
  calc
    _ ≤ c.a * ∑ j ∈ Finset.range c.N, |p j - q j| := inverseKernel_abs_sub_le c p q
    _ ≤ c.a * ∑ _j ∈ Finset.range c.N, C :=
      mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun j _ ↦ hpq j) c.a_nonneg
    _ = (c.gain : ℝ) * C := by simp [Params.coe_gain, mul_assoc]

/-- The finite-window inverse map `T`: at each time, add the clamped sum of
the previous `N` outputs. It acts on arbitrary, possibly unbounded histories. -/
noncomputable def inverse (c : Params) (x : Past) : Past :=
  fun k ↦ x k + inverseKernel c (dropPast (k + 1) x)

@[simp] theorem inverse_apply (c : Params) (x : Past) (k : ℕ) :
    inverse c x k = x k + c.a * clip c.s
      (∑ j ∈ Finset.range c.N, x (j + (k + 1))) := by
  simp only [inverse, inverseKernel_apply, dropPast]

@[fun_prop] theorem continuous_inverse (c : Params) : Continuous (inverse c) :=
  continuous_pi fun k ↦ (continuous_apply k).add
    ((inverseKernel c).continuous.comp (continuous_pi fun j ↦ continuous_apply (j + (k + 1))))

theorem inverse_odd (c : Params) : Function.Odd (inverse c) := by
  intro x
  funext k
  change -x k + inverseKernel c (-(dropPast (k + 1) x)) =
    -(x k + inverseKernel c (dropPast (k + 1) x))
  rw [inverseKernel_odd c]
  ring

theorem inverse_abs_sub_le (c : Params) (x : Past) (k : ℕ) :
    |inverse c x k - x k| ≤ c.budget := by
  simpa only [inverse, add_sub_cancel_left] using inverseKernel_abs_le c (dropPast (k + 1) x)

private theorem dropPast_comp (m n : ℕ) (x : Past) :
    dropPast m (dropPast n x) = dropPast (m + n) x := by
  funext k
  simp only [dropPast, Nat.add_assoc]

/-- The inverse controller respects time shifts of histories. -/
theorem inverse_dropPast (c : Params) (n : ℕ) (x : Past) :
    inverse c (dropPast n x) = dropPast n (inverse c x) := by
  funext k
  change x (k + n) + inverseKernel c (dropPast (k + 1) (dropPast n x)) =
    x (k + n) + inverseKernel c (dropPast (k + n + 1) x)
  rw [dropPast_comp, show k + 1 + n = k + n + 1 by omega]

/-- Each coordinate of `T` is uniformly coordinate-Lipschitz with constant
`1 + g`, without requiring either history itself to be bounded. -/
theorem inverse_uniformLip (c : Params) (k : ℕ) :
    UniformLip (fun x ↦ inverse c x k) (1 + (c.gain : ℝ)) := by
  intro C hC x y hxy
  have hw := inverseKernel_uniformLip c C hC (dropPast (k + 1) x) (dropPast (k + 1) y)
    (fun j ↦ hxy (j + (k + 1)))
  calc
    _ = |(x k - y k) + (inverseKernel c (dropPast (k + 1) x) -
        inverseKernel c (dropPast (k + 1) y))| := by
      congr 1
      dsimp only [inverse]
      ring
    _ ≤ |x k - y k| + |inverseKernel c (dropPast (k + 1) x) -
        inverseKernel c (dropPast (k + 1) y)| := abs_add_le _ _
    _ ≤ C + (c.gain : ℝ) * C := add_le_add (hxy k) hw
    _ = (1 + (c.gain : ℝ)) * C := by ring

/-- The entire output history associated to an innovation history. -/
def factorHistory (K : Correction) (x : Past) : Past := fun k ↦ factor K (dropPast k x)

/-- `T` really inverts this controller on its causal outputs, at every history. -/
theorem inverse_factorHistory_update (c : Params) (oldK : Correction) (x : Past) :
    inverse c (factorHistory (update c oldK) x) = factorHistory oldK x := by
  funext k
  rw [inverse_apply]
  change factor (update c oldK) (dropPast k x) + c.a * clip c.s
    (∑ j ∈ Finset.range c.N, factor (update c oldK) (dropPast (j + (k + 1)) x)) =
    factor oldK (dropPast k x)
  have hw : (∑ j ∈ Finset.range c.N,
      factor (update c oldK) (dropPast (j + (k + 1)) x)) =
      ∑ j ∈ Finset.range c.N, factor (update c oldK) (dropPast (j + 1) (dropPast k x)) := by
    apply Finset.sum_congr rfl
    intro j _
    rw [dropPast_comp]
    congr 2
    omega
  rw [hw]
  linarith only [factor_update c oldK (dropPast k x)]

end Inverse

/-- The exact linearized controller law, with the saturation error displayed
as the clamp residual. -/
theorem factor_update_add_window (c : Params) (oldK : Correction) (x : Past) :
    factor (update c oldK) x + c.a *
        (∑ j ∈ Finset.range c.N, factor (update c oldK) (dropPast (j + 1) x)) =
      factor oldK x + c.a * clipResidual c.s
        (∑ j ∈ Finset.range c.N, factor (update c oldK) (dropPast (j + 1) x)) := by
  conv_lhs => rw [factor_update c oldK x]
  unfold clipResidual
  ring

/-- A deterministic difference recurrence, before choosing an influence
majorant. The finite sum contains only strictly older output differences. -/
theorem abs_factor_update_sub_le (c : Params) (oldK : Correction) (x y : Past) :
    |factor (update c oldK) x - factor (update c oldK) y| ≤
      |factor oldK x - factor oldK y| + c.a *
        ∑ j ∈ Finset.range c.N,
          |factor (update c oldK) (dropPast (j + 1) x) -
            factor (update c oldK) (dropPast (j + 1) y)| := by
  let U := ∑ j ∈ Finset.range c.N, factor (update c oldK) (dropPast (j + 1) x)
  let V := ∑ j ∈ Finset.range c.N, factor (update c oldK) (dropPast (j + 1) y)
  have heq : factor (update c oldK) x - factor (update c oldK) y =
      (factor oldK x - factor oldK y) - c.a * (clip c.s U - clip c.s V) := by
    rw [factor_update c oldK x, factor_update c oldK y]
    dsimp only [U, V]
    ring
  rw [heq]
  calc
    _ ≤ |factor oldK x - factor oldK y| + |c.a * (clip c.s U - clip c.s V)| := abs_sub _ _
    _ = |factor oldK x - factor oldK y| + c.a * |clip c.s U - clip c.s V| := by
      rw [abs_mul, abs_of_nonneg c.a_nonneg]
    _ ≤ |factor oldK x - factor oldK y| + c.a * |U - V| :=
      add_le_add le_rfl (mul_le_mul_of_nonneg_left (abs_clip_sub_clip_le _ _ _) c.a_nonneg)
    _ ≤ _ := by
      apply add_le_add le_rfl
      apply mul_le_mul_of_nonneg_left _ c.a_nonneg
      dsimp only [U, V]
      rw [← Finset.sum_sub_distrib]
      exact Finset.abs_sum_le_sum_abs _ _

section Influence

private theorem dropPast_update_of_le (x : Past) (k n : ℕ) (z : ℝ) (hn : n ≤ k) :
    dropPast n (Function.update x k z) = Function.update (dropPast n x) (k - n) z := by
  funext i
  by_cases hi : i = k - n
  · subst i
    simp only [dropPast, Function.update_apply, Nat.sub_add_cancel hn, if_true]
  · have his : i + n ≠ k := by omega
    simp only [dropPast, Function.update_apply, hi, his, if_false]

private theorem dropPast_update_of_lt (x : Past) (k n : ℕ) (z : ℝ) (hn : k < n) :
    dropPast n (Function.update x k z) = dropPast n x := by
  funext i
  exact Function.update_of_ne (by omega : i + n ≠ k) z x

/-- Any majorant satisfying the finite causal renewal inequality controls the
new factor's one-coordinate influences. No summability assumption is needed
for this pointwise result. -/
theorem factor_update_hasInfluence_of (c : Params) (oldK : Correction) {d e : ℕ → ℝ}
    (hold : HasInfluence (factor oldK) d)
    (he : ∀ k, d k + c.a * (∑ j ∈ Finset.range c.N,
      if j + 1 ≤ k then e (k - (j + 1)) else 0) ≤ e k) :
    HasInfluence (factor (update c oldK)) e := by
  intro x k z
  induction k using Nat.strong_induction_on generalizing x with
  | h k ih =>
    have hlag : ∀ j ∈ Finset.range c.N,
        |factor (update c oldK) (dropPast (j + 1) (Function.update x k z)) -
          factor (update c oldK) (dropPast (j + 1) x)| ≤
          (if j + 1 ≤ k then e (k - (j + 1)) else 0) * |z - x k| := by
      intro j _
      by_cases hj : j + 1 ≤ k
      · rw [if_pos hj, dropPast_update_of_le x k (j + 1) z hj]
        have h := ih (k - (j + 1)) (by omega) (dropPast (j + 1) x)
        simpa only [dropPast, Nat.sub_add_cancel hj] using h
      · rw [if_neg hj, dropPast_update_of_lt x k (j + 1) z (by omega),
          sub_self, abs_zero, zero_mul]
    calc
      _ ≤ |factor oldK (Function.update x k z) - factor oldK x| + c.a *
          ∑ j ∈ Finset.range c.N,
            |factor (update c oldK) (dropPast (j + 1) (Function.update x k z)) -
              factor (update c oldK) (dropPast (j + 1) x)| :=
        abs_factor_update_sub_le c oldK _ _
      _ ≤ d k * |z - x k| + c.a * (∑ j ∈ Finset.range c.N,
          (if j + 1 ≤ k then e (k - (j + 1)) else 0) * |z - x k|) :=
        add_le_add (hold x k z)
          (mul_le_mul_of_nonneg_left (Finset.sum_le_sum hlag) c.a_nonneg)
      _ = (d k + c.a * (∑ j ∈ Finset.range c.N,
          if j + 1 ≤ k then e (k - (j + 1)) else 0)) * |z - x k| := by
        rw [← Finset.sum_mul]
        ring
      _ ≤ e k * |z - x k| := mul_le_mul_of_nonneg_right (he k) (abs_nonneg _)

/-- A concrete, causal influence envelope. At lag `k` it refers only to
strictly smaller lags. This is the renewal sequence for the finite controller,
with the old influence envelope as forcing. -/
noncomputable def influenceEnvelope (c : Params) (d : ℕ → ℝ) (k : ℕ) : ℝ :=
  d k + c.a * ∑ j ∈ Finset.range c.N,
    if _h : j + 1 ≤ k then influenceEnvelope c d (k - (j + 1)) else 0
termination_by k
decreasing_by omega

theorem influenceEnvelope_eq (c : Params) (d : ℕ → ℝ) (k : ℕ) :
    influenceEnvelope c d k = d k + c.a * (∑ j ∈ Finset.range c.N,
      if j + 1 ≤ k then influenceEnvelope c d (k - (j + 1)) else 0) := by
  rw [influenceEnvelope]
  simp only [dite_eq_ite]

@[simp] theorem influenceEnvelope_zero (c : Params) (d : ℕ → ℝ) :
    influenceEnvelope c d 0 = d 0 := by
  rw [influenceEnvelope_eq]
  simp

theorem influenceEnvelope_nonneg (c : Params) {d : ℕ → ℝ} (hd : ∀ k, 0 ≤ d k) :
    ∀ k, 0 ≤ influenceEnvelope c d k := by
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    rw [influenceEnvelope_eq]
    apply add_nonneg (hd k)
    apply mul_nonneg c.a_nonneg
    apply Finset.sum_nonneg
    intro j _
    split_ifs with hj
    · exact ih _ (by omega)
    · exact le_rfl

/-- The controller's everywhere-defined output factor inherits an explicit
one-coordinate influence envelope from its input factor. -/
theorem factor_update_hasInfluence (c : Params) (oldK : Correction) {d : ℕ → ℝ}
    (hold : HasInfluence (factor oldK) d) :
    HasInfluence (factor (update c oldK)) (influenceEnvelope c d) :=
  factor_update_hasInfluence_of c oldK hold fun k ↦ (influenceEnvelope_eq c d k).symm.le

end Influence

end Cascade.Controller
end


/- Supporting development: Cascade.History -/
section
set_option autoImplicit false

/-
# Histories of iid innovations

The elementary path maps respect the product topology and product measurable space.
An injective reindexing preserves an iid law, even for arbitrary index types.  Applying
this to backwards histories and time shifts gives the law and joint stationarity of
every measurable causal factor.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped BoundedContinuousFunction ENNReal NNReal

namespace Cascade

section PathMaps

@[simp] theorem dropPast_zero (x : Past) : dropPast 0 x = x := by
  ext k
  simp [dropPast]

/-- Dropping `m + n` coordinates is dropping `n` and then `m`. -/
theorem dropPast_add (m n : ℕ) (x : Past) :
    dropPast (m + n) x = dropPast m (dropPast n x) := by
  ext k
  simp [dropPast, Nat.add_assoc]

@[simp] theorem dropPast_dropPast (m n : ℕ) (x : Past) :
    dropPast m (dropPast n x) = dropPast (m + n) x :=
  (dropPast_add m n x).symm

@[simp] theorem shiftPath_zero (ω : NoisePath) : shiftPath 0 ω = ω := by
  ext k
  simp [shiftPath]

theorem shiftPath_add (s t : ℤ) (ω : NoisePath) :
    shiftPath (s + t) ω = shiftPath s (shiftPath t ω) := by
  ext k
  simp [shiftPath, add_assoc]

@[simp] theorem shiftPath_shiftPath (s t : ℤ) (ω : NoisePath) :
    shiftPath s (shiftPath t ω) = shiftPath (s + t) ω :=
  (shiftPath_add s t ω).symm

/-- A positive shift of the path advances the time of its history. -/
@[simp] theorem history_shift (t s : ℤ) (ω : NoisePath) :
    history t (shiftPath s ω) = history (t + s) ω := by
  ext k
  simp only [history, shiftPath]
  congr 1
  ring

/-- Dropping recent innovations moves the endpoint of a history into the past. -/
@[simp] theorem dropPast_history (n : ℕ) (t : ℤ) (ω : NoisePath) :
    dropPast n (history t ω) = history (t - (n : ℤ)) ω := by
  ext k
  simp only [dropPast, history, Nat.cast_add]
  congr 1
  ring

@[simp] theorem dropPast_neg (n : ℕ) (x : Past) :
    dropPast n (-x) = -dropPast n x := rfl

@[simp] theorem history_neg (t : ℤ) (ω : NoisePath) :
    history t (-ω) = -history t ω := rfl

@[simp] theorem shiftPath_neg (t : ℤ) (ω : NoisePath) :
    shiftPath t (-ω) = -shiftPath t ω := rfl

theorem continuous_reindex {I J : Type*} (r : J → I) :
    Continuous (fun (x : I → ℝ) j ↦ x (r j)) :=
  continuous_pi fun j ↦ continuous_apply (r j)

theorem measurable_reindex {I J : Type*} (r : J → I) :
    Measurable (fun (x : I → ℝ) j ↦ x (r j)) :=
  measurable_pi_lambda _ fun j ↦ measurable_pi_apply (r j)

@[fun_prop] theorem continuous_dropPast (n : ℕ) : Continuous (dropPast n) :=
  continuous_reindex (fun k ↦ k + n)

@[fun_prop] theorem measurable_dropPast (n : ℕ) : Measurable (dropPast n) :=
  measurable_reindex (fun k ↦ k + n)

@[fun_prop] theorem continuous_history (t : ℤ) : Continuous (history t) :=
  continuous_reindex (fun k : ℕ ↦ t - (k : ℤ))

@[fun_prop] theorem measurable_history (t : ℤ) : Measurable (history t) :=
  measurable_reindex (fun k : ℕ ↦ t - (k : ℤ))

@[fun_prop] theorem continuous_shiftPath (t : ℤ) : Continuous (shiftPath t) :=
  continuous_reindex (fun k ↦ k + t)

@[fun_prop] theorem measurable_shiftPath (t : ℤ) : Measurable (shiftPath t) :=
  measurable_reindex (fun k ↦ k + t)

@[simp] theorem atTime_shift (F : Past → ℝ) (t s : ℤ) (ω : NoisePath) :
    atTime F t (shiftPath s ω) = atTime F (t + s) ω := by
  simp only [atTime, history_shift]

@[fun_prop] theorem continuous_atTime {F : Past → ℝ} (hF : Continuous F) (t : ℤ) :
    Continuous (atTime F t) :=
  hF.comp (continuous_history t)

@[fun_prop] theorem measurable_atTime {F : Past → ℝ} (hF : Measurable F) (t : ℤ) :
    Measurable (atTime F t) :=
  hF.comp (measurable_history t)

end PathMaps

section IidLaw

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

instance isProbabilityMeasure_iidLaw (I : Type*) : IsProbabilityMeasure (iidLaw I ν) := by
  unfold iidLaw
  infer_instance

/-- Every coordinate of an iid path has the innovation law. -/
theorem measurePreserving_iid_eval {I : Type*} (i : I) :
    MeasurePreserving (fun x : I → ℝ ↦ x i) (iidLaw I ν) ν :=
  measurePreserving_eval_infinitePi (fun _ : I ↦ ν) i

@[simp] theorem iidLaw_map_eval {I : Type*} (i : I) :
    (iidLaw I ν).map (fun x : I → ℝ ↦ x i) = ν :=
  (measurePreserving_iid_eval ν i).map_eq

/-- The full family of innovation coordinates is independent. -/
theorem iIndepFun_iid (I : Type*) :
    iIndepFun (fun (i : I) (x : I → ℝ) ↦ x i) (iidLaw I ν) :=
  iIndepFun_infinitePi (P := fun _ : I ↦ ν) (X := fun _ ↦ id)
    (fun _ ↦ measurable_id)

/-- Any injective coordinate selection sends an iid law to the iid law on the
new index type. No countability or surjectivity assumption is needed. -/
theorem measurePreserving_iid_reindex {I J : Type*} (r : J → I)
    (hr : Function.Injective r) :
    MeasurePreserving (fun (x : I → ℝ) j ↦ x (r j)) (iidLaw I ν) (iidLaw J ν) where
  measurable := measurable_reindex r
  map_eq := by
    have hind := (iIndepFun_iid ν I).precomp hr
    have hmap := (iIndepFun_iff_map_fun_eq_infinitePi_map
      (fun j : J ↦ measurable_pi_apply (r j))).mp hind
    simpa only [iidLaw, Measure.infinitePi_map_eval] using hmap

@[simp] theorem iidLaw_map_reindex {I J : Type*} (r : J → I)
    (hr : Function.Injective r) :
    (iidLaw I ν).map (fun (x : I → ℝ) j ↦ x (r j)) = iidLaw J ν :=
  (measurePreserving_iid_reindex ν r hr).map_eq

theorem measurePreserving_dropPast (n : ℕ) :
    MeasurePreserving (dropPast n) (iidLaw ℕ ν) (iidLaw ℕ ν) :=
  measurePreserving_iid_reindex ν (fun k ↦ k + n)
    (fun _ _ h ↦ Nat.add_right_cancel h)

theorem measurePreserving_history (t : ℤ) :
    MeasurePreserving (history t) (iidLaw ℤ ν) (iidLaw ℕ ν) :=
  measurePreserving_iid_reindex ν (fun k : ℕ ↦ t - (k : ℤ))
    (by
      intro a b h
      change t - (a : ℤ) = t - (b : ℤ) at h
      omega)

theorem measurePreserving_shiftPath (t : ℤ) :
    MeasurePreserving (shiftPath t) (iidLaw ℤ ν) (iidLaw ℤ ν) :=
  measurePreserving_iid_reindex ν (fun k ↦ k + t)
    (fun _ _ h ↦ add_right_cancel h)

@[simp] theorem iidLaw_map_dropPast (n : ℕ) :
    (iidLaw ℕ ν).map (dropPast n) = iidLaw ℕ ν :=
  (measurePreserving_dropPast ν n).map_eq

@[simp] theorem iidLaw_map_history (t : ℤ) :
    (iidLaw ℤ ν).map (history t) = iidLaw ℕ ν :=
  (measurePreserving_history ν t).map_eq

@[simp] theorem iidLaw_map_shiftPath (t : ℤ) :
    (iidLaw ℤ ν).map (shiftPath t) = iidLaw ℤ ν :=
  (measurePreserving_shiftPath ν t).map_eq

end IidLaw

section Stationarity

/-- Composing a measurable observable with a measure-preserving map does not
change its law (the source and target probability spaces may be different). -/
theorem identDistrib_comp_measurePreserving {Ω Ω' E : Type*}
    [MeasurableSpace Ω] [MeasurableSpace Ω'] [MeasurableSpace E]
    {μ : Measure Ω} {μ' : Measure Ω'} {T : Ω → Ω'} {F : Ω' → E}
    (hT : MeasurePreserving T μ μ') (hF : Measurable F) :
    IdentDistrib (F ∘ T) F μ μ' where
  aemeasurable_fst := (hF.comp hT.measurable).aemeasurable
  aemeasurable_snd := hF.aemeasurable
  map_eq := by rw [← Measure.map_map hF hT.measurable, hT.map_eq]

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- The observable at any time has precisely its one-sided history law. -/
theorem identDistrib_atTime {F : Past → ℝ} (hF : Measurable F) (t : ℤ) :
    IdentDistrib (atTime F t) F (iidLaw ℤ ν) (iidLaw ℕ ν) :=
  identDistrib_comp_measurePreserving (measurePreserving_history ν t) hF

theorem iidLaw_map_atTime {F : Past → ℝ} (hF : Measurable F) (t : ℤ) :
    (iidLaw ℤ ν).map (atTime F t) = (iidLaw ℕ ν).map F :=
  (identDistrib_atTime ν hF t).map_eq

theorem identDistrib_atTime_atTime {F : Past → ℝ} (hF : Measurable F) (s t : ℤ) :
    IdentDistrib (atTime F s) (atTime F t) (iidLaw ℤ ν) (iidLaw ℤ ν) :=
  (identDistrib_atTime ν hF s).trans (identDistrib_atTime ν hF t).symm

/-- Joint stationarity for any indexed family of integer observation times. -/
theorem identDistrib_atTime_shift {I : Type*} {F : Past → ℝ} (hF : Measurable F)
    (times : I → ℤ) (k : ℤ) :
    IdentDistrib (fun ω i ↦ atTime F (times i + k) ω)
      (fun ω i ↦ atTime F (times i) ω) (iidLaw ℤ ν) (iidLaw ℤ ν) := by
  have hX : Measurable (fun (ω : NoisePath) i ↦ atTime F (times i) ω) :=
    measurable_pi_lambda _ fun i ↦ measurable_atTime hF (times i)
  simpa only [Function.comp_def, atTime_shift] using
    identDistrib_comp_measurePreserving (measurePreserving_shiftPath ν k) hX

/-- In particular the natural-time realization is strictly stationary, as an
identity in distribution of entire sequences, not just finite-dimensional marginals. -/
theorem atTime_stationary {F : Past → ℝ} (hF : Measurable F) :
    ∀ k : ℕ, IdentDistrib
      (fun ω (n : ℕ) ↦ atTime F ((n + k : ℕ) : ℤ) ω)
      (fun ω (n : ℕ) ↦ atTime F (n : ℤ) ω) (iidLaw ℤ ν) (iidLaw ℤ ν) := by
  intro k
  simpa only [Nat.cast_add] using
    identDistrib_atTime_shift ν hF (fun n : ℕ ↦ (n : ℤ)) (k : ℤ)

/-- Integer shifts are also allowed for the natural-time observation family. -/
theorem atTime_stationary_int {F : Past → ℝ} (hF : Measurable F) (k : ℤ) :
    IdentDistrib (fun ω (n : ℕ) ↦ atTime F ((n : ℤ) + k) ω)
      (fun ω (n : ℕ) ↦ atTime F (n : ℤ) ω) (iidLaw ℤ ν) (iidLaw ℤ ν) :=
  identDistrib_atTime_shift ν hF (fun n : ℕ ↦ (n : ℤ)) k

theorem memLp_atTime {F : Past → ℝ} {p : ℝ≥0∞}
    (hF : MemLp F p (iidLaw ℕ ν)) (t : ℤ) :
    MemLp (atTime F t) p (iidLaw ℤ ν) :=
  hF.comp_measurePreserving (measurePreserving_history ν t)

theorem integral_atTime {F : Past → ℝ} (hF : Measurable F) (t : ℤ) :
    (∫ ω, atTime F t ω ∂iidLaw ℤ ν) = ∫ x, F x ∂iidLaw ℕ ν :=
  (identDistrib_atTime ν hF t).integral_eq

end Stationarity

section Symmetry

/-- The definition of symmetry, packaged as a measure-preserving map. -/
theorem measurePreserving_neg_of_symmetric {ν : Measure ℝ} (hν : SymmetricLaw ν) :
    MeasurePreserving (fun x : ℝ ↦ -x) ν ν :=
  ⟨measurable_neg, hν⟩

/-- An odd real function integrates to zero against a symmetric law.
This also holds for the total Bochner integral when the function is not integrable. -/
theorem integral_odd_eq_zero {ν : Measure ℝ} (hν : SymmetricLaw ν)
    {f : ℝ → ℝ} (hf : Function.Odd f) : (∫ x, f x ∂ν) = 0 := by
  have hpres : MeasurePreserving (MeasurableEquiv.neg ℝ) ν ν :=
    measurePreserving_neg_of_symmetric hν
  have h := hpres.integral_comp' f
  change (∫ x, f (-x) ∂ν) = ∫ x, f x ∂ν at h
  simp only [Function.Odd] at hf
  simp only [hf, integral_neg] at h
  linarith

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- Simultaneously negating every coordinate preserves a symmetric iid law. -/
theorem measurePreserving_iid_neg (I : Type*) (hν : SymmetricLaw ν) :
    MeasurePreserving (fun x : I → ℝ ↦ -x) (iidLaw I ν) (iidLaw I ν) where
  measurable := measurable_pi_lambda _ fun i ↦ (measurable_pi_apply i).neg
  map_eq := by
    have hmap := Measure.infinitePi_map_pi (fun _ : I ↦ ν)
      (f := fun _ (x : ℝ) ↦ -x) (fun _ ↦ measurable_neg)
    change ν.map (fun x : ℝ ↦ -x) = ν at hν
    simpa only [iidLaw, hν] using hmap

theorem iidLaw_map_neg (I : Type*) (hν : SymmetricLaw ν) :
    (iidLaw I ν).map (fun x : I → ℝ ↦ -x) = iidLaw I ν :=
  (measurePreserving_iid_neg ν I hν).map_eq

/-- An odd history observable has mean zero under a symmetric iid law.
The statement holds for arbitrary index types. Integrable and `MemLp` observables
are important special cases; no measurability premise is needed for the total
Bochner integral because the sign change is a measurable equivalence. -/
theorem integral_iid_odd_eq_zero {I : Type*} (hν : SymmetricLaw ν)
    {F : (I → ℝ) → ℝ} (hF : Function.Odd F) :
    (∫ x, F x ∂iidLaw I ν) = 0 := by
  have hpres : MeasurePreserving (MeasurableEquiv.neg (I → ℝ))
      (iidLaw I ν) (iidLaw I ν) := measurePreserving_iid_neg ν I hν
  have h := hpres.integral_comp' F
  change (∫ x, F (-x) ∂iidLaw I ν) = ∫ x, F x ∂iidLaw I ν at h
  simp only [Function.Odd] at hF
  simp only [hF, integral_neg] at h
  linarith

end Symmetry

section Correction

@[fun_prop] theorem continuous_factor (K : Correction) : Continuous (factor K) :=
  (continuous_apply 0).add (K.continuous.comp (continuous_dropPast 1))

@[fun_prop] theorem measurable_factor (K : Correction) : Measurable (factor K) :=
  (continuous_factor K).measurable

theorem measurable_correction (K : Correction) : Measurable (K : Past → ℝ) :=
  K.continuous.measurable

/-- The correction to the current innovation is uniformly bounded. -/
theorem abs_factor_sub_current_le (K : Correction) (x : Past) :
    |factor K x - x 0| ≤ ‖K‖ := by
  simpa only [factor, add_sub_cancel_left, Real.norm_eq_abs] using
    K.norm_coe_le_norm (dropPast 1 x)

/-- An odd correction gives an odd causal factor. -/
theorem factor_odd (K : Correction) (hK : Function.Odd (K : Past → ℝ)) :
    Function.Odd (factor K) := by
  intro x
  change -x 0 + K (dropPast 1 (-x)) = -(x 0 + K (dropPast 1 x))
  rw [dropPast_neg, hK (dropPast 1 x), neg_add]

/-- A bounded continuous correction belongs to every `Lᵖ` on any finite history law. -/
theorem memLp_correction (K : Correction) (p : ℝ≥0∞) (μ : Measure Past)
    [IsFiniteMeasure μ] : MemLp (K : Past → ℝ) p μ :=
  MemLp.of_bound (measurable_correction K).aestronglyMeasurable ‖K‖
    (Eventually.of_forall fun x ↦ K.norm_coe_le_norm x)

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

theorem memLp_dropPast {F : Past → ℝ} {p : ℝ≥0∞}
    (hF : MemLp F p (iidLaw ℕ ν)) (n : ℕ) :
    MemLp (F ∘ dropPast n) p (iidLaw ℕ ν) :=
  hF.comp_measurePreserving (measurePreserving_dropPast ν n)

theorem integral_dropPast {F : Past → ℝ} (hF : Measurable F) (n : ℕ) :
    (∫ x, F (dropPast n x) ∂iidLaw ℕ ν) = ∫ x, F x ∂iidLaw ℕ ν :=
  (identDistrib_comp_measurePreserving (measurePreserving_dropPast ν n) hF).integral_eq

/-- Adding a bounded correction preserves `Lᵖ` membership. In particular, an
innovation with finite second moment gives a square-integrable causal factor. -/
theorem memLp_factor (K : Correction) {p : ℝ≥0∞}
    (hnoise : MemLp (fun x : ℝ ↦ x) p ν) : MemLp (factor K) p (iidLaw ℕ ν) :=
  (hnoise.comp_measurePreserving (measurePreserving_iid_eval ν (0 : ℕ))).add
    (memLp_dropPast ν (memLp_correction K p (iidLaw ℕ ν)) 1)

theorem integrable_factor (K : Correction)
    (hnoise : Integrable (fun x : ℝ ↦ x) ν) : Integrable (factor K) (iidLaw ℕ ν) :=
  memLp_one_iff_integrable.mp
    (memLp_factor ν K (memLp_one_iff_integrable.mpr hnoise))

/-- The expectation of a causal factor is the sum of the innovation expectation
and the expectation of its correction under the history law. -/
theorem integral_factor (K : Correction) (hnoise : Integrable (fun x : ℝ ↦ x) ν) :
    (∫ x, factor K x ∂iidLaw ℕ ν) =
      (∫ z, z ∂ν) + ∫ x, K x ∂iidLaw ℕ ν := by
  have hcurrent : Integrable (fun x : Past ↦ x 0) (iidLaw ℕ ν) :=
    (measurePreserving_iid_eval ν (0 : ℕ)).integrable_comp_of_integrable hnoise
  have hcorrection : Integrable (fun x : Past ↦ K (dropPast 1 x)) (iidLaw ℕ ν) :=
    (measurePreserving_dropPast ν 1).integrable_comp_of_integrable (K.integrable _)
  change (∫ x, x 0 + K (dropPast 1 x) ∂iidLaw ℕ ν) = _
  rw [integral_add hcurrent hcorrection,
    integral_dropPast ν (measurable_correction K) 1]
  congr 1
  exact (identDistrib_comp_measurePreserving (measurePreserving_iid_eval ν (0 : ℕ))
    measurable_id).integral_eq

/-- An odd bounded correction and symmetric innovations give a centered factor. -/
theorem integral_factor_eq_zero (K : Correction) (hν : SymmetricLaw ν)
    (hK : Function.Odd (K : Past → ℝ)) :
    (∫ x, factor K x ∂iidLaw ℕ ν) = 0 :=
  integral_iid_odd_eq_zero ν hν (factor_odd K hK)

/-- With finite second moment, the zero integral above is the expectation of a
genuinely integrable factor, not merely the total integral's default value. -/
theorem factor_integrable_mean_zero (K : Correction)
    (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν) (hν : SymmetricLaw ν)
    (hK : Function.Odd (K : Past → ℝ)) :
    Integrable (factor K) (iidLaw ℕ ν) ∧ (∫ x, factor K x ∂iidLaw ℕ ν) = 0 :=
  ⟨(memLp_factor ν K hnoise).integrable (by norm_num),
    integral_factor_eq_zero ν K hν hK⟩

theorem memLp_atTime_factor (K : Correction) {p : ℝ≥0∞}
    (hnoise : MemLp (fun x : ℝ ↦ x) p ν) (t : ℤ) :
    MemLp (atTime (factor K) t) p (iidLaw ℤ ν) :=
  memLp_atTime ν (memLp_factor ν K hnoise) t

theorem integral_atTime_factor_eq_zero (K : Correction) (hν : SymmetricLaw ν)
    (hK : Function.Odd (K : Past → ℝ)) (t : ℤ) :
    (∫ ω, atTime (factor K) t ω ∂iidLaw ℤ ν) = 0 := by
  rw [integral_atTime ν (measurable_factor K) t, integral_factor_eq_zero ν K hν hK]

theorem atTime_factor_stationary (K : Correction) :
    ∀ k : ℕ, IdentDistrib
      (fun ω (n : ℕ) ↦ atTime (factor K) ((n + k : ℕ) : ℤ) ω)
      (fun ω (n : ℕ) ↦ atTime (factor K) (n : ℤ) ω)
      (iidLaw ℤ ν) (iidLaw ℤ ν) :=
  atTime_stationary ν (measurable_factor K)

end Correction

end Cascade
end


/- Supporting development: Cascade.InverseCascade -/
section
set_option autoImplicit false

/-
# Finite cascades and their strict-past inverse kernels

Controllers are listed in forward application order. Thus `forward [c₁,c₂] K`
is `update c₂ (update c₁ K)`, while `inverse [c₁,c₂]` is `T₁ ∘ T₂`.
The inverse is defined on arbitrary real histories, not just bounded histories
or histories in the image of a forward factor.

Its bounded continuous correction `inverseKernel cs` has memory `∑ N`, norm
at most `∑ budget`, and uniform-coordinate Lipschitz constant `G - 1`, where
`G = ∏ (1 + gain)`. Appending a controller changes the kernel by at most
`Gprev * budget` in sup norm. This factor must not be omitted.
-/

open scoped BoundedContinuousFunction

namespace Cascade.InverseCascade

open Controller (Params)

/-- Append one controller to an inverse kernel. The older kernel is evaluated
on the transformed *past*, so this construction remains strictly causal. -/
noncomputable def kernelStep (H : Correction) (c : Params) : Correction :=
  Controller.inverseKernel c +
    H.compContinuous ⟨Controller.inverse c, Controller.continuous_inverse c⟩

@[simp] theorem kernelStep_apply (H : Correction) (c : Params) (p : Past) :
    kernelStep H c p = Controller.inverseKernel c p + H (Controller.inverse c p) := rfl

/-- Forward application of a finite list of controllers, starting from any
bounded continuous correction. -/
noncomputable def forward (cs : List Params) (oldK : Correction) : Correction :=
  cs.foldl (fun K c ↦ Controller.update c K) oldK

/-- The unrolled inverse composition, in the opposite order to the forward
updates: `T₁ (T₂ (... (Tₗ x)))`. -/
noncomputable def inverse (cs : List Params) (x : Past) : Past :=
  cs.foldr Controller.inverse x

/-- The strict-past bounded continuous kernel of the finite inverse. -/
noncomputable def inverseKernel (cs : List Params) : Correction :=
  cs.foldl kernelStep 0

/-- The sum of the controller window lengths. -/
def memory (cs : List Params) : ℕ := (cs.map Params.N).sum

/-- The full inverse Lipschitz bound `∏ (1 + g)`. -/
def gainProduct (cs : List Params) : ℝ :=
  (cs.map fun c ↦ 1 + (c.gain : ℝ)).prod

/-- The sum of the individual amplitude budgets, without Lipschitz factors. -/
def totalBudget (cs : List Params) : ℝ := (cs.map Params.budget).sum

section ListIdentities

@[simp] theorem forward_nil (oldK : Correction) : forward [] oldK = oldK := rfl

@[simp] theorem forward_cons (c : Params) (cs : List Params) (oldK : Correction) :
    forward (c :: cs) oldK = forward cs (Controller.update c oldK) := rfl

theorem forward_append (cs ds : List Params) (oldK : Correction) :
    forward (cs ++ ds) oldK = forward ds (forward cs oldK) := by
  simp only [forward, List.foldl_append]

@[simp] theorem forward_append_singleton (cs : List Params) (c : Params)
    (oldK : Correction) :
    forward (cs ++ [c]) oldK = Controller.update c (forward cs oldK) := by
  simp only [forward_append, forward_cons, forward_nil]

@[simp] theorem inverse_nil (x : Past) : inverse [] x = x := rfl

@[simp] theorem inverse_cons (c : Params) (cs : List Params) (x : Past) :
    inverse (c :: cs) x = Controller.inverse c (inverse cs x) := rfl

/-- The order of inverse composition for two successive batches. -/
theorem inverse_append (cs ds : List Params) (x : Past) :
    inverse (cs ++ ds) x = inverse cs (inverse ds x) := by
  simp only [inverse, List.foldr_append]

@[simp] theorem inverse_append_singleton (cs : List Params) (c : Params) (x : Past) :
    inverse (cs ++ [c]) x = inverse cs (Controller.inverse c x) := by
  simp only [inverse_append, inverse_cons, inverse_nil]

@[simp] theorem inverseKernel_nil : inverseKernel [] = 0 := rfl

@[simp] theorem inverseKernel_append_singleton (cs : List Params) (c : Params) :
    inverseKernel (cs ++ [c]) = kernelStep (inverseKernel cs) c := by
  simp only [inverseKernel, List.foldl_append, List.foldl_cons, List.foldl_nil]

/-- In particular the new kernel is not the sum of unchanged old controller
terms: the old kernel is composed with the new inverse. -/
theorem inverseKernel_append_singleton_apply (cs : List Params) (c : Params) (p : Past) :
    inverseKernel (cs ++ [c]) p = Controller.inverseKernel c p +
      inverseKernel cs (Controller.inverse c p) := by
  rw [inverseKernel_append_singleton, kernelStep_apply]

@[simp] theorem memory_nil : memory [] = 0 := rfl

@[simp] theorem memory_append (cs ds : List Params) :
    memory (cs ++ ds) = memory cs + memory ds := by
  simp [memory]

@[simp] theorem memory_append_singleton (cs : List Params) (c : Params) :
    memory (cs ++ [c]) = memory cs + c.N := by
  simp [memory]

@[simp] theorem gainProduct_nil : gainProduct [] = 1 := rfl

@[simp] theorem gainProduct_append (cs ds : List Params) :
    gainProduct (cs ++ ds) = gainProduct cs * gainProduct ds := by
  simp [gainProduct]

@[simp] theorem gainProduct_append_singleton (cs : List Params) (c : Params) :
    gainProduct (cs ++ [c]) = gainProduct cs * (1 + (c.gain : ℝ)) := by
  simp [gainProduct]

@[simp] theorem totalBudget_nil : totalBudget [] = 0 := rfl

@[simp] theorem totalBudget_append (cs ds : List Params) :
    totalBudget (cs ++ ds) = totalBudget cs + totalBudget ds := by
  simp [totalBudget]

@[simp] theorem totalBudget_append_singleton (cs : List Params) (c : Params) :
    totalBudget (cs ++ [c]) = totalBudget cs + c.budget := by
  simp [totalBudget]

theorem one_le_gainProduct (cs : List Params) : 1 ≤ gainProduct cs := by
  induction cs with
  | nil => simp
  | cons c cs ih =>
    change 1 ≤ (1 + (c.gain : ℝ)) * gainProduct cs
    exact one_le_mul_of_one_le_of_one_le (by simpa using c.gain.coe_nonneg) ih

theorem gainProduct_nonneg (cs : List Params) : 0 ≤ gainProduct cs :=
  le_trans zero_le_one (one_le_gainProduct cs)

theorem gainProduct_pos (cs : List Params) : 0 < gainProduct cs :=
  lt_of_lt_of_le zero_lt_one (one_le_gainProduct cs)

theorem totalBudget_nonneg (cs : List Params) : 0 ≤ totalBudget cs := by
  induction cs with
  | nil => simp
  | cons c cs ih =>
    change 0 ≤ c.budget + totalBudget cs
    exact add_nonneg c.budget_nonneg ih

end ListIdentities

section KernelStep

/-- A new window of length `N` adds at most `N` to the previous memory. -/
theorem kernelStep_hasMemory (H : Correction) (c : Params) {M : ℕ}
    (hH : HasMemory (H : Past → ℝ) M) :
    HasMemory (kernelStep H c : Past → ℝ) (M + c.N) := by
  intro p q hpq
  simp only [kernelStep_apply]
  congr 1
  · exact Controller.inverseKernel_hasMemory c p q (fun i hi ↦ hpq i (by omega))
  · apply hH
    intro i hi
    change p i + Controller.inverseKernel c (dropPast (i + 1) p) =
      q i + Controller.inverseKernel c (dropPast (i + 1) q)
    congr 1
    · exact hpq i (by omega)
    · apply Controller.inverseKernel_hasMemory c
      intro j hj
      exact hpq (j + (i + 1)) (by omega)

theorem kernelStep_odd (H : Correction) (c : Params)
    (hH : Function.Odd (H : Past → ℝ)) :
    Function.Odd (kernelStep H c : Past → ℝ) := by
  intro p
  simp only [kernelStep_apply, Controller.inverseKernel_odd c p,
    Controller.inverse_odd c p, hH (Controller.inverse c p), neg_add]

/-- The kernel Lipschitz recurrence `Lnew = g + Lold * (1 + g)`. -/
theorem kernelStep_uniformLip (H : Correction) (c : Params) {L : ℝ}
    (hH : UniformLip (H : Past → ℝ) L) :
    UniformLip (kernelStep H c : Past → ℝ)
      ((c.gain : ℝ) + L * (1 + (c.gain : ℝ))) := by
  intro C hC p q hpq
  have hT : ∀ i, |Controller.inverse c p i - Controller.inverse c q i| ≤
      (1 + (c.gain : ℝ)) * C := fun i ↦ Controller.inverse_uniformLip c i C hC p q hpq
  have hH' := hH ((1 + (c.gain : ℝ)) * C)
    (mul_nonneg (by positivity) hC) (Controller.inverse c p) (Controller.inverse c q) hT
  calc
    _ = |(Controller.inverseKernel c p - Controller.inverseKernel c q) +
        (H (Controller.inverse c p) - H (Controller.inverse c q))| := by
      simp only [kernelStep_apply]
      congr 1
      ring
    _ ≤ |Controller.inverseKernel c p - Controller.inverseKernel c q| +
        |H (Controller.inverse c p) - H (Controller.inverse c q)| := abs_add_le _ _
    _ ≤ (c.gain : ℝ) * C + L * ((1 + (c.gain : ℝ)) * C) :=
      add_le_add (Controller.inverseKernel_uniformLip c C hC p q hpq) hH'
    _ = _ := by ring

theorem kernelStep_norm_le (H : Correction) (c : Params) :
    ‖kernelStep H c‖ ≤ ‖H‖ + c.budget := by
  calc
    _ ≤ ‖Controller.inverseKernel c‖ +
        ‖H.compContinuous ⟨Controller.inverse c, Controller.continuous_inverse c⟩‖ :=
      norm_add_le _ _
    _ ≤ c.budget + ‖H‖ :=
      add_le_add (Controller.inverseKernel_norm_le c) (H.norm_compContinuous_le _)
    _ = _ := add_comm _ _

end KernelStep

section KernelStructure

/-- The unrolled inverse is the current coordinate plus a correction that
uses only its strict past. This holds for every coordinate of every history. -/
theorem inverse_apply (cs : List Params) (x : Past) (k : ℕ) :
    inverse cs x k = x k + inverseKernel cs (dropPast (k + 1) x) := by
  induction cs using List.reverseRecOn generalizing x with
  | nil => simp
  | append_singleton cs c ih =>
    rw [inverse_append_singleton, ih, inverseKernel_append_singleton_apply,
      ← Controller.inverse_dropPast]
    change (x k + Controller.inverseKernel c (dropPast (k + 1) x)) +
      inverseKernel cs (Controller.inverse c (dropPast (k + 1) x)) = _
    ring

/-- The explicit inverse composite is exactly the history map of its bounded
strict-past correction. -/
theorem inverse_eq_factorHistory (cs : List Params) (x : Past) :
    inverse cs x = Controller.factorHistory (inverseKernel cs) x := by
  funext k
  rw [inverse_apply]
  simp only [Controller.factorHistory, factor, dropPast_dropPast,
    show 1 + k = k + 1 by omega]
  simp only [dropPast, Nat.zero_add]

/-- Inverse cascades commute with dropping any number of recent coordinates. -/
theorem inverse_dropPast (cs : List Params) (n : ℕ) (x : Past) :
    inverse cs (dropPast n x) = dropPast n (inverse cs x) := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    rw [inverse_cons, ih, Controller.inverse_dropPast, inverse_cons]

@[fun_prop] theorem continuous_inverse (cs : List Params) : Continuous (inverse cs) := by
  apply continuous_pi
  intro k
  simp_rw [inverse_apply]
  exact (continuous_apply k).add
    ((inverseKernel cs).continuous.comp (continuous_dropPast (k + 1)))

theorem inverseKernel_hasMemory (cs : List Params) :
    HasMemory (inverseKernel cs : Past → ℝ) (memory cs) := by
  induction cs using List.reverseRecOn with
  | nil => intro p q _; rfl
  | append_singleton cs c ih =>
    rw [inverseKernel_append_singleton, memory_append_singleton]
    exact kernelStep_hasMemory _ _ ih

theorem inverseKernel_odd (cs : List Params) :
    Function.Odd (inverseKernel cs : Past → ℝ) := by
  induction cs using List.reverseRecOn with
  | nil => intro p; simp
  | append_singleton cs c ih =>
    rw [inverseKernel_append_singleton]
    exact kernelStep_odd _ _ ih

theorem inverse_odd (cs : List Params) : Function.Odd (inverse cs) := by
  intro x
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    rw [inverse_cons, ih, Controller.inverse_odd, inverse_cons]

/-- The sharp elementary bound `Lip(H) ≤ G - 1`, not the weaker `G + 1`. -/
theorem inverseKernel_uniformLip (cs : List Params) :
    UniformLip (inverseKernel cs : Past → ℝ) (gainProduct cs - 1) := by
  induction cs using List.reverseRecOn with
  | nil => intro C _ p q _; simp
  | append_singleton cs c ih =>
    rw [inverseKernel_append_singleton, gainProduct_append_singleton]
    convert kernelStep_uniformLip _ c ih using 1
    ring

/-- A uniform-coordinate Lipschitz bound does not assume that the histories
are themselves bounded: only their coordinatewise difference is bounded. -/
theorem inverse_uniformLip (cs : List Params) (k : ℕ) :
    UniformLip (fun x ↦ inverse cs x k) (gainProduct cs) := by
  intro C hC x y hxy
  have hH := inverseKernel_uniformLip cs C hC (dropPast (k + 1) x)
    (dropPast (k + 1) y) (fun j ↦ hxy (j + (k + 1)))
  calc
    _ = |(x k - y k) + (inverseKernel cs (dropPast (k + 1) x) -
        inverseKernel cs (dropPast (k + 1) y))| := by
      dsimp only
      rw [inverse_apply, inverse_apply]
      congr 1
      ring
    _ ≤ |x k - y k| + |inverseKernel cs (dropPast (k + 1) x) -
        inverseKernel cs (dropPast (k + 1) y)| := abs_add_le _ _
    _ ≤ C + (gainProduct cs - 1) * C := add_le_add (hxy k) hH
    _ = _ := by ring

/-- Kernel amplitudes sum without any inverse Lipschitz factors. Those factors
are needed for *increments*, not for this absolute norm bound. -/
theorem inverseKernel_norm_le (cs : List Params) :
    ‖inverseKernel cs‖ ≤ totalBudget cs := by
  induction cs using List.reverseRecOn with
  | nil => simp
  | append_singleton cs c ih =>
    rw [inverseKernel_append_singleton, totalBudget_append_singleton]
    exact (kernelStep_norm_le _ _).trans (add_le_add ih le_rfl)

theorem inverseKernel_abs_le (cs : List Params) (p : Past) :
    |inverseKernel cs p| ≤ totalBudget cs :=
  ((inverseKernel cs).norm_coe_le_norm p).trans (inverseKernel_norm_le cs)

theorem inverse_abs_sub_le (cs : List Params) (x : Past) (k : ℕ) :
    |inverse cs x k - x k| ≤ totalBudget cs := by
  rw [inverse_apply, add_sub_cancel_left]
  exact inverseKernel_abs_le cs _

end KernelStructure

section Forward

/-- Every finite forward cascade preserves oddness of its initial correction. -/
theorem forward_odd (cs : List Params) (oldK : Correction)
    (hK : Function.Odd (oldK : Past → ℝ)) :
    Function.Odd (forward cs oldK : Past → ℝ) := by
  induction cs using List.reverseRecOn with
  | nil => exact hK
  | append_singleton cs c ih =>
    rw [forward_append_singleton]
    exact Controller.update_odd c _ ih

/-- The total forward perturbation is bounded by the sum of the budgets. -/
theorem forward_norm_sub_le (cs : List Params) (oldK : Correction) :
    ‖forward cs oldK - oldK‖ ≤ totalBudget cs := by
  induction cs using List.reverseRecOn with
  | nil => simp
  | append_singleton cs c ih =>
    rw [forward_append_singleton, totalBudget_append_singleton]
    calc
      _ = ‖(Controller.update c (forward cs oldK) - forward cs oldK) +
          (forward cs oldK - oldK)‖ := by rw [sub_add_sub_cancel]
      _ ≤ ‖Controller.update c (forward cs oldK) - forward cs oldK‖ +
          ‖forward cs oldK - oldK‖ := norm_add_le _ _
      _ ≤ c.budget + totalBudget cs :=
        add_le_add (Controller.update_norm_sub_le c _) ih
      _ = _ := add_comm _ _

theorem forward_abs_sub_le (cs : List Params) (oldK : Correction) (p : Past) :
    |forward cs oldK p - oldK p| ≤ totalBudget cs :=
  ((forward cs oldK - oldK).norm_coe_le_norm p).trans (forward_norm_sub_le cs oldK)

theorem norm_forward_le (cs : List Params) (oldK : Correction) :
    ‖forward cs oldK‖ ≤ ‖oldK‖ + totalBudget cs := by
  calc
    _ = ‖(forward cs oldK - oldK) + oldK‖ := by rw [sub_add_cancel]
    _ ≤ ‖forward cs oldK - oldK‖ + ‖oldK‖ := norm_add_le _ _
    _ ≤ totalBudget cs + ‖oldK‖ := add_le_add (forward_norm_sub_le cs oldK) le_rfl
    _ = _ := add_comm _ _

theorem factor_forward_abs_sub_le (cs : List Params) (oldK : Correction) (x : Past) :
    |factor (forward cs oldK) x - factor oldK x| ≤ totalBudget cs := by
  simpa only [factor, add_sub_add_left_eq_sub] using forward_abs_sub_le cs oldK (dropPast 1 x)

/-- Exact, everywhere inverse factorization. For a nonzero initial correction,
the inverse recovers the *initial factor history*, as it should. -/
theorem inverse_factorHistory_forward (cs : List Params) (oldK : Correction) (x : Past) :
    inverse cs (Controller.factorHistory (forward cs oldK) x) =
      Controller.factorHistory oldK x := by
  induction cs using List.reverseRecOn with
  | nil => rfl
  | append_singleton cs c ih =>
    rw [forward_append_singleton, inverse_append_singleton,
      Controller.inverse_factorHistory_update, ih]

@[simp] theorem factorHistory_zero (x : Past) : Controller.factorHistory 0 x = x := by
  funext k
  simp [Controller.factorHistory, factor, dropPast]

/-- Starting from the zero correction, the composite inverse recovers the
entire innovation history exactly, not just almost surely. -/
theorem inverse_factorHistory_forward_zero (cs : List Params) (x : Past) :
    inverse cs (Controller.factorHistory (forward cs 0) x) = x := by
  rw [inverse_factorHistory_forward, factorHistory_zero]

theorem leftInverse_factorHistory_forward_zero (cs : List Params) :
    Function.LeftInverse (inverse cs) (Controller.factorHistory (forward cs 0)) :=
  inverse_factorHistory_forward_zero cs

theorem factorHistory_forward_zero_injective (cs : List Params) :
    Function.Injective (Controller.factorHistory (forward cs 0)) :=
  (leftInverse_factorHistory_forward_zero cs).injective

/-- The scalar reconstruction identity, with the inverse represented by its
strict-past correction rather than by the unrolled history operator. -/
theorem factor_inverseKernel_factorHistory_forward (cs : List Params)
    (oldK : Correction) (x : Past) :
    factor (inverseKernel cs) (Controller.factorHistory (forward cs oldK) x) =
      factor oldK x := by
  have h := congrFun (inverse_factorHistory_forward cs oldK x) 0
  rw [inverse_eq_factorHistory] at h
  simpa only [Controller.factorHistory, dropPast_zero] using h

/-- The current innovation is the final output plus the finite-memory kernel
of the strict *output* past. -/
theorem reconstruct_current (cs : List Params) (x : Past) :
    factor (forward cs 0) x +
        inverseKernel cs (dropPast 1 (Controller.factorHistory (forward cs 0) x)) = x 0 := by
  have h := factor_inverseKernel_factorHistory_forward cs 0 x
  simpa only [factor, Controller.factorHistory, dropPast_zero,
    BoundedContinuousFunction.coe_zero, Pi.zero_apply, add_zero] using h

end Forward

section Increments

/-- Composition of two finite inverse kernels. This also makes the order of
evaluation explicit for whole batches. -/
theorem inverseKernel_append_apply (cs ds : List Params) (p : Past) :
    inverseKernel (cs ++ ds) p = inverseKernel ds p + inverseKernel cs (inverse ds p) := by
  induction ds using List.reverseRecOn generalizing p with
  | nil => simp
  | append_singleton ds c ih =>
    rw [← List.append_assoc, inverseKernel_append_singleton_apply, ih,
      inverseKernel_append_singleton_apply, inverse_append_singleton]
    ring

theorem inverseKernel_append (cs ds : List Params) :
    inverseKernel (cs ++ ds) = inverseKernel ds +
      (inverseKernel cs).compContinuous ⟨inverse ds, continuous_inverse ds⟩ := by
  ext p
  exact inverseKernel_append_apply cs ds p

/-- Appending a batch costs at most the previous inverse Lipschitz factor
times the batch's total budget. In particular there is no *future* `G` factor. -/
theorem inverseKernel_append_abs_sub_le (cs ds : List Params) (p : Past) :
    |inverseKernel (cs ++ ds) p - inverseKernel cs p| ≤
      gainProduct cs * totalBudget ds := by
  have hH := inverseKernel_uniformLip cs (totalBudget ds) (totalBudget_nonneg ds)
    (inverse ds p) p (fun i ↦ inverse_abs_sub_le ds p i)
  calc
    _ = |inverseKernel ds p + (inverseKernel cs (inverse ds p) - inverseKernel cs p)| := by
      rw [inverseKernel_append_apply]
      congr 1
      ring
    _ ≤ |inverseKernel ds p| + |inverseKernel cs (inverse ds p) - inverseKernel cs p| :=
      abs_add_le _ _
    _ ≤ totalBudget ds + (gainProduct cs - 1) * totalBudget ds :=
      add_le_add (inverseKernel_abs_le ds p) hH
    _ = _ := by ring

theorem inverseKernel_append_norm_sub_le (cs ds : List Params) :
    ‖inverseKernel (cs ++ ds) - inverseKernel cs‖ ≤ gainProduct cs * totalBudget ds :=
  (BoundedContinuousFunction.norm_le
    (mul_nonneg (gainProduct_nonneg cs) (totalBudget_nonneg ds))).mpr
      (inverseKernel_append_abs_sub_le cs ds)

/-- The telescoping correction produced by appending one more controller. -/
noncomputable def increment (cs : List Params) (c : Params) : Correction :=
  inverseKernel (cs ++ [c]) - inverseKernel cs

@[simp] theorem increment_apply (cs : List Params) (c : Params) (p : Past) :
    increment cs c p = inverseKernel (cs ++ [c]) p - inverseKernel cs p := rfl

/-- The increment includes the change of all the older controller terms. -/
theorem increment_eq (cs : List Params) (c : Params) (p : Past) :
    increment cs c p = Controller.inverseKernel c p +
      (inverseKernel cs (Controller.inverse c p) - inverseKernel cs p) := by
  rw [increment_apply, inverseKernel_append_singleton_apply]
  ring

/-- The audited increment budget `c_ℓ = Gprev * b_ℓ`. -/
theorem increment_abs_le (cs : List Params) (c : Params) (p : Past) :
    |increment cs c p| ≤ gainProduct cs * c.budget := by
  simpa only [increment_apply, totalBudget, List.map_cons, List.map_nil,
    List.sum_cons, List.sum_nil, add_zero] using inverseKernel_append_abs_sub_le cs [c] p

theorem increment_norm_le (cs : List Params) (c : Params) :
    ‖increment cs c‖ ≤ gainProduct cs * c.budget := by
  simpa only [increment, totalBudget, List.map_cons, List.map_nil,
    List.sum_cons, List.sum_nil, add_zero] using inverseKernel_append_norm_sub_le cs [c]

theorem increment_hasMemory (cs : List Params) (c : Params) :
    HasMemory (increment cs c : Past → ℝ) (memory cs + c.N) := by
  intro p q hpq
  have hnew := inverseKernel_hasMemory (cs ++ [c]) p q
    (by simpa only [memory_append_singleton] using hpq)
  have hold := inverseKernel_hasMemory cs p q (fun i hi ↦ hpq i (by omega))
  simp only [increment_apply, hnew, hold]

theorem increment_odd (cs : List Params) (c : Params) :
    Function.Odd (increment cs c : Past → ℝ) := by
  intro p
  simp only [increment_apply, inverseKernel_odd (cs ++ [c]) p, inverseKernel_odd cs p]
  ring

end Increments

end Cascade.InverseCascade
end


/- Supporting development: Cascade.CascadeCost -/
section
set_option autoImplicit false

/- # Quantitative bookkeeping for a finite list of controllers -/

open scoped BoundedContinuousFunction

namespace Cascade.InverseCascade

/-- The amplitude bound on the change of the inverse kernel at one layer. -/
def layerAmplitude (cs : List Controller.Params) (i : Fin cs.length) : ℝ :=
  gainProduct (cs.take i.val) * (cs.get i).budget

/-- The full past memory just after a layer. -/
def layerMemory (cs : List Controller.Params) (i : Fin cs.length) : ℕ :=
  memory (cs.take (i.val + 1))

/-- Total uniform change budget, including inverse Lipschitz multipliers. -/
def amplitude (cs : List Controller.Params) : ℝ :=
  ∑ i : Fin cs.length, layerAmplitude cs i

/-- Square-variation cost of a finite cascade. -/
def cost (cs : List Controller.Params) : ℝ :=
  ∑ i : Fin cs.length, (layerMemory cs i : ℝ) * (layerAmplitude cs i) ^ 2

/-- Each new memory is at least the entire previous memory. -/
def DoublingMemory (cs : List Controller.Params) : Prop :=
  ∀ i : Fin cs.length, memory (cs.take i.val) ≤ (cs.get i).N

/-- A variation majorant obtained by summing all active layer amplitudes. -/
def profile (cs : List Controller.Params) (m : ℕ) : ℝ :=
  2 * ∑ i : Fin cs.length,
    if m < layerMemory cs i then layerAmplitude cs i else 0

end Cascade.InverseCascade
end


/- Supporting development: Cascade.BatchArithmetic -/
section
set_option autoImplicit false

/-
# Elementary arithmetic for cheap finite attenuation batches

A batch with total gain `1/2` keeps both resolvent mass and inverse gain
within a factor of two. Its square cost tends to zero with the number of
controllers. No exponential estimates are needed.
-/

namespace Cascade.AttenuationArithmetic

/-- A linear weight controls the resolvent update. -/
theorem weighted_div_step {t g M : ℝ} (ht : 0 ≤ t) (hg : 0 ≤ g)
    (hg1 : g < 1) (hM : 0 ≤ M) :
    (1 - (t + g)) * (M / (1 - g)) ≤ (1 - t) * M := by
  rw [← mul_div_assoc]
  apply (div_le_iff₀ (sub_pos.mpr hg1)).mpr
  nlinarith [mul_nonneg (mul_nonneg ht hg) hM]

/-- The same linear weight controls inverse Lipschitz gain. -/
theorem weighted_mul_step {t g G : ℝ} (ht : 0 ≤ t) (hg : 0 ≤ g)
    (hG : 0 ≤ G) :
    (1 - (t + g)) * (G * (1 + g)) ≤ (1 - t) * G := by
  nlinarith [mul_nonneg (mul_nonneg hg (add_nonneg ht hg)) hG]

theorem le_twice_of_weighted {t M D : ℝ} (ht : t ≤ 1 / 2) (hM : 0 ≤ M)
    (h : (1 - t) * M ≤ D) : M ≤ 2 * D := by
  nlinarith

/-- A residual of size `T/8` permits a deterministic linear slope decrease. -/
theorem slope_step {T u g R : ℝ} (hT : 0 ≤ T) (hu : 3 * T / 4 ≤ u)
    (hg : 0 ≤ g) (hg4 : g ≤ 1 / 4) (hR : R ≤ T / 8) :
    (u + g * R) / (1 + g) ≤ u - T * g / 2 := by
  have hgT : T * g ≤ T / 4 := by nlinarith
  have hRu : R ≤ u - T * (1 + g) / 2 := by linarith
  have hmul := mul_le_mul_of_nonneg_left hRu hg
  apply (div_le_iff₀ (by positivity : 0 < 1 + g)).mpr
  nlinarith

/-- Large windows make the layer amplitude arbitrarily small without changing
its scale-normalized square cost. -/
theorem exists_scaled_controller (M : ℕ) {g A G ε : ℝ}
    (hg : 0 ≤ g) (hg1 : g < 1) (hA : 0 < A) (hG : 0 ≤ G) (hε : 0 < ε) :
    ∃ c : Controller.Params, M ≤ c.N ∧ (c.gain : ℝ) = g ∧
      c.s = A * Real.sqrt (c.N : ℝ) ∧ G * c.budget ≤ ε ∧
      ((M + c.N : ℕ) : ℝ) * (G * c.budget) ^ 2 ≤ 2 * (G * g * A) ^ 2 := by
  obtain ⟨n, hn⟩ := exists_nat_ge ((G * g * A / ε) ^ 2)
  let N := n + M + 1
  have hN : 0 < N := by dsimp [N]; omega
  have hMN : M ≤ N := by dsimp [N]; omega
  have hNr : 0 < (N : ℝ) := by exact_mod_cast hN
  have hsqrt : 0 < Real.sqrt (N : ℝ) := Real.sqrt_pos.mpr hNr
  have hsq : (G * g * A / ε) ^ 2 ≤ (N : ℝ) := by
    apply hn.trans
    dsimp [N]
    push_cast
    linarith [Nat.cast_nonneg (α := ℝ) M]
  let c : Controller.Params := {
    N := N
    N_pos := hN
    a := g / (N : ℝ)
    a_nonneg := div_nonneg hg hNr.le
    s := A * Real.sqrt (N : ℝ)
    s_pos := mul_pos hA hsqrt
    gain_lt_one := by simpa only [div_mul_cancel₀ _ hNr.ne'] using hg1 }
  have hgain : (c.gain : ℝ) = g := by
    change g / (N : ℝ) * (N : ℝ) = g
    exact div_mul_cancel₀ _ hNr.ne'
  have hb : c.budget * Real.sqrt (N : ℝ) = g * A := by
    change (g / (N : ℝ) * (A * Real.sqrt (N : ℝ))) * Real.sqrt (N : ℝ) = _
    calc
      _ = (g * A / (N : ℝ)) * (Real.sqrt (N : ℝ)) ^ 2 := by ring
      _ = _ := by rw [Real.sq_sqrt hNr.le, div_mul_cancel₀ _ hNr.ne']
  have hGb : G * c.budget = G * g * A / Real.sqrt (N : ℝ) := by
    apply (eq_div_iff hsqrt.ne').mpr
    calc
      _ = G * (c.budget * Real.sqrt (N : ℝ)) := by ring
      _ = _ := by rw [hb]; ring
  have hamp : G * c.budget ≤ ε := by
    rw [hGb]
    apply (div_le_iff₀ hsqrt).mpr
    have hroot := (Real.le_sqrt (by positivity : 0 ≤ G * g * A / ε) hNr.le).mpr hsq
    have hmul := (div_le_iff₀ hε).mp hroot
    simpa only [mul_comm ε] using hmul
  have hcosteq : (N : ℝ) * (G * c.budget) ^ 2 = (G * g * A) ^ 2 := by
    have hGb' : (G * c.budget) * Real.sqrt (N : ℝ) = G * g * A := by
      calc
        _ = G * (c.budget * Real.sqrt (N : ℝ)) := by ring
        _ = _ := by rw [hb]; ring
    have heq := congrArg (fun x : ℝ ↦ x ^ 2) hGb'
    dsimp only at heq
    rw [mul_pow, Real.sq_sqrt hNr.le] at heq
    nlinarith only [heq]
  refine ⟨c, hMN, hgain, rfl, hamp, ?_⟩
  calc
    _ ≤ (2 * (N : ℝ)) * (G * c.budget) ^ 2 := by
      apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
      change ((M + N : ℕ) : ℝ) ≤ 2 * (N : ℝ)
      exact_mod_cast (show M + N ≤ 2 * N by omega)
    _ = _ := by rw [mul_assoc, hcosteq]

end Cascade.AttenuationArithmetic
end


/- Supporting development: Cascade.FiniteEfronStein -/
section
set_option autoImplicit false

/-
# The finite-product Efron–Stein inequality

This file proves the squared-integral form of Efron–Stein for heterogeneous
finite products of probability measures.  In particular, all resampled
functions and all squared resampling differences are integrable under the
stated `MemLp` hypothesis; there are no extra assumptions on their sections.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal

namespace Cascade

section Resampling

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
  (ν : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (ν i)]

/-- Replacing one coordinate by an independent sample preserves a finite
product probability law. -/
theorem finitePi_resample_measurePreserving (i : ι) :
    MeasurePreserving
      (fun p : (ι → ℝ) × ℝ ↦ Function.update p.1 i p.2)
      ((Measure.pi ν).prod (ν i)) (Measure.pi ν) := by
  have hm : Measurable (fun p : (ι → ℝ) × ℝ ↦ Function.update p.1 i p.2) := by
    fun_prop
  refine ⟨hm, (Measure.pi_eq fun s hs ↦ ?_).symm⟩
  rw [Measure.map_apply hm (MeasurableSet.univ_pi hs)]
  have hpre :
      (fun p : (ι → ℝ) × ℝ ↦ Function.update p.1 i p.2) ⁻¹' Set.pi Set.univ s =
        Set.pi Set.univ (Function.update s i Set.univ) ×ˢ s i := by
    ext p
    simp only [Set.mem_preimage, Set.mem_pi, Set.mem_univ, forall_true_left,
      Set.mem_prod]
    constructor
    · intro hp
      refine ⟨?_, ?_⟩
      · intro j
        by_cases hji : j = i
        · subst j; simp
        · simpa [Function.update_of_ne hji] using hp j
      · simpa using hp i
    · rintro ⟨hp, hz⟩ j
      by_cases hji : j = i
      · subst j; simpa using hz
      · simpa [Function.update_of_ne hji] using hp j
  rw [hpre, Measure.prod_prod, Measure.pi_pi]
  rw [← Finset.prod_erase_mul Finset.univ (fun j ↦ (ν j) (s j)) (Finset.mem_univ i)]
  congr 1
  rw [← Finset.prod_erase_mul Finset.univ
    (fun j ↦ (ν j) (Function.update s i Set.univ j)) (Finset.mem_univ i)]
  simp only [Function.update_self, measure_univ, mul_one]
  apply Finset.prod_congr rfl
  intro j hj
  simp only [Finset.mem_erase] at hj
  simp [Function.update_of_ne hj.1]

/-- The resampled function is still in `L²`. -/
theorem memLp_finitePi_resample {F : (ι → ℝ) → ℝ}
    (hF : MemLp F 2 (Measure.pi ν)) (i : ι) :
    MemLp (fun p : (ι → ℝ) × ℝ ↦ F (Function.update p.1 i p.2)) 2
      ((Measure.pi ν).prod (ν i)) :=
  hF.comp_measurePreserving (finitePi_resample_measurePreserving ν i)

/-- Squared coordinate-resampling differences are integrable. -/
theorem integrable_finitePi_resample_sq {F : (ι → ℝ) → ℝ}
    (hF : MemLp F 2 (Measure.pi ν)) (i : ι) :
    Integrable (fun p : (ι → ℝ) × ℝ ↦
      (F (Function.update p.1 i p.2) - F p.1) ^ 2)
      ((Measure.pi ν).prod (ν i)) :=
  ((memLp_finitePi_resample ν hF i).sub (hF.comp_fst (ν i))).integrable_sq

end Resampling

section ProductL2

variable {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
  {μ : Measure α} {ν : Measure β}
  [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]

/-- The elementary real `L²` Jensen inequality for a probability measure. -/
theorem sq_integral_le_integral_sq {f : α → ℝ} (hf : MemLp f 2 μ) :
    (∫ x, f x ∂μ) ^ 2 ≤ ∫ x, f x ^ 2 ∂μ := by
  have h := variance_nonneg f μ
  rw [variance_eq_sub hf] at h
  exact sub_nonneg.mp h

/-- Almost every section of an `L²` function on a product is in `L²`. -/
theorem memLp_two_prod_right_ae {f : α × β → ℝ} (hf : MemLp f 2 (μ.prod ν)) :
    ∀ᵐ x ∂μ, MemLp (fun y ↦ f (x, y)) 2 ν := by
  filter_upwards [hf.aestronglyMeasurable.prodMk_left,
    hf.integrable_sq.prod_right_ae] with x hxm hxi
  exact (memLp_two_iff_integrable_sq hxm).2 hxi

/-- Almost every section of an `L²` function on a product is in `L²`. -/
theorem memLp_two_prod_left_ae {f : α × β → ℝ} (hf : MemLp f 2 (μ.prod ν)) :
    ∀ᵐ y ∂ν, MemLp (fun x ↦ f (x, y)) 2 μ := by
  filter_upwards [hf.aestronglyMeasurable.prodMk_right,
    hf.integrable_sq.prod_left_ae] with y hym hyi
  exact (memLp_two_iff_integrable_sq hym).2 hyi

/-- Averaging the second argument preserves `L²`. -/
theorem memLp_two_integral_prod_right {f : α × β → ℝ}
    (hf : MemLp f 2 (μ.prod ν)) :
    MemLp (fun x ↦ ∫ y, f (x, y) ∂ν) 2 μ := by
  have hm := hf.aestronglyMeasurable.integral_prod_right'
  apply (memLp_two_iff_integrable_sq hm).2
  refine Integrable.mono' hf.integrable_sq.integral_prod_left (hm.pow 2) ?_
  filter_upwards [memLp_two_prod_right_ae hf] with x hx
  simpa only [Real.norm_eq_abs, abs_sq] using sq_integral_le_integral_sq hx

/-- Averaging the first argument preserves `L²`. -/
theorem memLp_two_integral_prod_left {f : α × β → ℝ}
    (hf : MemLp f 2 (μ.prod ν)) :
    MemLp (fun y ↦ ∫ x, f (x, y) ∂μ) 2 ν := by
  exact memLp_two_integral_prod_right
    (hf.comp_measurePreserving (Measure.measurePreserving_swap (μ := ν) (ν := μ)))

/-- Averaging the first argument is a contraction for the squared `L²` norm. -/
theorem integral_sq_integral_prod_left_le {f : α × β → ℝ}
    (hf : MemLp f 2 (μ.prod ν)) :
    (∫ y, (∫ x, f (x, y) ∂μ) ^ 2 ∂ν) ≤
      ∫ p, f p ^ 2 ∂(μ.prod ν) := by
  rw [integral_prod_symm _ hf.integrable_sq]
  apply integral_mono_ae (memLp_two_integral_prod_left hf).integrable_sq
    hf.integrable_sq.integral_prod_right
  filter_upwards [memLp_two_prod_left_ae hf] with y hy
  exact sq_integral_le_integral_sq hy

/-- Averaging is a contraction for squared `L²` distances. -/
theorem integral_sq_sub_integral_prod_left_le {f g : α × β → ℝ}
    (hf : MemLp f 2 (μ.prod ν)) (hg : MemLp g 2 (μ.prod ν)) :
    (∫ y, ((∫ x, f (x, y) ∂μ) - ∫ x, g (x, y) ∂μ) ^ 2 ∂ν) ≤
      ∫ p, (f p - g p) ^ 2 ∂(μ.prod ν) := by
  have h := integral_sq_integral_prod_left_le (hf.sub hg)
  convert h using 1
  apply integral_congr_ae
  filter_upwards [(hf.integrable (by norm_num)).prod_left_ae,
    (hg.integrable (by norm_num)).prod_left_ae] with y hyf hyg
  simp only [Pi.sub_apply, integral_sub hyf hyg]

/-- The law of total variance for a binary product of probability measures. -/
theorem variance_prod_decomposition {f : α × β → ℝ}
    (hf : MemLp f 2 (μ.prod ν)) :
    variance f (μ.prod ν) =
      (∫ y, variance (fun x ↦ f (x, y)) μ ∂ν) +
        variance (fun y ↦ ∫ x, f (x, y) ∂μ) ν := by
  have hg := memLp_two_integral_prod_left hf
  have he :
      (∫ y, variance (fun x ↦ f (x, y)) μ ∂ν) =
        (∫ p, f p ^ 2 ∂(μ.prod ν)) - ∫ y, (∫ x, f (x, y) ∂μ) ^ 2 ∂ν := by
    calc
      _ = ∫ y, (∫ x, f (x, y) ^ 2 ∂μ) - (∫ x, f (x, y) ∂μ) ^ 2 ∂ν := by
        apply integral_congr_ae
        filter_upwards [memLp_two_prod_left_ae hf] with y hy
        exact variance_eq_sub hy
      _ = _ := by
        rw [integral_sub hf.integrable_sq.integral_prod_right hg.integrable_sq,
          ← integral_prod_symm _ hf.integrable_sq]
  rw [he, variance_eq_sub hf, variance_eq_sub hg,
    integral_prod_symm _ (hf.integrable (by norm_num))]
  simp only [Pi.pow_apply]
  ring

/-- Twice the variance is the mean squared difference of independent copies. -/
theorem integral_sq_sub_independent_copies {f : α → ℝ} (hf : MemLp f 2 μ) :
    (∫ p : α × α, (f p.2 - f p.1) ^ 2 ∂(μ.prod μ)) = 2 * variance f μ := by
  have hd : MemLp (fun p : α × α ↦ f p.2 - f p.1) 2 (μ.prod μ) :=
    (hf.comp_snd μ).sub (hf.comp_fst μ)
  have hz : (∫ p : α × α, f p.2 - f p.1 ∂(μ.prod μ)) = 0 := by
    rw [integral_sub (hf.comp_snd μ |>.integrable (by norm_num))
      (hf.comp_fst μ |>.integrable (by norm_num)), integral_fun_snd, integral_fun_fst]
    simp
  have hv := variance_add_prod hf.neg hf
  simp only [Pi.neg_apply, ← sub_eq_neg_add, variance_neg] at hv
  rw [variance_eq_sub hd, hz] at hv
  simpa only [Pi.pow_apply, zero_pow (by decide : 2 ≠ 0), sub_zero, two_mul] using hv

end ProductL2

/-- The mean squared change produced by resampling coordinate `i`. -/
noncomputable def finiteResamplingEnergy {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ν : ι → Measure ℝ) (F : (ι → ℝ) → ℝ) (i : ι) : ℝ :=
  ∫ p : (ι → ℝ) × ℝ, (F (Function.update p.1 i p.2) - F p.1) ^ 2
    ∂((Measure.pi ν).prod (ν i))

/-- Product and iterated-integral versions of the resampling energy agree. -/
theorem finiteResamplingEnergy_eq_integral {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ν : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (ν i)]
    {F : (ι → ℝ) → ℝ} (hF : MemLp F 2 (Measure.pi ν)) (i : ι) :
    finiteResamplingEnergy ν F i =
      ∫ ω, ∫ z, (F (Function.update ω i z) - F ω) ^ 2 ∂ν i ∂Measure.pi ν :=
  integral_prod _ (integrable_finitePi_resample_sq ν hF i)

section FinSucc

variable {n : ℕ}

private theorem measurableEmbedding_finCons :
    MeasurableEmbedding
      (fun p : ℝ × (Fin n → ℝ) ↦ (Fin.cons p.1 p.2 : Fin (n + 1) → ℝ)) := by
  simpa only [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_zero,
    Fin.consEquiv_apply] using
    (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) ↦ ℝ) 0).symm.measurableEmbedding

/-- Decomposing a finite product into its first coordinate and its tail. -/
theorem finitePi_cons_measurePreserving (ν : Fin (n + 1) → Measure ℝ)
    [∀ i, IsProbabilityMeasure (ν i)] :
    MeasurePreserving (fun p : ℝ × (Fin n → ℝ) ↦ Fin.cons p.1 p.2)
      ((ν 0).prod (Measure.pi fun i ↦ ν i.succ)) (Measure.pi ν) := by
  simpa only [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_zero,
    Fin.consEquiv_apply, Fin.zero_succAbove] using
    (measurePreserving_piFinSuccAbove ν 0).symm

variable (ν : Fin (n + 1) → Measure ℝ) [∀ i, IsProbabilityMeasure (ν i)]
  {F : (Fin (n + 1) → ℝ) → ℝ}

/-- The energy of the first coordinate is twice the averaged conditional variance. -/
theorem finiteResamplingEnergy_zero (hF : MemLp F 2 (Measure.pi ν)) :
    finiteResamplingEnergy ν F 0 =
      2 * ∫ y : Fin n → ℝ, variance (fun x ↦ F (Fin.cons x y)) (ν 0)
        ∂Measure.pi (fun i ↦ ν i.succ) := by
  let τ := Measure.pi (fun i : Fin n ↦ ν i.succ)
  have hc := finitePi_cons_measurePreserving ν
  have hcp := hc.prod (MeasurePreserving.id (ν 0))
  have hd := integrable_finitePi_resample_sq ν hF 0
  have hdc := (hcp.integrable_comp hd.aestronglyMeasurable).2 hd
  have hdc' : Integrable (fun p : (ℝ × (Fin n → ℝ)) × ℝ ↦
      (F (Fin.cons p.2 p.1.2) - F (Fin.cons p.1.1 p.1.2)) ^ 2)
      (((ν 0).prod τ).prod (ν 0)) := by
    simpa only [Function.comp_def, Prod.map_fst, Prod.map_snd, id_eq, Fin.update_cons_zero]
      using hdc
  have hfc : MemLp (fun p : ℝ × (Fin n → ℝ) ↦ F (Fin.cons p.1 p.2)) 2
      ((ν 0).prod τ) := hF.comp_measurePreserving hc
  calc
    finiteResamplingEnergy ν F 0 =
        ∫ y : Fin n → ℝ, ∫ x, ∫ z,
          (F (Fin.cons z y) - F (Fin.cons x y)) ^ 2 ∂ν 0 ∂ν 0 ∂τ := by
      unfold finiteResamplingEnergy
      rw [← hcp.integral_comp
        (measurableEmbedding_finCons.prodMap MeasurableEmbedding.id)]
      simp only [Prod.map_fst, Prod.map_snd, id_eq, Fin.update_cons_zero]
      rw [integral_prod _ hdc', integral_prod_symm _ hdc'.integral_prod_left]
    _ = ∫ y : Fin n → ℝ, 2 * variance (fun x ↦ F (Fin.cons x y)) (ν 0) ∂τ := by
      apply integral_congr_ae
      filter_upwards [memLp_two_prod_left_ae hfc] with y hy
      rw [← integral_prod
        (fun p : ℝ × ℝ ↦ (F (Fin.cons p.2 y) - F (Fin.cons p.1 y)) ^ 2)
        ((hy.comp_snd (ν 0)).sub (hy.comp_fst (ν 0))).integrable_sq]
      exact integral_sq_sub_independent_copies hy
    _ = _ := integral_const_mul _ _

/-- Resampling energies can only decrease when another coordinate is averaged out. -/
theorem finiteResamplingEnergy_integral_cons_le (hF : MemLp F 2 (Measure.pi ν)) (i : Fin n) :
    finiteResamplingEnergy (fun j : Fin n ↦ ν j.succ)
        (fun y ↦ ∫ x, F (Fin.cons x y) ∂ν 0) i ≤
      finiteResamplingEnergy ν F i.succ := by
  let τ := Measure.pi (fun j : Fin n ↦ ν j.succ)
  have hc := finitePi_cons_measurePreserving ν
  have hfc : MemLp (fun p : ℝ × (Fin n → ℝ) ↦ F (Fin.cons p.1 p.2)) 2
      ((ν 0).prod τ) := hF.comp_measurePreserving hc
  have hr := finitePi_resample_measurePreserving (fun j : Fin n ↦ ν j.succ) i
  have h₁ : MemLp (fun p : ℝ × ((Fin n → ℝ) × ℝ) ↦
      F (Fin.cons p.1 (Function.update p.2.1 i p.2.2))) 2
      ((ν 0).prod (τ.prod (ν i.succ))) :=
    hfc.comp_measurePreserving ((MeasurePreserving.id (ν 0)).prod hr)
  have h₀ : MemLp (fun p : ℝ × ((Fin n → ℝ) × ℝ) ↦ F (Fin.cons p.1 p.2.1)) 2
      ((ν 0).prod (τ.prod (ν i.succ))) :=
    hfc.comp_measurePreserving ((MeasurePreserving.id (ν 0)).prod measurePreserving_fst)
  have h := integral_sq_sub_integral_prod_left_le h₁ h₀
  change finiteResamplingEnergy (fun j : Fin n ↦ ν j.succ)
    (fun y ↦ ∫ x, F (Fin.cons x y) ∂ν 0) i ≤ _ at h
  refine h.trans_eq ?_
  rw [← (measurePreserving_prodAssoc (ν 0) τ (ν i.succ)).integral_comp']
  simp only [Fin.cons_update]
  exact (hc.prod (MeasurePreserving.id (ν i.succ))).integral_comp
    (measurableEmbedding_finCons.prodMap MeasurableEmbedding.id)
    (fun p : (Fin (n + 1) → ℝ) × ℝ ↦ (F (Function.update p.1 i.succ p.2) - F p.1) ^ 2)

end FinSucc

/-- The finite-product Efron–Stein inequality, with coordinates indexed by `Fin n`. -/
theorem finiteEfronStein_fin (n : ℕ) (ν : Fin n → Measure ℝ)
    [∀ i, IsProbabilityMeasure (ν i)] {F : (Fin n → ℝ) → ℝ}
    (hF : MemLp F 2 (Measure.pi ν)) :
    variance F (Measure.pi ν) ≤ (1 / 2 : ℝ) * ∑ i, finiteResamplingEnergy ν F i := by
  induction n with
  | zero =>
    have hconst : F = fun _ ↦ F (fun i ↦ Fin.elim0 i) := by
      funext x
      exact congrArg F (Subsingleton.elim _ _)
    rw [hconst, variance_eq_integral measurable_const.aemeasurable]
    simp
  | succ n ih =>
    have hc := finitePi_cons_measurePreserving ν
    have hfc : MemLp (fun p : ℝ × (Fin n → ℝ) ↦ F (Fin.cons p.1 p.2)) 2
        ((ν 0).prod (Measure.pi fun i ↦ ν i.succ)) := hF.comp_measurePreserving hc
    have hg := memLp_two_integral_prod_left hfc
    have hv := variance_prod_decomposition hfc
    rw [hc.variance_fun_comp hF.aemeasurable] at hv
    have hzero := finiteResamplingEnergy_zero ν hF
    have htail := ih (fun i : Fin n ↦ ν i.succ) hg
    have hsum :
        (∑ i : Fin n, finiteResamplingEnergy (fun j : Fin n ↦ ν j.succ)
          (fun y ↦ ∫ x, F (Fin.cons x y) ∂ν 0) i) ≤
        ∑ i : Fin n, finiteResamplingEnergy ν F i.succ := by
      exact Finset.sum_le_sum fun i _ ↦ finiteResamplingEnergy_integral_cons_le ν hF i
    rw [Fin.sum_univ_succ]
    linarith

section Fintype

variable {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]

/-- Resampling energy is invariant under a relabeling of the coordinates. -/
theorem finiteResamplingEnergy_reindex (ν : κ → Measure ℝ)
    [∀ i, IsProbabilityMeasure (ν i)] (e : ι ≃ κ) (F : (κ → ℝ) → ℝ) (i : ι) :
    finiteResamplingEnergy (fun j ↦ ν (e j))
        (fun ω ↦ F (MeasurableEquiv.piCongrLeft (fun _ : κ ↦ ℝ) e ω)) i =
      finiteResamplingEnergy ν F (e i) := by
  have hu (ω : ι → ℝ) (z : ℝ) :
      MeasurableEquiv.piCongrLeft (fun _ : κ ↦ ℝ) e (Function.update ω i z) =
        Function.update (MeasurableEquiv.piCongrLeft (fun _ : κ ↦ ℝ) e ω) (e i) z := by
    funext k
    obtain ⟨j, rfl⟩ := e.surjective k
    by_cases hji : j = i
    · subst j
      simp [MeasurableEquiv.piCongrLeft_apply_apply]
    · simp [MeasurableEquiv.piCongrLeft_apply_apply, Function.update_of_ne hji,
        Function.update_of_ne (e.injective.ne hji)]
  unfold finiteResamplingEnergy
  simp_rw [hu]
  exact ((measurePreserving_piCongrLeft ν e).prod (MeasurePreserving.id (ν (e i)))).integral_comp
    ((MeasurableEquiv.piCongrLeft (fun _ : κ ↦ ℝ) e).measurableEmbedding.prodMap
      MeasurableEmbedding.id)
    (fun p : (κ → ℝ) × ℝ ↦ (F (Function.update p.1 (e i) p.2) - F p.1) ^ 2)

variable (ν : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (ν i)]
  {F : (ι → ℝ) → ℝ}

/-- Efron–Stein for a heterogeneous finite product, expressed in terms of
`finiteResamplingEnergy`.  Only `MemLp F 2` is needed: a separate pointwise
measurability assumption is unnecessary. -/
theorem finiteEfronStein_energy (hF : MemLp F 2 (Measure.pi ν)) :
    variance F (Measure.pi ν) ≤ (1 / 2 : ℝ) * ∑ i, finiteResamplingEnergy ν F i := by
  let e := (Fintype.equivFin ι).symm
  have hp := measurePreserving_piCongrLeft ν e
  have h := finiteEfronStein_fin (Fintype.card ι) (fun j ↦ ν (e j))
    (hF.comp_measurePreserving hp)
  simpa only [Function.comp_def, hp.variance_fun_comp hF.aemeasurable,
    finiteResamplingEnergy_reindex, Equiv.sum_comp] using h

/-- **Finite-product Efron–Stein**, with a product integral for the independently
resampled coordinate.  The factor `1/2` is sharp. -/
theorem finiteEfronStein_prod (hF : MemLp F 2 (Measure.pi ν)) :
    variance F (Measure.pi ν) ≤ (1 / 2 : ℝ) *
      ∑ i, ∫ p : (ι → ℝ) × ℝ,
        (F (Function.update p.1 i p.2) - F p.1) ^ 2
        ∂((Measure.pi ν).prod (ν i)) :=
  finiteEfronStein_energy ν hF

/-- **Finite-product Efron–Stein**, in iterated-integral form.  The measures may
be heterogeneous, and `ι` may be empty. -/
theorem finiteEfronStein (hF : MemLp F 2 (Measure.pi ν)) :
    variance F (Measure.pi ν) ≤ (1 / 2 : ℝ) *
      ∑ i, ∫ ω, ∫ z, (F (Function.update ω i z) - F ω) ^ 2 ∂ν i ∂Measure.pi ν := by
  simpa only [finiteResamplingEnergy_eq_integral ν hF] using finiteEfronStein_energy ν hF

/-- The centered squared-integral form of finite-product Efron–Stein. -/
theorem finiteEfronStein_centered (hF : MemLp F 2 (Measure.pi ν))
    (hcenter : (∫ ω, F ω ∂Measure.pi ν) = 0) :
    (∫ ω, F ω ^ 2 ∂Measure.pi ν) ≤ (1 / 2 : ℝ) *
      ∑ i, ∫ ω, ∫ z, (F (Function.update ω i z) - F ω) ^ 2 ∂ν i ∂Measure.pi ν := by
  have h := finiteEfronStein ν hF
  rw [variance_eq_sub hF, hcenter] at h
  simpa only [Pi.pow_apply, zero_pow (by decide : 2 ≠ 0), sub_zero] using h

/-- The centered squared-integral form with product rather than iterated integrals. -/
theorem finiteEfronStein_centered_prod (hF : MemLp F 2 (Measure.pi ν))
    (hcenter : (∫ ω, F ω ∂Measure.pi ν) = 0) :
    (∫ ω, F ω ^ 2 ∂Measure.pi ν) ≤ (1 / 2 : ℝ) *
      ∑ i, ∫ p : (ι → ℝ) × ℝ,
        (F (Function.update p.1 i p.2) - F p.1) ^ 2
        ∂((Measure.pi ν).prod (ν i)) := by
  have h := finiteEfronStein_prod ν hF
  rw [variance_eq_sub hF, hcenter] at h
  simpa only [Pi.pow_apply, zero_pow (by decide : 2 ≠ 0), sub_zero] using h

end Fintype

end Cascade
end


/- Supporting development: Cascade.FiniteApprox -/
section
set_option autoImplicit false

/-
# Zero-filled finite histories and passage to L²

`finiteApprox F K` evaluates `F` on its first `K` inputs, with every older input
set to zero.  Continuity gives pointwise convergence, not an a priori dominating
function.  The main passage theorem therefore uses Fatou: a uniform bound on the
finite squared integrals gives both `MemLp F 2` and the same bound for `F`.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace Cascade

/-- Keep the first `K` coordinates of a history, setting older coordinates to zero. -/
def truncatePast (K : ℕ) (x : Past) : Past := fun i ↦ if i < K then x i else 0

/-- Embed a finite input vector into a history by filling older inputs with zero. -/
def zeroFill (K : ℕ) (x : Fin K → ℝ) : Past :=
  fun i ↦ if h : i < K then x ⟨i, h⟩ else 0

/-- The finite-input zero-fill approximation of a history observable. -/
def finiteApprox (F : Past → ℝ) (K : ℕ) (x : Fin K → ℝ) : ℝ := F (zeroFill K x)

@[simp] theorem truncatePast_apply_lt (K : ℕ) (x : Past) {i : ℕ} (hi : i < K) :
    truncatePast K x i = x i := if_pos hi

@[simp] theorem truncatePast_apply_ge (K : ℕ) (x : Past) {i : ℕ} (hi : K ≤ i) :
    truncatePast K x i = 0 := if_neg (not_lt.mpr hi)

@[simp] theorem truncatePast_zero (x : Past) : truncatePast 0 x = 0 := by
  ext i
  simp [truncatePast]

@[simp] theorem zeroFill_apply (K : ℕ) (x : Fin K → ℝ) (i : Fin K) :
    zeroFill K x i = x i := dif_pos i.isLt

@[simp] theorem zeroFill_apply_ge (K : ℕ) (x : Fin K → ℝ) {i : ℕ} (hi : K ≤ i) :
    zeroFill K x i = 0 := dif_neg (not_lt.mpr hi)

@[simp] theorem zeroFill_restrict (K : ℕ) (x : Past) :
    zeroFill K (fun i ↦ x i) = truncatePast K x := by
  ext i
  simp only [zeroFill, truncatePast]
  split_ifs <;> rfl

@[simp] theorem truncatePast_zeroFill (K : ℕ) (x : Fin K → ℝ) :
    truncatePast K (zeroFill K x) = zeroFill K x := by
  ext i
  by_cases hi : i < K
  · simp [hi]
  · simp [truncatePast, zeroFill, hi]

@[simp] theorem zeroFill_neg (K : ℕ) (x : Fin K → ℝ) :
    zeroFill K (-x) = -zeroFill K x := by
  ext i
  by_cases hi : i < K <;> simp [zeroFill, hi]

@[simp] theorem zeroFill_zero (K : ℕ) : zeroFill K 0 = 0 := by
  ext i
  simp [zeroFill]

@[simp] theorem truncatePast_neg (K : ℕ) (x : Past) :
    truncatePast K (-x) = -truncatePast K x := by
  ext i
  by_cases hi : i < K <;> simp [truncatePast, hi]

theorem truncatePast_succ (K : ℕ) (x : Past) :
    truncatePast (K + 1) x = Function.update (truncatePast K x) K (x K) := by
  ext i
  by_cases hi : i = K
  · subst i
    simp [truncatePast]
  · simp only [Function.update_of_ne hi, truncatePast]
    have : i < K + 1 ↔ i < K := by omega
    simp [this]

@[simp] theorem zeroFill_update (K : ℕ) (x : Fin K → ℝ) (i : Fin K) (z : ℝ) :
    zeroFill K (Function.update x i z) = Function.update (zeroFill K x) (i : ℕ) z := by
  ext j
  by_cases hj : j < K
  · by_cases hji : j = i
    · subst j
      simp
    · have hfin : (⟨j, hj⟩ : Fin K) ≠ i := by
        intro h
        exact hji (congrArg Fin.val h)
      simp [zeroFill, hj, Function.update_of_ne hji, Function.update_of_ne hfin]
  · have hji : j ≠ i := by intro h; subst j; exact hj i.isLt
    simp [zeroFill, hj, Function.update_of_ne hji]

/-- Drop `t` coordinates from a finite input. Its length is `K - t`, so
this also handles dropping past the end of the finite input. -/
def finiteTail (K t : ℕ) (x : Fin K → ℝ) : Fin (K - t) → ℝ :=
  fun i ↦ x ⟨i + t, by have := i.isLt; omega⟩

/-- Dropping a zero-filled history gives a shorter zero-filled history. -/
theorem dropPast_zeroFill (K t : ℕ) (x : Fin K → ℝ) :
    dropPast t (zeroFill K x) = zeroFill (K - t) (finiteTail K t x) := by
  ext i
  by_cases hi : i < K - t
  · have hit : i + t < K := by omega
    simp [dropPast, zeroFill, finiteTail, hi, hit]
  · have hit : ¬ i + t < K := by omega
    simp [dropPast, zeroFill, hi, hit]

theorem finiteTail_update_of_le (K t : ℕ) (x : Fin K → ℝ) (i : Fin K)
    (z : ℝ) (ht : t ≤ i) :
    finiteTail K t (Function.update x i z) =
      Function.update (finiteTail K t x) (⟨i - t, by have := i.isLt; omega⟩ : Fin (K - t)) z := by
  ext j
  by_cases hji : (j : ℕ) = i - t
  · have heq : (⟨j + t, by have := j.isLt; omega⟩ : Fin K) = i := by
      apply Fin.ext
      dsimp
      omega
    have heq' : j = (⟨i - t, by have := i.isLt; omega⟩ : Fin (K - t)) := Fin.ext hji
    change Function.update x i z ⟨j + t, _⟩ = _
    rw [heq, heq']
    simp
  · have hne : (⟨j + t, by have := j.isLt; omega⟩ : Fin K) ≠ i := by
      intro h
      have hv := congrArg Fin.val h
      dsimp at hv
      omega
    have hne' : j ≠ (⟨i - t, by have := i.isLt; omega⟩ : Fin (K - t)) := by
      intro h
      exact hji (congrArg Fin.val h)
    simp [finiteTail, Function.update_of_ne hne, Function.update_of_ne hne']

/-- Observable form of the shorter-zero-fill identity. -/
theorem finiteApprox_dropPast (F : Past → ℝ) (K t : ℕ) (x : Fin K → ℝ) :
    finiteApprox (F ∘ dropPast t) K x = finiteApprox F (K - t) (finiteTail K t x) := by
  simp only [finiteApprox, Function.comp_def, dropPast_zeroFill]

@[fun_prop] theorem continuous_zeroFill (K : ℕ) : Continuous (zeroFill K) := by
  apply continuous_pi
  intro i
  by_cases hi : i < K
  · simpa only [zeroFill, dif_pos hi] using (continuous_apply (⟨i, hi⟩ : Fin K))
  · simpa only [zeroFill, dif_neg hi] using (continuous_const : Continuous (fun _ : Fin K → ℝ ↦ (0 : ℝ)))

@[fun_prop] theorem continuous_truncatePast (K : ℕ) : Continuous (truncatePast K) := by
  simpa only [Function.comp_def, zeroFill_restrict] using
    (continuous_zeroFill K).comp (continuous_reindex (fun i : Fin K ↦ (i : ℕ)))

@[fun_prop] theorem continuous_finiteApprox {F : Past → ℝ} (hF : Continuous F) (K : ℕ) :
    Continuous (finiteApprox F K) := hF.comp (continuous_zeroFill K)

theorem odd_finiteApprox {F : Past → ℝ} (hF : Function.Odd F) (K : ℕ) :
    Function.Odd (finiteApprox F K) := by
  intro x
  simpa only [finiteApprox, zeroFill_neg] using hF (zeroFill K x)

/-- Zero-filling converges in the product topology: every fixed coordinate is
ultimately unchanged. -/
theorem tendsto_truncatePast (x : Past) :
    Tendsto (fun K ↦ truncatePast K x) atTop (𝓝 x) := by
  apply tendsto_pi_nhds.mpr
  intro i
  apply tendsto_const_nhds.congr'
  filter_upwards [eventually_gt_atTop i] with K hK
  simp [truncatePast, hK]

theorem tendsto_finiteApprox {F : Past → ℝ} (hF : Continuous F) (x : Past) :
    Tendsto (fun K ↦ finiteApprox F K (fun i ↦ x i)) atTop (𝓝 (F x)) := by
  simpa only [finiteApprox, zeroFill_restrict] using
    (hF.tendsto x).comp (tendsto_truncatePast x)

section Fatou

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}

/-- Fatou for real squared integrals, including the `L²` membership conclusion.
The uniform finite bound is essential: no integrable pointwise majorant is assumed. -/
theorem memLp_two_and_integral_sq_le_of_ae_tendsto
    {f : ℕ → α → ℝ} {g : α → ℝ} {B : ℝ}
    (hf : ∀ K, MemLp (f K) 2 μ) (hg : AEStronglyMeasurable g μ)
    (hlim : ∀ᵐ x ∂μ, Tendsto (fun K ↦ f K x) atTop (𝓝 (g x)))
    (hB : ∀ K, (∫ x, f K x ^ 2 ∂μ) ≤ B) :
    MemLp g 2 μ ∧ (∫ x, g x ^ 2 ∂μ) ≤ B := by
  have hB0 : 0 ≤ B :=
    (integral_nonneg (fun x ↦ sq_nonneg (f 0 x))).trans (hB 0)
  have hfatou : (∫⁻ x, ENNReal.ofReal (g x ^ 2) ∂μ) ≤ ENNReal.ofReal B := by
    calc
      _ = ∫⁻ x, liminf (fun K ↦ ENNReal.ofReal (f K x ^ 2)) atTop ∂μ := by
        apply lintegral_congr_ae
        filter_upwards [hlim] with x hx
        exact ((ENNReal.continuous_ofReal.tendsto _).comp (hx.pow 2)).liminf_eq.symm
      _ ≤ liminf (fun K ↦ ∫⁻ x, ENNReal.ofReal (f K x ^ 2) ∂μ) atTop :=
        lintegral_liminf_le' (fun K ↦ ((hf K).aemeasurable.pow_const 2).ennreal_ofReal)
      _ ≤ ENNReal.ofReal B := by
        apply liminf_le_of_frequently_le'
        apply Frequently.of_forall
        intro K
        rw [← ofReal_integral_eq_lintegral_ofReal (hf K).integrable_sq
          (ae_of_all _ fun x ↦ sq_nonneg (f K x))]
        exact ENNReal.ofReal_le_ofReal (hB K)
  have hgi : Integrable (fun x ↦ g x ^ 2) μ :=
    (lintegral_ofReal_ne_top_iff_integrable (hg.pow 2)
      (ae_of_all _ fun x ↦ sq_nonneg (g x))).mp
      (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hfatou)
  refine ⟨(memLp_two_iff_integrable_sq hg).mpr hgi, ?_⟩
  rw [← ofReal_integral_eq_lintegral_ofReal hgi
    (ae_of_all _ fun x ↦ sq_nonneg (g x))] at hfatou
  exact (ENNReal.ofReal_le_ofReal_iff hB0).mp hfatou

/-- The ordinary squared norm of an `L²` representative is its squared integral. -/
theorem norm_toLp_two_sq {f : α → ℝ} (hf : MemLp f 2 μ) :
    ‖hf.toLp f‖ ^ 2 = ∫ x, f x ^ 2 ∂μ := by
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [hf.coeFn_toLp] with x hx
  simp [hx, Real.norm_eq_abs]

theorem toReal_eLpNorm_two_sq {f : α → ℝ} (hf : MemLp f 2 μ) :
    (eLpNorm f 2 μ).toReal ^ 2 = ∫ x, f x ^ 2 ∂μ := by
  rw [← Lp.norm_toLp f hf, norm_toLp_two_sq hf]

/-- Finite Minkowski inequality in the real-valued `eLpNorm.toReal` form.
The membership hypotheses rule out the spurious `∞.toReal = 0` case. -/
theorem toReal_eLpNorm_sum_le {ι : Type*} (s : Finset ι) {f : ι → α → ℝ}
    (hf : ∀ i ∈ s, MemLp (f i) 2 μ) :
    (eLpNorm (fun x ↦ ∑ i ∈ s, f i x) 2 μ).toReal ≤
      ∑ i ∈ s, (eLpNorm (f i) 2 μ).toReal := by
  have h : eLpNorm (fun x ↦ ∑ i ∈ s, f i x) 2 μ ≤ ∑ i ∈ s, eLpNorm (f i) 2 μ := by
    convert eLpNorm_sum_le (f := f) (s := s)
      (fun i hi ↦ (hf i hi).aestronglyMeasurable) (by norm_num : (1 : ℝ≥0∞) ≤ 2) using 1
    congr 1
    ext x
    simp
  have ht : ∀ i ∈ s, eLpNorm (f i) 2 μ ≠ ∞ := fun i hi ↦ (hf i hi).2.ne
  have hreal := ENNReal.toReal_mono (ENNReal.sum_ne_top.mpr ht) h
  rwa [ENNReal.toReal_sum ht] at hreal

/-- A real-valued form of the `L²` norm, without choosing an `Lp` representative. -/
theorem toReal_eLpNorm_two_eq_sqrt {f : α → ℝ} (hf : MemLp f 2 μ) :
    (eLpNorm f 2 μ).toReal = Real.sqrt (∫ x, f x ^ 2 ∂μ) := by
  rw [← Lp.norm_toLp f hf, ← norm_toLp_two_sq hf, Real.sqrt_sq (norm_nonneg _)]

end Fatou

section Iid

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- Restricting an infinite iid history to its first `K` coordinates gives the
finite product measure used by finite Efron–Stein. -/
theorem measurePreserving_restrictPast (K : ℕ) :
    MeasurePreserving (fun x : Past ↦ fun i : Fin K ↦ x i)
      (iidLaw ℕ ν) (Measure.pi fun _ : Fin K ↦ ν) := by
  simpa only [iidLaw, Measure.infinitePi_eq_pi] using
    measurePreserving_iid_reindex ν (fun i : Fin K ↦ (i : ℕ)) Fin.val_injective

/-- An iid finite tail still has the shorter iid finite-product law. -/
theorem measurePreserving_finiteTail (K t : ℕ) :
    MeasurePreserving (finiteTail K t) (Measure.pi fun _ : Fin K ↦ ν)
      (Measure.pi fun _ : Fin (K - t) ↦ ν) := by
  let r : Fin (K - t) → Fin K := fun i ↦ ⟨i + t, by have := i.isLt; omega⟩
  have hr : Function.Injective r := by
    intro i j hij
    apply Fin.ext
    have hv := congrArg Fin.val hij
    dsimp [r] at hv
    omega
  simpa only [iidLaw, Measure.infinitePi_eq_pi] using measurePreserving_iid_reindex ν r hr

/-- Every shifted finite approximation inherits `Lᵖ` membership from a
shorter unshifted approximation, even when the shift exceeds the cutoff. -/
theorem memLp_finiteApprox_dropPast {F : Past → ℝ} {p : ℝ≥0∞}
    (hfin : ∀ K, MemLp (finiteApprox F K) p (Measure.pi fun _ : Fin K ↦ ν)) (K t : ℕ) :
    MemLp (finiteApprox (F ∘ dropPast t) K) p (Measure.pi fun _ : Fin K ↦ ν) := by
  simpa only [Function.comp_def, ← finiteApprox_dropPast] using
    (hfin (K - t)).comp_measurePreserving (measurePreserving_finiteTail ν K t)

/-- Dropping recent coordinates preserves the finite approximation norm,
with the cutoff shortened by the same amount. -/
theorem eLpNorm_finiteApprox_dropPast {F : Past → ℝ} {p : ℝ≥0∞}
    (hfin : ∀ K, MemLp (finiteApprox F K) p (Measure.pi fun _ : Fin K ↦ ν)) (K t : ℕ) :
    eLpNorm (finiteApprox (F ∘ dropPast t) K) p (Measure.pi fun _ : Fin K ↦ ν) =
      eLpNorm (finiteApprox F (K - t)) p (Measure.pi fun _ : Fin (K - t) ↦ ν) := by
  have heq : finiteApprox (F ∘ dropPast t) K = finiteApprox F (K - t) ∘ finiteTail K t := by
    ext x
    exact finiteApprox_dropPast F K t x
  rw [heq]
  exact eLpNorm_comp_measurePreserving (hfin (K - t)).aestronglyMeasurable
    (measurePreserving_finiteTail ν K t)

theorem integral_finiteApprox_sq {F : Past → ℝ} (hF : Continuous F) (K : ℕ) :
    (∫ x, F (truncatePast K x) ^ 2 ∂iidLaw ℕ ν) =
      ∫ x, finiteApprox F K x ^ 2 ∂Measure.pi (fun _ : Fin K ↦ ν) := by
  simpa only [Function.comp_def, finiteApprox, zeroFill_restrict] using
    (identDistrib_comp_measurePreserving (measurePreserving_restrictPast ν K)
      ((continuous_finiteApprox hF K).measurable.pow_const 2)).integral_eq

/-- The reusable finite-approximation passage theorem. It is deliberately
independent of deterministic Lipschitz or influence assumptions, so it also
applies to residuals controlled only by random replacement energies. -/
theorem memLp_two_and_integral_sq_le_of_finiteApprox {F : Past → ℝ} {B : ℝ}
    (hF : Continuous F)
    (hfin : ∀ K, MemLp (finiteApprox F K) 2 (Measure.pi fun _ : Fin K ↦ ν))
    (hB : ∀ K, (∫ x, finiteApprox F K x ^ 2 ∂Measure.pi (fun _ : Fin K ↦ ν)) ≤ B) :
    MemLp F 2 (iidLaw ℕ ν) ∧ (∫ x, F x ^ 2 ∂iidLaw ℕ ν) ≤ B := by
  refine memLp_two_and_integral_sq_le_of_ae_tendsto
    (f := fun K x ↦ F (truncatePast K x)) ?_ hF.aestronglyMeasurable
    (ae_of_all _ fun x ↦ (hF.tendsto x).comp (tendsto_truncatePast x)) ?_
  · intro K
    simpa only [Function.comp_def, finiteApprox, zeroFill_restrict] using
      (hfin K).comp_measurePreserving (measurePreserving_restrictPast ν K)
  · intro K
    rw [integral_finiteApprox_sq ν hF K]
    exact hB K

end Iid

end Cascade
end


/- Supporting development: Cascade.InfluenceL2 -/
section
set_option autoImplicit false

/-
# Infinite-input L² influence bounds

Continuous odd history observables are approximated by finite zero-filled
inputs.  Coordinate telescoping proves that each approximation is in `L²`;
finite Efron–Stein and Fatou then give the infinite-input bound.  For reversed
time blocks, the row/column sums of the influence convolution yield the sharp
linear-in-block-length squared bound.

`HasFiniteL2Influence` packages random replacement norms uniformly over all
finite zero-fills. Finite tails transport these estimates to masked histories,
and Minkowski gives the same block convolution. The resulting residual bound
needs no deterministic noise-scaled Lipschitz estimate. The uniform finite
squared-integral and finite-energy passages are also exposed separately.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace Cascade

section FiniteInfluence

/-- Coordinate telescoping from the all-zero history. Only finitely many
coordinates change, so no boundedness assumption on histories is needed. -/
theorem abs_truncatePast_le_of_hasInfluence {F : Past → ℝ} {d : ℕ → ℝ}
    (hF : HasInfluence F d) (hzero : F 0 = 0) (K : ℕ) (x : Past) :
    |F (truncatePast K x)| ≤ ∑ i ∈ Finset.range K, d i * |x i| := by
  induction K with
  | zero => simp [hzero]
  | succ K ih =>
    have hstep : |F (truncatePast (K + 1) x) - F (truncatePast K x)| ≤ d K * |x K| := by
      rw [truncatePast_succ]
      simpa only [truncatePast_apply_ge K x le_rfl, sub_zero] using
        hF (truncatePast K x) K (x K)
    calc
      _ ≤ |F (truncatePast (K + 1) x) - F (truncatePast K x)| +
          |F (truncatePast K x)| := by
        simpa only [sub_add_cancel] using
          abs_add_le (F (truncatePast (K + 1) x) - F (truncatePast K x)) (F (truncatePast K x))
      _ ≤ d K * |x K| + ∑ i ∈ Finset.range K, d i * |x i| := add_le_add hstep ih
      _ = _ := by rw [Finset.sum_range_succ]; ring

/-- The elementary integrable majorant for a finite-input approximation. -/
theorem abs_finiteApprox_le_of_hasInfluence {F : Past → ℝ} {d : ℕ → ℝ}
    (hF : HasInfluence F d) (hzero : F 0 = 0) (K : ℕ) (x : Fin K → ℝ) :
    |finiteApprox F K x| ≤ ∑ i : Fin K, d i * |x i| := by
  have h := abs_truncatePast_le_of_hasInfluence hF hzero K (zeroFill K x)
  rw [truncatePast_zeroFill] at h
  simpa only [finiteApprox, ← Fin.sum_univ_eq_sum_range, zeroFill_apply] using h

/-- Zero-filling preserves every active coordinate's deterministic influence. -/
theorem finiteApprox_hasInfluence {F : Past → ℝ} {d : ℕ → ℝ}
    (hF : HasInfluence F d) (K : ℕ) (x : Fin K → ℝ) (i : Fin K) (z : ℝ) :
    |finiteApprox F K (Function.update x i z) - finiteApprox F K x| ≤
      d i * |z - x i| := by
  simpa only [finiteApprox, zeroFill_update, zeroFill_apply] using
    hF (zeroFill K x) i z

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- Finite-input approximations are genuinely square integrable, before
applying Efron–Stein or using the total Bochner integral. -/
theorem memLp_finiteApprox_of_hasInfluence {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hcont : Continuous F)
    (hF : HasInfluence F d) (hzero : F 0 = 0) (K : ℕ) :
    MemLp (finiteApprox F K) 2 (Measure.pi fun _ : Fin K ↦ ν) := by
  have hmajor : MemLp (fun x : Fin K → ℝ ↦ ∑ i : Fin K, d i * |x i|) 2
      (Measure.pi fun _ : Fin K ↦ ν) := by
    apply memLp_finset_sum
    intro i _
    exact ((hnoise.comp_measurePreserving (measurePreserving_eval (fun _ : Fin K ↦ ν) i)).abs).const_mul (d i)
  apply hmajor.mono' (continuous_finiteApprox hcont K).aestronglyMeasurable
  exact ae_of_all _ fun x ↦ by
    simpa only [Real.norm_eq_abs] using abs_finiteApprox_le_of_hasInfluence hF hzero K x

/-- Odd finite approximations are centered under a symmetric innovation law. -/
theorem integral_finiteApprox_eq_zero {F : Past → ℝ}
    (hν : SymmetricLaw ν) (hodd : Function.Odd F) (K : ℕ) :
    (∫ x, finiteApprox F K x ∂Measure.pi (fun _ : Fin K ↦ ν)) = 0 := by
  simpa only [iidLaw, Measure.infinitePi_eq_pi] using
    integral_iid_odd_eq_zero ν hν (odd_finiteApprox hodd K)

/-- An independently replaced innovation has second moment twice the
innovation second moment. Symmetry is used only to center the innovation. -/
theorem integral_finitePi_coordinate_sub_sq {ι : Type*} [Fintype ι]
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν) (i : ι) :
    (∫ p : (ι → ℝ) × ℝ, (p.2 - p.1 i) ^ 2
      ∂((Measure.pi fun _ : ι ↦ ν).prod ν)) = 2 * ∫ z, z ^ 2 ∂ν := by
  calc
    _ = ∫ p : ℝ × ℝ, (p.2 - p.1) ^ 2 ∂ν.prod ν := by
      exact (identDistrib_comp_measurePreserving
        ((measurePreserving_eval (fun _ : ι ↦ ν) i).prod (MeasurePreserving.id ν))
        (by fun_prop : Measurable (fun p : ℝ × ℝ ↦ (p.2 - p.1) ^ 2))).integral_eq
    _ = 2 * variance (fun z : ℝ ↦ z) ν := integral_sq_sub_independent_copies hnoise
    _ = _ := by
      rw [variance_eq_sub hnoise, integral_odd_eq_zero hν (show Function.Odd (fun z : ℝ ↦ z) from fun _ ↦ rfl)]
      simp

/-- The finite replacement-energy estimate for a deterministic coordinate
Lipschitz bound. The factor two cancels the sharp Efron–Stein factor `1/2`. -/
theorem finiteResamplingEnergy_le_of_lipschitz {ι : Type*} [Fintype ι] [DecidableEq ι]
    {F : (ι → ℝ) → ℝ} {a : ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hF : MemLp F 2 (Measure.pi fun _ : ι ↦ ν)) (i : ι) (ha : 0 ≤ a)
    (hinfl : ∀ x z, |F (Function.update x i z) - F x| ≤ a * |z - x i|) :
    finiteResamplingEnergy (fun _ : ι ↦ ν) F i ≤
      2 * (∫ z, z ^ 2 ∂ν) * a ^ 2 := by
  have heval := hnoise.comp_measurePreserving (measurePreserving_eval (fun _ : ι ↦ ν) i)
  have hdiff : MemLp (fun p : (ι → ℝ) × ℝ ↦ p.2 - p.1 i) 2
      ((Measure.pi fun _ : ι ↦ ν).prod ν) :=
    (hnoise.comp_snd _).sub (heval.comp_fst ν)
  calc
    _ ≤ ∫ p : (ι → ℝ) × ℝ, a ^ 2 * (p.2 - p.1 i) ^ 2
        ∂((Measure.pi fun _ : ι ↦ ν).prod ν) := by
      apply integral_mono (integrable_finitePi_resample_sq (fun _ : ι ↦ ν) hF i)
        (hdiff.integrable_sq.const_mul (a ^ 2))
      intro p
      have h := (sq_le_sq₀ (abs_nonneg _) (mul_nonneg ha (abs_nonneg _))).mpr (hinfl p.1 p.2)
      simpa only [sq_abs, mul_pow] using h
    _ = _ := by
      rw [integral_const_mul, integral_finitePi_coordinate_sub_sq ν hnoise hν i]
      ring

/-- Sharp finite-input influence bound. No summability of `d` is needed here. -/
theorem integral_sq_finiteApprox_le {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (K : ℕ) :
    (∫ x, finiteApprox F K x ^ 2 ∂Measure.pi (fun _ : Fin K ↦ ν)) ≤
      (∫ z, z ^ 2 ∂ν) * ∑ i : Fin K, d i ^ 2 := by
  have hfin := memLp_finiteApprox_of_hasInfluence ν hnoise hcont hinfl hodd.map_zero K
  have h := finiteEfronStein_centered_prod (fun _ : Fin K ↦ ν) hfin
    (integral_finiteApprox_eq_zero ν hν hodd K)
  calc
    _ ≤ (1 / 2 : ℝ) * ∑ i : Fin K, finiteResamplingEnergy (fun _ : Fin K ↦ ν)
        (finiteApprox F K) i := h
    _ ≤ (1 / 2 : ℝ) * ∑ i : Fin K, 2 * (∫ z, z ^ 2 ∂ν) * d i ^ 2 := by
      gcongr with i
      exact finiteResamplingEnergy_le_of_lipschitz ν hnoise hν hfin i (hd i)
        (fun x z ↦ finiteApprox_hasInfluence hinfl K x i z)
    _ = _ := by rw [← Finset.mul_sum]; ring

end FiniteInfluence

section FiniteEnergyPassage

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- Efron–Stein followed by Fatou. This is the residual-friendly entry point:
only uniformly bounded finite replacement energies, not pointwise Lipschitz
constants or a dominating function, are required. -/
theorem memLp_two_and_integral_sq_le_of_finiteEnergy {F : Past → ℝ} {B : ℝ}
    (hν : SymmetricLaw ν) (hcont : Continuous F) (hodd : Function.Odd F)
    (hfin : ∀ K, MemLp (finiteApprox F K) 2 (Measure.pi fun _ : Fin K ↦ ν))
    (henergy : ∀ K, (1 / 2 : ℝ) * ∑ i : Fin K,
      finiteResamplingEnergy (fun _ : Fin K ↦ ν) (finiteApprox F K) i ≤ B) :
    MemLp F 2 (iidLaw ℕ ν) ∧ (∫ x, F x ^ 2 ∂iidLaw ℕ ν) ≤ B := by
  apply memLp_two_and_integral_sq_le_of_finiteApprox ν hcont hfin
  intro K
  exact (finiteEfronStein_centered_prod (fun _ : Fin K ↦ ν) (hfin K)
    (integral_finiteApprox_eq_zero ν hν hodd K)).trans (henergy K)

end FiniteEnergyPassage

section InfiniteInfluence

/-- A nonnegative summable influence envelope is square summable. -/
theorem summable_sq_of_nonneg {d : ℕ → ℝ} (hd : ∀ i, 0 ≤ d i) (hs : Summable d) :
    Summable (fun i ↦ d i ^ 2) := by
  apply Summable.of_nonneg_of_le (fun i ↦ sq_nonneg (d i))
    (fun i ↦ ?_) (hs.mul_left (∑' i, d i))
  simpa only [pow_two, mul_comm] using
    mul_le_mul_of_nonneg_left (hs.le_tsum i (fun j _ ↦ hd j)) (hd i)

/-- The `ℓ²` norm of a nonnegative summable envelope is at most its `ℓ¹` norm. -/
theorem tsum_sq_le_sq_tsum {d : ℕ → ℝ} (hd : ∀ i, 0 ≤ d i) (hs : Summable d) :
    (∑' i, d i ^ 2) ≤ (∑' i, d i) ^ 2 := by
  calc
    _ ≤ ∑' i, (∑' j, d j) * d i := by
      apply (summable_sq_of_nonneg hd hs).tsum_le_tsum _ (hs.mul_left _)
      intro i
      simpa only [pow_two, mul_comm] using
        mul_le_mul_of_nonneg_left (hs.le_tsum i (fun j _ ↦ hd j)) (hd i)
    _ = _ := by rw [tsum_mul_left]; ring

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- Infinite-input influence inequality, with the square-sum constant.
Continuity is used only in passing from finite zero-fills to the full history. -/
theorem memLp_two_and_integral_sq_le_of_hasInfluence {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) :
    MemLp F 2 (iidLaw ℕ ν) ∧
      (∫ x, F x ^ 2 ∂iidLaw ℕ ν) ≤ (∫ z, z ^ 2 ∂ν) * ∑' i, d i ^ 2 := by
  refine memLp_two_and_integral_sq_le_of_finiteApprox ν hcont
    (memLp_finiteApprox_of_hasInfluence ν hnoise hcont hinfl hodd.map_zero) ?_
  intro K
  refine (integral_sq_finiteApprox_le ν hnoise hν hcont hodd hinfl hd K).trans ?_
  apply mul_le_mul_of_nonneg_left _ (integral_nonneg fun z ↦ sq_nonneg z)
  simpa only [← Fin.sum_univ_eq_sum_range] using
    (summable_sq_of_nonneg hd hs).sum_le_tsum (Finset.range K) (fun i _ ↦ sq_nonneg (d i))

/-- Convenient membership-only form. -/
theorem memLp_two_of_hasInfluence {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) : MemLp F 2 (iidLaw ℕ ν) :=
  (memLp_two_and_integral_sq_le_of_hasInfluence ν hnoise hν hcont hodd hinfl hd hs).1

/-- Norm form of the square-sum influence inequality. -/
theorem toReal_eLpNorm_le_of_hasInfluence {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) :
    (eLpNorm F 2 (iidLaw ℕ ν)).toReal ≤
      Real.sqrt (∫ z, z ^ 2 ∂ν) * Real.sqrt (∑' i, d i ^ 2) := by
  obtain ⟨hmem, hbound⟩ := memLp_two_and_integral_sq_le_of_hasInfluence ν hnoise hν hcont hodd hinfl hd hs
  rw [toReal_eLpNorm_two_eq_sqrt hmem, ← Real.sqrt_mul (integral_nonneg fun z ↦ sq_nonneg z)]
  exact Real.sqrt_le_sqrt hbound

/-- The slightly weaker, often more convenient `σ * ∑ d` norm bound. -/
theorem toReal_eLpNorm_le_tsum_of_hasInfluence {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) :
    (eLpNorm F 2 (iidLaw ℕ ν)).toReal ≤ Real.sqrt (∫ z, z ^ 2 ∂ν) * ∑' i, d i := by
  refine (toReal_eLpNorm_le_of_hasInfluence ν hnoise hν hcont hodd hinfl hd hs).trans ?_
  apply mul_le_mul_of_nonneg_left _ (Real.sqrt_nonneg _)
  exact (Real.sqrt_le_sqrt (tsum_sq_le_sq_tsum hd hs)).trans_eq (Real.sqrt_sq (tsum_nonneg hd))

end InfiniteInfluence

section PastSums

/-- A reversed-time block, represented on a single one-sided history.
Under iid histories this has the same law as `sumProcess F n`. -/
def pastSum (F : Past → ℝ) (n : ℕ) (x : Past) : ℝ :=
  ∑ t ∈ Finset.range n, F (dropPast t x)

@[simp] theorem pastSum_zero (F : Past → ℝ) : pastSum F 0 = 0 := by
  ext x
  simp [pastSum]

@[fun_prop] theorem continuous_pastSum {F : Past → ℝ} (hF : Continuous F) (n : ℕ) :
    Continuous (pastSum F n) := by
  unfold pastSum
  exact continuous_finset_sum _ fun t _ ↦ hF.comp (continuous_dropPast t)

@[fun_prop] theorem measurable_pastSum {F : Past → ℝ} (hF : Measurable F) (n : ℕ) :
    Measurable (pastSum F n) := by
  unfold pastSum
  exact Finset.measurable_sum _ fun t _ ↦ hF.comp (measurable_dropPast t)

theorem odd_pastSum {F : Past → ℝ} (hF : Function.Odd F) (n : ℕ) :
    Function.Odd (pastSum F n) := by
  intro x
  simp only [Function.Odd] at hF
  simp only [pastSum, dropPast_neg, hF, Finset.sum_neg_distrib]

/-- Exact reversal of a consecutive block, including the empty block. -/
theorem pastSum_history_eq_sumProcess (F : Past → ℝ) (n : ℕ) (ω : NoisePath) :
    pastSum F n (history ((n : ℤ) - 1) ω) = sumProcess F n ω := by
  unfold pastSum sumProcess
  simp only [dropPast_history]
  calc
    _ = ∑ t ∈ Finset.range n, atTime F ((n - 1 - t : ℕ) : ℤ) ω := by
      apply Finset.sum_congr rfl
      intro t ht
      have ht' : t < n := Finset.mem_range.mp ht
      change F (history ((n : ℤ) - 1 - (t : ℤ)) ω) =
        F (history ((n - 1 - t : ℕ) : ℤ) ω)
      congr 2
      omega
    _ = _ := Finset.sum_range_reflect (fun t ↦ atTime F (t : ℤ) ω) n

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- The one-sided reversed block and the two-sided forward block have the
same joint-law realization, without any asymptotic variance construction. -/
theorem identDistrib_sumProcess_pastSum {F : Past → ℝ} (hF : Measurable F) (n : ℕ) :
    IdentDistrib (sumProcess F n) (pastSum F n) (iidLaw ℤ ν) (iidLaw ℕ ν) := by
  simpa only [Function.comp_def, pastSum_history_eq_sumProcess] using
    identDistrib_comp_measurePreserving (measurePreserving_history ν ((n : ℤ) - 1))
      (measurable_pastSum hF n)

theorem integral_sq_sumProcess_eq_pastSum {F : Past → ℝ} (hF : Measurable F) (n : ℕ) :
    (∫ ω, sumProcess F n ω ^ 2 ∂iidLaw ℤ ν) =
      ∫ x, pastSum F n x ^ 2 ∂iidLaw ℕ ν :=
  ((identDistrib_sumProcess_pastSum ν hF n).comp (by fun_prop : Measurable (fun z : ℝ ↦ z ^ 2))).integral_eq

theorem memLp_pastSum {F : Past → ℝ} {p : ℝ≥0∞}
    (hF : MemLp F p (iidLaw ℕ ν)) (n : ℕ) : MemLp (pastSum F n) p (iidLaw ℕ ν) :=
  memLp_finset_sum _ fun t _ ↦ memLp_dropPast ν hF t

theorem memLp_sumProcess {F : Past → ℝ} {p : ℝ≥0∞}
    (hF : MemLp F p (iidLaw ℕ ν)) (n : ℕ) : MemLp (sumProcess F n) p (iidLaw ℤ ν) :=
  memLp_finset_sum _ fun t _ ↦ memLp_atTime ν hF (t : ℤ)

@[simp] theorem finiteApprox_pastSum (F : Past → ℝ) (n K : ℕ) (x : Fin K → ℝ) :
    finiteApprox (pastSum F n) K x =
      ∑ t ∈ Finset.range n, finiteApprox (F ∘ dropPast t) K x := rfl

/-- Finite approximations of a block are in `Lᵖ` whenever all finite
approximations of its single observable are in `Lᵖ`. -/
theorem memLp_finiteApprox_pastSum {F : Past → ℝ} {p : ℝ≥0∞}
    (hfin : ∀ K, MemLp (finiteApprox F K) p (Measure.pi fun _ : Fin K ↦ ν)) (n K : ℕ) :
    MemLp (finiteApprox (pastSum F n) K) p (Measure.pi fun _ : Fin K ↦ ν) :=
  memLp_finset_sum (Finset.range n) fun t _ ↦ memLp_finiteApprox_dropPast ν hfin K t

end PastSums

section InfluenceConvolution

/-- The influence convolution of a reversed block. Each input occurs in the
rows with shift `t ≤ i`, at lag `i - t`. -/
def pastSumInfluence (d : ℕ → ℝ) (n i : ℕ) : ℝ :=
  ∑ t ∈ Finset.range n, if t ≤ i then d (i - t) else 0

theorem dropPast_update_of_le (x : Past) (i t : ℕ) (z : ℝ) (ht : t ≤ i) :
    dropPast t (Function.update x i z) = Function.update (dropPast t x) (i - t) z := by
  ext k
  by_cases hk : k = i - t
  · subst k
    simp only [dropPast, Function.update_apply, Nat.sub_add_cancel ht, if_true]
  · have hkt : k + t ≠ i := by omega
    simp only [dropPast, Function.update_apply, hk, hkt, if_false]

theorem dropPast_update_of_lt (x : Past) (i t : ℕ) (z : ℝ) (ht : i < t) :
    dropPast t (Function.update x i z) = dropPast t x := by
  ext k
  exact Function.update_of_ne (by omega : k + t ≠ i) z x

/-- Coordinate updates commute with dropping the relevant recent inputs. -/
theorem hasInfluence_pastSum {F : Past → ℝ} {d : ℕ → ℝ}
    (hF : HasInfluence F d) (n : ℕ) : HasInfluence (pastSum F n) (pastSumInfluence d n) := by
  intro x i z
  have hrow (t : ℕ) :
      |F (dropPast t (Function.update x i z)) - F (dropPast t x)| ≤
        (if t ≤ i then d (i - t) else 0) * |z - x i| := by
    by_cases ht : t ≤ i
    · rw [if_pos ht, dropPast_update_of_le x i t z ht]
      simpa only [dropPast, Nat.sub_add_cancel ht] using hF (dropPast t x) (i - t) z
    · rw [if_neg ht, dropPast_update_of_lt x i t z (by omega), sub_self, abs_zero, zero_mul]
  change |(∑ t ∈ Finset.range n, F (dropPast t (Function.update x i z))) -
    ∑ t ∈ Finset.range n, F (dropPast t x)| ≤ _
  rw [← Finset.sum_sub_distrib]
  calc
    _ ≤ ∑ t ∈ Finset.range n, |F (dropPast t (Function.update x i z)) -
        F (dropPast t x)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ t ∈ Finset.range n, (if t ≤ i then d (i - t) else 0) * |z - x i| :=
      Finset.sum_le_sum fun t _ ↦ hrow t
    _ = _ := (Finset.sum_mul _ _ _).symm

theorem pastSumInfluence_nonneg {d : ℕ → ℝ} (hd : ∀ i, 0 ≤ d i) (n i : ℕ) :
    0 ≤ pastSumInfluence d n i := by
  apply Finset.sum_nonneg
  intro t _
  split_ifs
  · exact hd _
  · exact le_rfl

private theorem sum_comp_le_tsum_of_injOn {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (s : Finset ℕ) (r : ℕ → ℕ)
    (hr : Set.InjOn r (s : Set ℕ)) : (∑ i ∈ s, d (r i)) ≤ ∑' i, d i := by
  have heq : (∑ j ∈ s.image r, d j) = ∑ i ∈ s, d (r i) :=
    Finset.sum_image (fun a ha b hb hab ↦ hr ha hb hab)
  rw [← heq]
  exact hs.sum_le_tsum _ (fun i _ ↦ hd i)

/-- A convolution row is bounded by the full influence mass `D = ∑ d`. -/
theorem pastSumInfluence_le_tsum {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n i : ℕ) :
    pastSumInfluence d n i ≤ ∑' j, d j := by
  unfold pastSumInfluence
  rw [← Finset.sum_filter]
  apply sum_comp_le_tsum_of_injOn hd hs _ (fun t ↦ i - t)
  intro a ha b hb hab
  simp only [Finset.mem_coe, Finset.mem_filter] at ha hb
  dsimp only at hab
  omega

/-- A finite column has total mass at most `D`. -/
theorem sum_shiftInfluence_le_tsum {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (K t : ℕ) :
    (∑ i ∈ Finset.range K, if t ≤ i then d (i - t) else 0) ≤ ∑' j, d j := by
  rw [← Finset.sum_filter]
  apply sum_comp_le_tsum_of_injOn hd hs _ (fun i ↦ i - t)
  intro a ha b hb hab
  simp only [Finset.mem_coe, Finset.mem_filter] at ha hb
  dsimp only at hab
  omega

/-- The sum of all finite rows is at most `n D`. The estimate is uniform in
the zero-fill cutoff `K`. -/
theorem sum_pastSumInfluence_le {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n K : ℕ) :
    (∑ i ∈ Finset.range K, pastSumInfluence d n i) ≤ (n : ℝ) * ∑' j, d j := by
  unfold pastSumInfluence
  rw [Finset.sum_comm]
  calc
    _ ≤ ∑ _t ∈ Finset.range n, ∑' j, d j :=
      Finset.sum_le_sum fun t _ ↦ sum_shiftInfluence_le_tsum hd hs K t
    _ = _ := by simp

theorem summable_pastSumInfluence {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n : ℕ) :
    Summable (pastSumInfluence d n) :=
  summable_of_sum_range_le (pastSumInfluence_nonneg hd n) (sum_pastSumInfluence_le hd hs n)

/-- Shifting an envelope to an older input, with zeros at the new front,
preserves summability. -/
theorem summable_shiftInfluence {d : ℕ → ℝ} (hs : Summable d) (t : ℕ) :
    Summable (fun i ↦ if t ≤ i then d (i - t) else 0) := by
  apply (summable_nat_add_iff t).mp
  simpa only [Nat.le_add_left, if_true, Nat.add_sub_cancel] using hs

theorem tsum_shiftInfluence {d : ℕ → ℝ} (hs : Summable d) (t : ℕ) :
    (∑' i, if t ≤ i then d (i - t) else 0) = ∑' i, d i := by
  have hfirst : (∑ i ∈ Finset.range t, if t ≤ i then d (i - t) else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro i hi
    simp only [if_neg (not_le.mpr (Finset.mem_range.mp hi))]
  have h := (summable_shiftInfluence hs t).sum_add_tsum_nat_add t
  simpa only [hfirst, Nat.le_add_left, if_true, Nat.add_sub_cancel, zero_add] using h.symm

/-- The exact total mass of the block influence convolution is `n D`. -/
theorem tsum_pastSumInfluence {d : ℕ → ℝ} (hs : Summable d) (n : ℕ) :
    (∑' i, pastSumInfluence d n i) = (n : ℝ) * ∑' j, d j := by
  unfold pastSumInfluence
  rw [Summable.tsum_finsetSum (fun t _ ↦ summable_shiftInfluence hs t)]
  simp only [tsum_shiftInfluence hs, Finset.sum_const, Finset.card_range, nsmul_eq_mul]

/-- The row/column estimate `∑ cᵢ² ≤ (max cᵢ) ∑ cᵢ ≤ n D²`, in the
finite-cutoff form needed by both deterministic and random influences. -/
theorem sum_sq_pastSumInfluence_le {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n K : ℕ) :
    (∑ i ∈ Finset.range K, pastSumInfluence d n i ^ 2) ≤ (n : ℝ) * (∑' j, d j) ^ 2 := by
  calc
    _ ≤ ∑ i ∈ Finset.range K, (∑' j, d j) * pastSumInfluence d n i := by
      apply Finset.sum_le_sum
      intro i _
      simpa only [pow_two, mul_comm] using
        mul_le_mul_of_nonneg_left (pastSumInfluence_le_tsum hd hs n i)
          (pastSumInfluence_nonneg hd n i)
    _ = (∑' j, d j) * ∑ i ∈ Finset.range K, pastSumInfluence d n i :=
      (Finset.mul_sum _ _ _).symm
    _ ≤ (∑' j, d j) * ((n : ℝ) * ∑' j, d j) :=
      mul_le_mul_of_nonneg_left (sum_pastSumInfluence_le hd hs n K) (tsum_nonneg hd)
    _ = _ := by ring

theorem tsum_sq_pastSumInfluence_le {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n : ℕ) :
    (∑' i, pastSumInfluence d n i ^ 2) ≤ (n : ℝ) * (∑' j, d j) ^ 2 :=
  Real.tsum_le_of_sum_range_le (fun _ ↦ sq_nonneg _) (sum_sq_pastSumInfluence_le hd hs n)

end InfluenceConvolution

section FiniteL2Influence

/-- Real `L²` norm of a finite-product coordinate replacement difference. -/
noncomputable def finiteResamplingL2Norm {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ν : ι → Measure ℝ) (F : (ι → ℝ) → ℝ) (i : ι) : ℝ :=
  (eLpNorm (fun p : (ι → ℝ) × ℝ ↦ F (Function.update p.1 i p.2) - F p.1)
    2 ((Measure.pi ν).prod (ν i))).toReal

theorem finiteResamplingL2Norm_nonneg {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ν : ι → Measure ℝ) (F : (ι → ℝ) → ℝ) (i : ι) :
    0 ≤ finiteResamplingL2Norm ν F i := ENNReal.toReal_nonneg

/-- The random replacement norm and energy interfaces are equivalent in `L²`. -/
theorem finiteResamplingL2Norm_sq {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ν : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (ν i)] {F : (ι → ℝ) → ℝ}
    (hF : MemLp F 2 (Measure.pi ν)) (i : ι) :
    finiteResamplingL2Norm ν F i ^ 2 = finiteResamplingEnergy ν F i :=
  toReal_eLpNorm_two_sq ((memLp_finitePi_resample ν hF i).sub (hF.comp_fst (ν i)))

/-- A random `L²` replacement envelope, uniform over *all* finite zero-fills.
Unlike `HasInfluence`, this imposes no pointwise bound by `|z - x i|`.
The membership field makes the real-valued norms nondegenerate. -/
structure HasFiniteL2Influence (ν : Measure ℝ) (F : Past → ℝ) (w : ℕ → ℝ) (C : ℝ) : Prop where
  memLp_finite : ∀ K, MemLp (finiteApprox F K) 2 (Measure.pi fun _ : Fin K ↦ ν)
  norm_resample_le : ∀ K (i : Fin K),
    finiteResamplingL2Norm (fun _ : Fin K ↦ ν) (finiteApprox F K) i ≤ C * w i

variable {ν : Measure ℝ} [IsProbabilityMeasure ν]
  {R : Past → ℝ} {w : ℕ → ℝ} {C : ℝ}

/-- Construct the random-norm predicate directly from squared-energy bounds. -/
theorem hasFiniteL2Influence_of_energy (hC : 0 ≤ C) (hw : ∀ i, 0 ≤ w i)
    (hfin : ∀ K, MemLp (finiteApprox R K) 2 (Measure.pi fun _ : Fin K ↦ ν))
    (henergy : ∀ K (i : Fin K),
      finiteResamplingEnergy (fun _ : Fin K ↦ ν) (finiteApprox R K) i ≤ C ^ 2 * w i ^ 2) :
    HasFiniteL2Influence ν R w C := by
  refine ⟨hfin, ?_⟩
  intro K i
  apply (sq_le_sq₀ (finiteResamplingL2Norm_nonneg _ _ _) (mul_nonneg hC (hw i))).mp
  rw [finiteResamplingL2Norm_sq _ (hfin K), mul_pow]
  exact henergy K i

theorem HasFiniteL2Influence.energy_le (hR : HasFiniteL2Influence ν R w C)
    (hC : 0 ≤ C) (hw : ∀ i, 0 ≤ w i) (K : ℕ) (i : Fin K) :
    finiteResamplingEnergy (fun _ : Fin K ↦ ν) (finiteApprox R K) i ≤ C ^ 2 * w i ^ 2 := by
  rw [← finiteResamplingL2Norm_sq _ (hR.memLp_finite K), ← mul_pow]
  exact (sq_le_sq₀ (finiteResamplingL2Norm_nonneg _ _ _) (mul_nonneg hC (hw i))).mpr
    (hR.norm_resample_le K i)

/-- A shifted, masked finite observable has the original envelope at the
shifted lag. The finite-tail law handles the mask; no infinite-law estimate
is illicitly applied to a zero-filled input. -/
theorem HasFiniteL2Influence.norm_dropPast_le (hR : HasFiniteL2Influence ν R w C)
    (K t : ℕ) (i : Fin K) :
    finiteResamplingL2Norm (fun _ : Fin K ↦ ν) (finiteApprox (R ∘ dropPast t) K) i ≤
      C * (if t ≤ i then w (i - t) else 0) := by
  by_cases ht : t ≤ i
  · rw [if_pos ht]
    let j : Fin (K - t) := ⟨i - t, by have := i.isLt; omega⟩
    have hchange :
        (fun p : (Fin K → ℝ) × ℝ ↦
          finiteApprox (R ∘ dropPast t) K (Function.update p.1 i p.2) -
            finiteApprox (R ∘ dropPast t) K p.1) =
        (fun p : (Fin (K - t) → ℝ) × ℝ ↦
          finiteApprox R (K - t) (Function.update p.1 j p.2) - finiteApprox R (K - t) p.1) ∘
          Prod.map (finiteTail K t) id := by
      ext p
      simp only [finiteApprox_dropPast, Function.comp_apply, Prod.map_fst, Prod.map_snd, id_eq,
        finiteTail_update_of_le K t p.1 i p.2 ht]
      rfl
    have hmem : MemLp (fun p : (Fin (K - t) → ℝ) × ℝ ↦
        finiteApprox R (K - t) (Function.update p.1 j p.2) - finiteApprox R (K - t) p.1)
        2 ((Measure.pi fun _ : Fin (K - t) ↦ ν).prod ν) :=
      (memLp_finitePi_resample (fun _ : Fin (K - t) ↦ ν) (hR.memLp_finite (K - t)) j).sub
        ((hR.memLp_finite (K - t)).comp_fst ν)
    unfold finiteResamplingL2Norm
    rw [hchange, eLpNorm_comp_measurePreserving hmem.aestronglyMeasurable
      ((measurePreserving_finiteTail ν K t).prod (MeasurePreserving.id ν))]
    exact hR.norm_resample_le (K - t) j
  · have hchange :
        (fun p : (Fin K → ℝ) × ℝ ↦
          finiteApprox (R ∘ dropPast t) K (Function.update p.1 i p.2) -
            finiteApprox (R ∘ dropPast t) K p.1) = 0 := by
      ext p
      simp only [finiteApprox, Function.comp_apply, zeroFill_update,
        dropPast_update_of_lt (zeroFill K p.1) i t p.2 (by omega), sub_self, Pi.zero_apply]
    simp only [if_neg ht, mul_zero, finiteResamplingL2Norm, hchange, eLpNorm_zero,
      ENNReal.toReal_zero, le_refl]

/-- Minkowski combines the masked row replacement norms into the convolution
bound, uniformly in the cutoff. -/
theorem HasFiniteL2Influence.norm_pastSum_le (hR : HasFiniteL2Influence ν R w C)
    (n K : ℕ) (i : Fin K) :
    finiteResamplingL2Norm (fun _ : Fin K ↦ ν) (finiteApprox (pastSum R n) K) i ≤
      C * pastSumInfluence w n i := by
  let f (t : ℕ) (p : (Fin K → ℝ) × ℝ) : ℝ :=
    finiteApprox (R ∘ dropPast t) K (Function.update p.1 i p.2) -
      finiteApprox (R ∘ dropPast t) K p.1
  have hf (t : ℕ) : MemLp (f t) 2 ((Measure.pi fun _ : Fin K ↦ ν).prod ν) := by
    have hmem := memLp_finiteApprox_dropPast ν hR.memLp_finite K t
    exact (memLp_finitePi_resample (fun _ : Fin K ↦ ν) hmem i).sub (hmem.comp_fst ν)
  have hsplit :
      (fun p : (Fin K → ℝ) × ℝ ↦ finiteApprox (pastSum R n) K (Function.update p.1 i p.2) -
        finiteApprox (pastSum R n) K p.1) = fun p ↦ ∑ t ∈ Finset.range n, f t p := by
    ext p
    simp only [finiteApprox_pastSum, ← Finset.sum_sub_distrib, f]
  unfold finiteResamplingL2Norm
  rw [hsplit]
  calc
    _ ≤ ∑ t ∈ Finset.range n, (eLpNorm (f t) 2 ((Measure.pi fun _ : Fin K ↦ ν).prod ν)).toReal :=
      toReal_eLpNorm_sum_le _ (fun t _ ↦ hf t)
    _ ≤ ∑ t ∈ Finset.range n, C * (if t ≤ i then w (i - t) else 0) :=
      Finset.sum_le_sum fun t _ ↦ hR.norm_dropPast_le K t i
    _ = _ := (Finset.mul_sum _ _ _).symm

/-- Uniform finite-input random influences are stable under reversed blocks;
the new envelope is exactly the causal row convolution. -/
theorem HasFiniteL2Influence.pastSum (hR : HasFiniteL2Influence ν R w C) (n : ℕ) :
    HasFiniteL2Influence ν (pastSum R n) (pastSumInfluence w n) C :=
  ⟨memLp_finiteApprox_pastSum ν hR.memLp_finite n, hR.norm_pastSum_le n⟩

end FiniteL2Influence

section PartialSumBounds

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- The square-sum norm bound before passage to infinitely many inputs. -/
theorem toReal_eLpNorm_finiteApprox_le {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (K : ℕ) :
    (eLpNorm (finiteApprox F K) 2 (Measure.pi fun _ : Fin K ↦ ν)).toReal ≤
      Real.sqrt (∫ z, z ^ 2 ∂ν) * Real.sqrt (∑ i : Fin K, d i ^ 2) := by
  rw [toReal_eLpNorm_two_eq_sqrt
    (memLp_finiteApprox_of_hasInfluence ν hnoise hcont hinfl hodd.map_zero K),
    ← Real.sqrt_mul (integral_nonneg fun z ↦ sq_nonneg z)]
  exact Real.sqrt_le_sqrt (integral_sq_finiteApprox_le ν hnoise hν hcont hodd hinfl hd K)

/-- The `ℓ¹` norm bound holds uniformly for every finite zero-fill as well. -/
theorem toReal_eLpNorm_finiteApprox_le_tsum {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (K : ℕ) :
    (eLpNorm (finiteApprox F K) 2 (Measure.pi fun _ : Fin K ↦ ν)).toReal ≤
      Real.sqrt (∫ z, z ^ 2 ∂ν) * ∑' i, d i := by
  refine (toReal_eLpNorm_finiteApprox_le ν hnoise hν hcont hodd hinfl hd K).trans ?_
  apply mul_le_mul_of_nonneg_left _ (Real.sqrt_nonneg _)
  have hsum : (∑ i : Fin K, d i ^ 2) ≤ ∑' i, d i ^ 2 := by
    simpa only [← Fin.sum_univ_eq_sum_range] using
      (summable_sq_of_nonneg hd hs).sum_le_tsum (Finset.range K) (fun i _ ↦ sq_nonneg (d i))
  exact (Real.sqrt_le_sqrt (hsum.trans (tsum_sq_le_sq_tsum hd hs))).trans_eq
    (Real.sqrt_sq (tsum_nonneg hd))

/-- The block squared bound is uniform in the zero-fill cutoff. This is
useful for the finite masked window `W` in residual replacement estimates. -/
theorem integral_sq_finiteApprox_pastSum_le {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n K : ℕ) :
    (∫ x, finiteApprox (pastSum F n) K x ^ 2 ∂Measure.pi (fun _ : Fin K ↦ ν)) ≤
      (∫ z, z ^ 2 ∂ν) * (n : ℝ) * (∑' i, d i) ^ 2 := by
  refine (integral_sq_finiteApprox_le ν hnoise hν (continuous_pastSum hcont n)
    (odd_pastSum hodd n) (hasInfluence_pastSum hinfl n) (pastSumInfluence_nonneg hd n) K).trans ?_
  calc
    _ ≤ (∫ z, z ^ 2 ∂ν) * ((n : ℝ) * (∑' i, d i) ^ 2) := by
      apply mul_le_mul_of_nonneg_left _ (integral_nonneg fun z ↦ sq_nonneg z)
      simpa only [← Fin.sum_univ_eq_sum_range] using sum_sq_pastSumInfluence_le hd hs n K
    _ = _ := by ring

/-- The same finite masked-window estimate in norm form. -/
theorem toReal_eLpNorm_finiteApprox_pastSum_le {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n K : ℕ) :
    (eLpNorm (finiteApprox (pastSum F n) K) 2 (Measure.pi fun _ : Fin K ↦ ν)).toReal ≤
      Real.sqrt (∫ z, z ^ 2 ∂ν) * (∑' i, d i) * Real.sqrt (n : ℝ) := by
  have hmem := memLp_finiteApprox_pastSum ν
    (memLp_finiteApprox_of_hasInfluence ν hnoise hcont hinfl hodd.map_zero) n K
  rw [toReal_eLpNorm_two_eq_sqrt hmem]
  refine (Real.sqrt_le_sqrt (integral_sq_finiteApprox_pastSum_le ν hnoise hν hcont hodd hinfl hd hs n K)).trans_eq ?_
  rw [Real.sqrt_mul (mul_nonneg (integral_nonneg fun z ↦ sq_nonneg z) (Nat.cast_nonneg n)),
    Real.sqrt_mul (integral_nonneg fun z ↦ sq_nonneg z), Real.sqrt_sq (tsum_nonneg hd)]
  ring

/-- The reversed-block bound `E[pastSum²] ≤ σ² n (∑ d)²`. -/
theorem memLp_pastSum_and_integral_sq_le {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n : ℕ) :
    MemLp (pastSum F n) 2 (iidLaw ℕ ν) ∧
      (∫ x, pastSum F n x ^ 2 ∂iidLaw ℕ ν) ≤
        (∫ z, z ^ 2 ∂ν) * (n : ℝ) * (∑' i, d i) ^ 2 := by
  obtain ⟨hmem, hbound⟩ := memLp_two_and_integral_sq_le_of_hasInfluence ν hnoise hν
    (continuous_pastSum hcont n) (odd_pastSum hodd n) (hasInfluence_pastSum hinfl n)
    (pastSumInfluence_nonneg hd n) (summable_pastSumInfluence hd hs n)
  refine ⟨hmem, hbound.trans ?_⟩
  calc
    _ ≤ (∫ z, z ^ 2 ∂ν) * ((n : ℝ) * (∑' i, d i) ^ 2) :=
      mul_le_mul_of_nonneg_left (tsum_sq_pastSumInfluence_le hd hs n)
        (integral_nonneg fun z ↦ sq_nonneg z)
    _ = _ := by ring

/-- The same sharp linear squared bound for the original stationary process. -/
theorem memLp_sumProcess_and_integral_sq_le {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n : ℕ) :
    MemLp (sumProcess F n) 2 (iidLaw ℤ ν) ∧
      (∫ ω, sumProcess F n ω ^ 2 ∂iidLaw ℤ ν) ≤
        (∫ z, z ^ 2 ∂ν) * (n : ℝ) * (∑' i, d i) ^ 2 := by
  obtain ⟨hmem, hbound⟩ := memLp_pastSum_and_integral_sq_le ν hnoise hν hcont hodd hinfl hd hs n
  refine ⟨(identDistrib_sumProcess_pastSum ν hcont.measurable n).memLp_iff.mpr hmem, ?_⟩
  rw [integral_sq_sumProcess_eq_pastSum ν hcont.measurable n]
  exact hbound

/-- The upper `L²` envelope for finite cascade attenuation: `‖Sₙ‖₂ ≤ σ D √n`. -/
theorem toReal_eLpNorm_sumProcess_le {F : Past → ℝ} {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hcont : Continuous F) (hodd : Function.Odd F) (hinfl : HasInfluence F d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (n : ℕ) :
    (eLpNorm (sumProcess F n) 2 (iidLaw ℤ ν)).toReal ≤
      Real.sqrt (∫ z, z ^ 2 ∂ν) * (∑' i, d i) * Real.sqrt (n : ℝ) := by
  obtain ⟨hmem, hbound⟩ := memLp_sumProcess_and_integral_sq_le ν hnoise hν hcont hodd hinfl hd hs n
  rw [toReal_eLpNorm_two_eq_sqrt hmem]
  refine (Real.sqrt_le_sqrt hbound).trans_eq ?_
  rw [Real.sqrt_mul (mul_nonneg (integral_nonneg fun z ↦ sq_nonneg z) (Nat.cast_nonneg n)),
    Real.sqrt_mul (integral_nonneg fun z ↦ sq_nonneg z), Real.sqrt_sq (tsum_nonneg hd)]
  ring

/-- Random replacement-energy version for a residual block. The premises
are on every finite zero-fill of the *whole reversed block*. In particular,
this does not assume a deterministic noise-scaled Lipschitz estimate for the
residual. The `L²` row norm bound `C * pastSumInfluence w n i` is exactly the
squared-energy premise below. -/
theorem memLp_pastSum_and_integral_sq_le_of_finiteEnergy
    {R : Past → ℝ} {w : ℕ → ℝ} {C : ℝ}
    (hν : SymmetricLaw ν) (hcont : Continuous R) (hodd : Function.Odd R)
    (hw : ∀ i, 0 ≤ w i) (hs : Summable w) (n : ℕ)
    (hfin : ∀ K, MemLp (finiteApprox (pastSum R n) K) 2 (Measure.pi fun _ : Fin K ↦ ν))
    (henergy : ∀ K (i : Fin K),
      finiteResamplingEnergy (fun _ : Fin K ↦ ν) (finiteApprox (pastSum R n) K) i ≤
        C ^ 2 * pastSumInfluence w n i ^ 2) :
    MemLp (pastSum R n) 2 (iidLaw ℕ ν) ∧
      (∫ x, pastSum R n x ^ 2 ∂iidLaw ℕ ν) ≤
        (1 / 2 : ℝ) * C ^ 2 * (n : ℝ) * (∑' i, w i) ^ 2 := by
  apply memLp_two_and_integral_sq_le_of_finiteEnergy ν hν
    (continuous_pastSum hcont n) (odd_pastSum hodd n) hfin
  intro K
  calc
    _ ≤ (1 / 2 : ℝ) * ∑ i : Fin K, C ^ 2 * pastSumInfluence w n i ^ 2 := by
      gcongr with i
      exact henergy K i
    _ = (1 / 2 : ℝ) * C ^ 2 * ∑ i : Fin K, pastSumInfluence w n i ^ 2 := by
      rw [← Finset.mul_sum, mul_assoc]
    _ ≤ (1 / 2 : ℝ) * C ^ 2 * ((n : ℝ) * (∑' i, w i) ^ 2) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      simpa only [← Fin.sum_univ_eq_sum_range] using sum_sq_pastSumInfluence_le hw hs n K
    _ = _ := by ring

/-- Transfer of the residual finite-energy bound to the forward-time process. -/
theorem memLp_sumProcess_and_integral_sq_le_of_finiteEnergy
    {R : Past → ℝ} {w : ℕ → ℝ} {C : ℝ}
    (hν : SymmetricLaw ν) (hcont : Continuous R) (hodd : Function.Odd R)
    (hw : ∀ i, 0 ≤ w i) (hs : Summable w) (n : ℕ)
    (hfin : ∀ K, MemLp (finiteApprox (pastSum R n) K) 2 (Measure.pi fun _ : Fin K ↦ ν))
    (henergy : ∀ K (i : Fin K),
      finiteResamplingEnergy (fun _ : Fin K ↦ ν) (finiteApprox (pastSum R n) K) i ≤
        C ^ 2 * pastSumInfluence w n i ^ 2) :
    MemLp (sumProcess R n) 2 (iidLaw ℤ ν) ∧
      (∫ ω, sumProcess R n ω ^ 2 ∂iidLaw ℤ ν) ≤
        (1 / 2 : ℝ) * C ^ 2 * (n : ℝ) * (∑' i, w i) ^ 2 := by
  obtain ⟨hmem, hbound⟩ := memLp_pastSum_and_integral_sq_le_of_finiteEnergy ν hν hcont hodd hw hs n hfin henergy
  refine ⟨(identDistrib_sumProcess_pastSum ν hcont.measurable n).memLp_iff.mpr hmem, ?_⟩
  rw [integral_sq_sumProcess_eq_pastSum ν hcont.measurable n]
  exact hbound

/-- Norm version of the residual block-energy theorem. We drop the favorable
factor `1/√2` to give the simple upper envelope `C (∑ w) √n`. -/
theorem toReal_eLpNorm_sumProcess_le_of_finiteEnergy
    {R : Past → ℝ} {w : ℕ → ℝ} {C : ℝ}
    (hν : SymmetricLaw ν) (hcont : Continuous R) (hodd : Function.Odd R)
    (hC : 0 ≤ C) (hw : ∀ i, 0 ≤ w i) (hs : Summable w) (n : ℕ)
    (hfin : ∀ K, MemLp (finiteApprox (pastSum R n) K) 2 (Measure.pi fun _ : Fin K ↦ ν))
    (henergy : ∀ K (i : Fin K),
      finiteResamplingEnergy (fun _ : Fin K ↦ ν) (finiteApprox (pastSum R n) K) i ≤
        C ^ 2 * pastSumInfluence w n i ^ 2) :
    (eLpNorm (sumProcess R n) 2 (iidLaw ℤ ν)).toReal ≤
      C * (∑' i, w i) * Real.sqrt (n : ℝ) := by
  obtain ⟨hmem, hbound⟩ := memLp_sumProcess_and_integral_sq_le_of_finiteEnergy ν hν hcont hodd hw hs n hfin henergy
  rw [toReal_eLpNorm_two_eq_sqrt hmem]
  apply Real.sqrt_le_iff.mpr
  refine ⟨mul_nonneg (mul_nonneg hC (tsum_nonneg hw)) (Real.sqrt_nonneg _), ?_⟩
  calc
    _ ≤ (1 / 2 : ℝ) * C ^ 2 * (n : ℝ) * (∑' i, w i) ^ 2 := hbound
    _ ≤ C ^ 2 * (n : ℝ) * (∑' i, w i) ^ 2 := by
      have : 0 ≤ C ^ 2 * (n : ℝ) * (∑' i, w i) ^ 2 := by positivity
      nlinarith
    _ = _ := by rw [mul_pow, mul_pow, Real.sq_sqrt (Nat.cast_nonneg n)]; ring

/-- Single-observable random `L²` influence inequality. -/
theorem memLp_two_and_integral_sq_le_of_hasFiniteL2Influence
    {R : Past → ℝ} {w : ℕ → ℝ} {C : ℝ}
    (hν : SymmetricLaw ν) (hcont : Continuous R) (hodd : Function.Odd R)
    (hR : HasFiniteL2Influence ν R w C) (hC : 0 ≤ C)
    (hw : ∀ i, 0 ≤ w i) (hs : Summable w) :
    MemLp R 2 (iidLaw ℕ ν) ∧
      (∫ x, R x ^ 2 ∂iidLaw ℕ ν) ≤ (1 / 2 : ℝ) * C ^ 2 * ∑' i, w i ^ 2 := by
  apply memLp_two_and_integral_sq_le_of_finiteEnergy ν hν hcont hodd hR.memLp_finite
  intro K
  calc
    _ ≤ (1 / 2 : ℝ) * ∑ i : Fin K, C ^ 2 * w i ^ 2 := by
      gcongr with i
      exact hR.energy_le hC hw K i
    _ = (1 / 2 : ℝ) * C ^ 2 * ∑ i : Fin K, w i ^ 2 := by
      rw [← Finset.mul_sum, mul_assoc]
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      simpa only [← Fin.sum_univ_eq_sum_range] using
        (summable_sq_of_nonneg hw hs).sum_le_tsum (Finset.range K) (fun i _ ↦ sq_nonneg (w i))

/-- A random replacement envelope for every finite zero-fill of `R` suffices:
masking and Minkowski automatically provide the block's row-energy bounds. -/
theorem memLp_pastSum_and_integral_sq_le_of_hasFiniteL2Influence
    {R : Past → ℝ} {w : ℕ → ℝ} {C : ℝ}
    (hν : SymmetricLaw ν) (hcont : Continuous R) (hodd : Function.Odd R)
    (hR : HasFiniteL2Influence ν R w C) (hC : 0 ≤ C)
    (hw : ∀ i, 0 ≤ w i) (hs : Summable w) (n : ℕ) :
    MemLp (pastSum R n) 2 (iidLaw ℕ ν) ∧
      (∫ x, pastSum R n x ^ 2 ∂iidLaw ℕ ν) ≤
        (1 / 2 : ℝ) * C ^ 2 * (n : ℝ) * (∑' i, w i) ^ 2 :=
  memLp_pastSum_and_integral_sq_le_of_finiteEnergy ν hν hcont hodd hw hs n
    (hR.pastSum n).memLp_finite ((hR.pastSum n).energy_le hC (pastSumInfluence_nonneg hw n))

/-- The random replacement bound for forward stationary sums. It requires
no noise moment assumption beyond the supplied finite random `L²` bounds. -/
theorem memLp_sumProcess_and_integral_sq_le_of_hasFiniteL2Influence
    {R : Past → ℝ} {w : ℕ → ℝ} {C : ℝ}
    (hν : SymmetricLaw ν) (hcont : Continuous R) (hodd : Function.Odd R)
    (hR : HasFiniteL2Influence ν R w C) (hC : 0 ≤ C)
    (hw : ∀ i, 0 ≤ w i) (hs : Summable w) (n : ℕ) :
    MemLp (sumProcess R n) 2 (iidLaw ℤ ν) ∧
      (∫ ω, sumProcess R n ω ^ 2 ∂iidLaw ℤ ν) ≤
        (1 / 2 : ℝ) * C ^ 2 * (n : ℝ) * (∑' i, w i) ^ 2 :=
  memLp_sumProcess_and_integral_sq_le_of_finiteEnergy ν hν hcont hodd hw hs n
    (hR.pastSum n).memLp_finite ((hR.pastSum n).energy_le hC (pastSumInfluence_nonneg hw n))

/-- The residual upper envelope used in finite cascade attenuation. -/
theorem toReal_eLpNorm_sumProcess_le_of_hasFiniteL2Influence
    {R : Past → ℝ} {w : ℕ → ℝ} {C : ℝ}
    (hν : SymmetricLaw ν) (hcont : Continuous R) (hodd : Function.Odd R)
    (hR : HasFiniteL2Influence ν R w C) (hC : 0 ≤ C)
    (hw : ∀ i, 0 ≤ w i) (hs : Summable w) (n : ℕ) :
    (eLpNorm (sumProcess R n) 2 (iidLaw ℤ ν)).toReal ≤ C * (∑' i, w i) * Real.sqrt (n : ℝ) :=
  toReal_eLpNorm_sumProcess_le_of_finiteEnergy ν hν hcont hodd hC hw hs n
    (hR.pastSum n).memLp_finite ((hR.pastSum n).energy_le hC (pastSumInfluence_nonneg hw n))

end PartialSumBounds

end Cascade
end


/- Supporting development: Cascade.InfluenceEnvelope -/
section
set_option autoImplicit false

/-
# Summability and mass of the controller influence envelope

This file concerns the *recursive* `Controller.influenceEnvelope`, not a
replacement convolution definition. Bounded partial sums give summability;
only then do we sum the recurrence, using the exact mass of each finite delay.
All statements are deterministic and independent of an innovation law.
-/

namespace Cascade.Controller

private theorem sum_range_delay (f : ℕ → ℝ) (m n : ℕ) :
    (∑ k ∈ Finset.range n, if m ≤ k then f (k - m) else 0) =
      ∑ k ∈ Finset.range (n - m), f k := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ, ih]
    by_cases hm : m ≤ n
    · rw [if_pos hm, show n + 1 - m = (n - m) + 1 by omega,
        Finset.sum_range_succ]
    · have hn : n - m = 0 := by omega
      have hn' : n + 1 - m = 0 := by omega
      simp [hm, hn, hn']

private theorem summable_delay {f : ℕ → ℝ} (hf : Summable f) (m : ℕ) :
    Summable (fun k ↦ if m ≤ k then f (k - m) else 0) := by
  apply (summable_nat_add_iff m).mp
  simpa using hf

private theorem tsum_delay {f : ℕ → ℝ} (hf : Summable f) (m : ℕ) :
    (∑' k, if m ≤ k then f (k - m) else 0) = ∑' k, f k := by
  have h := (summable_delay hf m).sum_add_tsum_nat_add m
  have hz : (∑ k ∈ Finset.range m, if m ≤ k then f (k - m) else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro k hk
    simp [not_le.mpr (Finset.mem_range.mp hk)]
  rw [hz, zero_add] at h
  simpa using h.symm

/-- The exact renewal recurrence for cumulative masses. Every delayed partial
sum on the right is strictly shorter when `n > 0`. -/
theorem sum_range_influenceEnvelope_eq (c : Params) (d : ℕ → ℝ) (n : ℕ) :
    (∑ k ∈ Finset.range n, influenceEnvelope c d k) =
      (∑ k ∈ Finset.range n, d k) + c.a *
        ∑ j ∈ Finset.range c.N,
          ∑ k ∈ Finset.range (n - (j + 1)), influenceEnvelope c d k := by
  calc
    _ = ∑ k ∈ Finset.range n, (d k + c.a *
        ∑ j ∈ Finset.range c.N,
          if j + 1 ≤ k then influenceEnvelope c d (k - (j + 1)) else 0) :=
      Finset.sum_congr rfl fun k _ ↦ influenceEnvelope_eq c d k
    _ = (∑ k ∈ Finset.range n, d k) + c.a *
        ∑ j ∈ Finset.range c.N, ∑ k ∈ Finset.range n,
          if j + 1 ≤ k then influenceEnvelope c d (k - (j + 1)) else 0 := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_comm]
    _ = _ := by simp_rw [sum_range_delay]

/-- Nonnegative summable forcing gives a uniform bound on every partial mass
of the recursively defined influence envelope. -/
theorem sum_range_influenceEnvelope_le (c : Params) {d : ℕ → ℝ}
    (hd : ∀ k, 0 ≤ d k) (hs : Summable d) (n : ℕ) :
    (∑ k ∈ Finset.range n, influenceEnvelope c d k) ≤
      (∑' k, d k) / (1 - (c.gain : ℝ)) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | n
    · simpa using div_nonneg (tsum_nonneg hd) c.one_sub_gain_pos.le
    · rw [sum_range_influenceEnvelope_eq]
      calc
        _ ≤ (∑' k, d k) + c.a *
            ∑ _j ∈ Finset.range c.N, (∑' k, d k) / (1 - (c.gain : ℝ)) := by
          apply add_le_add (hs.sum_le_tsum _ (fun k _ ↦ hd k))
          apply mul_le_mul_of_nonneg_left _ c.a_nonneg
          exact Finset.sum_le_sum fun j _ ↦ ih (n + 1 - (j + 1)) (by omega)
        _ = (∑' k, d k) + (c.gain : ℝ) *
            ((∑' k, d k) / (1 - (c.gain : ℝ))) := by
          simp [Params.coe_gain, mul_assoc]
        _ = (∑' k, d k) / (1 - (c.gain : ℝ)) := by
          have hcancel := div_mul_cancel₀ (∑' k, d k) c.one_sub_gain_pos.ne'
          linarith

/-- A weak controller preserves summability of nonnegative deterministic
influence envelopes. -/
theorem summable_influenceEnvelope (c : Params) {d : ℕ → ℝ}
    (hd : ∀ k, 0 ≤ d k) (hs : Summable d) :
    Summable (influenceEnvelope c d) :=
  summable_of_sum_range_le (influenceEnvelope_nonneg c hd)
    (sum_range_influenceEnvelope_le c hd hs)

/-- The exact total influence mass, including the resolvent factor `1/(1-g)`.
The proof sums the recurrence only after establishing summability. -/
theorem tsum_influenceEnvelope (c : Params) {d : ℕ → ℝ}
    (hd : ∀ k, 0 ≤ d k) (hs : Summable d) :
    (∑' k, influenceEnvelope c d k) = (∑' k, d k) / (1 - (c.gain : ℝ)) := by
  have he := summable_influenceEnvelope c hd hs
  have hdelay : ∀ j ∈ Finset.range c.N, Summable (fun k ↦
      if j + 1 ≤ k then influenceEnvelope c d (k - (j + 1)) else 0) :=
    fun j _ ↦ summable_delay he (j + 1)
  have hsum := summable_sum hdelay
  have hmass : (∑' k, influenceEnvelope c d k) =
      (∑' k, d k) + (c.gain : ℝ) * (∑' k, influenceEnvelope c d k) := by
    calc
      _ = ∑' k, (d k + c.a * ∑ j ∈ Finset.range c.N,
          if j + 1 ≤ k then influenceEnvelope c d (k - (j + 1)) else 0) :=
        tsum_congr fun k ↦ influenceEnvelope_eq c d k
      _ = (∑' k, d k) + c.a * (∑ j ∈ Finset.range c.N,
          ∑' k, if j + 1 ≤ k then influenceEnvelope c d (k - (j + 1)) else 0) := by
        rw [hs.tsum_add (hsum.mul_left c.a), tsum_mul_left,
          Summable.tsum_finsetSum hdelay]
      _ = _ := by simp_rw [tsum_delay he]; simp [Params.coe_gain, mul_assoc]
  apply (eq_div_iff c.one_sub_gain_pos.ne').mpr
  linarith

/-- `HasSum` form of the exact mass formula. -/
theorem hasSum_influenceEnvelope (c : Params) {d : ℕ → ℝ}
    (hd : ∀ k, 0 ≤ d k) (hs : Summable d) :
    HasSum (influenceEnvelope c d) ((∑' k, d k) / (1 - (c.gain : ℝ))) := by
  rw [← tsum_influenceEnvelope c hd hs]
  exact (summable_influenceEnvelope c hd hs).hasSum

/-- The pointwise influence theorem together with all the analytic properties
of its explicit envelope. No almost-everywhere qualifications are involved. -/
theorem factor_update_hasInfluence_summable (c : Params) (oldK : Correction)
    {d : ℕ → ℝ} (hold : HasInfluence (factor oldK) d)
    (hd : ∀ k, 0 ≤ d k) (hs : Summable d) :
    HasInfluence (factor (update c oldK)) (influenceEnvelope c d) ∧
      (∀ k, 0 ≤ influenceEnvelope c d k) ∧
      Summable (influenceEnvelope c d) ∧
      (∑' k, influenceEnvelope c d k) = (∑' k, d k) / (1 - (c.gain : ℝ)) :=
  ⟨factor_update_hasInfluence c oldK hold, influenceEnvelope_nonneg c hd,
    summable_influenceEnvelope c hd hs, tsum_influenceEnvelope c hd hs⟩

end Cascade.Controller
end


/- Supporting development: Cascade.Residual -/
section
set_option autoImplicit false

/-
# Quantitative saturation residuals with only second moments

The large-replacement term is an actual `L²` tail of the difference of two
independent innovations. The small-replacement term uses a uniform `L²` bound
for every finite zero-filled window, including its independently resampled
version. No higher moments or infinite-input resampling assumptions are used.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace Cascade

section RealL2Norm

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}

/-- Minkowski in real-valued norm form, with finiteness explicitly checked. -/
theorem toReal_eLpNorm_add_le {f g : α → ℝ}
    (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) :
    (eLpNorm (fun x ↦ f x + g x) 2 μ).toReal ≤
      (eLpNorm f 2 μ).toReal + (eLpNorm g 2 μ).toReal := by
  have h := ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨hf.2.ne, hg.2.ne⟩)
    (eLpNorm_add_le hf.aestronglyMeasurable hg.aestronglyMeasurable
      (by norm_num : (1 : ℝ≥0∞) ≤ 2))
  simpa only [ENNReal.toReal_add hf.2.ne hg.2.ne] using h

theorem toReal_eLpNorm_const_mul (a : ℝ) (f : α → ℝ) :
    (eLpNorm (fun x ↦ a * f x) 2 μ).toReal = |a| * (eLpNorm f 2 μ).toReal := by
  change (eLpNorm (a • f) 2 μ).toReal = _
  rw [eLpNorm_const_smul, ENNReal.toReal_mul]
  simp [Real.norm_eq_abs]

theorem toReal_eLpNorm_abs (f : α → ℝ) :
    (eLpNorm (fun x ↦ |f x|) 2 μ).toReal = (eLpNorm f 2 μ).toReal := by
  simpa only [Real.norm_eq_abs] using congrArg ENNReal.toReal (eLpNorm_norm (p := 2) (μ := μ) f)

/-- Monotonicity needs finiteness of the majorant, not merely the convention
`∞.toReal = 0`. -/
theorem toReal_eLpNorm_mono {f g : α → ℝ} (hg : MemLp g 2 μ)
    (h : ∀ x, |f x| ≤ |g x|) :
    (eLpNorm f 2 μ).toReal ≤ (eLpNorm g 2 μ).toReal :=
  ENNReal.toReal_mono hg.2.ne (eLpNorm_mono (by simpa only [Real.norm_eq_abs] using h))

end RealL2Norm

/-- Nonnegative large-replacement tail, on two independent innovation values. -/
noncomputable def noiseTail (L : ℝ) : ℝ × ℝ → ℝ :=
  {p : ℝ × ℝ | L < |p.2 - p.1|}.indicator (fun p ↦ |p.2 - p.1|)

@[simp] theorem noiseTail_apply (L : ℝ) (p : ℝ × ℝ) :
    noiseTail L p = if L < |p.2 - p.1| then |p.2 - p.1| else 0 := by
  classical
  rfl

theorem noiseTail_nonneg (L : ℝ) (p : ℝ × ℝ) : 0 ≤ noiseTail L p := by
  rw [noiseTail_apply]
  split_ifs <;> positivity

theorem noiseTail_le (L : ℝ) (p : ℝ × ℝ) : noiseTail L p ≤ |p.2 - p.1| := by
  rw [noiseTail_apply]
  split_ifs <;> simp [abs_nonneg]

@[fun_prop] theorem measurable_noiseTail (L : ℝ) : Measurable (noiseTail L) :=
  (measurable_snd.sub measurable_fst).abs.indicator
    (measurableSet_lt measurable_const (measurable_snd.sub measurable_fst).abs)

/-- The noise-tail modulus. Absolute values inside the indicator do not change
its `L²` norm compared with the signed innovation difference. -/
noncomputable def noiseTailL2 (ν : Measure ℝ) (L : ℝ) : ℝ :=
  (eLpNorm (noiseTail L) 2 (ν.prod ν)).toReal

theorem noiseTailL2_nonneg (ν : Measure ℝ) (L : ℝ) : 0 ≤ noiseTailL2 ν L :=
  ENNReal.toReal_nonneg

section NoiseTail

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

theorem memLp_noiseTail (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (L : ℝ) :
    MemLp (noiseTail L) 2 (ν.prod ν) :=
  ((hnoise.comp_snd ν).sub (hnoise.comp_fst ν)).abs.indicator
    (measurableSet_lt measurable_const (measurable_snd.sub measurable_fst).abs)

/-- Second moments alone make the replacement-tail modulus tend to zero.
This is dominated convergence for the squared innovation difference. -/
theorem tendsto_noiseTailL2 (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) :
    Tendsto (noiseTailL2 ν) atTop (𝓝 0) := by
  have hdiff : MemLp (fun p : ℝ × ℝ ↦ p.2 - p.1) 2 (ν.prod ν) :=
    (hnoise.comp_snd ν).sub (hnoise.comp_fst ν)
  have hint : Tendsto (fun L : ℝ ↦ ∫ p, noiseTail L p ^ 2 ∂ν.prod ν) atTop (𝓝 0) := by
    have h := tendsto_integral_filter_of_dominated_convergence
      (μ := ν.prod ν) (l := (atTop : Filter ℝ))
      (F := fun L p ↦ noiseTail L p ^ 2) (f := fun _ ↦ (0 : ℝ))
      (fun p : ℝ × ℝ ↦ (p.2 - p.1) ^ 2)
      (Eventually.of_forall fun L ↦ ((memLp_noiseTail ν hnoise L).aestronglyMeasurable.pow 2))
      (Eventually.of_forall fun L ↦ ae_of_all _ fun p ↦ ?_)
      hdiff.integrable_sq (ae_of_all _ fun p ↦ ?_)
    · simpa only [integral_zero] using h
    · dsimp only
      rw [Real.norm_eq_abs, abs_sq, ← sq_abs (p.2 - p.1)]
      exact (sq_le_sq₀ (noiseTail_nonneg L p) (abs_nonneg _)).mpr (noiseTail_le L p)
    · apply tendsto_const_nhds.congr'
      filter_upwards [eventually_ge_atTop |p.2 - p.1|] with L hL
      simp [not_lt.mpr hL]
  have hsqrt := Real.continuous_sqrt.continuousAt.tendsto.comp hint
  change Tendsto (fun L ↦ noiseTailL2 ν L) atTop (𝓝 0)
  simp_rw [noiseTailL2, toReal_eLpNorm_two_eq_sqrt (memLp_noiseTail ν hnoise _)]
  simpa only [Real.sqrt_zero, Function.comp_def] using hsqrt

/-- A strictly positive truncation level with arbitrarily small replacement
`L²` tail. In particular no fourth moment is required. -/
theorem exists_noiseTailL2_le (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν)
    {ε : ℝ} (hε : 0 < ε) : ∃ L : ℝ, 0 < L ∧ noiseTailL2 ν L ≤ ε := by
  have h := (tendsto_order.mp (tendsto_noiseTailL2 ν hnoise)).2 ε hε
  obtain ⟨L, hL, htail⟩ := ((eventually_gt_atTop (0 : ℝ)).and h).exists
  exact ⟨L, hL, htail.le⟩

end NoiseTail

/-- The pointwise split into large innovation replacements and small
replacements with a large window. It is valid also when the influence is zero. -/
theorem abs_clipResidual_sub_le_tail {s w L u v δ : ℝ}
    (hs : 0 < s) (hw : 0 ≤ w) (hL : 0 ≤ L) (huv : |u - v| ≤ w * |δ|) :
    |clipResidual s u - clipResidual s v| ≤
      w * ((if L < |δ| then |δ| else 0) + (L / s) * (|u| + |v|)) := by
  by_cases hlarge : L < |δ|
  · rw [if_pos hlarge]
    refine (abs_clipResidual_sub_le s u v).trans (huv.trans ?_)
    exact mul_le_mul_of_nonneg_left
      (le_add_of_nonneg_right (mul_nonneg (div_nonneg hL hs.le)
        (add_nonneg (abs_nonneg _) (abs_nonneg _)))) hw
  · rw [if_neg hlarge, zero_add]
    calc
      _ ≤ |u - v| * ((|u| + |v|) / s) := abs_clipResidual_sub_le_mul hs u v
      _ ≤ (w * |δ|) * ((|u| + |v|) / s) :=
        mul_le_mul_of_nonneg_right huv (by positivity)
      _ ≤ (w * L) * ((|u| + |v|) / s) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (le_of_not_gt hlarge) hw)
          (by positivity)
      _ = _ := by ring

section FiniteResidual

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

omit [IsProbabilityMeasure ν] in
/-- Saturation residuals of square-integrable finite windows remain in `L²`.
The clamp residual is bounded by the window itself, not by a higher moment. -/
theorem memLp_finiteApprox_scaled_clipResidual {W : Past → ℝ} {s : ℝ}
    (hcont : Continuous W) (hs : 0 ≤ s)
    (hfin : ∀ K, MemLp (finiteApprox W K) 2 (Measure.pi fun _ : Fin K ↦ ν))
    (a : ℝ) (K : ℕ) :
    MemLp (finiteApprox (fun x ↦ a * clipResidual s (W x)) K) 2
      (Measure.pi fun _ : Fin K ↦ ν) := by
  have hmem : MemLp (fun x ↦ clipResidual s (finiteApprox W K x)) 2
      (Measure.pi fun _ : Fin K ↦ ν) := by
    apply (hfin K).abs.mono'
      ((continuous_clipResidual s).comp (continuous_finiteApprox hcont K)).aestronglyMeasurable
    exact ae_of_all _ fun x ↦ by
      simpa only [Real.norm_eq_abs] using abs_clipResidual_le hs (finiteApprox W K x)
  exact hmem.const_mul a

/-- A uniform finite-window norm bound gives the quantitative random influence
constant `a (q(L) + 2 L B / s)`. The resampled window has the *finite-product*
law of the original window; an infinite-law bound is never substituted here. -/
theorem hasFiniteL2Influence_scaled_clipResidual {W : Past → ℝ} {w : ℕ → ℝ}
    {a s L B : ℝ} (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν)
    (hcont : Continuous W) (hinfl : HasInfluence W w) (hw : ∀ i, 0 ≤ w i)
    (ha : 0 ≤ a) (hs : 0 < s) (hL : 0 ≤ L)
    (hfin : ∀ K, MemLp (finiteApprox W K) 2 (Measure.pi fun _ : Fin K ↦ ν))
    (hbound : ∀ K, (eLpNorm (finiteApprox W K) 2
      (Measure.pi fun _ : Fin K ↦ ν)).toReal ≤ B) :
    HasFiniteL2Influence ν (fun x ↦ a * clipResidual s (W x)) w
      (a * (noiseTailL2 ν L + 2 * L * B / s)) := by
  refine ⟨memLp_finiteApprox_scaled_clipResidual ν hcont hs.le hfin a, ?_⟩
  intro K i
  let μ := Measure.pi (fun _ : Fin K ↦ ν)
  let U := finiteApprox W K
  let V : (Fin K → ℝ) × ℝ → ℝ := fun p ↦ U (Function.update p.1 i p.2)
  let U₀ : (Fin K → ℝ) × ℝ → ℝ := fun p ↦ U p.1
  let T : (Fin K → ℝ) × ℝ → ℝ := fun p ↦ noiseTail L (p.1 i, p.2)
  have hU : MemLp U 2 μ := hfin K
  have hV : MemLp V 2 (μ.prod ν) := memLp_finitePi_resample _ hU i
  have hU₀ : MemLp U₀ 2 (μ.prod ν) := hU.comp_fst ν
  have hpair : MeasurePreserving (fun p : (Fin K → ℝ) × ℝ ↦ (p.1 i, p.2))
      (μ.prod ν) (ν.prod ν) :=
    (measurePreserving_eval (fun _ : Fin K ↦ ν) i).prod (MeasurePreserving.id ν)
  have hT : MemLp T 2 (μ.prod ν) :=
    (memLp_noiseTail ν hnoise L).comp_measurePreserving hpair
  have hTnorm : (eLpNorm T 2 (μ.prod ν)).toReal = noiseTailL2 ν L := by
    exact congrArg ENNReal.toReal
      (eLpNorm_comp_measurePreserving (memLp_noiseTail ν hnoise L).aestronglyMeasurable hpair)
  have hVnorm : (eLpNorm V 2 (μ.prod ν)).toReal = (eLpNorm U 2 μ).toReal := by
    exact congrArg ENNReal.toReal (eLpNorm_comp_measurePreserving hU.aestronglyMeasurable
      (finitePi_resample_measurePreserving (fun _ : Fin K ↦ ν) i))
  have hU₀norm : (eLpNorm U₀ 2 (μ.prod ν)).toReal = (eLpNorm U 2 μ).toReal := by
    exact congrArg ENNReal.toReal
      (eLpNorm_comp_measurePreserving hU.aestronglyMeasurable measurePreserving_fst)
  let H : (Fin K → ℝ) × ℝ → ℝ := fun p ↦ T p + (L / s) * (|V p| + |U₀ p|)
  have hH : MemLp H 2 (μ.prod ν) := hT.add ((hV.abs.add hU₀.abs).const_mul (L / s))
  have hHnorm : (eLpNorm H 2 (μ.prod ν)).toReal ≤ noiseTailL2 ν L + 2 * L * B / s := by
    calc
      _ ≤ (eLpNorm T 2 (μ.prod ν)).toReal +
          (eLpNorm (fun p ↦ (L / s) * (|V p| + |U₀ p|)) 2 (μ.prod ν)).toReal :=
        toReal_eLpNorm_add_le hT ((hV.abs.add hU₀.abs).const_mul (L / s))
      _ = noiseTailL2 ν L + (L / s) *
          (eLpNorm (fun p ↦ |V p| + |U₀ p|) 2 (μ.prod ν)).toReal := by
        rw [hTnorm, toReal_eLpNorm_const_mul, abs_of_nonneg (div_nonneg hL hs.le)]
      _ ≤ noiseTailL2 ν L + (L / s) *
          ((eLpNorm (fun p ↦ |V p|) 2 (μ.prod ν)).toReal +
            (eLpNorm (fun p ↦ |U₀ p|) 2 (μ.prod ν)).toReal) :=
        add_le_add le_rfl (mul_le_mul_of_nonneg_left
          (toReal_eLpNorm_add_le hV.abs hU₀.abs) (div_nonneg hL hs.le))
      _ = noiseTailL2 ν L + (L / s) * (2 * (eLpNorm U 2 μ).toReal) := by
        rw [toReal_eLpNorm_abs, toReal_eLpNorm_abs, hVnorm, hU₀norm]
        ring
      _ ≤ noiseTailL2 ν L + (L / s) * (2 * B) := by
        gcongr
        exact hbound K
      _ = _ := by ring
  let M : (Fin K → ℝ) × ℝ → ℝ := fun p ↦ (a * w i) * H p
  have hM : MemLp M 2 (μ.prod ν) := hH.const_mul (a * w i)
  have hpoint (p : (Fin K → ℝ) × ℝ) :
      |finiteApprox (fun x ↦ a * clipResidual s (W x)) K (Function.update p.1 i p.2) -
        finiteApprox (fun x ↦ a * clipResidual s (W x)) K p.1| ≤ |M p| := by
    change |a * clipResidual s (V p) - a * clipResidual s (U₀ p)| ≤ _
    rw [← mul_sub, abs_mul, abs_of_nonneg ha]
    calc
      _ ≤ a * (w i * ((if L < |p.2 - p.1 i| then |p.2 - p.1 i| else 0) +
          (L / s) * (|V p| + |U₀ p|))) :=
        mul_le_mul_of_nonneg_left (abs_clipResidual_sub_le_tail hs (hw i) hL
          (finiteApprox_hasInfluence hinfl K p.1 i p.2)) ha
      _ = M p := by simp only [M, H, T, noiseTail_apply]; ring
      _ ≤ |M p| := le_abs_self _
  calc
    _ ≤ (eLpNorm M 2 (μ.prod ν)).toReal := toReal_eLpNorm_mono hM hpoint
    _ = (a * w i) * (eLpNorm H 2 (μ.prod ν)).toReal := by
      exact (toReal_eLpNorm_const_mul (a * w i) H).trans
        (by rw [abs_of_nonneg (mul_nonneg ha (hw i))])
    _ ≤ (a * w i) * (noiseTailL2 ν L + 2 * L * B / s) :=
      mul_le_mul_of_nonneg_left hHnorm (mul_nonneg ha (hw i))
    _ = _ := by ring

end FiniteResidual

/-- A deterministic influence envelope shifts with a dropped history. -/
theorem hasInfluence_dropPast {F : Past → ℝ} {d : ℕ → ℝ}
    (hF : HasInfluence F d) (t : ℕ) :
    HasInfluence (F ∘ dropPast t) (fun i ↦ if t ≤ i then d (i - t) else 0) := by
  intro x i z
  by_cases ht : t ≤ i
  · simp only [Function.comp_apply, if_pos ht, dropPast_update_of_le x i t z ht]
    simpa only [dropPast, Nat.sub_add_cancel ht] using hF (dropPast t x) (i - t) z
  · simp only [Function.comp_apply, if_neg ht,
      dropPast_update_of_lt x i t z (by omega), sub_self, abs_zero, zero_mul, le_refl]

namespace Controller

/-- The actual window of the new factor, with strict lags `1, ..., N`. -/
noncomputable def outputWindow (c : Params) (oldK : Correction) : Past → ℝ :=
  pastSum (factor (update c oldK)) c.N ∘ dropPast 1

theorem outputWindow_eq_sum (c : Params) (oldK : Correction) (x : Past) :
    outputWindow c oldK x =
      ∑ j ∈ Finset.range c.N, factor (update c oldK) (dropPast (j + 1) x) := by
  simp only [outputWindow, Function.comp_apply, pastSum, dropPast_dropPast]

@[fun_prop] theorem continuous_outputWindow (c : Params) (oldK : Correction) :
    Continuous (outputWindow c oldK) :=
  (continuous_pastSum (continuous_factor (update c oldK)) c.N).comp (continuous_dropPast 1)

theorem outputWindow_odd (c : Params) (oldK : Correction)
    (hodd : Function.Odd (oldK : Past → ℝ)) : Function.Odd (outputWindow c oldK) := by
  intro x
  change pastSum (factor (update c oldK)) c.N (dropPast 1 (-x)) = _
  rw [dropPast_neg]
  exact odd_pastSum (factor_update_odd c oldK hodd) c.N (dropPast 1 x)

/-- The nonnegative deterministic window envelope, as a one-step-shifted block
convolution of the new factor's renewal envelope. -/
noncomputable def windowInfluence (c : Params) (d : ℕ → ℝ) (i : ℕ) : ℝ :=
  if 1 ≤ i then pastSumInfluence (influenceEnvelope c d) c.N (i - 1) else 0

/-- Explicit strict-lag form of the window envelope. -/
theorem windowInfluence_eq_sum (c : Params) (d : ℕ → ℝ) (i : ℕ) :
    windowInfluence c d i = ∑ j ∈ Finset.range c.N,
      if j + 1 ≤ i then influenceEnvelope c d (i - (j + 1)) else 0 := by
  by_cases hi : 1 ≤ i
  · rw [windowInfluence, if_pos hi, pastSumInfluence]
    apply Finset.sum_congr rfl
    intro j _
    have hj : j ≤ i - 1 ↔ j + 1 ≤ i := by omega
    simp only [hj, Nat.sub_sub, Nat.add_comm 1 j]
  · have hi0 : i = 0 := by omega
    subst i
    simp [windowInfluence]

theorem outputWindow_hasInfluence (c : Params) (oldK : Correction) {d : ℕ → ℝ}
    (hold : HasInfluence (factor oldK) d) :
    HasInfluence (outputWindow c oldK) (windowInfluence c d) :=
  hasInfluence_dropPast (hasInfluence_pastSum (factor_update_hasInfluence c oldK hold) c.N) 1

theorem windowInfluence_nonneg (c : Params) {d : ℕ → ℝ} (hd : ∀ i, 0 ≤ d i) (i : ℕ) :
    0 ≤ windowInfluence c d i := by
  unfold windowInfluence
  split_ifs
  · exact pastSumInfluence_nonneg (influenceEnvelope_nonneg c hd) c.N _
  · exact le_rfl

theorem summable_windowInfluence (c : Params) {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) : Summable (windowInfluence c d) :=
  summable_shiftInfluence (summable_pastSumInfluence (influenceEnvelope_nonneg c hd)
    (summable_influenceEnvelope c hd hs) c.N) 1

/-- The exact window influence mass is `N E`. -/
theorem tsum_windowInfluence (c : Params) {d : ℕ → ℝ}
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) :
    (∑' i, windowInfluence c d i) = (c.N : ℝ) * ∑' i, influenceEnvelope c d i := by
  unfold windowInfluence
  rw [tsum_shiftInfluence (summable_pastSumInfluence (influenceEnvelope_nonneg c hd)
    (summable_influenceEnvelope c hd hs) c.N) 1,
    tsum_pastSumInfluence (summable_influenceEnvelope c hd hs)]

/-- The controller saturation residual is an actual continuous history function. -/
noncomputable def residual (c : Params) (oldK : Correction) (x : Past) : ℝ :=
  c.a * clipResidual c.s (outputWindow c oldK x)

@[fun_prop] theorem continuous_residual (c : Params) (oldK : Correction) :
    Continuous (residual c oldK) :=
  continuous_const.mul ((continuous_clipResidual c.s).comp (continuous_outputWindow c oldK))

theorem residual_odd (c : Params) (oldK : Correction)
    (hodd : Function.Odd (oldK : Past → ℝ)) : Function.Odd (residual c oldK) := by
  intro x
  simp only [residual, outputWindow_odd c oldK hodd x,
    clipResidual_neg c.s_pos.le, mul_neg]

/-- The local residual modulus, before multiplication by `a` or the window
influence mass. Here `σ = sqrt (∫ z²)` and `E = ∑ influenceEnvelope c d`. -/
noncomputable def residualModulus (ν : Measure ℝ) (c : Params) (d : ℕ → ℝ) (L : ℝ) : ℝ :=
  noiseTailL2 ν L + 2 * L *
    (Real.sqrt (∫ z, z ^ 2 ∂ν) * Real.sqrt (c.N : ℝ) * (∑' i, influenceEnvelope c d i)) / c.s

theorem residualModulus_nonneg (ν : Measure ℝ) (c : Params) {d : ℕ → ℝ} {L : ℝ}
    (hd : ∀ i, 0 ≤ d i) (hL : 0 ≤ L) : 0 ≤ residualModulus ν c d L := by
  exact add_nonneg (noiseTailL2_nonneg ν L)
    (div_nonneg (mul_nonneg (mul_nonneg (by norm_num) hL)
      (mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
        (tsum_nonneg (influenceEnvelope_nonneg c hd)))) c.s_pos.le)

section L2

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

theorem memLp_outputWindow (c : Params) (oldK : Correction)
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) :
    MemLp (outputWindow c oldK) 2 (iidLaw ℕ ν) :=
  memLp_dropPast ν (memLp_pastSum ν (memLp_factor ν (update c oldK) hnoise) c.N) 1

theorem memLp_residual (c : Params) (oldK : Correction)
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) :
    MemLp (residual c oldK) 2 (iidLaw ℕ ν) := by
  have hmem : MemLp (fun x ↦ clipResidual c.s (outputWindow c oldK x)) 2 (iidLaw ℕ ν) := by
    apply (memLp_outputWindow ν c oldK hnoise).abs.mono'
      ((continuous_clipResidual c.s).comp (continuous_outputWindow c oldK)).aestronglyMeasurable
    exact ae_of_all _ fun x ↦ by
      simpa only [Real.norm_eq_abs] using abs_clipResidual_le c.s_pos.le (outputWindow c oldK x)
  exact hmem.const_mul c.a

theorem memLp_sumProcess_residual (c : Params) (oldK : Correction)
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (n : ℕ) :
    MemLp (sumProcess (residual c oldK) n) 2 (iidLaw ℤ ν) :=
  memLp_sumProcess ν (memLp_residual ν c oldK hnoise) n

theorem memLp_finiteApprox_outputWindow (c : Params) (oldK : Correction) {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hodd : Function.Odd (oldK : Past → ℝ))
    (hold : HasInfluence (factor oldK) d) (K : ℕ) :
    MemLp (finiteApprox (outputWindow c oldK) K) 2 (Measure.pi fun _ : Fin K ↦ ν) :=
  memLp_finiteApprox_of_hasInfluence ν hnoise (continuous_outputWindow c oldK)
    (outputWindow_hasInfluence c oldK hold) (outputWindow_odd c oldK hodd).map_zero K

theorem memLp_finiteApprox_residual (c : Params) (oldK : Correction) {d : ℕ → ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hodd : Function.Odd (oldK : Past → ℝ))
    (hold : HasInfluence (factor oldK) d) (K : ℕ) :
    MemLp (finiteApprox (residual c oldK) K) 2 (Measure.pi fun _ : Fin K ↦ ν) :=
  memLp_finiteApprox_scaled_clipResidual ν (continuous_outputWindow c oldK) c.s_pos.le
    (memLp_finiteApprox_outputWindow ν c oldK hnoise hodd hold) c.a K

/-- The sharp finite zero-fill window bound `‖W_K‖₂ ≤ σ √N E`.
Dropping one input shortens the cutoff, even when the cutoff is zero. -/
theorem toReal_eLpNorm_finiteApprox_outputWindow_le (c : Params) (oldK : Correction)
    {d : ℕ → ℝ} (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hodd : Function.Odd (oldK : Past → ℝ)) (hold : HasInfluence (factor oldK) d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (K : ℕ) :
    (eLpNorm (finiteApprox (outputWindow c oldK) K) 2 (Measure.pi fun _ : Fin K ↦ ν)).toReal ≤
      Real.sqrt (∫ z, z ^ 2 ∂ν) * Real.sqrt (c.N : ℝ) * (∑' i, influenceEnvelope c d i) := by
  have hfin := memLp_finiteApprox_of_hasInfluence ν hnoise (continuous_factor (update c oldK))
    (factor_update_hasInfluence c oldK hold) (factor_update_odd c oldK hodd).map_zero
  change (eLpNorm (finiteApprox (pastSum (factor (update c oldK)) c.N ∘ dropPast 1) K)
    2 (Measure.pi fun _ : Fin K ↦ ν)).toReal ≤ _
  rw [eLpNorm_finiteApprox_dropPast ν (memLp_finiteApprox_pastSum ν hfin c.N) K 1]
  calc
    _ ≤ Real.sqrt (∫ z, z ^ 2 ∂ν) * (∑' i, influenceEnvelope c d i) * Real.sqrt (c.N : ℝ) :=
      toReal_eLpNorm_finiteApprox_pastSum_le ν hnoise hν (continuous_factor (update c oldK))
        (factor_update_odd c oldK hodd) (factor_update_hasInfluence c oldK hold)
        (influenceEnvelope_nonneg c hd) (summable_influenceEnvelope c hd hs) c.N (K - 1)
    _ = _ := by ring

/-- Quantitative residual resampling bound, uniform over all finite zero-fills:
`C = a (q(L) + 2 L σ √N E / s)` and `w = windowInfluence c d`. -/
theorem residual_hasFiniteL2Influence (c : Params) (oldK : Correction) {d : ℕ → ℝ} {L : ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hodd : Function.Odd (oldK : Past → ℝ)) (hold : HasInfluence (factor oldK) d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (hL : 0 ≤ L) :
    HasFiniteL2Influence ν (residual c oldK) (windowInfluence c d)
      (c.a * residualModulus ν c d L) :=
  hasFiniteL2Influence_scaled_clipResidual ν hnoise (continuous_outputWindow c oldK)
    (outputWindow_hasInfluence c oldK hold) (windowInfluence_nonneg c hd)
    c.a_nonneg c.s_pos hL (memLp_finiteApprox_outputWindow ν c oldK hnoise hodd hold)
    (toReal_eLpNorm_finiteApprox_outputWindow_le ν c oldK hnoise hν hodd hold hd hs)

/-- The residual partial-sum norm is at most
`√n g E (q(L) + 2 L σ √N E / s)`, with no boundary constant. -/
theorem toReal_eLpNorm_sumProcess_residual_le (c : Params) (oldK : Correction)
    {d : ℕ → ℝ} {L : ℝ} (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hodd : Function.Odd (oldK : Past → ℝ)) (hold : HasInfluence (factor oldK) d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (hL : 0 ≤ L) (n : ℕ) :
    (eLpNorm (sumProcess (residual c oldK) n) 2 (iidLaw ℤ ν)).toReal ≤
      (c.gain : ℝ) * (∑' i, influenceEnvelope c d i) * residualModulus ν c d L * Real.sqrt n := by
  have h := toReal_eLpNorm_sumProcess_le_of_hasFiniteL2Influence ν hν
    (continuous_residual c oldK) (residual_odd c oldK hodd)
    (residual_hasFiniteL2Influence ν c oldK hnoise hν hodd hold hd hs hL)
    (mul_nonneg c.a_nonneg (residualModulus_nonneg ν c hd hL))
    (windowInfluence_nonneg c hd) (summable_windowInfluence c hd hs) n
  rw [tsum_windowInfluence c hd hs] at h
  convert h using 1
  rw [Params.coe_gain]
  ring

end L2

/-- At the batch scaling `s = A √N`, the small-replacement term no longer
contains `N`: the modulus is `q(L) + 2 L σ E / A`. -/
theorem residualModulus_eq_of_scale (ν : Measure ℝ) (c : Params) (d : ℕ → ℝ) (L : ℝ)
    {A : ℝ} (hA : 0 < A) (hscale : c.s = A * Real.sqrt (c.N : ℝ)) :
    residualModulus ν c d L = noiseTailL2 ν L +
      2 * L * Real.sqrt (∫ z, z ^ 2 ∂ν) * (∑' i, influenceEnvelope c d i) / A := by
  have hN : Real.sqrt (c.N : ℝ) ≠ 0 :=
    (Real.sqrt_pos.mpr (Nat.cast_pos.mpr c.N_pos)).ne'
  unfold residualModulus
  rw [hscale]
  congr 1
  field_simp

end Controller

end Cascade
end


/- Supporting development: Cascade.UpperL2 -/
section
set_option autoImplicit false

/- # Uniform square-root upper envelopes for partial sums -/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

namespace Cascade

/-- A square-root upper bound, up to a fixed boundary error, for the genuine
`L²` norms of all partial sums. No asymptotic-variance limit is assumed. -/
structure UpperL2 (ν : Measure ℝ) (F : Past → ℝ) (τ : ℝ) : Prop where
  memLp : ∀ n, MemLp (sumProcess F n) 2 (iidLaw ℤ ν)
  bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ n : ℕ,
    (eLpNorm (sumProcess F n) 2 (iidLaw ℤ ν)).toReal ≤ τ * Real.sqrt n + C

lemma UpperL2.mono {ν : Measure ℝ} {F : Past → ℝ} {τ υ : ℝ}
    (h : UpperL2 ν F τ) (hτυ : τ ≤ υ) : UpperL2 ν F υ := by
  refine ⟨h.memLp, ?_⟩
  rcases h.bound with ⟨C, hC, hb⟩
  exact ⟨C, hC, fun n ↦ (hb n).trans
    (add_le_add (mul_le_mul_of_nonneg_right hτυ (Real.sqrt_nonneg _)) le_rfl)⟩

end Cascade
end


/- Supporting development: Cascade.ControllerEnvelope -/
section
set_option autoImplicit false

/-
# One-controller square-root upper envelopes

The exact controller recurrence is summed over a reversed block. All lag
errors telescope to two endpoint blocks, whose `L²` norms are uniformly
bounded in the block length. This gives attenuation of `UpperL2` directly;
no asymptotic-variance limit, covariance series, or Poisson equation is used.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace Cascade

/-- Real-valued `L²` triangle inequality for a difference. -/
theorem toReal_eLpNorm_sub_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {f g : α → ℝ} (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) :
    (eLpNorm (fun x ↦ f x - g x) 2 μ).toReal ≤
      (eLpNorm f 2 μ).toReal + (eLpNorm g 2 μ).toReal := by
  simpa only [sub_eq_add_neg, Pi.neg_apply, eLpNorm_neg] using toReal_eLpNorm_add_le hf hg.neg

/-- Splitting a reversed block at an arbitrary natural endpoint. -/
theorem pastSum_add (F : Past → ℝ) (n m : ℕ) (x : Past) :
    pastSum F (n + m) x = pastSum F n x + pastSum F m (dropPast n x) := by
  simp only [pastSum, Finset.sum_range_add, dropPast_dropPast]
  congr 1
  apply Finset.sum_congr rfl
  intro t _
  rw [Nat.add_comm n t]

/-- Shifting a block by `m` leaves only its two length-`m` endpoint blocks.
This identity includes `m > n` and empty blocks. -/
theorem pastSum_sub_dropPast (F : Past → ℝ) (n m : ℕ) (x : Past) :
    pastSum F n x - pastSum F n (dropPast m x) =
      pastSum F m x - pastSum F m (dropPast n x) := by
  have h := pastSum_add F n m x
  have h' := pastSum_add F m n x
  rw [Nat.add_comm m n] at h'
  linarith

/-- The unscaled endpoint error for a window of strict lags `1, ..., N`. -/
def lagBoundary (F : Past → ℝ) (N n : ℕ) (x : Past) : ℝ :=
  ∑ j ∈ Finset.range N, (pastSum F (j + 1) x - pastSum F (j + 1) (dropPast n x))

/-- A sum of lagged block sums equals `N` copies of the block, modulo endpoints. -/
theorem pastSum_window_eq (F : Past → ℝ) (N n : ℕ) (x : Past) :
    pastSum (pastSum F N ∘ dropPast 1) n x =
      (N : ℝ) * pastSum F n x - lagBoundary F N n x := by
  have hcomm : pastSum (pastSum F N ∘ dropPast 1) n x =
      ∑ j ∈ Finset.range N, pastSum F n (dropPast (j + 1) x) := by
    simp only [pastSum, Function.comp_apply, dropPast_dropPast]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro t _
    congr 2
    omega
  rw [hcomm]
  calc
    _ = ∑ j ∈ Finset.range N,
        (pastSum F n x - (pastSum F (j + 1) x - pastSum F (j + 1) (dropPast n x))) := by
      apply Finset.sum_congr rfl
      intro j _
      linarith only [pastSum_sub_dropPast F n (j + 1) x]
    _ = _ := by simp only [Finset.sum_sub_distrib, Finset.sum_const,
      Finset.card_range, nsmul_eq_mul, lagBoundary]

section BoundaryL2

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- The elementary, linear-in-length block bound, used only on endpoint blocks. -/
theorem toReal_eLpNorm_pastSum_le_linear {F : Past → ℝ}
    (hF : MemLp F 2 (iidLaw ℕ ν)) (n : ℕ) :
    (eLpNorm (pastSum F n) 2 (iidLaw ℕ ν)).toReal ≤
      (n : ℝ) * (eLpNorm F 2 (iidLaw ℕ ν)).toReal := by
  calc
    _ ≤ ∑ t ∈ Finset.range n, (eLpNorm (F ∘ dropPast t) 2 (iidLaw ℕ ν)).toReal :=
      toReal_eLpNorm_sum_le _ (fun t _ ↦ memLp_dropPast ν hF t)
    _ = _ := by
      simp only [eLpNorm_comp_measurePreserving hF.aestronglyMeasurable
        (measurePreserving_dropPast ν _), Finset.sum_const, Finset.card_range, nsmul_eq_mul]

theorem memLp_lagBoundary {F : Past → ℝ} (hF : MemLp F 2 (iidLaw ℕ ν)) (N n : ℕ) :
    MemLp (lagBoundary F N n) 2 (iidLaw ℕ ν) :=
  memLp_finset_sum _ fun j _ ↦
    (memLp_pastSum ν hF (j + 1)).sub (memLp_dropPast ν (memLp_pastSum ν hF (j + 1)) n)

private theorem sum_range_two_mul_add_one (N : ℕ) (b : ℝ) :
    (∑ j ∈ Finset.range N, 2 * ((j : ℝ) + 1) * b) = (N : ℝ) * ((N : ℝ) + 1) * b := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, ih]
    push_cast
    ring

/-- Both endpoint blocks have length `j+1`, so the total error is at most
`2 ∑_{j<N} (j+1) ‖F‖₂ = N(N+1) ‖F‖₂`, uniformly in `n`. -/
theorem toReal_eLpNorm_lagBoundary_le {F : Past → ℝ}
    (hF : MemLp F 2 (iidLaw ℕ ν)) (N n : ℕ) :
    (eLpNorm (lagBoundary F N n) 2 (iidLaw ℕ ν)).toReal ≤
      (N : ℝ) * ((N : ℝ) + 1) * (eLpNorm F 2 (iidLaw ℕ ν)).toReal := by
  have hrow (j : ℕ) :
      (eLpNorm (fun x ↦ pastSum F (j + 1) x - pastSum F (j + 1) (dropPast n x))
        2 (iidLaw ℕ ν)).toReal ≤
        2 * ((j : ℝ) + 1) * (eLpNorm F 2 (iidLaw ℕ ν)).toReal := by
    have hm := memLp_pastSum ν hF (j + 1)
    calc
      _ ≤ (eLpNorm (pastSum F (j + 1)) 2 (iidLaw ℕ ν)).toReal +
          (eLpNorm (pastSum F (j + 1) ∘ dropPast n) 2 (iidLaw ℕ ν)).toReal :=
        toReal_eLpNorm_sub_le hm (memLp_dropPast ν hm n)
      _ = (eLpNorm (pastSum F (j + 1)) 2 (iidLaw ℕ ν)).toReal +
          (eLpNorm (pastSum F (j + 1)) 2 (iidLaw ℕ ν)).toReal := by
        rw [eLpNorm_comp_measurePreserving hm.aestronglyMeasurable (measurePreserving_dropPast ν n)]
      _ ≤ ((j + 1 : ℕ) : ℝ) * (eLpNorm F 2 (iidLaw ℕ ν)).toReal +
          ((j + 1 : ℕ) : ℝ) * (eLpNorm F 2 (iidLaw ℕ ν)).toReal :=
        add_le_add (toReal_eLpNorm_pastSum_le_linear ν hF (j + 1))
          (toReal_eLpNorm_pastSum_le_linear ν hF (j + 1))
      _ = _ := by push_cast; ring
  calc
    _ ≤ ∑ j ∈ Finset.range N,
        (eLpNorm (fun x ↦ pastSum F (j + 1) x - pastSum F (j + 1) (dropPast n x))
          2 (iidLaw ℕ ν)).toReal :=
      toReal_eLpNorm_sum_le _ (fun j _ ↦
        (memLp_pastSum ν hF (j + 1)).sub (memLp_dropPast ν (memLp_pastSum ν hF (j + 1)) n))
    _ ≤ ∑ j ∈ Finset.range N, 2 * ((j : ℝ) + 1) * (eLpNorm F 2 (iidLaw ℕ ν)).toReal :=
      Finset.sum_le_sum fun j _ ↦ hrow j
    _ = _ := sum_range_two_mul_add_one N _

end BoundaryL2

namespace Controller

/-- The controller's endpoint error, realized on the same noise path as all
three partial sums in the exact identity below. -/
noncomputable def boundary (c : Params) (oldK : Correction) (n : ℕ) (ω : NoisePath) : ℝ :=
  c.a * lagBoundary (factor (update c oldK)) c.N n (history ((n : ℤ) - 1) ω)

/-- A uniform, finite endpoint norm bound. The updated factor belongs to `L²`
whenever the innovation does, independently of its influence envelope. -/
noncomputable def boundaryConstant (ν : Measure ℝ) (c : Params) (oldK : Correction) : ℝ :=
  c.a * (c.N : ℝ) * ((c.N : ℝ) + 1) *
    (eLpNorm (factor (update c oldK)) 2 (iidLaw ℕ ν)).toReal

theorem boundaryConstant_nonneg (ν : Measure ℝ) (c : Params) (oldK : Correction) :
    0 ≤ boundaryConstant ν c oldK := by
  unfold boundaryConstant
  exact mul_nonneg (mul_nonneg (mul_nonneg c.a_nonneg (Nat.cast_nonneg _))
    (by positivity)) ENNReal.toReal_nonneg

/-- The exact, everywhere reversed-block controller identity. -/
theorem pastSum_update_identity (c : Params) (oldK : Correction) (n : ℕ) (x : Past) :
    (1 + (c.gain : ℝ)) * pastSum (factor (update c oldK)) n x =
      pastSum (factor oldK) n x + pastSum (residual c oldK) n x +
        c.a * lagBoundary (factor (update c oldK)) c.N n x := by
  have hsum : pastSum (factor (update c oldK)) n x +
      c.a * pastSum (outputWindow c oldK) n x =
      pastSum (factor oldK) n x + pastSum (residual c oldK) n x := by
    calc
      _ = ∑ t ∈ Finset.range n, (factor (update c oldK) (dropPast t x) +
          c.a * outputWindow c oldK (dropPast t x)) := by
        simp only [pastSum, Finset.sum_add_distrib, Finset.mul_sum]
      _ = ∑ t ∈ Finset.range n, (factor oldK (dropPast t x) + residual c oldK (dropPast t x)) := by
        apply Finset.sum_congr rfl
        intro t _
        simpa only [residual, outputWindow_eq_sum] using factor_update_add_window c oldK (dropPast t x)
      _ = _ := by simp only [pastSum, Finset.sum_add_distrib]
  rw [outputWindow, pastSum_window_eq] at hsum
  rw [Params.coe_gain]
  nlinarith only [hsum]

/-- Exact forward-time summation of the controller law:
`(1+g) SₙX = SₙY + SₙR + boundaryₙ`. -/
theorem sumProcess_update_identity (c : Params) (oldK : Correction) (n : ℕ) (ω : NoisePath) :
    (1 + (c.gain : ℝ)) * sumProcess (factor (update c oldK)) n ω =
      sumProcess (factor oldK) n ω + sumProcess (residual c oldK) n ω + boundary c oldK n ω := by
  simpa only [pastSum_history_eq_sumProcess, boundary] using
    pastSum_update_identity c oldK n (history ((n : ℤ) - 1) ω)

section L2

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

theorem memLp_boundary (c : Params) (oldK : Correction)
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (n : ℕ) :
    MemLp (boundary c oldK n) 2 (iidLaw ℤ ν) :=
  ((memLp_lagBoundary ν (memLp_factor ν (update c oldK) hnoise) c.N n).const_mul c.a).comp_measurePreserving
    (measurePreserving_history ν ((n : ℤ) - 1))

/-- The endpoint error is uniformly bounded by `a N(N+1) ‖X₀‖₂`. -/
theorem toReal_eLpNorm_boundary_le (c : Params) (oldK : Correction)
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (n : ℕ) :
    (eLpNorm (boundary c oldK n) 2 (iidLaw ℤ ν)).toReal ≤ boundaryConstant ν c oldK := by
  have hF := memLp_factor ν (update c oldK) hnoise
  have hB := memLp_lagBoundary ν hF c.N n
  change (eLpNorm ((fun x ↦ c.a * lagBoundary (factor (update c oldK)) c.N n x) ∘
    history ((n : ℤ) - 1)) 2 (iidLaw ℤ ν)).toReal ≤ _
  rw [eLpNorm_comp_measurePreserving (hB.const_mul c.a).aestronglyMeasurable
    (measurePreserving_history ν ((n : ℤ) - 1)), toReal_eLpNorm_const_mul,
    abs_of_nonneg c.a_nonneg]
  calc
    _ ≤ c.a * ((c.N : ℝ) * ((c.N : ℝ) + 1) *
        (eLpNorm (factor (update c oldK)) 2 (iidLaw ℕ ν)).toReal) :=
      mul_le_mul_of_nonneg_left (toReal_eLpNorm_lagBoundary_le ν hF c.N n) c.a_nonneg
    _ = _ := by unfold boundaryConstant; ring

/-- Finite-`n` norm comparison, before inserting upper envelopes for the old
factor and residual. All three norms are genuine finite `L²` norms. -/
theorem toReal_eLpNorm_sumProcess_update_le (c : Params) (oldK : Correction)
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (n : ℕ) :
    (1 + (c.gain : ℝ)) * (eLpNorm (sumProcess (factor (update c oldK)) n) 2 (iidLaw ℤ ν)).toReal ≤
      (eLpNorm (sumProcess (factor oldK) n) 2 (iidLaw ℤ ν)).toReal +
        (eLpNorm (sumProcess (residual c oldK) n) 2 (iidLaw ℤ ν)).toReal + boundaryConstant ν c oldK := by
  have hY := memLp_sumProcess ν (memLp_factor ν oldK hnoise) n
  have hR := memLp_sumProcess_residual ν c oldK hnoise n
  have hB := memLp_boundary ν c oldK hnoise n
  have hdenom : 0 ≤ 1 + (c.gain : ℝ) := by positivity
  calc
    _ = (eLpNorm (fun ω ↦ (1 + (c.gain : ℝ)) * sumProcess (factor (update c oldK)) n ω)
        2 (iidLaw ℤ ν)).toReal := by
      rw [toReal_eLpNorm_const_mul, abs_of_nonneg hdenom]
    _ = (eLpNorm (fun ω ↦ sumProcess (factor oldK) n ω + sumProcess (residual c oldK) n ω +
        boundary c oldK n ω) 2 (iidLaw ℤ ν)).toReal := by
      congr 2
      funext ω
      exact sumProcess_update_identity c oldK n ω
    _ ≤ (eLpNorm (fun ω ↦ sumProcess (factor oldK) n ω + sumProcess (residual c oldK) n ω)
        2 (iidLaw ℤ ν)).toReal + (eLpNorm (boundary c oldK n) 2 (iidLaw ℤ ν)).toReal :=
      toReal_eLpNorm_add_le (hY.add hR) hB
    _ ≤ _ := add_le_add (toReal_eLpNorm_add_le hY hR) (toReal_eLpNorm_boundary_le ν c oldK hnoise n)

/-- Abstract one-controller attenuation: a residual upper envelope with slope
`ρ` changes an old slope `τ` into `(τ+ρ)/(1+g)`. Only fixed endpoint constants
are absorbed; no limiting variance is introduced. -/
theorem upperL2_update_of_residual (c : Params) (oldK : Correction) {τ ρ : ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν)
    (hY : UpperL2 ν (factor oldK) τ) (hR : UpperL2 ν (residual c oldK) ρ) :
    UpperL2 ν (factor (update c oldK)) ((τ + ρ) / (1 + (c.gain : ℝ))) := by
  refine ⟨memLp_sumProcess ν (memLp_factor ν (update c oldK) hnoise), ?_⟩
  obtain ⟨CY, hCY, hYbound⟩ := hY.bound
  obtain ⟨CR, hCR, hRbound⟩ := hR.bound
  have hdenom : 0 < 1 + (c.gain : ℝ) := by positivity
  refine ⟨(CY + CR + boundaryConstant ν c oldK) / (1 + (c.gain : ℝ)),
    div_nonneg (add_nonneg (add_nonneg hCY hCR) (boundaryConstant_nonneg ν c oldK)) hdenom.le, ?_⟩
  intro n
  have h := (toReal_eLpNorm_sumProcess_update_le ν c oldK hnoise n).trans
    (add_le_add (add_le_add (hYbound n) (hRbound n)) le_rfl)
  calc
    _ ≤ ((τ * Real.sqrt n + CY) + (ρ * Real.sqrt n + CR) + boundaryConstant ν c oldK) /
        (1 + (c.gain : ℝ)) := by
      apply (le_div_iff₀ hdenom).mpr
      simpa only [mul_comm (1 + (c.gain : ℝ))] using h
    _ = _ := by ring

/-- Full quantitative upper estimate for one controller. Set
`E = ∑ influenceEnvelope c d` and `q = noiseTailL2 ν L`; the new slope is
`(τ + g E (q + 2 L σ √N E / s)) / (1+g)`. -/
theorem upperL2_update (c : Params) (oldK : Correction) {d : ℕ → ℝ} {L τ : ℝ}
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hodd : Function.Odd (oldK : Past → ℝ)) (hold : HasInfluence (factor oldK) d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (hL : 0 ≤ L)
    (hupper : UpperL2 ν (factor oldK) τ) :
    UpperL2 ν (factor (update c oldK))
      ((τ + (c.gain : ℝ) * (∑' i, influenceEnvelope c d i) * residualModulus ν c d L) /
        (1 + (c.gain : ℝ))) := by
  apply upperL2_update_of_residual ν c oldK hnoise hupper
  refine ⟨memLp_sumProcess_residual ν c oldK hnoise, 0, le_rfl, ?_⟩
  intro n
  simpa only [add_zero] using
    toReal_eLpNorm_sumProcess_residual_le ν c oldK hnoise hν hodd hold hd hs hL n

/-- Batch-normalized one-controller upper estimate, with `s = A √N`.
After this substitution the residual modulus has no explicit window length. -/
theorem upperL2_update_of_scale (c : Params) (oldK : Correction)
    {d : ℕ → ℝ} {L τ A : ℝ} (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (hodd : Function.Odd (oldK : Past → ℝ)) (hold : HasInfluence (factor oldK) d)
    (hd : ∀ i, 0 ≤ d i) (hs : Summable d) (hL : 0 ≤ L)
    (hA : 0 < A) (hscale : c.s = A * Real.sqrt (c.N : ℝ))
    (hupper : UpperL2 ν (factor oldK) τ) :
    UpperL2 ν (factor (update c oldK))
      ((τ + (c.gain : ℝ) * (∑' i, influenceEnvelope c d i) *
        (noiseTailL2 ν L + 2 * L * Real.sqrt (∫ z, z ^ 2 ∂ν) *
          (∑' i, influenceEnvelope c d i) / A)) / (1 + (c.gain : ℝ))) := by
  simpa only [residualModulus_eq_of_scale ν c d L hA hscale] using
    upperL2_update ν c oldK hnoise hν hodd hold hd hs hL hupper

end L2
end Controller
end Cascade
end


/- Supporting development: Cascade.Attenuation -/
section
set_option autoImplicit false

/-
# Arbitrarily cheap attenuation by finite controller extensions

All bounds in this file concern genuine finite-block `L²` upper envelopes.
No asymptotic variance is defined or assumed. The innovation law needs only
symmetry and a finite second moment; its variance may be zero.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal BoundedContinuousFunction

namespace Cascade.InverseCascade

open Controller (Params)
open AttenuationArithmetic

/-- The global causal influence envelope of a finite forward cascade, starting
from the unit mass at the current innovation. -/
noncomputable def forwardInfluence (cs : List Params) : ℕ → ℝ :=
  cs.foldl (fun d c ↦ Controller.influenceEnvelope c d) (fun i ↦ if i = 0 then 1 else 0)

@[simp] theorem forwardInfluence_nil :
    forwardInfluence [] = fun i ↦ if i = 0 then 1 else 0 := rfl

@[simp] theorem forwardInfluence_append_singleton (cs : List Params) (c : Params) :
    forwardInfluence (cs ++ [c]) = Controller.influenceEnvelope c (forwardInfluence cs) := by
  simp only [forwardInfluence, List.foldl_append, List.foldl_cons, List.foldl_nil]

private theorem hasInfluence_factor_zero :
    HasInfluence (factor (0 : Correction)) (fun i ↦ if i = 0 then 1 else 0) := by
  intro x j z
  by_cases hj : j = 0
  · subst j
    simp [factor]
  · simp [factor, hj, Ne.symm hj]

/-- An explicit summable envelope for every finite cascade, with its exact
resolvent mass. In particular this is not an assumed finite-cascade bound. -/
theorem forwardInfluence_properties (cs : List Params) :
    HasInfluence (factor (forward cs 0)) (forwardInfluence cs) ∧
      (∀ i, 0 ≤ forwardInfluence cs i) ∧ Summable (forwardInfluence cs) ∧
      (∑' i, forwardInfluence cs i) =
        (cs.map (fun c ↦ (1 - (c.gain : ℝ))⁻¹)).prod := by
  induction cs using List.reverseRecOn with
  | nil =>
    refine ⟨hasInfluence_factor_zero, ?_, (hasSum_ite_eq (0 : ℕ) (1 : ℝ)).summable, ?_⟩
    · intro i
      simp only [forwardInfluence_nil]
      split_ifs <;> norm_num
    · simp [forwardInfluence_nil]
  | append_singleton cs c ih =>
    rcases ih with ⟨hi, hn, hs, hm⟩
    rw [forward_append_singleton, forwardInfluence_append_singleton]
    refine ⟨Controller.factor_update_hasInfluence c _ hi,
      Controller.influenceEnvelope_nonneg c hn,
      Controller.summable_influenceEnvelope c hn hs, ?_⟩
    rw [Controller.tsum_influenceEnvelope c hn hs, hm]
    simp [div_eq_mul_inv]

private theorem odd_forward_zero (cs : List Params) :
    Function.Odd (forward cs 0 : Past → ℝ) :=
  forward_odd cs 0 (by intro x; simp)

/-- Every finite cascade has a strictly positive square-root upper slope.
The added `1` avoids any nondegeneracy assumption on the noise. -/
theorem exists_upperL2_forward (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν) (cs : List Params) :
    ∃ T : ℝ, 0 < T ∧ UpperL2 ν (factor (forward cs 0)) T := by
  obtain ⟨hi, hn, hs, _⟩ := forwardInfluence_properties cs
  let T := Real.sqrt (∫ z, z ^ 2 ∂ν) * (∑' i, forwardInfluence cs i) + 1
  have hT : 0 < T := by
    have : 0 ≤ Real.sqrt (∫ z, z ^ 2 ∂ν) * (∑' i, forwardInfluence cs i) :=
      mul_nonneg (Real.sqrt_nonneg _) (tsum_nonneg hn)
    dsimp [T]
    linarith
  refine ⟨T, hT, ?_⟩
  have hu : UpperL2 ν (factor (forward cs 0))
      (Real.sqrt (∫ z, z ^ 2 ∂ν) * (∑' i, forwardInfluence cs i)) := by
    refine ⟨memLp_sumProcess ν (memLp_factor ν (forward cs 0) hnoise), 0, le_rfl, ?_⟩
    intro n
    simpa only [add_zero] using toReal_eLpNorm_sumProcess_le ν hnoise hν
      (continuous_factor _) (factor_odd _ (odd_forward_zero cs)) hi hn hs n
  exact hu.mono (by dsimp [T]; linarith)

private theorem amplitude_snoc (cs : List Params) (c : Params) :
    amplitude (cs ++ [c]) = amplitude cs + gainProduct cs * c.budget := by
  unfold amplitude
  have hl : (cs ++ [c]).length = cs.length + 1 := by simp
  rw [← Equiv.sum_comp (finCongr hl.symm) (layerAmplitude (cs ++ [c])),
    Fin.sum_univ_castSucc]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    simp only [layerAmplitude, List.get_eq_getElem, Fin.val_castSucc, Fin.val_cast,
      finCongr_apply]
    rw [List.take_append_of_le_length i.isLt.le, List.getElem_append_left i.isLt]
  · simp [layerAmplitude, List.get_eq_getElem, List.getElem_append_right]

private theorem cost_snoc (cs : List Params) (c : Params) :
    cost (cs ++ [c]) = cost cs + ((memory cs + c.N : ℕ) : ℝ) *
      (gainProduct cs * c.budget) ^ 2 := by
  unfold cost
  have hl : (cs ++ [c]).length = cs.length + 1 := by simp
  rw [← Equiv.sum_comp (finCongr hl.symm)
    (fun i ↦ (layerMemory (cs ++ [c]) i : ℝ) * layerAmplitude (cs ++ [c]) i ^ 2),
    Fin.sum_univ_castSucc]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    simp only [layerMemory, layerAmplitude, List.get_eq_getElem, Fin.val_castSucc,
      Fin.val_cast, finCongr_apply]
    rw [List.take_append_of_le_length i.isLt.le,
      List.take_append_of_le_length i.isLt, List.getElem_append_left i.isLt]
  · have ht : cs.take (cs.length + 1) = cs := List.take_of_length_le (by omega)
    simp [layerMemory, layerAmplitude, List.get_eq_getElem, List.take_append,
      List.getElem_append_right, ht, memory]

private theorem doublingMemory_snoc {cs : List Params} (hc : DoublingMemory cs)
    (c : Params) (hN : memory cs ≤ c.N) : DoublingMemory (cs ++ [c]) := by
  intro i
  by_cases hi : i.val < cs.length
  · have hh := hc ⟨i.val, hi⟩
    simpa only [List.take_append_of_le_length hi.le, List.get_eq_getElem,
      List.getElem_append_left hi] using hh
  · have heq : i.val = cs.length := by
      have := i.isLt
      simp only [List.length_append, List.length_singleton] at this
      omega
    simpa [heq, List.get_eq_getElem, List.take_append, List.getElem_append_right] using hN

/-- A nonempty finite batch reduces a positive upper slope by the fixed factor
`3/4`, with arbitrarily small added square cost and total amplitude. -/
theorem exists_attenuating_batch (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (cs : List Params) (hcs : DoublingMemory cs) {T η β : ℝ}
    (hT : 0 < T) (hη : 0 < η) (hβ : 0 < β)
    (hupper : UpperL2 ν (factor (forward cs 0)) T) :
    ∃ ds : List Params, ds ≠ [] ∧
      UpperL2 ν (factor (forward (cs ++ ds) 0)) (3 * T / 4) ∧
      DoublingMemory (cs ++ ds) ∧ cost (cs ++ ds) ≤ cost cs + η ∧
      amplitude (cs ++ ds) ≤ amplitude cs + β := by
  obtain ⟨hi₀, hn₀, hs₀, _⟩ := forwardInfluence_properties cs
  let D := (∑' i, forwardInfluence cs i) + 1
  have hD : 0 < D := by
    have hm : 0 ≤ ∑' i, forwardInfluence cs i := tsum_nonneg hn₀
    dsimp [D]
    linarith
  let Dmax := 2 * D
  have hDmax : 0 < Dmax := mul_pos (by norm_num) hD
  let ε := T / (16 * Dmax)
  have hε : 0 < ε := div_pos hT (mul_pos (by norm_num) hDmax)
  obtain ⟨L, hL, htail⟩ := exists_noiseTailL2_le ν hnoise hε
  let σ := Real.sqrt (∫ z, z ^ 2 ∂ν)
  have hσ : 0 ≤ σ := Real.sqrt_nonneg _
  let A := 1 + 2 * L * σ * Dmax / ε
  have hA : 0 < A := by dsimp [A]; positivity
  have hsmallMod : 2 * L * σ * Dmax / A ≤ ε := by
    apply (div_le_iff₀ hA).mpr
    have hc := div_mul_cancel₀ (2 * L * σ * Dmax) hε.ne'
    dsimp [A]
    nlinarith
  have hres (E : ℝ) (hE : 0 ≤ E) (hED : E ≤ Dmax) :
      E * (noiseTailL2 ν L + 2 * L * σ * E / A) ≤ T / 8 := by
    have hs : 2 * L * σ * E / A ≤ ε := by
      apply le_trans _ hsmallMod
      gcongr
    calc
      _ ≤ E * (ε + ε) := mul_le_mul_of_nonneg_left (add_le_add htail hs) hE
      _ ≤ Dmax * (ε + ε) := mul_le_mul_of_nonneg_right hED (by positivity)
      _ = T / 8 := by dsimp [ε]; field_simp; ring
  let G := gainProduct cs
  have hG : 0 < G := gainProduct_pos cs
  obtain ⟨m, hm⟩ := exists_nat_gt (max (2 : ℝ) (2 * (G * A) ^ 2 / η))
  have hm2r : (2 : ℝ) < (m : ℝ) := (le_max_left _ _).trans_lt hm
  have hm2 : 2 ≤ m := by exact_mod_cast hm2r.le
  have hmpos : 0 < (m : ℝ) := by linarith
  have hmposNat : 0 < m := by omega
  have hCm : 2 * (G * A) ^ 2 ≤ (m : ℝ) * η :=
    (div_le_iff₀ hη).mp ((le_max_right _ _).trans hm.le)
  let g := 1 / (2 * (m : ℝ))
  have hg : 0 < g := by dsimp [g]; positivity
  have hg4 : g ≤ 1 / 4 := by
    dsimp [g]
    apply (div_le_iff₀ (by positivity : 0 < 2 * (m : ℝ))).mpr
    linarith
  have hg1 : g < 1 := by linarith
  have hmg : (m : ℝ) * g = 1 / 2 := by dsimp [g]; field_simp
  have hkg (k : ℕ) (hk : k ≤ m) : (k : ℝ) * g ≤ 1 / 2 := by
    rw [← hmg]
    exact mul_le_mul_of_nonneg_right (by exact_mod_cast hk) hg.le
  have hcostSmall : 2 * (2 * G * g * A) ^ 2 ≤ η / (m : ℝ) := by
    apply (le_div_iff₀ hmpos).mpr
    calc
      _ = 2 * (G * A) ^ 2 / (m : ℝ) := by dsimp [g]; field_simp
      _ ≤ η := (div_le_iff₀ hmpos).mpr (by nlinarith only [hCm])
  have hbatch : ∀ k : ℕ, k ≤ m → ∃ ds : List Params, ds.length = k ∧
      DoublingMemory (cs ++ ds) ∧
      (1 - (k : ℝ) * g) * (∑' i, forwardInfluence (cs ++ ds) i) ≤ D ∧
      (1 - (k : ℝ) * g) * gainProduct (cs ++ ds) ≤ G ∧
      UpperL2 ν (factor (forward (cs ++ ds) 0)) (T * (1 - (k : ℝ) * g / 2)) ∧
      cost (cs ++ ds) ≤ cost cs + (k : ℝ) * (η / (m : ℝ)) ∧
      amplitude (cs ++ ds) ≤ amplitude cs + (k : ℝ) * (β / (m : ℝ)) := by
    intro k
    induction k with
    | zero =>
      intro _
      refine ⟨[], rfl, ?_⟩
      simpa [D, G] using
        (show DoublingMemory cs ∧ (∑' i, forwardInfluence cs i) ≤ D ∧
          gainProduct cs ≤ G ∧ UpperL2 ν (factor (forward cs 0)) T ∧
          cost cs ≤ cost cs ∧ amplitude cs ≤ amplitude cs from
          ⟨hcs, by dsimp [D]; linarith, le_rfl, hupper, le_rfl, le_rfl⟩)
    | succ k ih =>
      intro hk
      obtain ⟨ds, hlen, hdbl, hmass, hgain, hu, hcost, hamp⟩ := ih (by omega)
      obtain ⟨hi, hn, hs, _⟩ := forwardInfluence_properties (cs ++ ds)
      have hmass0 : 0 ≤ ∑' i, forwardInfluence (cs ++ ds) i := tsum_nonneg hn
      have hkt : 0 ≤ (k : ℝ) * g := mul_nonneg (Nat.cast_nonneg _) hg.le
      have hGcur0 : 0 ≤ gainProduct (cs ++ ds) := gainProduct_nonneg _
      have hGcur : gainProduct (cs ++ ds) ≤ 2 * G :=
        le_twice_of_weighted (hkg k (by omega)) hGcur0 hgain
      obtain ⟨c, hN, hcg, hscale, hca, hcc⟩ :=
        exists_scaled_controller (memory (cs ++ ds)) hg.le hg1 hA
          (gainProduct_nonneg (cs ++ ds)) (div_pos hβ hmpos)
      let E := ∑' i, Controller.influenceEnvelope c (forwardInfluence (cs ++ ds)) i
      have hE0 : 0 ≤ E := tsum_nonneg (Controller.influenceEnvelope_nonneg c hn)
      have hEmass : (1 - ((k + 1 : ℕ) : ℝ) * g) * E ≤ D := by
        dsimp [E]
        rw [Controller.tsum_influenceEnvelope c hn hs, hcg]
        convert (weighted_div_step hkt hg.le hg1 hmass0).trans hmass using 1
        push_cast
        ring
      have hED : E ≤ Dmax := le_twice_of_weighted (hkg (k + 1) hk) hE0 hEmass
      have hnewgain : (1 - ((k + 1 : ℕ) : ℝ) * g) *
          gainProduct ((cs ++ ds) ++ [c]) ≤ G := by
        rw [gainProduct_append_singleton, hcg]
        convert (weighted_mul_step hkt hg.le (gainProduct_nonneg (cs ++ ds))).trans hgain
          using 1
        push_cast
        ring
      have hnewupper : UpperL2 ν (factor (forward ((cs ++ ds) ++ [c]) 0))
          (T * (1 - ((k + 1 : ℕ) : ℝ) * g / 2)) := by
        rw [forward_append_singleton]
        have hup := Controller.upperL2_update_of_scale ν c (forward (cs ++ ds) 0)
          hnoise hν (odd_forward_zero _) hi hn hs hL.le hA hscale hu
        rw [hcg] at hup
        apply hup.mono
        have huLower : 3 * T / 4 ≤ T * (1 - (k : ℝ) * g / 2) := by
          have hmul := mul_le_mul_of_nonneg_left (hkg k (by omega)) hT.le
          nlinarith only [hmul]
        convert slope_step hT.le huLower hg.le hg4 (hres E hE0 hED) using 1 <;>
          dsimp [E, σ] <;> push_cast <;> ring
      have hcsmall : ((memory (cs ++ ds) + c.N : ℕ) : ℝ) *
          (gainProduct (cs ++ ds) * c.budget) ^ 2 ≤ η / (m : ℝ) := by
        apply hcc.trans
        apply le_trans _ hcostSmall
        gcongr
      refine ⟨ds ++ [c], by simp [hlen], ?_⟩
      rw [← List.append_assoc]
      refine ⟨doublingMemory_snoc hdbl c hN, ?_, hnewgain, hnewupper, ?_, ?_⟩
      · simpa only [forwardInfluence_append_singleton] using hEmass
      · rw [cost_snoc]
        push_cast at hcsmall ⊢
        linarith only [hcost, hcsmall]
      · rw [amplitude_snoc]
        push_cast
        linarith only [hamp, hca]
  obtain ⟨ds, hlen, hdbl, _, _, hu, hc, ha⟩ := hbatch m le_rfl
  have hne : ds ≠ [] := by intro hz; simp [hz] at hlen; omega
  refine ⟨ds, hne, ?_, hdbl, ?_, ?_⟩
  · convert hu using 1
    rw [hmg]
    ring
  · simpa only [mul_div_cancel₀ η hmpos.ne'] using hc
  · simpa only [mul_div_cancel₀ β hmpos.ne'] using ha

private theorem exists_attenuating_iterate (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (cs : List Params) (hcs : DoublingMemory cs) {T η β : ℝ}
    (hT : 0 < T) (hη : 0 < η) (hβ : 0 < β)
    (hupper : UpperL2 ν (factor (forward cs 0)) T) (q : ℕ) :
    ∃ ds : List Params, (0 < q → ds ≠ []) ∧
      UpperL2 ν (factor (forward (cs ++ ds) 0)) (T * (3 / 4 : ℝ) ^ q) ∧
      DoublingMemory (cs ++ ds) ∧ cost (cs ++ ds) ≤ cost cs + (q : ℝ) * η ∧
      amplitude (cs ++ ds) ≤ amplitude cs + (q : ℝ) * β := by
  induction q with
  | zero =>
    exact ⟨[], by simp, by simpa using hupper, by simpa using hcs, by simp, by simp⟩
  | succ q ih =>
    obtain ⟨ds, _, hu, hd, hc, ha⟩ := ih
    obtain ⟨es, hes, hnew, hdnew, hcnew, hanew⟩ := exists_attenuating_batch ν hnoise hν
      (cs ++ ds) hd (by positivity : 0 < T * (3 / 4 : ℝ) ^ q) hη hβ hu
    refine ⟨ds ++ es, ?_, ?_⟩
    · intro _ hz
      exact hes (List.append_eq_nil_iff.mp hz).2
    · rw [← List.append_assoc]
      refine ⟨?_, hdnew, ?_, ?_⟩
      · convert hnew using 1
        rw [pow_succ]
        ring
      · push_cast
        linarith only [hc, hcnew]
      · push_cast
        linarith only [ha, hanew]

/-- Attenuation to an arbitrary positive target, starting with a supplied
positive finite-block upper envelope. Budgets are split between finitely many
batches only after the required number of batches has been chosen. -/
theorem exists_attenuating_extension_of_upper (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (cs : List Params) (hcs : DoublingMemory cs) {T τ η β : ℝ}
    (hT : 0 < T) (hτ : 0 < τ) (hη : 0 < η) (hβ : 0 < β)
    (hupper : UpperL2 ν (factor (forward cs 0)) T) :
    ∃ ds : List Params, ds ≠ [] ∧
      UpperL2 ν (factor (forward (cs ++ ds) 0)) τ ∧
      DoublingMemory (cs ++ ds) ∧ cost (cs ++ ds) ≤ cost cs + η ∧
      amplitude (cs ++ ds) ≤ amplitude cs + β := by
  have htend : Tendsto (fun q : ℕ ↦ T * (3 / 4 : ℝ) ^ q) atTop (𝓝 0) := by
    simpa only [mul_zero] using tendsto_const_nhds.mul
      (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 3 / 4)
        (by norm_num : (3 / 4 : ℝ) < 1))
  have he := (tendsto_order.mp htend).2 τ hτ
  obtain ⟨q, hq, htarget⟩ := ((eventually_gt_atTop (0 : ℕ)).and he).exists
  have hqr : 0 < (q : ℝ) := by exact_mod_cast hq
  obtain ⟨ds, hne, hu, hd, hc, ha⟩ := exists_attenuating_iterate ν hnoise hν cs hcs hT
    (div_pos hη hqr) (div_pos hβ hqr) hupper q
  exact ⟨ds, hne hq, hu.mono htarget.le, hd,
    by simpa only [mul_div_cancel₀ η hqr.ne'] using hc,
    by simpa only [mul_div_cancel₀ β hqr.ne'] using ha⟩

/-- **Cheap attenuation extension.** Every finite cascade with doubling memory
has a nonempty finite extension whose genuine partial-sum `L²` upper slope is
at most any prescribed positive target, while its added square-variation cost
and amplitude are bounded by arbitrary positive budgets.

Only a symmetric probability law with finite second moment is needed. The
initial upper envelope is proved from the explicit global influence envelope;
there is no attenuation premise and no asymptotic-variance assumption. -/
theorem exists_attenuating_extension (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (hnoise : MemLp (fun z : ℝ ↦ z) 2 ν) (hν : SymmetricLaw ν)
    (cs : List Params) (hcs : DoublingMemory cs) {τ η β : ℝ}
    (hτ : 0 < τ) (hη : 0 < η) (hβ : 0 < β) :
    ∃ ds : List Params, ds ≠ [] ∧
      UpperL2 ν (factor (forward (cs ++ ds) 0)) τ ∧
      DoublingMemory (cs ++ ds) ∧ cost (cs ++ ds) ≤ cost cs + η ∧
      amplitude (cs ++ ds) ≤ amplitude cs + β := by
  obtain ⟨T, hT, hupper⟩ := exists_upperL2_forward ν hnoise hν cs
  exact exists_attenuating_extension_of_upper ν hnoise hν cs hcs hT hτ hη hβ hupper

end Cascade.InverseCascade
end


/- Supporting development: Cascade.MeasureClose -/
section
set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal

namespace Cascade

variable {α β ι : Type*} [MeasurableSpace α] [MeasurableSpace β]

/-- Distance at most `e` when tested against measurable functions with values in `[0,1]`.
No finiteness assumption is built into the predicate; applications below use finite measures. -/
def TestClose (P Q : Measure α) (e : ℝ) : Prop :=
  ∀ f : α → ℝ, Measurable f → (∀ x, 0 ≤ f x ∧ f x ≤ 1) →
    |(∫ x, f x ∂P) - ∫ x, f x ∂Q| ≤ e

namespace TestClose

variable {P Q R : Measure α} {e d : ℝ}

theorem nonneg (h : TestClose P Q e) : 0 ≤ e := by
  simpa using h (fun _ ↦ 0) measurable_const (fun _ ↦ by constructor <;> norm_num)

theorem refl (P : Measure α) : TestClose P P 0 := by
  intro f _ _
  simp

theorem mono (h : TestClose P Q e) (hed : e ≤ d) : TestClose P Q d := by
  intro f hf hf01
  exact (h f hf hf01).trans hed

theorem symm (h : TestClose P Q e) : TestClose Q P e := by
  intro f hf hf01
  simpa only [abs_sub_comm] using h f hf hf01

theorem triangle (hPQ : TestClose P Q e) (hQR : TestClose Q R d) :
    TestClose P R (e + d) := by
  intro f hf hf01
  exact (abs_sub_le _ _ _).trans (add_le_add (hPQ f hf hf01) (hQR f hf hf01))

/-- Measurable observations cannot increase test distance. -/
theorem map (h : TestClose P Q e) {g : α → β} (hg : Measurable g) :
    TestClose (P.map g) (Q.map g) e := by
  intro f hf hf01
  rw [integral_map_of_stronglyMeasurable hg hf.stronglyMeasurable,
    integral_map_of_stronglyMeasurable hg hf.stronglyMeasurable]
  exact h (fun x ↦ f (g x)) (hf.comp hg) (fun x ↦ hf01 (g x))

/-- In particular, all measurable event probabilities are close. -/
theorem event (h : TestClose P Q e) {s : Set α} (hs : MeasurableSet s) :
    |P.real s - Q.real s| ≤ e := by
  have hi := h (s.indicator (fun _ ↦ (1 : ℝ))) (measurable_const.indicator hs)
    (fun x ↦ by by_cases hx : x ∈ s <;> simp [hx])
  simpa only [integral_indicator_const (1 : ℝ) hs, smul_eq_mul, mul_one] using hi

theorem event_toReal (h : TestClose P Q e) {s : Set α} (hs : MeasurableSet s) :
    |(P s).toReal - (Q s).toReal| ≤ e := h.event hs

/-- Multiplication by a common nonnegative finite weight. -/
theorem smul (h : TestClose P Q e) (w : ℝ≥0) :
    TestClose (w • P) (w • Q) ((w : ℝ) * e) := by
  intro f hf hf01
  simpa only [integral_smul_nnreal_measure, NNReal.smul_def, smul_eq_mul,
    ← mul_sub, abs_mul, abs_of_nonneg w.coe_nonneg] using
    mul_le_mul_of_nonneg_left (h f hf hf01) w.coe_nonneg

end TestClose

/-- Bounded measurable tests are integrable against a finite measure. -/
theorem integrable_of_test (P : Measure α) [IsFiniteMeasure P] {f : α → ℝ}
    (hf : Measurable f) (hf01 : ∀ x, 0 ≤ f x ∧ f x ≤ 1) : Integrable f P := by
  exact Integrable.of_bound hf.aestronglyMeasurable 1
    (ae_of_all _ fun x ↦ by simpa [Real.norm_eq_abs, abs_of_nonneg (hf01 x).1]
      using (hf01 x).2)

namespace TestClose

/-- Finite sums glue componentwise test bounds. -/
theorem finset_sum (s : Finset ι) {P Q : ι → Measure α} {e : ι → ℝ}
    [∀ i, IsFiniteMeasure (P i)] [∀ i, IsFiniteMeasure (Q i)]
    (h : ∀ i ∈ s, TestClose (P i) (Q i) (e i)) :
    TestClose (∑ i ∈ s, P i) (∑ i ∈ s, Q i) (∑ i ∈ s, e i) := by
  intro f hf hf01
  rw [integral_finset_sum_measure (fun i _ ↦ integrable_of_test (P i) hf hf01),
    integral_finset_sum_measure (fun i _ ↦ integrable_of_test (Q i) hf hf01),
    ← Finset.sum_sub_distrib]
  exact (Finset.abs_sum_le_sum_abs _ _).trans
    (Finset.sum_le_sum fun i hi ↦ h i hi f hf hf01)

/-- A common finite mixture glues bounds with the same weights. -/
theorem finite_mixture (s : Finset ι) (w : ι → ℝ≥0)
    {P Q : ι → Measure α} {e : ι → ℝ}
    [∀ i, IsFiniteMeasure (P i)] [∀ i, IsFiniteMeasure (Q i)]
    (h : ∀ i ∈ s, TestClose (P i) (Q i) (e i)) :
    TestClose (∑ i ∈ s, w i • P i) (∑ i ∈ s, w i • Q i)
      (∑ i ∈ s, (w i : ℝ) * e i) :=
  finset_sum s (fun i hi ↦ (h i hi).smul (w i))

/-- Uniform component bounds remain uniform under a probability mixture. -/
theorem finite_mixture_uniform (s : Finset ι) (w : ι → ℝ≥0)
    {P Q : ι → Measure α} {e : ℝ}
    [∀ i, IsFiniteMeasure (P i)] [∀ i, IsFiniteMeasure (Q i)]
    (hw : ∑ i ∈ s, (w i : ℝ) = 1)
    (h : ∀ i ∈ s, TestClose (P i) (Q i) e) :
    TestClose (∑ i ∈ s, w i • P i) (∑ i ∈ s, w i • Q i) e := by
  simpa only [← Finset.sum_mul, hw, one_mul] using finite_mixture s w h

end TestClose

/-- Expectations of tests are again in `[0,1]`. -/
theorem integral_test_mem_Icc (P : Measure α) [IsProbabilityMeasure P] {f : α → ℝ}
    (hf : Measurable f) (hf01 : ∀ x, 0 ≤ f x ∧ f x ≤ 1) :
    0 ≤ (∫ x, f x ∂P) ∧ (∫ x, f x ∂P) ≤ 1 := by
  refine ⟨integral_nonneg (fun x ↦ (hf01 x).1), ?_⟩
  calc
    (∫ x, f x ∂P) ≤ ∫ _, (1 : ℝ) ∂P :=
      integral_mono (integrable_of_test P hf hf01) (integrable_const 1) (fun x ↦ (hf01 x).2)
    _ = 1 := by simp

namespace TestClose

/-- Integral mixture gluing, retaining the mixing parameter as a latent coordinate.
The component estimate need only hold almost everywhere, and is uniform in the parameter. -/
theorem compProd {μ : Measure α} [IsProbabilityMeasure μ]
    {κ η : Kernel α β} [IsMarkovKernel κ] [IsMarkovKernel η] {e : ℝ}
    (h : ∀ᵐ x ∂μ, TestClose (κ x) (η x) e) :
    TestClose (μ ⊗ₘ κ) (μ ⊗ₘ η) e := by
  intro f hf hf01
  have hκf := integrable_of_test (μ ⊗ₘ κ) hf hf01
  have hηf := integrable_of_test (μ ⊗ₘ η) hf hf01
  have hiκ : Integrable (fun x ↦ ∫ y, f (x, y) ∂κ x) μ :=
    integrable_of_test μ (hf.stronglyMeasurable.integral_kernel_prod_right').measurable
      (fun x ↦ integral_test_mem_Icc (κ x) (hf.comp (measurable_const.prodMk measurable_id))
        (fun y ↦ hf01 (x, y)))
  have hiη : Integrable (fun x ↦ ∫ y, f (x, y) ∂η x) μ :=
    integrable_of_test μ (hf.stronglyMeasurable.integral_kernel_prod_right').measurable
      (fun x ↦ integral_test_mem_Icc (η x) (hf.comp (measurable_const.prodMk measurable_id))
        (fun y ↦ hf01 (x, y)))
  rw [Measure.integral_compProd hκf, Measure.integral_compProd hηf, ← integral_sub hiκ hiη]
  have hb : ∀ᵐ x ∂μ, ‖(∫ y, f (x, y) ∂κ x) - ∫ y, f (x, y) ∂η x‖ ≤ e := by
    filter_upwards [h] with x hx
    exact hx (fun y ↦ f (x, y)) (hf.comp (measurable_const.prodMk measurable_id))
      (fun y ↦ hf01 (x, y))
  simpa only [Real.norm_eq_abs, probReal_univ, mul_one] using
    norm_integral_le_of_norm_le_const hb

/-- Forgetting the latent parameter gives ordinary integral-mixture gluing. -/
theorem mixture {μ : Measure α} [IsProbabilityMeasure μ]
    {κ η : Kernel α β} [IsMarkovKernel κ] [IsMarkovKernel η] {e : ℝ}
    (h : ∀ᵐ x ∂μ, TestClose (κ x) (η x) e) :
    TestClose (κ ∘ₘ μ) (η ∘ₘ μ) e := by
  have hm := (compProd h).map measurable_snd
  change TestClose (μ ⊗ₘ κ).snd (μ ⊗ₘ η).snd e at hm
  simpa only [Measure.snd_compProd] using hm

end TestClose

/-- An integrable nonnegative density gives an elementary `L¹` test bound. -/
theorem testClose_withDensity (P : Measure α) [IsFiniteMeasure P] {D : α → ℝ}
    (hD : Measurable D) (hD0 : ∀ x, 0 ≤ D x) (hDi : Integrable D P) :
    TestClose P (P.withDensity (fun x ↦ ENNReal.ofReal (D x)))
      (∫ x, |D x - 1| ∂P) := by
  intro f hf hf01
  have hfP := integrable_of_test P hf hf01
  have hfb : ∀ᵐ x ∂P, ‖f x‖ ≤ 1 :=
    ae_of_all _ fun x ↦ by simpa [Real.norm_eq_abs, abs_of_nonneg (hf01 x).1] using (hf01 x).2
  have hDf : Integrable (fun x ↦ D x * f x) P := hDi.mul_bdd hf.aestronglyMeasurable hfb
  rw [integral_withDensity_eq_integral_toReal_smul hD.ennreal_ofReal
    (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top) f]
  simp only [ENNReal.toReal_ofReal (hD0 _), smul_eq_mul]
  rw [← integral_sub hfP hDf]
  have hb : ∀ᵐ x ∂P, ‖f x - D x * f x‖ ≤ |D x - 1| := by
    apply ae_of_all
    intro x
    rw [Real.norm_eq_abs, show f x - D x * f x = (1 - D x) * f x by ring,
      abs_mul, abs_of_nonneg (hf01 x).1, abs_sub_comm]
    exact mul_le_of_le_one_right (abs_nonneg _) (hf01 x).2
  exact norm_integral_le_of_norm_le (hDi.sub (integrable_const 1)).abs hb

/-- The real Cauchy--Schwarz inequality, with the square roots exposed for likelihood estimates. -/
theorem integral_abs_mul_le_sqrt_sq {P : Measure α} {f g : α → ℝ}
    (hf : MemLp f 2 P) (hg : MemLp g 2 P) :
    (∫ x, |f x * g x| ∂P) ≤
      Real.sqrt (∫ x, f x ^ 2 ∂P) * Real.sqrt (∫ x, g x ^ 2 ∂P) := by
  have h := integral_mul_norm_le_Lp_mul_Lq Real.HolderConjugate.two_two
    (by simpa using hf) (by simpa using hg)
  simpa only [Real.norm_eq_abs, ← abs_mul, Real.rpow_two, sq_abs, ← Real.sqrt_eq_rpow] using h

private theorem integral_sq_add_const {P : Measure α} [IsProbabilityMeasure P]
    {U : α → ℝ} (hUi : Integrable U P) (hU2i : Integrable (fun x ↦ U x ^ 2) P) (c : ℝ) :
    (∫ x, (U x + c) ^ 2 ∂P) =
      (∫ x, U x ^ 2 ∂P) + (2 * c) * (∫ x, U x ∂P) + c ^ 2 := by
  calc
    (∫ x, (U x + c) ^ 2 ∂P) = ∫ x, (U x ^ 2 + (2 * c) * U x) + c ^ 2 ∂P := by
      apply integral_congr_ae
      exact ae_of_all _ fun x ↦ by ring
    _ = _ := by
      have hsum : Integrable (fun x ↦ U x ^ 2 + (2 * c) * U x) P :=
        hU2i.add (hUi.const_mul (2 * c))
      rw [integral_add hsum (integrable_const (c ^ 2)),
        integral_add hU2i (hUi.const_mul (2 * c)), integral_const_mul]
      simp

/-- Half-likelihood/Cauchy--Schwarz bound, without relative entropy or Pinsker.
If `dQ = U² dP`, `E[U²] = 1`, and `E[U] ≥ exp(-s/8)`, then tests differ by at most `sqrt s`.
The hypotheses themselves imply `s ≥ 0`; no separate sign assumption is needed.
The underlying space can include arbitrary retained latent variables. -/
theorem testClose_of_halfLikelihood {P Q : Measure α} [IsProbabilityMeasure P]
    {U : α → ℝ} {s : ℝ} (hU : Measurable U)
    (hQ : Q = P.withDensity (fun x ↦ ENNReal.ofReal (U x ^ 2)))
    (hU2 : (∫ x, U x ^ 2 ∂P) = 1)
    (hAffinity : Real.exp (-s / 8) ≤ ∫ x, U x ∂P) :
    TestClose P Q (Real.sqrt s) := by
  have hU2i : Integrable (fun x ↦ U x ^ 2) P := by
    by_contra h
    rw [integral_undef h] at hU2
    norm_num at hU2
  have hUL2 : MemLp U 2 P := (memLp_two_iff_integrable_sq hU.aestronglyMeasurable).mpr hU2i
  have hUi : Integrable U P := hUL2.integrable (by norm_num)
  have hm : (∫ x, (U x - 1) ^ 2 ∂P) = 2 - 2 * (∫ x, U x ∂P) := by
    have hh := integral_sq_add_const hUi hU2i (-1)
    simp only [hU2] at hh
    convert hh using 1
    ring
  have hp : (∫ x, (U x + 1) ^ 2 ∂P) = 2 + 2 * (∫ x, U x ∂P) := by
    rw [integral_sq_add_const hUi hU2i, hU2]
    ring
  have hm0 : 0 ≤ 2 - 2 * (∫ x, U x ∂P) := by
    rw [← hm]
    exact integral_nonneg fun x ↦ sq_nonneg (U x - 1)
  have hL1 : (∫ x, |U x ^ 2 - 1| ∂P) ≤ Real.sqrt s := by
    calc
      (∫ x, |U x ^ 2 - 1| ∂P) = ∫ x, |(U x - 1) * (U x + 1)| ∂P := by
        apply integral_congr_ae
        exact ae_of_all _ fun x ↦ by
          dsimp only
          rw [show U x ^ 2 - 1 = (U x - 1) * (U x + 1) by ring]
      _ ≤ Real.sqrt (∫ x, (U x - 1) ^ 2 ∂P) * Real.sqrt (∫ x, (U x + 1) ^ 2 ∂P) :=
        integral_abs_mul_le_sqrt_sq (hUL2.sub (memLp_const 1)) (hUL2.add (memLp_const 1))
      _ = Real.sqrt ((2 - 2 * (∫ x, U x ∂P)) * (2 + 2 * (∫ x, U x ∂P))) := by
        rw [hm, hp, Real.sqrt_mul hm0]
      _ ≤ Real.sqrt s := by
        apply Real.sqrt_le_sqrt
        have he := Real.add_one_le_exp (-s / 8)
        nlinarith [sq_nonneg ((∫ x, U x ∂P) - 1)]
  rw [hQ]
  exact (testClose_withDensity P (hU.pow_const 2) (fun x ↦ sq_nonneg (U x)) hU2i).mono hL1

end Cascade
end


/- Supporting development: Cascade.GaussianTests -/
section
set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal

namespace Cascade

/-- Completing the square for the standard Gaussian density. -/
theorem gaussianPDFReal_standard_tilt (a z : ℝ) :
    gaussianPDFReal 0 1 z * Real.exp (a * z - a ^ 2 / 2) = gaussianPDFReal a 1 z := by
  simp only [gaussianPDFReal, NNReal.coe_one, mul_one, sub_zero]
  rw [mul_assoc, ← Real.exp_add]
  congr 2
  ring

/-- Affine exponentials are integrable against every real Gaussian, including variance zero. -/
theorem integrable_exp_affine_gaussianReal (μ : ℝ) (v : ℝ≥0) (a b : ℝ) :
    Integrable (fun z ↦ Real.exp (a * z + b)) (gaussianReal μ v) := by
  simpa only [Real.exp_add] using
    (integrable_exp_mul_gaussianReal (μ := μ) (v := v) a).mul_const (Real.exp b)

/-- The affine exponential moment of a Gaussian. -/
theorem integral_exp_affine_gaussianReal (μ : ℝ) (v : ℝ≥0) (a b : ℝ) :
    (∫ z, Real.exp (a * z + b) ∂gaussianReal μ v) =
      Real.exp (μ * a + (v : ℝ) * a ^ 2 / 2 + b) := by
  simp only [Real.exp_add, integral_mul_const]
  have hm : (∫ z, Real.exp (a * z) ∂gaussianReal μ v) =
      Real.exp (μ * a + (v : ℝ) * a ^ 2 / 2) := by
    exact congrFun (mgf_id_gaussianReal (μ := μ) (v := v)) a
  rw [hm, Real.exp_add]

/-- The standard Gaussian specialization used for likelihood moments. -/
theorem integral_exp_affine_stdGaussian (a b : ℝ) :
    (∫ z, Real.exp (a * z + b) ∂gaussianReal 0 1) = Real.exp (a ^ 2 / 2 + b) := by
  simpa using integral_exp_affine_gaussianReal 0 1 a b

/-- Uniform minorization weight for shifts in the interval `[-B,B]`. -/
noncomputable def gaussianMinorizationCoeff (B : ℝ) : ℝ :=
  Real.exp (-(B ^ 2)) / Real.sqrt 2

theorem gaussianMinorizationCoeff_pos (B : ℝ) : 0 < gaussianMinorizationCoeff B := by
  unfold gaussianMinorizationCoeff
  positivity

theorem gaussianMinorizationCoeff_lt_one (B : ℝ) : gaussianMinorizationCoeff B < 1 := by
  have hs : (1 : ℝ) < Real.sqrt 2 := by
    have h := Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)
    have h0 := Real.sqrt_nonneg (2 : ℝ)
    nlinarith
  have he : Real.exp (-(B ^ 2)) ≤ 1 := Real.exp_le_one_iff.mpr (neg_nonpos.mpr (sq_nonneg B))
  exact (div_lt_one (by positivity)).mpr (he.trans_lt hs)

/-- The half-variance density in a form useful for minorization. -/
theorem gaussianPDFReal_half (z : ℝ) :
    gaussianPDFReal 0 (1 / 2) z = (Real.sqrt Real.pi)⁻¹ * Real.exp (-(z ^ 2)) := by
  have hv : ((1 / 2 : ℝ≥0) : ℝ) = 1 / 2 := by norm_num
  have hc : 2 * Real.pi * (1 / 2) = Real.pi := by ring
  simp only [gaussianPDFReal, hv, hc, sub_zero]
  norm_num

/-- An explicit pointwise common minorizer for every bounded Gaussian shift. -/
theorem gaussianPDFReal_shift_minorization {B u : ℝ} (hB : 0 ≤ B) (hu : |u| ≤ B) (z : ℝ) :
    gaussianMinorizationCoeff B * gaussianPDFReal 0 (1 / 2) z ≤ gaussianPDFReal 0 1 (z + u) := by
  have hu2 : u ^ 2 ≤ B ^ 2 := by
    simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg u) hB).mpr hu
  have he : -(B ^ 2) - z ^ 2 ≤ -((z + u) ^ 2) / 2 := by
    nlinarith [sq_nonneg (z - u)]
  calc
    gaussianMinorizationCoeff B * gaussianPDFReal 0 (1 / 2) z =
        (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(B ^ 2) - z ^ 2) := by
      rw [gaussianMinorizationCoeff, gaussianPDFReal_half,
        Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2), sub_eq_add_neg, Real.exp_add]
      simp only [mul_inv_rev, div_eq_mul_inv]
      ring
    _ ≤ (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-((z + u) ^ 2) / 2) :=
      mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr he) (by positivity)
    _ = gaussianPDFReal 0 1 (z + u) := by simp [gaussianPDFReal]

/-- Measure minorization of every Gaussian with unit variance and bounded mean. -/
theorem gaussianReal_minorization {B u : ℝ} (hB : 0 ≤ B) (hu : |u| ≤ B) :
    ENNReal.ofReal (gaussianMinorizationCoeff B) • gaussianReal 0 (1 / 2) ≤ gaussianReal u 1 := by
  rw [gaussianReal_of_var_ne_zero 0 (by norm_num : (1 / 2 : ℝ≥0) ≠ 0),
    gaussianReal_of_var_ne_zero u one_ne_zero,
    ← withDensity_smul _ (measurable_gaussianPDF 0 (1 / 2))]
  apply withDensity_mono
  apply ae_of_all
  intro z
  change ENNReal.ofReal (gaussianMinorizationCoeff B) *
      ENNReal.ofReal (gaussianPDFReal 0 (1 / 2) z) ≤ ENNReal.ofReal (gaussianPDFReal u 1 z)
  rw [← ENNReal.ofReal_mul (gaussianMinorizationCoeff_pos B).le]
  apply ENNReal.ofReal_le_ofReal
  simpa only [gaussianPDFReal_add, zero_sub, neg_neg] using
    gaussianPDFReal_shift_minorization hB (u := -u) (by simpa using hu) z

/-- The same minorization stated directly for the pushforward by a shift. -/
theorem map_stdGaussian_minorization {B u : ℝ} (hB : 0 ≤ B) (hu : |u| ≤ B) :
    ENNReal.ofReal (gaussianMinorizationCoeff B) • gaussianReal 0 (1 / 2) ≤
      (gaussianReal 0 1).map (fun z ↦ z + u) := by
  simpa only [gaussianReal_map_add_const, zero_add] using gaussianReal_minorization hB hu

/-- The exponential tilt of the standard Gaussian, as an equality of measures. -/
theorem stdGaussian_withDensity_exp (a : ℝ) :
    (gaussianReal 0 1).withDensity (fun z ↦ ENNReal.ofReal (Real.exp (a * z - a ^ 2 / 2))) =
      gaussianReal a 1 := by
  rw [gaussianReal_of_var_ne_zero 0 one_ne_zero,
    gaussianReal_of_var_ne_zero a one_ne_zero,
    ← withDensity_mul volume (measurable_gaussianPDF 0 1) (by fun_prop)]
  apply withDensity_congr_ae
  apply ae_of_all
  intro z
  change ENNReal.ofReal (gaussianPDFReal 0 1 z) *
      ENNReal.ofReal (Real.exp (a * z - a ^ 2 / 2)) = ENNReal.ofReal (gaussianPDFReal a 1 z)
  rw [← ENNReal.ofReal_mul (gaussianPDFReal_nonneg 0 1 z), gaussianPDFReal_standard_tilt]

/-- The square root of the likelihood for shifting a standard Gaussian by `a`. -/
noncomputable def gaussianHalfLikelihood (a z : ℝ) : ℝ :=
  Real.exp ((a / 2) * z - a ^ 2 / 4)

@[fun_prop]
theorem measurable_gaussianHalfLikelihood (a : ℝ) : Measurable (gaussianHalfLikelihood a) := by
  unfold gaussianHalfLikelihood
  fun_prop

theorem gaussianHalfLikelihood_pos (a z : ℝ) : 0 < gaussianHalfLikelihood a z := Real.exp_pos _

theorem gaussianHalfLikelihood_sq (a z : ℝ) :
    gaussianHalfLikelihood a z ^ 2 = Real.exp (a * z - a ^ 2 / 2) := by
  rw [gaussianHalfLikelihood, ← Real.exp_nat_mul]
  congr 1
  ring

theorem integrable_gaussianHalfLikelihood (a : ℝ) :
    Integrable (gaussianHalfLikelihood a) (gaussianReal 0 1) := by
  simpa only [gaussianHalfLikelihood, sub_eq_add_neg] using
    integrable_exp_affine_gaussianReal 0 1 (a / 2) (-(a ^ 2 / 4))

theorem integrable_gaussianHalfLikelihood_sq (a : ℝ) :
    Integrable (fun z ↦ gaussianHalfLikelihood a z ^ 2) (gaussianReal 0 1) := by
  simp_rw [gaussianHalfLikelihood_sq]
  simpa only [sub_eq_add_neg] using integrable_exp_affine_gaussianReal 0 1 a (-(a ^ 2 / 2))

/-- The Gaussian half-likelihood affinity is exactly `exp(-a²/8)`. -/
theorem integral_gaussianHalfLikelihood (a : ℝ) :
    (∫ z, gaussianHalfLikelihood a z ∂gaussianReal 0 1) = Real.exp (-(a ^ 2) / 8) := by
  simp only [gaussianHalfLikelihood, sub_eq_add_neg]
  rw [integral_exp_affine_stdGaussian]
  congr 1
  ring

theorem integral_gaussianHalfLikelihood_sq (a : ℝ) :
    (∫ z, gaussianHalfLikelihood a z ^ 2 ∂gaussianReal 0 1) = 1 := by
  simp_rw [gaussianHalfLikelihood_sq, sub_eq_add_neg]
  rw [integral_exp_affine_stdGaussian]
  simp

theorem stdGaussian_withDensity_halfLikelihood (a : ℝ) :
    (gaussianReal 0 1).withDensity (fun z ↦ ENNReal.ofReal (gaussianHalfLikelihood a z ^ 2)) =
      gaussianReal a 1 := by
  simpa only [gaussianHalfLikelihood_sq] using stdGaussian_withDensity_exp a

/-- One-step Gaussian shift bound, obtained from the half-likelihood moments. -/
theorem testClose_stdGaussian_shift (a : ℝ) :
    TestClose (gaussianReal 0 1) (gaussianReal a 1) |a| := by
  have h := testClose_of_halfLikelihood (s := a ^ 2)
    (measurable_gaussianHalfLikelihood a)
    (stdGaussian_withDensity_halfLikelihood a).symm (integral_gaussianHalfLikelihood_sq a)
    (integral_gaussianHalfLikelihood a).ge
  simpa only [Real.sqrt_sq_eq_abs] using h

/-- Unit-variance Gaussian laws are Lipschitz in their means for all `[0,1]` tests. -/
theorem testClose_gaussianReal_shift (u v : ℝ) :
    TestClose (gaussianReal u 1) (gaussianReal v 1) |u - v| := by
  have h := (testClose_stdGaussian_shift (v - u)).map (measurable_id'.add_const u)
  simpa only [gaussianReal_map_add_const, zero_add, sub_add_cancel, abs_sub_comm] using h

end Cascade
end


/- Supporting development: Cascade.SpikeNoise -/
section
set_option autoImplicit false

/-
# Mutually exclusive symmetric spikes with Gaussian smoothing

A summable subprobability sequence selects at most one symmetric two-point
spike. The unused mass is placed at zero. Gaussian smoothing is defined on a
product space, retaining the spike as a latent variable. Finite stages keep a
finite set of spikes and return the remaining mass to zero.

Unlike a random series, this construction requires no countable independence
or almost-sure convergence argument. Summability of the weighted squared spike
sizes is precisely the second-moment hypothesis.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace Cascade

/-- Nonnegative, summable spike probabilities with total mass at most one.
Summability is explicit: an unconstrained `tsum` would be zero for a divergent
series and would not express the intended mass bound. -/
structure SpikeWeights where
  p : ℕ → ℝ≥0
  summable : Summable p
  mass_le_one : ∑' i, p i ≤ 1

namespace SpikeWeights

/-- Total probability of selecting a spike. -/
noncomputable def mass (w : SpikeWeights) : ℝ≥0 := ∑' i, w.p i

/-- Unused probability, assigned to the base component. -/
noncomputable def remainder (w : SpikeWeights) : ℝ≥0 := 1 - w.mass

@[simp] theorem remainder_add_mass (w : SpikeWeights) : w.remainder + w.mass = 1 :=
  tsub_add_cancel_of_le w.mass_le_one

/-- Every finite collection of spikes has total probability at most one. -/
theorem sum_le_one (w : SpikeWeights) (s : Finset ℕ) : ∑ i ∈ s, w.p i ≤ 1 :=
  (w.summable.sum_le_tsum s (fun _ _ ↦ zero_le _)).trans w.mass_le_one

/-- Probability of spikes omitted from a finite stage. -/
noncomputable def tailMass (w : SpikeWeights) (s : Finset ℕ) : ℝ≥0 :=
  ∑' i : {i // i ∉ s}, w.p i

end SpikeWeights

section Mixtures

variable {α : Type*} [MeasurableSpace α]

/-- A countable probability mixture, using the base law for the unused mass. -/
noncomputable def spikeMixture (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) : Measure α :=
  w.remainder • μ₀ + Measure.sum (fun i ↦ w.p i • μ i)

/-- A finite stage: retain the components in `s`, putting all remaining mass
back on the base law. -/
noncomputable def spikeMixtureFinset (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) (s : Finset ℕ) : Measure α :=
  (1 - ∑ i ∈ s, w.p i) • μ₀ + ∑ i ∈ s, w.p i • μ i

instance isProbabilityMeasure_spikeMixture (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) [IsProbabilityMeasure μ₀] [∀ i, IsProbabilityMeasure (μ i)] :
    IsProbabilityMeasure (spikeMixture w μ₀ μ) where
  measure_univ := by
    simp only [spikeMixture, Measure.add_apply, Measure.smul_apply, measure_univ,
      ENNReal.smul_def, smul_eq_mul, mul_one, Measure.sum_apply _ MeasurableSet.univ]
    rw [← ENNReal.coe_tsum w.summable, ← ENNReal.coe_add]
    exact_mod_cast w.remainder_add_mass

instance isProbabilityMeasure_spikeMixtureFinset (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) [IsProbabilityMeasure μ₀] [∀ i, IsProbabilityMeasure (μ i)]
    (s : Finset ℕ) : IsProbabilityMeasure (spikeMixtureFinset w μ₀ μ s) where
  measure_univ := by
    simp only [spikeMixtureFinset, Measure.add_apply, Measure.smul_apply, measure_univ,
      ENNReal.smul_def, smul_eq_mul, mul_one, Measure.finset_sum_apply]
    rw [← ENNReal.coe_finset_sum, ← ENNReal.coe_add,
      tsub_add_cancel_of_le (w.sum_le_one s)]
    rfl

/-- Nonnegative integrals split into the weighted component integrals. -/
theorem lintegral_spikeMixture (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) (f : α → ℝ≥0∞) :
    (∫⁻ x, f x ∂spikeMixture w μ₀ μ) =
      (w.remainder : ℝ≥0∞) * (∫⁻ x, f x ∂μ₀) +
        ∑' i, (w.p i : ℝ≥0∞) * ∫⁻ x, f x ∂μ i := by
  simp [spikeMixture, lintegral_add_measure, lintegral_sum_measure,
    lintegral_smul_measure, ENNReal.smul_def, smul_eq_mul]

/-- Every selected component is a submeasure of the full mixture. -/
theorem smul_le_spikeMixture (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) (i : ℕ) : w.p i • μ i ≤ spikeMixture w μ₀ μ :=
  (Measure.le_sum (fun j ↦ w.p j • μ j) i).trans (Measure.le_add_left le_rfl)

end Mixtures

/-- The symmetric probability measure assigning half its mass to each of `q`
and `-q`. This also covers `q = 0`. -/
noncomputable def symmetricSpike (q : ℝ) : Measure ℝ :=
  (1 / 2 : ℝ≥0) • Measure.dirac q + (1 / 2 : ℝ≥0) • Measure.dirac (-q)

instance isProbabilityMeasure_symmetricSpike (q : ℝ) :
    IsProbabilityMeasure (symmetricSpike q) where
  measure_univ := by
    simp only [symmetricSpike, Measure.add_apply, Measure.smul_apply, measure_univ,
      ENNReal.smul_def, smul_eq_mul, mul_one]
    rw [← ENNReal.coe_add]
    norm_num

theorem symmetricLaw_symmetricSpike (q : ℝ) : SymmetricLaw (symmetricSpike q) := by
  simp only [SymmetricLaw, symmetricSpike, Measure.map_add _ _ measurable_neg,
    Measure.map_smul, Measure.map_dirac measurable_neg, neg_neg]
  exact add_comm _ _

/-- Law of one mutually exclusive spike, or zero if no spike is selected. -/
noncomputable def spikeLaw (w : SpikeWeights) (Q : ℕ → ℝ) : Measure ℝ :=
  spikeMixture w (Measure.dirac 0) (fun i ↦ symmetricSpike (Q i))

/-- Finite spike law, with omitted mass returned to zero. -/
noncomputable def spikeLawFinset (w : SpikeWeights) (Q : ℕ → ℝ)
    (s : Finset ℕ) : Measure ℝ :=
  spikeMixtureFinset w (Measure.dirac 0) (fun i ↦ symmetricSpike (Q i)) s

instance isProbabilityMeasure_spikeLaw (w : SpikeWeights) (Q : ℕ → ℝ) :
    IsProbabilityMeasure (spikeLaw w Q) := by
  unfold spikeLaw
  infer_instance

instance isProbabilityMeasure_spikeLawFinset (w : SpikeWeights) (Q : ℕ → ℝ)
    (s : Finset ℕ) : IsProbabilityMeasure (spikeLawFinset w Q s) := by
  unfold spikeLawFinset
  infer_instance

/-- The countable spike law is symmetric. -/
theorem symmetricLaw_spikeLaw (w : SpikeWeights) (Q : ℕ → ℝ) :
    SymmetricLaw (spikeLaw w Q) := by
  change (spikeMixture w (Measure.dirac 0) (fun i ↦ symmetricSpike (Q i))).map
    (fun x : ℝ ↦ -x) = _
  simp only [spikeMixture, Measure.map_add _ _ measurable_neg, Measure.map_smul,
    Measure.map_dirac measurable_neg, neg_zero, Measure.map_sum measurable_neg.aemeasurable]
  congr 1
  exact congrArg Measure.sum (funext fun i ↦
    congrArg (fun μ ↦ w.p i • μ) (symmetricLaw_symmetricSpike (Q i)))

/-- In particular, the spike law is centered. Integrability is established
below under the weighted second-moment hypothesis. -/
theorem integral_id_spikeLaw (w : SpikeWeights) (Q : ℕ → ℝ) :
    (∫ x, x ∂spikeLaw w Q) = 0 :=
  integral_odd_eq_zero (symmetricLaw_spikeLaw w Q) (fun _ ↦ rfl)

/-- Exact second moment of a symmetric two-point spike, at the nonnegative
integral level. -/
theorem lintegral_sq_symmetricSpike (q : ℝ) :
    (∫⁻ x, ENNReal.ofReal (x ^ 2) ∂symmetricSpike q) = ENNReal.ofReal (q ^ 2) := by
  simp only [symmetricSpike, lintegral_add_measure, lintegral_smul_measure,
    lintegral_dirac, neg_sq, ENNReal.smul_def, smul_eq_mul, ← add_mul,
    ← ENNReal.coe_add]
  norm_num

/-- The nonnegative second moment of the spike law is the weighted energy
series, whether or not that series is finite. -/
theorem lintegral_sq_spikeLaw (w : SpikeWeights) (Q : ℕ → ℝ) :
    (∫⁻ x, ENNReal.ofReal (x ^ 2) ∂spikeLaw w Q) =
      ∑' i, ENNReal.ofReal ((w.p i : ℝ) * Q i ^ 2) := by
  simp only [spikeLaw, lintegral_spikeMixture, lintegral_dirac,
    zero_pow (by decide : 2 ≠ 0), ENNReal.ofReal_zero, mul_zero, zero_add,
    lintegral_sq_symmetricSpike, ENNReal.ofReal_mul (w.p _).coe_nonneg,
    ENNReal.ofReal_coe_nnreal]

/-- Finite weighted spike energy gives square integrability. -/
theorem memLp_two_spikeLaw (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) :
    MemLp (fun x : ℝ ↦ x) 2 (spikeLaw w Q) := by
  apply (memLp_two_iff_integrable_sq measurable_id.aestronglyMeasurable).2
  refine ⟨(measurable_id.pow_const 2).aestronglyMeasurable, ?_⟩
  change HasFiniteIntegral (fun x : ℝ ↦ x ^ 2) (spikeLaw w Q)
  rw [hasFiniteIntegral_iff_ofReal (ae_of_all _ fun x ↦ sq_nonneg x),
    lintegral_sq_spikeLaw,
    ← ENNReal.ofReal_tsum_of_nonneg (fun i ↦ mul_nonneg (w.p i).coe_nonneg (sq_nonneg _)) hQ]
  exact ENNReal.ofReal_lt_top

/-- Exact second moment of the spike law. -/
theorem integral_sq_spikeLaw (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) :
    (∫ x, x ^ 2 ∂spikeLaw w Q) = ∑' i, (w.p i : ℝ) * Q i ^ 2 := by
  rw [integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun x ↦ sq_nonneg x)
      (measurable_id.pow_const 2).aestronglyMeasurable,
    lintegral_sq_spikeLaw,
    ← ENNReal.ofReal_tsum_of_nonneg (fun i ↦ mul_nonneg (w.p i).coe_nonneg (sq_nonneg _)) hQ,
    ENNReal.toReal_ofReal (tsum_nonneg fun i ↦ mul_nonneg (w.p i).coe_nonneg (sq_nonneg _))]

/-- Since the spike law is centered, its variance is its weighted energy. -/
theorem variance_spikeLaw (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) :
    variance (fun x : ℝ ↦ x) (spikeLaw w Q) = ∑' i, (w.p i : ℝ) * Q i ^ 2 := by
  rw [variance_eq_sub (memLp_two_spikeLaw w Q hQ), integral_id_spikeLaw]
  simpa using integral_sq_spikeLaw w Q hQ

/-- Add a standard Gaussian to a latent real-valued innovation. The product
representation deliberately retains that latent innovation for finite paths. -/
noncomputable def gaussianConvolution (J : Measure ℝ) : Measure ℝ :=
  ((gaussianReal 0 1).prod J).map (fun p : ℝ × ℝ ↦ p.1 + p.2)

instance isProbabilityMeasure_gaussianConvolution (J : Measure ℝ)
    [IsProbabilityMeasure J] : IsProbabilityMeasure (gaussianConvolution J) := by
  unfold gaussianConvolution
  exact Measure.isProbabilityMeasure_map (by fun_prop)

/-- Symmetry is preserved by convolution with a standard Gaussian. -/
theorem symmetricLaw_gaussianConvolution {J : Measure ℝ} [IsProbabilityMeasure J]
    (hJ : SymmetricLaw J) : SymmetricLaw (gaussianConvolution J) := by
  have hg : SymmetricLaw (gaussianReal 0 1) := by
    simp [SymmetricLaw, gaussianReal_map_neg]
  have hp := (measurePreserving_neg_of_symmetric hg).prod
    (measurePreserving_neg_of_symmetric hJ)
  change (((gaussianReal 0 1).prod J).map (fun p : ℝ × ℝ ↦ p.1 + p.2)).map
    (fun x : ℝ ↦ -x) = _
  rw [Measure.map_map measurable_neg (by fun_prop)]
  calc
    _ = ((gaussianReal 0 1).prod J).map
        ((fun p : ℝ × ℝ ↦ p.1 + p.2) ∘ Prod.map (fun x : ℝ ↦ -x) (fun x : ℝ ↦ -x)) := by
      congr 1
      funext p
      simp [add_comm]
    _ = _ := by
      rw [← Measure.map_map (by fun_prop) hp.measurable, hp.map_eq]
      rfl

/-- Convolution with a standard Gaussian preserves square integrability. -/
theorem memLp_two_gaussianConvolution {J : Measure ℝ} [IsProbabilityMeasure J]
    (hJ : MemLp (fun x : ℝ ↦ x) 2 J) :
    MemLp (fun x : ℝ ↦ x) 2 (gaussianConvolution J) := by
  apply (memLp_map_measure_iff measurable_id.aestronglyMeasurable
    (show Measurable (fun p : ℝ × ℝ ↦ p.1 + p.2) by fun_prop).aemeasurable).2
  exact ((memLp_id_gaussianReal (μ := 0) (v := 1) 2).comp_fst J).add
    (hJ.comp_snd (gaussianReal 0 1))

/-- The variance contributed by Gaussian smoothing is exactly one. -/
theorem variance_gaussianConvolution {J : Measure ℝ} [IsProbabilityMeasure J]
    (hJ : MemLp (fun x : ℝ ↦ x) 2 J) :
    variance (fun x : ℝ ↦ x) (gaussianConvolution J) =
      1 + variance (fun x : ℝ ↦ x) J := by
  change variance id (((gaussianReal 0 1).prod J).map (fun p : ℝ × ℝ ↦ p.1 + p.2)) = _
  rw [variance_id_map (by fun_prop)]
  simpa using variance_add_prod (memLp_id_gaussianReal (μ := 0) (v := 1) 2) hJ

/-- The final Gaussian-convolution noise law. -/
noncomputable def spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ) : Measure ℝ :=
  gaussianConvolution (spikeLaw w Q)

/-- The finite Gaussian-convolution stage on an arbitrary finite set. -/
noncomputable def spikeNoiseFinset (w : SpikeWeights) (Q : ℕ → ℝ)
    (s : Finset ℕ) : Measure ℝ := gaussianConvolution (spikeLawFinset w Q s)

/-- The stage containing exactly the spikes with index less than `j`. -/
noncomputable def spikeNoiseStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) : Measure ℝ :=
  spikeNoiseFinset w Q (Finset.range j)

/-- The corresponding latent, unsmoothed finite stage. -/
noncomputable def spikeLawStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) : Measure ℝ :=
  spikeLawFinset w Q (Finset.range j)

instance isProbabilityMeasure_spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ) :
    IsProbabilityMeasure (spikeNoise w Q) := by unfold spikeNoise; infer_instance

instance isProbabilityMeasure_spikeNoiseFinset (w : SpikeWeights) (Q : ℕ → ℝ)
    (s : Finset ℕ) : IsProbabilityMeasure (spikeNoiseFinset w Q s) := by
  unfold spikeNoiseFinset
  infer_instance

instance isProbabilityMeasure_spikeNoiseStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    IsProbabilityMeasure (spikeNoiseStage w Q j) := by unfold spikeNoiseStage; infer_instance

instance isProbabilityMeasure_spikeLawStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    IsProbabilityMeasure (spikeLawStage w Q j) := by unfold spikeLawStage; infer_instance

theorem symmetricLaw_spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ) :
    SymmetricLaw (spikeNoise w Q) :=
  symmetricLaw_gaussianConvolution (symmetricLaw_spikeLaw w Q)

theorem integral_id_spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ) :
    (∫ x, x ∂spikeNoise w Q) = 0 :=
  integral_odd_eq_zero (symmetricLaw_spikeNoise w Q) (fun _ ↦ rfl)

theorem memLp_two_spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) :
    MemLp (fun x : ℝ ↦ x) 2 (spikeNoise w Q) :=
  memLp_two_gaussianConvolution (memLp_two_spikeLaw w Q hQ)

theorem variance_spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) :
    variance (fun x : ℝ ↦ x) (spikeNoise w Q) = 1 + ∑' i, (w.p i : ℝ) * Q i ^ 2 := by
  rw [spikeNoise, variance_gaussianConvolution (memLp_two_spikeLaw w Q hQ),
    variance_spikeLaw w Q hQ]

theorem integral_sq_spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) :
    (∫ x, x ^ 2 ∂spikeNoise w Q) = 1 + ∑' i, (w.p i : ℝ) * Q i ^ 2 := by
  have h := variance_spikeNoise w Q hQ
  rw [variance_eq_sub (memLp_two_spikeNoise w Q hQ), integral_id_spikeNoise] at h
  simpa using h

section FiniteMoments

/-- Nonnegative integrals of finite stages split into their components. -/
theorem lintegral_spikeMixtureFinset {α : Type*} [MeasurableSpace α]
    (w : SpikeWeights) (μ₀ : Measure α) (μ : ℕ → Measure α) (s : Finset ℕ)
    (f : α → ℝ≥0∞) :
    (∫⁻ x, f x ∂spikeMixtureFinset w μ₀ μ s) =
      ((1 - ∑ i ∈ s, w.p i : ℝ≥0) : ℝ≥0∞) * (∫⁻ x, f x ∂μ₀) +
        ∑ i ∈ s, (w.p i : ℝ≥0∞) * ∫⁻ x, f x ∂μ i := by
  simp [spikeMixtureFinset, lintegral_add_measure, lintegral_finset_sum_measure,
    lintegral_smul_measure, ENNReal.smul_def, smul_eq_mul]

/-- Measurable pushforwards commute with finite-stage mixtures. -/
theorem map_spikeMixtureFinset {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (w : SpikeWeights) (μ₀ : Measure α) (μ : ℕ → Measure α) (s : Finset ℕ)
    {f : α → β} (hf : Measurable f) :
    (spikeMixtureFinset w μ₀ μ s).map f =
      spikeMixtureFinset w (μ₀.map f) (fun i ↦ (μ i).map f) s := by
  simp only [spikeMixtureFinset, Measure.map_add _ _ hf, Measure.map_smul]
  congr 1
  rw [← Measure.sum_coe_finset, Measure.map_sum hf.aemeasurable]
  simp only [Measure.map_smul]
  exact Measure.sum_coe_finset s (fun i ↦ w.p i • (μ i).map f)

theorem symmetricLaw_spikeLawFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    SymmetricLaw (spikeLawFinset w Q s) := by
  change (spikeMixtureFinset w (Measure.dirac 0) (fun i ↦ symmetricSpike (Q i)) s).map
    (fun x : ℝ ↦ -x) = _
  rw [map_spikeMixtureFinset _ _ _ _ measurable_neg]
  simp only [Measure.map_dirac measurable_neg, neg_zero,
    show ∀ q, (symmetricSpike q).map (fun x : ℝ ↦ -x) = symmetricSpike q
      from symmetricLaw_symmetricSpike]
  rfl

theorem integral_id_spikeLawFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    (∫ x, x ∂spikeLawFinset w Q s) = 0 :=
  integral_odd_eq_zero (symmetricLaw_spikeLawFinset w Q s) (fun _ ↦ rfl)

/-- Exact nonnegative second moment of a finite spike law. -/
theorem lintegral_sq_spikeLawFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    (∫⁻ x, ENNReal.ofReal (x ^ 2) ∂spikeLawFinset w Q s) =
      ENNReal.ofReal (∑ i ∈ s, (w.p i : ℝ) * Q i ^ 2) := by
  simp only [spikeLawFinset, lintegral_spikeMixtureFinset, lintegral_dirac,
    zero_pow (by decide : 2 ≠ 0), ENNReal.ofReal_zero, mul_zero, zero_add,
    lintegral_sq_symmetricSpike,
    ENNReal.ofReal_sum_of_nonneg (fun i _ ↦ mul_nonneg (w.p i).coe_nonneg (sq_nonneg _)),
    ENNReal.ofReal_mul (w.p _).coe_nonneg, ENNReal.ofReal_coe_nnreal]

/-- Finite stages are always in `L²`; no infinite-energy hypothesis is needed. -/
theorem memLp_two_spikeLawFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    MemLp (fun x : ℝ ↦ x) 2 (spikeLawFinset w Q s) := by
  apply (memLp_two_iff_integrable_sq measurable_id.aestronglyMeasurable).2
  refine ⟨(measurable_id.pow_const 2).aestronglyMeasurable, ?_⟩
  change HasFiniteIntegral (fun x : ℝ ↦ x ^ 2) (spikeLawFinset w Q s)
  rw [hasFiniteIntegral_iff_ofReal (ae_of_all _ fun x ↦ sq_nonneg x),
    lintegral_sq_spikeLawFinset]
  exact ENNReal.ofReal_lt_top

theorem integral_sq_spikeLawFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    (∫ x, x ^ 2 ∂spikeLawFinset w Q s) = ∑ i ∈ s, (w.p i : ℝ) * Q i ^ 2 := by
  rw [integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun x ↦ sq_nonneg x)
      (measurable_id.pow_const 2).aestronglyMeasurable,
    lintegral_sq_spikeLawFinset,
    ENNReal.toReal_ofReal (Finset.sum_nonneg fun i _ ↦
      mul_nonneg (w.p i).coe_nonneg (sq_nonneg _))]

theorem variance_spikeLawFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    variance (fun x : ℝ ↦ x) (spikeLawFinset w Q s) = ∑ i ∈ s, (w.p i : ℝ) * Q i ^ 2 := by
  rw [variance_eq_sub (memLp_two_spikeLawFinset w Q s), integral_id_spikeLawFinset]
  simpa using integral_sq_spikeLawFinset w Q s

theorem symmetricLaw_spikeNoiseFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    SymmetricLaw (spikeNoiseFinset w Q s) :=
  symmetricLaw_gaussianConvolution (symmetricLaw_spikeLawFinset w Q s)

theorem integral_id_spikeNoiseFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    (∫ x, x ∂spikeNoiseFinset w Q s) = 0 :=
  integral_odd_eq_zero (symmetricLaw_spikeNoiseFinset w Q s) (fun _ ↦ rfl)

theorem memLp_two_spikeNoiseFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    MemLp (fun x : ℝ ↦ x) 2 (spikeNoiseFinset w Q s) :=
  memLp_two_gaussianConvolution (memLp_two_spikeLawFinset w Q s)

theorem variance_spikeNoiseFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    variance (fun x : ℝ ↦ x) (spikeNoiseFinset w Q s) =
      1 + ∑ i ∈ s, (w.p i : ℝ) * Q i ^ 2 := by
  rw [spikeNoiseFinset, variance_gaussianConvolution (memLp_two_spikeLawFinset w Q s),
    variance_spikeLawFinset]

theorem integral_sq_spikeNoiseFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    (∫ x, x ^ 2 ∂spikeNoiseFinset w Q s) = 1 + ∑ i ∈ s, (w.p i : ℝ) * Q i ^ 2 := by
  have h := variance_spikeNoiseFinset w Q s
  rw [variance_eq_sub (memLp_two_spikeNoiseFinset w Q s), integral_id_spikeNoiseFinset] at h
  simpa using h

/-- A convenient uniform squared-`L²` bound. -/
theorem integral_sq_spikeNoise_le (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) {C : ℝ}
    (hC : ∑' i, (w.p i : ℝ) * Q i ^ 2 ≤ C) :
    (∫ x, x ^ 2 ∂spikeNoise w Q) ≤ 1 + C := by
  rw [integral_sq_spikeNoise w Q hQ]
  exact add_le_add le_rfl hC

/-- The same squared-`L²` bound holds uniformly over all finite stages. -/
theorem integral_sq_spikeNoiseFinset_le (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) {C : ℝ}
    (hC : ∑' i, (w.p i : ℝ) * Q i ^ 2 ≤ C) (s : Finset ℕ) :
    (∫ x, x ^ 2 ∂spikeNoiseFinset w Q s) ≤ 1 + C := by
  rw [integral_sq_spikeNoiseFinset]
  exact add_le_add le_rfl ((hQ.sum_le_tsum s (fun i _ ↦
    mul_nonneg (w.p i).coe_nonneg (sq_nonneg _))).trans hC)

end FiniteMoments

section ConvolutionRepresentations

-- Mathlib provides the `ENNReal` scalar instance, but not its `NNReal` alias.
local instance sFinite_nnreal_spike_smul (c : ℝ≥0) (J : Measure ℝ) [SFinite J] :
    SFinite (c • J) := by
  rw [ENNReal.smul_def]
  infer_instance

@[simp] theorem gaussianConvolution_dirac (q : ℝ) :
    gaussianConvolution (Measure.dirac q) = gaussianReal q 1 := by
  rw [gaussianConvolution, Measure.prod_dirac, Measure.map_map (by fun_prop) (by fun_prop)]
  simp only [Function.comp_def, gaussianReal_map_add_const, zero_add]

theorem gaussianConvolution_add (J K : Measure ℝ) [SFinite J] [SFinite K] :
    gaussianConvolution (J + K) = gaussianConvolution J + gaussianConvolution K := by
  simp only [gaussianConvolution, Measure.prod_add,
    Measure.map_add _ _ (show Measurable (fun p : ℝ × ℝ ↦ p.1 + p.2) by fun_prop)]

theorem gaussianConvolution_smul (c : ℝ≥0) (J : Measure ℝ) [SFinite J] :
    gaussianConvolution (c • J) = c • gaussianConvolution J := by
  simp only [gaussianConvolution, ENNReal.smul_def, Measure.prod_smul_right, Measure.map_smul]

theorem gaussianConvolution_sum {ι : Type*} [Countable ι] (J : ι → Measure ℝ)
    [∀ i, SFinite (J i)] :
    gaussianConvolution (Measure.sum J) = Measure.sum (fun i ↦ gaussianConvolution (J i)) := by
  simp only [gaussianConvolution, Measure.prod_sum_right,
    Measure.map_sum (show Measurable (fun p : ℝ × ℝ ↦ p.1 + p.2) by fun_prop).aemeasurable]

theorem gaussianConvolution_finset_sum {ι : Type*} (J : ι → Measure ℝ)
    [∀ i, SFinite (J i)] (s : Finset ι) :
    gaussianConvolution (∑ i ∈ s, J i) = ∑ i ∈ s, gaussianConvolution (J i) := by
  rw [← Measure.sum_coe_finset s J, gaussianConvolution_sum]
  exact Measure.sum_coe_finset s (fun i ↦ gaussianConvolution (J i))

theorem gaussianConvolution_symmetricSpike (q : ℝ) :
    gaussianConvolution (symmetricSpike q) =
      (1 / 2 : ℝ≥0) • gaussianReal q 1 + (1 / 2 : ℝ≥0) • gaussianReal (-q) 1 := by
  rw [symmetricSpike, gaussianConvolution_add, gaussianConvolution_smul,
    gaussianConvolution_smul, gaussianConvolution_dirac, gaussianConvolution_dirac]

theorem gaussianConvolution_spikeMixture (w : SpikeWeights) (J₀ : Measure ℝ)
    (J : ℕ → Measure ℝ) [SFinite J₀] [∀ i, SFinite (J i)] :
    gaussianConvolution (spikeMixture w J₀ J) =
      spikeMixture w (gaussianConvolution J₀) (fun i ↦ gaussianConvolution (J i)) := by
  simp only [spikeMixture, gaussianConvolution_add, gaussianConvolution_smul,
    gaussianConvolution_sum]

theorem gaussianConvolution_spikeMixtureFinset (w : SpikeWeights) (J₀ : Measure ℝ)
    (J : ℕ → Measure ℝ) [SFinite J₀] [∀ i, SFinite (J i)] (s : Finset ℕ) :
    gaussianConvolution (spikeMixtureFinset w J₀ J s) =
      spikeMixtureFinset w (gaussianConvolution J₀) (fun i ↦ gaussianConvolution (J i)) s := by
  letI : SFinite (∑ i ∈ s, w.p i • J i) := by
    rw [← Measure.sum_coe_finset s (fun i ↦ w.p i • J i)]
    infer_instance
  simp only [spikeMixtureFinset, gaussianConvolution_add, gaussianConvolution_smul,
    gaussianConvolution_finset_sum]

/-- The explicit Gaussian-mixture formula for the final law. -/
theorem spikeNoise_eq_gaussianMixture (w : SpikeWeights) (Q : ℕ → ℝ) :
    spikeNoise w Q = w.remainder • gaussianReal 0 1 + Measure.sum (fun i ↦
      (w.p i / 2) • gaussianReal (Q i) 1 + (w.p i / 2) • gaussianReal (-Q i) 1) := by
  rw [spikeNoise, spikeLaw, gaussianConvolution_spikeMixture]
  simp only [gaussianConvolution_dirac, gaussianConvolution_symmetricSpike, spikeMixture,
    smul_add, smul_smul, div_eq_mul_inv, one_mul]

/-- The explicit finite Gaussian mixture, with all omitted mass returned to
the standard Gaussian component. -/
theorem spikeNoiseFinset_eq_gaussianMixture (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    spikeNoiseFinset w Q s = (1 - ∑ i ∈ s, w.p i) • gaussianReal 0 1 + ∑ i ∈ s,
      ((w.p i / 2) • gaussianReal (Q i) 1 + (w.p i / 2) • gaussianReal (-Q i) 1) := by
  rw [spikeNoiseFinset, spikeLawFinset, gaussianConvolution_spikeMixtureFinset]
  simp only [gaussianConvolution_dirac, gaussianConvolution_symmetricSpike, spikeMixtureFinset,
    smul_add, smul_smul, div_eq_mul_inv, one_mul]

/-- The Gaussian-first product representation is definitional. -/
theorem spikeNoise_eq_map_prod (w : SpikeWeights) (Q : ℕ → ℝ) :
    spikeNoise w Q = ((gaussianReal 0 1).prod (spikeLaw w Q)).map
      (fun p : ℝ × ℝ ↦ p.1 + p.2) := rfl

theorem spikeNoiseFinset_eq_map_prod (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    spikeNoiseFinset w Q s = ((gaussianReal 0 1).prod (spikeLawFinset w Q s)).map
      (fun p : ℝ × ℝ ↦ p.1 + p.2) := rfl

/-- The latent-first product representation, convenient for augmented
Gaussian finite-path kernels. -/
theorem gaussianConvolution_eq_map_prod_swap (J : Measure ℝ) [IsProbabilityMeasure J] :
    gaussianConvolution J = (J.prod (gaussianReal 0 1)).map
      (fun p : ℝ × ℝ ↦ p.1 + p.2) := by
  rw [gaussianConvolution,
    ← (Measure.measurePreserving_swap (μ := J) (ν := gaussianReal 0 1)).map_eq,
    Measure.map_map (by fun_prop) measurable_swap]
  congr 1
  funext p
  exact add_comm _ _

end ConvolutionRepresentations

section StageAPI

@[simp] theorem spikeLawFinset_empty (w : SpikeWeights) (Q : ℕ → ℝ) :
    spikeLawFinset w Q ∅ = Measure.dirac 0 := by
  simp [spikeLawFinset, spikeMixtureFinset]

@[simp] theorem spikeNoiseFinset_empty (w : SpikeWeights) (Q : ℕ → ℝ) :
    spikeNoiseFinset w Q ∅ = gaussianReal 0 1 := by
  simp [spikeNoiseFinset]

@[simp] theorem spikeLawStage_zero (w : SpikeWeights) (Q : ℕ → ℝ) :
    spikeLawStage w Q 0 = Measure.dirac 0 := by simp [spikeLawStage]

@[simp] theorem spikeNoiseStage_zero (w : SpikeWeights) (Q : ℕ → ℝ) :
    spikeNoiseStage w Q 0 = gaussianReal 0 1 := by simp [spikeNoiseStage]

theorem symmetricLaw_spikeLawStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    SymmetricLaw (spikeLawStage w Q j) := symmetricLaw_spikeLawFinset w Q _

theorem symmetricLaw_spikeNoiseStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    SymmetricLaw (spikeNoiseStage w Q j) := symmetricLaw_spikeNoiseFinset w Q _

theorem memLp_two_spikeLawStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    MemLp (fun x : ℝ ↦ x) 2 (spikeLawStage w Q j) := memLp_two_spikeLawFinset w Q _

theorem memLp_two_spikeNoiseStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    MemLp (fun x : ℝ ↦ x) 2 (spikeNoiseStage w Q j) := memLp_two_spikeNoiseFinset w Q _

theorem integral_id_spikeNoiseStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    (∫ x, x ∂spikeNoiseStage w Q j) = 0 := integral_id_spikeNoiseFinset w Q _

theorem integral_sq_spikeNoiseStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    (∫ x, x ^ 2 ∂spikeNoiseStage w Q j) =
      1 + ∑ i ∈ Finset.range j, (w.p i : ℝ) * Q i ^ 2 := integral_sq_spikeNoiseFinset w Q _

theorem variance_spikeNoiseStage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    variance (fun x : ℝ ↦ x) (spikeNoiseStage w Q j) =
      1 + ∑ i ∈ Finset.range j, (w.p i : ℝ) * Q i ^ 2 := variance_spikeNoiseFinset w Q _

/-- A finite stage depends only on the probabilities and sizes already
selected, not on future choices in either sequence. -/
theorem spikeLawFinset_congr {w v : SpikeWeights} {Q Q' : ℕ → ℝ} (s : Finset ℕ)
    (hp : ∀ i ∈ s, w.p i = v.p i) (hQ : ∀ i ∈ s, Q i = Q' i) :
    spikeLawFinset w Q s = spikeLawFinset v Q' s := by
  simp only [spikeLawFinset, spikeMixtureFinset]
  have hs : ∑ i ∈ s, w.p i = ∑ i ∈ s, v.p i := Finset.sum_congr rfl hp
  rw [hs]
  congr 1
  exact Finset.sum_congr rfl (fun i hi ↦ by rw [hp i hi, hQ i hi])

theorem spikeNoiseFinset_congr {w v : SpikeWeights} {Q Q' : ℕ → ℝ} (s : Finset ℕ)
    (hp : ∀ i ∈ s, w.p i = v.p i) (hQ : ∀ i ∈ s, Q i = Q' i) :
    spikeNoiseFinset w Q s = spikeNoiseFinset v Q' s :=
  congrArg gaussianConvolution (spikeLawFinset_congr s hp hQ)

theorem spikeNoiseStage_eq_map_prod (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    spikeNoiseStage w Q j = ((gaussianReal 0 1).prod (spikeLawStage w Q j)).map
      (fun p : ℝ × ℝ ↦ p.1 + p.2) := rfl

end StageAPI

section FiniteStageApproximation

namespace SpikeWeights

theorem summable_tail (w : SpikeWeights) (s : Finset ℕ) :
    Summable (fun i : {i // i ∉ s} ↦ w.p i) :=
  NNReal.summable_comp_injective w.summable Subtype.val_injective

theorem sum_add_tailMass (w : SpikeWeights) (s : Finset ℕ) :
    (∑ i ∈ s, w.p i) + w.tailMass s = w.mass := by
  apply NNReal.eq
  simpa only [tailMass, mass, NNReal.coe_add, NNReal.coe_sum, NNReal.coe_tsum] using
    (NNReal.summable_coe.mpr w.summable).sum_add_tsum_subtype_compl s

/-- Omitted mass is exactly the extra base-component mass in a finite stage. -/
theorem remainder_add_tailMass (w : SpikeWeights) (s : Finset ℕ) :
    w.remainder + w.tailMass s = 1 - ∑ i ∈ s, w.p i := by
  apply NNReal.eq
  have h := congrArg (fun x : ℝ≥0 ↦ (x : ℝ)) (w.sum_add_tailMass s)
  simp only [NNReal.coe_add] at h
  rw [NNReal.coe_add, remainder, NNReal.coe_sub (show w.mass ≤ 1 from w.mass_le_one),
    NNReal.coe_sub (w.sum_le_one s), NNReal.coe_one]
  linarith

theorem tailMass_range (w : SpikeWeights) (j : ℕ) :
    w.tailMass (Finset.range j) = ∑' i, w.p (i + j) := by
  apply add_left_cancel (a := ∑ i ∈ Finset.range j, w.p i)
  exact (w.sum_add_tailMass _).trans (NNReal.sum_add_tsum_nat_add j w.summable)

/-- The finite-stage error budgets tend to zero. -/
theorem tendsto_tail_probability (w : SpikeWeights) :
    Tendsto (fun j ↦ ∑' i, (w.p (i + j) : ℝ)) atTop (𝓝 0) :=
  tendsto_sum_nat_add (fun i ↦ (w.p i : ℝ))

end SpikeWeights

variable {α : Type*} [MeasurableSpace α]

/-- The unnormalized mixture of the omitted components. -/
noncomputable def spikeMixtureTail (w : SpikeWeights) (μ : ℕ → Measure α)
    (s : Finset ℕ) : Measure α := Measure.sum (fun i : {i // i ∉ s} ↦ w.p i • μ i)

@[simp] theorem spikeMixtureTail_univ (w : SpikeWeights) (μ : ℕ → Measure α)
    [∀ i, IsProbabilityMeasure (μ i)] (s : Finset ℕ) :
    spikeMixtureTail w μ s Set.univ = (w.tailMass s : ℝ≥0∞) := by
  simp only [spikeMixtureTail, Measure.sum_apply _ MeasurableSet.univ,
    Measure.smul_apply, measure_univ, ENNReal.smul_def, smul_eq_mul, mul_one]
  exact (ENNReal.coe_tsum (w.summable_tail s)).symm

instance isFiniteMeasure_spikeMixtureTail (w : SpikeWeights) (μ : ℕ → Measure α)
    [∀ i, IsProbabilityMeasure (μ i)] (s : Finset ℕ) :
    IsFiniteMeasure (spikeMixtureTail w μ s) := by
  apply (isFiniteMeasure_iff _).2
  rw [spikeMixtureTail_univ]
  exact ENNReal.coe_lt_top

/-- The full and finite mixtures share the original base mass and all
components retained in the finite stage. -/
theorem spikeMixture_eq_add_tail (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) (s : Finset ℕ) :
    spikeMixture w μ₀ μ =
      (w.remainder • μ₀ + ∑ i ∈ s, w.p i • μ i) + spikeMixtureTail w μ s := by
  rw [spikeMixture, add_assoc]
  congr 1
  symm
  rw [← Measure.sum_coe_finset s (fun i ↦ w.p i • μ i)]
  exact Measure.sum_add_sum_compl (s : Set ℕ) (fun i ↦ w.p i • μ i)

theorem spikeMixtureFinset_eq_add_tailMass (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) (s : Finset ℕ) :
    spikeMixtureFinset w μ₀ μ s =
      (w.remainder • μ₀ + ∑ i ∈ s, w.p i • μ i) + w.tailMass s • μ₀ := by
  rw [spikeMixtureFinset, ← w.remainder_add_tailMass s, add_smul]
  exact add_right_comm _ _ _

/-- A bounded test integral lies between zero and the total mass. -/
theorem integral_test_mem_Icc_mass (P : Measure α) [IsFiniteMeasure P] {f : α → ℝ}
    (hf : Measurable f) (hf01 : ∀ x, 0 ≤ f x ∧ f x ≤ 1) :
    0 ≤ (∫ x, f x ∂P) ∧ (∫ x, f x ∂P) ≤ P.real Set.univ := by
  refine ⟨integral_nonneg (fun x ↦ (hf01 x).1), ?_⟩
  calc
    (∫ x, f x ∂P) ≤ ∫ _, (1 : ℝ) ∂P :=
      integral_mono (integrable_of_test P hf hf01) (integrable_const 1) (fun x ↦ (hf01 x).2)
    _ = P.real Set.univ := by simp

/-- A common finite component cancels. Only the masses of the two residual
measures enter the test bound; no optimal-coupling theorem is required. -/
theorem testClose_add_common (C A B : Measure α) [IsFiniteMeasure C]
    [IsFiniteMeasure A] [IsFiniteMeasure B] {e : ℝ}
    (hA : A.real Set.univ ≤ e) (hB : B.real Set.univ ≤ e) :
    TestClose (C + A) (C + B) e := by
  intro f hf hf01
  rw [integral_add_measure (integrable_of_test C hf hf01) (integrable_of_test A hf hf01),
    integral_add_measure (integrable_of_test C hf hf01) (integrable_of_test B hf hf01)]
  have ha := integral_test_mem_Icc_mass A hf hf01
  have hb := integral_test_mem_Icc_mass B hf hf01
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- Finite-stage approximation costs at most the total omitted probability.
The estimate is independent of the locations or sizes of the components. -/
theorem testClose_spikeMixture_finset (w : SpikeWeights) (μ₀ : Measure α)
    (μ : ℕ → Measure α) [IsProbabilityMeasure μ₀] [∀ i, IsProbabilityMeasure (μ i)]
    (s : Finset ℕ) :
    TestClose (spikeMixture w μ₀ μ) (spikeMixtureFinset w μ₀ μ s) (w.tailMass s : ℝ) := by
  rw [spikeMixture_eq_add_tail w μ₀ μ s, spikeMixtureFinset_eq_add_tailMass]
  apply testClose_add_common
  · simp [measureReal_def]
  · simp [measureReal_def, Measure.smul_apply, ENNReal.smul_def]

/-- The latent spike laws themselves are close, so latent spikes can be
retained in subsequent Gaussian finite-path constructions. -/
theorem testClose_spikeLaw_finset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    TestClose (spikeLaw w Q) (spikeLawFinset w Q s) (w.tailMass s : ℝ) :=
  testClose_spikeMixture_finset w (Measure.dirac 0) (fun i ↦ symmetricSpike (Q i)) s

/-- Adding a common independent standard Gaussian contracts test distance. -/
theorem TestClose.gaussianConvolution {J K : Measure ℝ}
    [IsProbabilityMeasure J] [IsProbabilityMeasure K] {e : ℝ} (h : TestClose J K e) :
    TestClose (gaussianConvolution J) (gaussianConvolution K) e := by
  have hp : TestClose ((gaussianReal 0 1).prod J) ((gaussianReal 0 1).prod K) e := by
    simpa only [Measure.compProd_const, Kernel.const_apply] using
      (TestClose.compProd (μ := gaussianReal 0 1) (κ := Kernel.const ℝ J)
        (η := Kernel.const ℝ K) (ae_of_all _ fun _ ↦ h))
  exact hp.map (by fun_prop)

theorem testClose_spikeNoise_finset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    TestClose (spikeNoise w Q) (spikeNoiseFinset w Q s) (w.tailMass s : ℝ) :=
  (testClose_spikeLaw_finset w Q s).gaussianConvolution

theorem testClose_spikeLaw_stage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    TestClose (spikeLaw w Q) (spikeLawStage w Q j) (∑' i, (w.p (i + j) : ℝ)) := by
  simpa only [spikeLawStage, w.tailMass_range, NNReal.coe_tsum] using
    testClose_spikeLaw_finset w Q (Finset.range j)

theorem testClose_spikeNoise_stage (w : SpikeWeights) (Q : ℕ → ℝ) (j : ℕ) :
    TestClose (spikeNoise w Q) (spikeNoiseStage w Q j) (∑' i, (w.p (i + j) : ℝ)) :=
  (testClose_spikeLaw_stage w Q j).gaussianConvolution

end FiniteStageApproximation

section TailEnergy

/-- Squared energy beyond the strict absolute-value cutoff `R`. -/
noncomputable def spikeTailSquare (R : ℝ) : ℝ → ℝ :=
  {x : ℝ | R < |x|}.indicator (fun x ↦ x ^ 2)

/-- Tail second moment of a real law. -/
noncomputable def spikeTailEnergy (μ : Measure ℝ) (R : ℝ) : ℝ :=
  ∫ x, spikeTailSquare R x ∂μ

@[fun_prop] theorem measurable_spikeTailSquare (R : ℝ) : Measurable (spikeTailSquare R) :=
  (measurable_id.pow_const 2).indicator (measurableSet_lt measurable_const measurable_id.abs)

@[simp] theorem spikeTailSquare_of_lt {R x : ℝ} (h : R < |x|) :
    spikeTailSquare R x = x ^ 2 := by simp [spikeTailSquare, h]

@[simp] theorem spikeTailSquare_of_le {R x : ℝ} (h : |x| ≤ R) :
    spikeTailSquare R x = 0 := by simp [spikeTailSquare, not_lt.mpr h]

theorem spikeTailSquare_nonneg (R x : ℝ) : 0 ≤ spikeTailSquare R x := by
  by_cases h : R < |x|
  · rw [spikeTailSquare_of_lt h]
    exact sq_nonneg x
  · simp [spikeTailSquare, h]

theorem spikeTailSquare_le_sq (R x : ℝ) : spikeTailSquare R x ≤ x ^ 2 := by
  by_cases h : R < |x|
  · rw [spikeTailSquare_of_lt h]
  · simpa [spikeTailSquare, h] using sq_nonneg x

@[simp] theorem spikeTailSquare_neg (R x : ℝ) :
    spikeTailSquare R (-x) = spikeTailSquare R x := by
  by_cases h : R < |x| <;> simp [spikeTailSquare, h]

/-- The cutoff of the square of an `L²` observable is integrable. -/
theorem integrable_spikeTailSquare_comp {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {f : α → ℝ} (hf : MemLp f 2 μ) (hfm : Measurable f) (R : ℝ) :
    Integrable (fun x ↦ spikeTailSquare R (f x)) μ := by
  refine Integrable.mono' hf.integrable_sq
    ((measurable_spikeTailSquare R).comp hfm).aestronglyMeasurable ?_
  exact ae_of_all _ fun x ↦ by
    rw [Real.norm_eq_abs, abs_of_nonneg (spikeTailSquare_nonneg _ _)]
    exact spikeTailSquare_le_sq _ _

theorem integrable_spikeTailSquare {μ : Measure ℝ}
    (hμ : MemLp (fun x : ℝ ↦ x) 2 μ) (R : ℝ) : Integrable (spikeTailSquare R) μ :=
  integrable_spikeTailSquare_comp hμ measurable_id R

theorem spikeTailEnergy_nonneg (μ : Measure ℝ) (R : ℝ) : 0 ≤ spikeTailEnergy μ R :=
  integral_nonneg (spikeTailSquare_nonneg R)

theorem spikeTailEnergy_le_secondMoment {μ : Measure ℝ}
    (hμ : MemLp (fun x : ℝ ↦ x) 2 μ) (R : ℝ) :
    spikeTailEnergy μ R ≤ ∫ x, x ^ 2 ∂μ :=
  integral_mono (integrable_spikeTailSquare hμ R) hμ.integrable_sq (spikeTailSquare_le_sq R)

/-- For every base value `z`, one of the two symmetric shifts has magnitude
at least `q`. This elementary fact replaces a Gaussian tail estimate. -/
theorem sq_le_spikeTailSquare_shift_pair {q R : ℝ} (hq : 0 ≤ q) (hR : R < q) (z : ℝ) :
    q ^ 2 ≤ spikeTailSquare R (z + q) + spikeTailSquare R (z - q) := by
  by_cases hz : 0 ≤ z
  · have hqz : q ≤ |z + q| := by
      have h := le_abs_self (z + q)
      linarith
    have hs : q ^ 2 ≤ (z + q) ^ 2 := by
      simpa only [sq_abs] using (sq_le_sq₀ hq (abs_nonneg _)).mpr hqz
    rw [spikeTailSquare_of_lt (hR.trans_le hqz)]
    linarith [spikeTailSquare_nonneg R (z - q)]
  · have hqz : q ≤ |z - q| := by
      rw [abs_of_nonpos (by linarith : z - q ≤ 0)]
      linarith
    have hs : q ^ 2 ≤ (z - q) ^ 2 := by
      simpa only [sq_abs] using (sq_le_sq₀ hq (abs_nonneg _)).mpr hqz
    rw [spikeTailSquare_of_lt (hR.trans_le hqz)]
    linarith [spikeTailSquare_nonneg R (z + q)]

/-- Express the shifted Gaussian tail integral on a common standard-Gaussian
space, so that the two signs can be compared pointwise. -/
theorem spikeTailEnergy_gaussian_shift (q R : ℝ) :
    spikeTailEnergy (gaussianReal q 1) R =
      ∫ z, spikeTailSquare R (z + q) ∂gaussianReal 0 1 := by
  have hm : (gaussianReal 0 1).map (fun z ↦ z + q) = gaussianReal q 1 := by
    simp only [gaussianReal_map_add_const, zero_add]
  rw [spikeTailEnergy, ← hm]
  exact integral_map_of_stronglyMeasurable (by fun_prop)
    (measurable_spikeTailSquare R).stronglyMeasurable

/-- Tail energy of a smoothed symmetric spike is the average of the energies
of its two shifts on the same Gaussian space. -/
theorem spikeTailEnergy_gaussian_pair (q R : ℝ) :
    spikeTailEnergy (gaussianConvolution (symmetricSpike q)) R =
      (1 / 2 : ℝ) * ∫ z,
        (spikeTailSquare R (z + q) + spikeTailSquare R (z - q)) ∂gaussianReal 0 1 := by
  have hi (a : ℝ) : Integrable (spikeTailSquare R) (gaussianReal a 1) :=
    integrable_spikeTailSquare (memLp_id_gaussianReal 2) R
  have hs (a : ℝ) : Integrable (fun z ↦ spikeTailSquare R (z + a)) (gaussianReal 0 1) :=
    integrable_spikeTailSquare_comp
      ((memLp_id_gaussianReal 2).add (memLp_const a)) (by fun_prop) R
  calc
    _ = (1 / 2 : ℝ) * spikeTailEnergy (gaussianReal q 1) R +
        (1 / 2 : ℝ) * spikeTailEnergy (gaussianReal (-q) 1) R := by
      rw [gaussianConvolution_symmetricSpike, spikeTailEnergy,
        integral_add_measure (hi q).smul_measure_nnreal (hi (-q)).smul_measure_nnreal]
      simp only [integral_smul_nnreal_measure, NNReal.smul_def, smul_eq_mul,
        NNReal.coe_div, NNReal.coe_one, NNReal.coe_ofNat, spikeTailEnergy]
    _ = _ := by
      rw [spikeTailEnergy_gaussian_shift, spikeTailEnergy_gaussian_shift,
        integral_add (hs q) (by simpa only [sub_eq_add_neg] using hs (-q))]
      simp only [sub_eq_add_neg]
      ring

/-- A symmetric spike retains at least half its squared size in the tail
whenever the cutoff is smaller than the spike. No lower bound on its size,
and no Gaussian density or Chebyshev estimate, is needed. -/
theorem spikeTailEnergy_gaussian_pair_ge {q R : ℝ} (hq : 0 ≤ q) (hR : R < q) :
    q ^ 2 / 2 ≤ spikeTailEnergy (gaussianConvolution (symmetricSpike q)) R := by
  have hs (a : ℝ) : Integrable (fun z ↦ spikeTailSquare R (z + a)) (gaussianReal 0 1) :=
    integrable_spikeTailSquare_comp
      ((memLp_id_gaussianReal 2).add (memLp_const a)) (by fun_prop) R
  have hi : Integrable (fun z ↦ spikeTailSquare R (z + q) + spikeTailSquare R (z - q))
      (gaussianReal 0 1) := (hs q).add (by simpa only [sub_eq_add_neg] using hs (-q))
  have hb := integral_mono (integrable_const (q ^ 2)) hi (sq_le_spikeTailSquare_shift_pair hq hR)
  simp only [integral_const, probReal_univ, smul_eq_mul, one_mul] at hb
  rw [spikeTailEnergy_gaussian_pair]
  linarith

/-- Each smoothed symmetric spike occurs as an actual weighted submeasure of
the noise, rather than as one term of a potentially cancelling random sum. -/
theorem smul_gaussian_pair_le_spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ) (i : ℕ) :
    w.p i • gaussianConvolution (symmetricSpike (Q i)) ≤ spikeNoise w Q := by
  rw [spikeNoise, spikeLaw, gaussianConvolution_spikeMixture]
  exact smul_le_spikeMixture w _ _ i

/-- **Component tail-energy bound.** A selected symmetric spike alone supplies
at least `pᵢ Qᵢ² / 2` beyond every cutoff strictly smaller than `Qᵢ`. -/
theorem spikeTailEnergy_spikeNoise_ge (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) (i : ℕ)
    {R : ℝ} (hQi : 0 ≤ Q i) (hR : R < Q i) :
    (w.p i : ℝ) * Q i ^ 2 / 2 ≤ spikeTailEnergy (spikeNoise w Q) R := by
  have hc := integral_mono_measure (smul_gaussian_pair_le_spikeNoise w Q i)
    (ae_of_all _ (spikeTailSquare_nonneg R))
    (integrable_spikeTailSquare (memLp_two_spikeNoise w Q hQ) R)
  simp only [integral_smul_nnreal_measure, NNReal.smul_def, smul_eq_mul] at hc
  calc
    _ = (w.p i : ℝ) * (Q i ^ 2 / 2) := by ring
    _ ≤ (w.p i : ℝ) * spikeTailEnergy (gaussianConvolution (symmetricSpike (Q i))) R :=
      mul_le_mul_of_nonneg_left (spikeTailEnergy_gaussian_pair_ge hQi hR) (w.p i).coe_nonneg
    _ ≤ _ := hc

/-- The requested conservative `/8` tail bound, with the convenient hypotheses
`Qᵢ ≥ 4` and `R ≤ Qᵢ/2`. The theorem above gives a stronger `/2` constant. -/
theorem spikeTailEnergy_spikeNoise_ge_eighth (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) (i : ℕ)
    {R : ℝ} (hQi : 4 ≤ Q i) (hR : R ≤ Q i / 2) :
    (w.p i : ℝ) * Q i ^ 2 / 8 ≤ spikeTailEnergy (spikeNoise w Q) R := by
  have h := spikeTailEnergy_spikeNoise_ge w Q hQ i (by linarith) (by linarith : R < Q i)
  have hp : 0 ≤ (w.p i : ℝ) * Q i ^ 2 := mul_nonneg (w.p i).coe_nonneg (sq_nonneg _)
  linarith

end TailEnergy

section NormAndCutoff

private theorem eLpNorm_two_real_eq_sqrt_sq {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {f : α → ℝ} (hf : MemLp f 2 μ) :
    eLpNorm f 2 μ = ENNReal.ofReal (Real.sqrt (∫ x, f x ^ 2 ∂μ)) := by
  have h := hf.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)
  simpa only [ENNReal.toReal_ofNat, Real.norm_eq_abs, Real.rpow_two, sq_abs,
    ← one_div, ← Real.sqrt_eq_rpow] using h

theorem eLpNorm_two_spikeNoise (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) :
    eLpNorm (fun x : ℝ ↦ x) 2 (spikeNoise w Q) =
      ENNReal.ofReal (Real.sqrt (1 + ∑' i, (w.p i : ℝ) * Q i ^ 2)) := by
  rw [eLpNorm_two_real_eq_sqrt_sq (memLp_two_spikeNoise w Q hQ), integral_sq_spikeNoise w Q hQ]

theorem eLpNorm_two_spikeNoiseFinset (w : SpikeWeights) (Q : ℕ → ℝ) (s : Finset ℕ) :
    eLpNorm (fun x : ℝ ↦ x) 2 (spikeNoiseFinset w Q s) =
      ENNReal.ofReal (Real.sqrt (1 + ∑ i ∈ s, (w.p i : ℝ) * Q i ^ 2)) := by
  rw [eLpNorm_two_real_eq_sqrt_sq (memLp_two_spikeNoiseFinset w Q s),
    integral_sq_spikeNoiseFinset]

theorem eLpNorm_two_spikeNoise_le (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) {C : ℝ}
    (hC : ∑' i, (w.p i : ℝ) * Q i ^ 2 ≤ C) :
    eLpNorm (fun x : ℝ ↦ x) 2 (spikeNoise w Q) ≤ ENNReal.ofReal (Real.sqrt (1 + C)) := by
  rw [eLpNorm_two_spikeNoise w Q hQ]
  exact ENNReal.ofReal_le_ofReal (Real.sqrt_le_sqrt (add_le_add le_rfl hC))

theorem eLpNorm_two_spikeNoiseFinset_le (w : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : Summable (fun i ↦ (w.p i : ℝ) * Q i ^ 2)) {C : ℝ}
    (hC : ∑' i, (w.p i : ℝ) * Q i ^ 2 ≤ C) (s : Finset ℕ) :
    eLpNorm (fun x : ℝ ↦ x) 2 (spikeNoiseFinset w Q s) ≤
      ENNReal.ofReal (Real.sqrt (1 + C)) := by
  rw [eLpNorm_two_real_eq_sqrt_sq (memLp_two_spikeNoiseFinset w Q s)]
  exact ENNReal.ofReal_le_ofReal (Real.sqrt_le_sqrt (integral_sq_spikeNoiseFinset_le w Q hQ hC s))

/-- The odd tail observable used to test a bounded-correction partial sum. -/
noncomputable def spikeTailCut (R : ℝ) : ℝ → ℝ :=
  {x : ℝ | R < |x|}.indicator (fun x ↦ x)

@[fun_prop] theorem measurable_spikeTailCut (R : ℝ) : Measurable (spikeTailCut R) :=
  measurable_id.indicator (measurableSet_lt measurable_const measurable_id.abs)

theorem odd_spikeTailCut (R : ℝ) : Function.Odd (spikeTailCut R) := by
  intro x
  by_cases h : R < |x| <;> simp [spikeTailCut, h]

@[simp] theorem sq_spikeTailCut (R x : ℝ) :
    spikeTailCut R x ^ 2 = spikeTailSquare R x := by
  by_cases h : R < |x| <;> simp [spikeTailCut, spikeTailSquare, h]

@[simp] theorem mul_spikeTailCut (R x : ℝ) :
    x * spikeTailCut R x = spikeTailSquare R x := by
  by_cases h : R < |x| <;> simp [spikeTailCut, spikeTailSquare, h, pow_two]

theorem memLp_spikeTailCut {μ : Measure ℝ} {p : ℝ≥0∞}
    (hμ : MemLp (fun x : ℝ ↦ x) p μ) (R : ℝ) : MemLp (spikeTailCut R) p μ :=
  MemLp.indicator (measurableSet_lt measurable_const measurable_id.abs) hμ

/-- Symmetry genuinely centers the integrable tail observable whenever the
original innovation is in `L²` (membership is given by `memLp_spikeTailCut`). -/
theorem integral_spikeTailCut_eq_zero {μ : Measure ℝ} (hμ : SymmetricLaw μ) (R : ℝ) :
    (∫ x, spikeTailCut R x ∂μ) = 0 := integral_odd_eq_zero hμ (odd_spikeTailCut R)

theorem integral_sq_spikeTailCut (μ : Measure ℝ) (R : ℝ) :
    (∫ x, spikeTailCut R x ^ 2 ∂μ) = spikeTailEnergy μ R := by
  simp only [sq_spikeTailCut, spikeTailEnergy]

theorem variance_spikeTailCut {μ : Measure ℝ} [IsProbabilityMeasure μ]
    (hμ : MemLp (fun x : ℝ ↦ x) 2 μ) (hsym : SymmetricLaw μ) (R : ℝ) :
    variance (spikeTailCut R) μ = spikeTailEnergy μ R := by
  rw [variance_eq_sub (memLp_spikeTailCut hμ R), integral_spikeTailCut_eq_zero hsym]
  simpa only [Pi.pow_apply, zero_pow (by decide : 2 ≠ 0), sub_zero] using
    integral_sq_spikeTailCut μ R

/-- Pointwise first-moment control by tail energy, useful for bounding the
covariance contribution of any uniformly bounded correction. -/
theorem abs_spikeTailCut_le_div {R : ℝ} (hR : 0 < R) (x : ℝ) :
    |spikeTailCut R x| ≤ spikeTailSquare R x / R := by
  by_cases hx : R < |x|
  · have hc : spikeTailCut R x = x := by simp [spikeTailCut, hx]
    rw [hc, spikeTailSquare_of_lt hx]
    apply (le_div_iff₀ hR).2
    nlinarith [sq_abs x, abs_nonneg x]
  · simp [spikeTailCut, spikeTailSquare, hx]

end NormAndCutoff

section PrescribedEnergy

namespace SpikeWeights

/-- Turn a summable energy budget into rare spike probabilities by dividing
by the squared sizes. Sizes at least one ensure that the probabilities are
still a subprobability sequence. -/
noncomputable def forSizes (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) :
    SpikeWeights := by
  let p : ℕ → ℝ≥0 := fun i ↦ a.p i / (Q i).toNNReal ^ 2
  have hp : ∀ i, p i ≤ a.p i := by
    intro i
    apply NNReal.coe_le_coe.mp
    change (a.p i : ℝ) / ((Q i).toNNReal : ℝ) ^ 2 ≤ (a.p i : ℝ)
    rw [Real.coe_toNNReal _ (by linarith [hQ i])]
    exact div_le_self (a.p i).coe_nonneg (by nlinarith [hQ i])
  have hs : Summable p := NNReal.summable_coe.mp
    (Summable.of_nonneg_of_le (fun i ↦ (p i).coe_nonneg)
      (fun i ↦ NNReal.coe_le_coe.mpr (hp i)) (NNReal.summable_coe.mpr a.summable))
  exact ⟨p, hs, (hs.tsum_le_tsum hp a.summable).trans a.mass_le_one⟩

@[simp] theorem forSizes_p (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) (i : ℕ) :
    (a.forSizes Q hQ).p i = a.p i / (Q i).toNNReal ^ 2 := rfl

theorem forSizes_p_coe (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) (i : ℕ) :
    ((a.forSizes Q hQ).p i : ℝ) = (a.p i : ℝ) / Q i ^ 2 := by
  rw [forSizes_p, NNReal.coe_div, NNReal.coe_pow, Real.coe_toNNReal _ (by linarith [hQ i])]

@[simp] theorem forSizes_energy (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) (i : ℕ) :
    ((a.forSizes Q hQ).p i : ℝ) * Q i ^ 2 = (a.p i : ℝ) := by
  rw [forSizes_p_coe]
  exact div_mul_cancel₀ _ (pow_ne_zero 2 (by linarith [hQ i]))

theorem summable_forSizes_energy (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) :
    Summable (fun i ↦ ((a.forSizes Q hQ).p i : ℝ) * Q i ^ 2) := by
  simp only [forSizes_energy]
  exact NNReal.summable_coe.mpr a.summable

theorem tsum_forSizes_energy (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) :
    (∑' i, ((a.forSizes Q hQ).p i : ℝ) * Q i ^ 2) = (a.mass : ℝ) := by
  simp only [forSizes_energy, mass, NNReal.coe_tsum]

end SpikeWeights

/-- Prescribing the energy budget automatically supplies the needed `L²`
hypothesis, regardless of how late or how large the sizes were chosen. -/
theorem memLp_two_spikeNoise_forSizes (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) :
    MemLp (fun x : ℝ ↦ x) 2 (spikeNoise (a.forSizes Q hQ) Q) :=
  memLp_two_spikeNoise _ _ (a.summable_forSizes_energy Q hQ)

theorem variance_spikeNoise_forSizes (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) :
    variance (fun x : ℝ ↦ x) (spikeNoise (a.forSizes Q hQ) Q) = 1 + (a.mass : ℝ) := by
  rw [variance_spikeNoise _ _ (a.summable_forSizes_energy Q hQ), a.tsum_forSizes_energy]

/-- All prescribed-energy laws with total energy at most one have `L²` norm
at most `sqrt 2`. -/
theorem eLpNorm_two_spikeNoise_forSizes_le (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) :
    eLpNorm (fun x : ℝ ↦ x) 2 (spikeNoise (a.forSizes Q hQ) Q) ≤ ENNReal.ofReal (Real.sqrt 2) := by
  apply (eLpNorm_two_spikeNoise_le _ _ (a.summable_forSizes_energy Q hQ) (C := 1) ?_).trans_eq
    (by norm_num)
  rw [a.tsum_forSizes_energy]
  exact_mod_cast a.mass_le_one

/-- The same norm bound holds uniformly at every finite stage. -/
theorem eLpNorm_two_spikeNoiseFinset_forSizes_le (a : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : ∀ i, 1 ≤ Q i) (s : Finset ℕ) :
    eLpNorm (fun x : ℝ ↦ x) 2 (spikeNoiseFinset (a.forSizes Q hQ) Q s) ≤
      ENNReal.ofReal (Real.sqrt 2) := by
  apply (eLpNorm_two_spikeNoiseFinset_le _ _ (a.summable_forSizes_energy Q hQ) (C := 1) ?_ s).trans_eq
    (by norm_num)
  rw [a.tsum_forSizes_energy]
  exact_mod_cast a.mass_le_one

/-- In prescribed-energy form, the tail estimate no longer involves the
(probably extremely small) spike probability. -/
theorem spikeTailEnergy_forSizes_ge (a : SpikeWeights) (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i)
    (i : ℕ) {R : ℝ} (hR : R < Q i) :
    (a.p i : ℝ) / 2 ≤ spikeTailEnergy (spikeNoise (a.forSizes Q hQ) Q) R := by
  simpa only [a.forSizes_energy] using
    spikeTailEnergy_spikeNoise_ge (a.forSizes Q hQ) Q (a.summable_forSizes_energy Q hQ)
      i (by linarith [hQ i]) hR

/-- The geometric energy allocation `wᵢ = 2^(-i-1)` has total energy one. -/
theorem hasSum_geometricSpikeEnergy :
    HasSum (fun i : ℕ ↦ (1 / 2 : ℝ≥0) ^ (i + 1)) 1 := by
  have h := (NNReal.hasSum_geometric (r := 1 / 2) (by norm_num)).mul_left (1 / 2)
  convert h using 1
  · funext i
    rw [pow_succ, mul_comm]
  · apply NNReal.coe_injective
    rw [NNReal.coe_mul, NNReal.coe_inv, NNReal.coe_sub (by norm_num)]
    norm_num

/-- A fixed geometric energy budget, to be combined with `forSizes`. -/
noncomputable def geometricSpikeEnergy : SpikeWeights where
  p i := (1 / 2 : ℝ≥0) ^ (i + 1)
  summable := hasSum_geometricSpikeEnergy.summable
  mass_le_one := hasSum_geometricSpikeEnergy.tsum_eq.le

@[simp] theorem geometricSpikeEnergy_p (i : ℕ) :
    geometricSpikeEnergy.p i = (1 / 2 : ℝ≥0) ^ (i + 1) := rfl

@[simp] theorem geometricSpikeEnergy_mass : geometricSpikeEnergy.mass = 1 :=
  hasSum_geometricSpikeEnergy.tsum_eq

/-- The resulting noise has variance exactly two, independently of the sizes. -/
theorem variance_geometricSpikeNoise (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) :
    variance (fun x : ℝ ↦ x) (spikeNoise (geometricSpikeEnergy.forSizes Q hQ) Q) = 2 := by
  rw [variance_spikeNoise_forSizes, geometricSpikeEnergy_mass]
  norm_num

end PrescribedEnergy

section NextSpikeArithmetic

/-- If the preceding scale fits below `16 n`, then the geometric energy of
the next spike cannot be too small relative to `n`. -/
theorem nextSpike_geometric_energy_lower {n : ℝ} {j : ℕ} (hprev : (4 : ℝ) ^ j ≤ 16 * n) :
    (2 : ℝ) ^ j / 32 ≤ n * (1 / 2 : ℝ) ^ (j + 1) := by
  have hp : (0 : ℝ) < (2 : ℝ) ^ j := pow_pos (by norm_num) j
  have hpow : (4 : ℝ) ^ j = (2 : ℝ) ^ j * (2 : ℝ) ^ j := by
    rw [← mul_pow]
    norm_num
  have hinv : (1 / 2 : ℝ) ^ (j + 1) = 1 / (2 * (2 : ℝ) ^ j) := by
    simp [one_div, inv_pow, pow_succ, mul_comm]
  rw [hinv, ← mul_div_assoc, mul_one]
  apply (le_div_iff₀ (mul_pos (by norm_num) hp)).2
  rw [hpow] at hprev
  nlinarith

/-- The preceding-scale condition and a cofinal next-spike index imply
that `n` times the next geometric energy tends to infinity. -/
theorem tendsto_nextSpike_geometric_energy {k : ℕ → ℕ}
    (hk : Tendsto k atTop atTop)
    (hprev : ∀ᶠ n : ℕ in atTop, (4 : ℝ) ^ k n ≤ 16 * (n : ℝ)) :
    Tendsto (fun n : ℕ ↦ (n : ℝ) * (1 / 2 : ℝ) ^ (k n + 1)) atTop atTop := by
  have htwo : Tendsto (fun n ↦ (2 : ℝ) ^ k n / 32) atTop atTop :=
    ((tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 2)).comp hk).atTop_div_const
      (by norm_num)
  exact tendsto_atTop_mono' atTop (hprev.mono fun n hn ↦ nextSpike_geometric_energy_lower hn) htwo

end NextSpikeArithmetic

section NextSpikeSelection

/-- Exponentially growing spike sizes exceed every fixed threshold. -/
theorem exists_spike_above (Q : ℕ → ℝ) (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j) (r : ℝ) :
    ∃ j, r < Q j := by
  have hp : Tendsto (fun j : ℕ ↦ (4 : ℝ) ^ (j + 1)) atTop atTop := by
    simpa only [pow_succ] using
      (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 4)).atTop_mul_const
        (by norm_num : (0 : ℝ) < 4)
  exact ((tendsto_atTop_mono hg hp).eventually_gt_atTop r).exists

/-- The first spike larger than `16 n`. This index is defined for every `n`. -/
noncomputable def nextSpikeIndex (Q : ℕ → ℝ) (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j) (n : ℕ) : ℕ :=
  Nat.find (exists_spike_above Q hg (16 * (n : ℝ)))

/-- The selected spike is above the observation-scale cutoff. -/
theorem nextSpikeIndex_spec (Q : ℕ → ℝ) (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j) (n : ℕ) :
    16 * (n : ℝ) < Q (nextSpikeIndex Q hg n) :=
  Nat.find_spec (exists_spike_above Q hg (16 * (n : ℝ)))

/-- All earlier spikes fit below that cutoff. -/
theorem nextSpikeIndex_min (Q : ℕ → ℝ) (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j) (n : ℕ)
    {j : ℕ} (hj : j < nextSpikeIndex Q hg n) : Q j ≤ 16 * (n : ℝ) :=
  not_lt.mp (Nat.find_min (exists_spike_above Q hg (16 * (n : ℝ))) hj)

/-- Minimality and the growth assumption supply the preceding-scale inequality. -/
theorem pow_nextSpikeIndex_le (Q : ℕ → ℝ) (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j)
    {n : ℕ} (hn : 1 ≤ n) : (4 : ℝ) ^ nextSpikeIndex Q hg n ≤ 16 * (n : ℝ) := by
  cases hk : nextSpikeIndex Q hg n with
  | zero =>
      have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
      simp only [pow_zero]
      linarith
  | succ j =>
      have hj : j < nextSpikeIndex Q hg n := by omega
      exact (hg j).trans (nextSpikeIndex_min Q hg n hj)

/-- The first spike above `16 n` tends to infinity. No monotonicity of `Q`
is required: every finite prefix is eventually below `16 n`. -/
theorem tendsto_nextSpikeIndex (Q : ℕ → ℝ) (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j) :
    Tendsto (nextSpikeIndex Q hg) atTop atTop := by
  have hn : Tendsto (fun n : ℕ ↦ 16 * (n : ℝ)) atTop atTop := by
    simpa only [mul_comm] using
      (tendsto_natCast_atTop_atTop (R := ℝ)).atTop_mul_const (by norm_num : (0 : ℝ) < 16)
  apply tendsto_atTop.2
  intro j
  filter_upwards [hn.eventually_ge_atTop (∑ i ∈ Finset.range j, |Q i|)] with n hn
  by_contra h
  have hlt : nextSpikeIndex Q hg n < j := lt_of_not_ge h
  have hb : Q (nextSpikeIndex Q hg n) ≤ ∑ i ∈ Finset.range j, |Q i| :=
    (le_abs_self _).trans (Finset.single_le_sum (fun i _ ↦ abs_nonneg (Q i))
      (Finset.mem_range.mpr hlt))
  linarith [nextSpikeIndex_spec Q hg n]

/-- For every observation time, use the next spike. Its geometric energy
multiplied by time diverges along the full sequence, not merely a subsequence. -/
theorem tendsto_nextSpike_energy (Q : ℕ → ℝ) (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j) :
    Tendsto (fun n : ℕ ↦ (n : ℝ) * (1 / 2 : ℝ) ^ (nextSpikeIndex Q hg n + 1)) atTop atTop :=
  tendsto_nextSpike_geometric_energy (tendsto_nextSpikeIndex Q hg)
    ((eventually_ge_atTop 1).mono fun _ hn ↦ pow_nextSpikeIndex_le Q hg hn)

/-- **Full-sequence tail-energy growth.** Geometric energy weights and sizes
`Qⱼ ≥ 4^(j+1)` give `n * e(16 n) → ∞`. Comparing a bounded-correction partial
sum variance to this tail energy is a separate process-level argument. -/
theorem tendsto_mul_tailEnergy_geometricSpikeNoise (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i)
    (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j) :
    Tendsto (fun n : ℕ ↦ (n : ℝ) *
      spikeTailEnergy (spikeNoise (geometricSpikeEnergy.forSizes Q hQ) Q) (16 * (n : ℝ)))
      atTop atTop := by
  have hb := (tendsto_nextSpike_energy Q hg).atTop_div_const (by norm_num : (0 : ℝ) < 2)
  refine tendsto_atTop_mono' atTop (Eventually.of_forall fun n ↦ ?_) hb
  have ht := spikeTailEnergy_forSizes_ge geometricSpikeEnergy Q hQ
    (nextSpikeIndex Q hg n) (nextSpikeIndex_spec Q hg n)
  have hm := mul_le_mul_of_nonneg_left ht (Nat.cast_nonneg n : (0 : ℝ) ≤ n)
  simpa only [geometricSpikeEnergy_p, NNReal.coe_pow, NNReal.coe_div,
    NNReal.coe_one, NNReal.coe_ofNat, ← mul_div_assoc] using hm

end NextSpikeSelection

section PrescribedEnergyStages

/-- Altering future sizes does not change the latent finite-stage law,
even though the probabilities are themselves computed from the sizes. -/
theorem spikeLawFinset_forSizes_congr (a : SpikeWeights) {Q Q' : ℕ → ℝ}
    (hQ : ∀ i, 1 ≤ Q i) (hQ' : ∀ i, 1 ≤ Q' i) (s : Finset ℕ)
    (h : ∀ i ∈ s, Q i = Q' i) :
    spikeLawFinset (a.forSizes Q hQ) Q s = spikeLawFinset (a.forSizes Q' hQ') Q' s := by
  apply spikeLawFinset_congr s _ h
  intro i hi
  simp only [a.forSizes_p, h i hi]

theorem spikeNoiseFinset_forSizes_congr (a : SpikeWeights) {Q Q' : ℕ → ℝ}
    (hQ : ∀ i, 1 ≤ Q i) (hQ' : ∀ i, 1 ≤ Q' i) (s : Finset ℕ)
    (h : ∀ i ∈ s, Q i = Q' i) :
    spikeNoiseFinset (a.forSizes Q hQ) Q s = spikeNoiseFinset (a.forSizes Q' hQ') Q' s :=
  congrArg gaussianConvolution (spikeLawFinset_forSizes_congr a hQ hQ' s h)

/-- Explicit tail-probability error after the substitution `pᵢ = wᵢ / Qᵢ²`. -/
theorem testClose_spikeLaw_forSizes_stage (a : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : ∀ i, 1 ≤ Q i) (j : ℕ) :
    TestClose (spikeLaw (a.forSizes Q hQ) Q) (spikeLawStage (a.forSizes Q hQ) Q j)
      (∑' i, (a.p (i + j) : ℝ) / Q (i + j) ^ 2) := by
  simpa only [a.forSizes_p_coe] using testClose_spikeLaw_stage (a.forSizes Q hQ) Q j

theorem testClose_spikeNoise_forSizes_stage (a : SpikeWeights) (Q : ℕ → ℝ)
    (hQ : ∀ i, 1 ≤ Q i) (j : ℕ) :
    TestClose (spikeNoise (a.forSizes Q hQ) Q) (spikeNoiseStage (a.forSizes Q hQ) Q j)
      (∑' i, (a.p (i + j) : ℝ) / Q (i + j) ^ 2) :=
  (testClose_spikeLaw_forSizes_stage a Q hQ j).gaussianConvolution

/-- The cutoff-square notation is exactly the squared value times the tail
indicator appearing in the tail-energy estimate. -/
theorem spikeTailSquare_eq_mul_indicator (R x : ℝ) :
    spikeTailSquare R x = x ^ 2 * {y : ℝ | R < |y|}.indicator (fun _ ↦ (1 : ℝ)) x := by
  by_cases h : R < |x| <;> simp [spikeTailSquare, h]

end PrescribedEnergyStages

end Cascade
end


/- Supporting development: Cascade.VarianceLower -/
section
set_option autoImplicit false

/-
# Partial-sum variance forced by innovation tails

A uniformly bounded **total** correction cannot cancel a sufficiently remote
innovation tail.  The test variable is the sum of the odd tail cutoffs of the
innovations.  Independence gives its variance and its covariance with the raw
innovation sum exactly; the correction is estimated using its uniform bound
and the first moment of the test variable.

The final `/4` estimate follows from `0 ≤ Var(S - T/2)`.  In particular, it does
not require the correction to be odd or the process to be centered.  Separate
centering lemmas record what oddness supplies under a symmetric iid law.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace Cascade

section ProcessSums

/-- The raw innovations at times `0, …, n-1`. -/
def sumInnovations (n : ℕ) (ω : NoisePath) : ℝ :=
  ∑ t ∈ Finset.range n, ω (t : ℤ)

/-- The sum of all predictable corrections in the observation block. -/
def sumProcessDrift (K : Correction) (n : ℕ) (ω : NoisePath) : ℝ :=
  ∑ t ∈ Finset.range n, K (dropPast 1 (history (t : ℤ) ω))

/-- The decomposition uses the total correction, not an individual layer. -/
theorem sumProcess_factor_eq (K : Correction) (n : ℕ) (ω : NoisePath) :
    sumProcess (factor K) n ω = sumInnovations n ω + sumProcessDrift K n ω := by
  simp only [sumProcess, atTime, factor, history, Nat.cast_zero, sub_zero,
    sumInnovations, sumProcessDrift, Finset.sum_add_distrib]

/-- The deterministic drift bound is independent of the sign of the correction. -/
theorem abs_sumProcessDrift_le (K : Correction) (n : ℕ) (ω : NoisePath) :
    |sumProcessDrift K n ω| ≤ (n : ℝ) * ‖K‖ := by
  calc
    _ ≤ ∑ t ∈ Finset.range n, |K (dropPast 1 (history (t : ℤ) ω))| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _t ∈ Finset.range n, ‖K‖ := by
      exact Finset.sum_le_sum fun t _ ↦ by
        simpa only [Real.norm_eq_abs] using K.norm_coe_le_norm (dropPast 1 (history (t : ℤ) ω))
    _ = _ := by simp

theorem abs_sumProcess_factor_sub_sumInnovations_le (K : Correction) {B : ℝ}
    (hK : ‖K‖ ≤ B) (n : ℕ) (ω : NoisePath) :
    |sumProcess (factor K) n ω - sumInnovations n ω| ≤ (n : ℝ) * B := by
  rw [sumProcess_factor_eq, add_sub_cancel_left]
  exact (abs_sumProcessDrift_le K n ω).trans
    (mul_le_mul_of_nonneg_left hK (Nat.cast_nonneg n))

theorem odd_sumProcess {F : Past → ℝ} (hF : Function.Odd F) (n : ℕ) :
    Function.Odd (sumProcess F n) := by
  intro ω
  simp only [Function.Odd] at hF
  simp only [sumProcess, atTime, history_neg, hF, Finset.sum_neg_distrib]

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

theorem memLp_sumProcess_factor (K : Correction) {p : ℝ≥0∞}
    (hnoise : MemLp (fun x : ℝ ↦ x) p ν) (n : ℕ) :
    MemLp (sumProcess (factor K) n) p (iidLaw ℤ ν) :=
  memLp_sumProcess ν (memLp_factor ν K hnoise) n

theorem integral_sumProcess_eq_zero {F : Past → ℝ} (hν : SymmetricLaw ν)
    (hF : Function.Odd F) (n : ℕ) :
    (∫ ω, sumProcess F n ω ∂iidLaw ℤ ν) = 0 :=
  integral_iid_odd_eq_zero ν hν (odd_sumProcess hF n)

theorem integral_sumProcess_factor_eq_zero (K : Correction) (hν : SymmetricLaw ν)
    (hK : Function.Odd (K : Past → ℝ)) (n : ℕ) :
    (∫ ω, sumProcess (factor K) n ω ∂iidLaw ℤ ν) = 0 :=
  integral_sumProcess_eq_zero ν hν (factor_odd K hK) n

theorem sumProcess_factor_integrable_mean_zero (K : Correction)
    (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν) (hν : SymmetricLaw ν)
    (hK : Function.Odd (K : Past → ℝ)) (n : ℕ) :
    Integrable (sumProcess (factor K) n) (iidLaw ℤ ν) ∧
      (∫ ω, sumProcess (factor K) n ω ∂iidLaw ℤ ν) = 0 :=
  ⟨(memLp_sumProcess_factor ν K hnoise n).integrable (by norm_num),
    integral_sumProcess_factor_eq_zero ν K hν hK n⟩

theorem memLp_sumInnovations {p : ℝ≥0∞} (hnoise : MemLp (fun x : ℝ ↦ x) p ν)
    (n : ℕ) : MemLp (sumInnovations n) p (iidLaw ℤ ν) :=
  memLp_finset_sum _ fun t _ ↦
    hnoise.comp_measurePreserving (measurePreserving_iid_eval ν (t : ℤ))

/-- Integration of a measurable single-coordinate observable under an iid law. -/
theorem integral_comp_iid_eval {I : Type*} (i : I) {f : ℝ → ℝ} (hf : Measurable f) :
    (∫ ω, f (ω i) ∂iidLaw I ν) = ∫ x, f x ∂ν :=
  (identDistrib_comp_measurePreserving (measurePreserving_iid_eval ν i) hf).integral_eq

end ProcessSums

section TailTest

/-- The tail witness for a block of length `n`. -/
noncomputable def spikeTailSum (R : ℝ) (n : ℕ) (ω : NoisePath) : ℝ :=
  ∑ t ∈ Finset.range n, spikeTailCut R (ω (t : ℤ))

theorem odd_spikeTailSum (R : ℝ) (n : ℕ) : Function.Odd (spikeTailSum R n) := by
  intro ω
  have hodd : ∀ x, spikeTailCut R (-x) = -spikeTailCut R x := odd_spikeTailCut R
  simp only [spikeTailSum, Pi.neg_apply, hodd, Finset.sum_neg_distrib]

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

theorem memLp_spikeTailSum {p : ℝ≥0∞} (hnoise : MemLp (fun x : ℝ ↦ x) p ν)
    (R : ℝ) (n : ℕ) : MemLp (spikeTailSum R n) p (iidLaw ℤ ν) :=
  memLp_finset_sum _ fun t _ ↦
    (memLp_spikeTailCut hnoise R).comp_measurePreserving
      (measurePreserving_iid_eval ν (t : ℤ))

theorem integral_spikeTailSum_eq_zero (hν : SymmetricLaw ν) (R : ℝ) (n : ℕ) :
    (∫ ω, spikeTailSum R n ω ∂iidLaw ℤ ν) = 0 :=
  integral_iid_odd_eq_zero ν hν (odd_spikeTailSum R n)

/-- Only diagonal innovation/tail products survive.  The off-diagonal case
uses the product-integral identity for independent coordinate observables. -/
theorem integral_iid_eval_mul_spikeTailCut (hν : SymmetricLaw ν) (R : ℝ) (s t : ℤ) :
    (∫ ω : NoisePath, ω s * spikeTailCut R (ω t) ∂iidLaw ℤ ν) =
      if s = t then spikeTailEnergy ν R else 0 := by
  by_cases hst : s = t
  · subst s
    simp only [ite_true, mul_spikeTailCut]
    exact integral_comp_iid_eval ν t (measurable_spikeTailSquare R)
  · rw [if_neg hst]
    have hi := ((iIndepFun_iid ν ℤ).indepFun hst).comp
      measurable_id (measurable_spikeTailCut R)
    have hp := hi.integral_fun_mul_eq_mul_integral
      (measurable_pi_apply s).aestronglyMeasurable
      ((measurable_spikeTailCut R).comp (measurable_pi_apply t)).aestronglyMeasurable
    simpa only [Function.comp_def, id_eq, integral_comp_iid_eval ν t
      (measurable_spikeTailCut R), integral_spikeTailCut_eq_zero hν, mul_zero] using hp

theorem covariance_iid_eval_spikeTailCut (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν)
    (hν : SymmetricLaw ν) (R : ℝ) (s t : ℤ) :
    covariance (fun ω : NoisePath ↦ ω s) (fun ω ↦ spikeTailCut R (ω t)) (iidLaw ℤ ν) =
      if s = t then spikeTailEnergy ν R else 0 := by
  have hx : MemLp (fun ω : NoisePath ↦ ω s) 2 (iidLaw ℤ ν) :=
    hnoise.comp_measurePreserving (measurePreserving_iid_eval ν s)
  have hu : MemLp (fun ω : NoisePath ↦ spikeTailCut R (ω t)) 2 (iidLaw ℤ ν) :=
    (memLp_spikeTailCut hnoise R).comp_measurePreserving (measurePreserving_iid_eval ν t)
  rw [covariance_eq_sub hx hu]
  simp only [Pi.mul_apply, integral_comp_iid_eval ν t (measurable_spikeTailCut R),
    integral_spikeTailCut_eq_zero hν, mul_zero, sub_zero]
  exact integral_iid_eval_mul_spikeTailCut ν hν R s t

/-- The witness variance is exactly the block length times the tail energy. -/
theorem variance_spikeTailSum (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν)
    (hν : SymmetricLaw ν) (R : ℝ) (n : ℕ) :
    variance (spikeTailSum R n) (iidLaw ℤ ν) = (n : ℝ) * spikeTailEnergy ν R := by
  have hm (t : ℕ) : MemLp (fun ω : NoisePath ↦ spikeTailCut R (ω (t : ℤ))) 2
      (iidLaw ℤ ν) := (memLp_spikeTailCut hnoise R).comp_measurePreserving
        (measurePreserving_iid_eval ν (t : ℤ))
  have hi : Set.Pairwise (↑(Finset.range n) : Set ℕ) (fun s t ↦
      IndepFun (fun ω : NoisePath ↦ spikeTailCut R (ω (s : ℤ)))
        (fun ω ↦ spikeTailCut R (ω (t : ℤ))) (iidLaw ℤ ν)) := by
    intro s _ t _ hst
    exact ((iIndepFun_iid ν ℤ).indepFun (by exact_mod_cast hst)).comp
      (measurable_spikeTailCut R) (measurable_spikeTailCut R)
  have hv (t : ℕ) : variance (fun ω : NoisePath ↦ spikeTailCut R (ω (t : ℤ)))
      (iidLaw ℤ ν) = spikeTailEnergy ν R := by
    rw [(measurePreserving_iid_eval ν (t : ℤ)).variance_fun_comp
      (measurable_spikeTailCut R).aemeasurable, variance_spikeTailCut hnoise hν]
  unfold spikeTailSum
  simpa only [Finset.sum_fn, hv, Finset.sum_const, Finset.card_range,
    nsmul_eq_mul] using IndepFun.variance_sum (fun t _ ↦ hm t) hi

/-- Exact covariance of the uncorrected block with its tail witness. -/
theorem covariance_sumInnovations_spikeTailSum (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν)
    (hν : SymmetricLaw ν) (R : ℝ) (n : ℕ) :
    covariance (sumInnovations n) (spikeTailSum R n) (iidLaw ℤ ν) =
      (n : ℝ) * spikeTailEnergy ν R := by
  have hx (t : ℕ) : MemLp (fun ω : NoisePath ↦ ω (t : ℤ)) 2 (iidLaw ℤ ν) :=
    hnoise.comp_measurePreserving (measurePreserving_iid_eval ν (t : ℤ))
  have hu (t : ℕ) : MemLp (fun ω : NoisePath ↦ spikeTailCut R (ω (t : ℤ))) 2
      (iidLaw ℤ ν) := (memLp_spikeTailCut hnoise R).comp_measurePreserving
        (measurePreserving_iid_eval ν (t : ℤ))
  unfold sumInnovations spikeTailSum
  rw [covariance_fun_sum_fun_sum' (fun t _ ↦ hx t) (fun t _ ↦ hu t)]
  simp_rw [covariance_iid_eval_spikeTailCut ν hnoise hν, Int.natCast_inj]
  simp only [Finset.sum_ite_eq, Finset.mem_range]
  rw [Finset.sum_congr rfl (fun t ht ↦ if_pos (Finset.mem_range.mp ht))]
  simp

/-- The same identity as an uncentered product integral, since the witness is centered. -/
theorem integral_sumInnovations_mul_spikeTailSum (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν)
    (hν : SymmetricLaw ν) (R : ℝ) (n : ℕ) :
    (∫ ω, sumInnovations n ω * spikeTailSum R n ω ∂iidLaw ℤ ν) =
      (n : ℝ) * spikeTailEnergy ν R := by
  have h := covariance_sumInnovations_spikeTailSum ν hnoise hν R n
  rw [covariance_eq_sub (memLp_sumInnovations ν hnoise n) (memLp_spikeTailSum ν hnoise R n),
    integral_spikeTailSum_eq_zero ν hν, mul_zero, sub_zero] at h
  exact h

/-- The first moment of one tail cutoff is at most its energy divided by the cutoff. -/
theorem integral_abs_spikeTailCut_le (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν)
    {R : ℝ} (hR : 0 < R) :
    (∫ x, |spikeTailCut R x| ∂ν) ≤ spikeTailEnergy ν R / R := by
  calc
    _ ≤ ∫ x, spikeTailSquare R x / R ∂ν :=
      integral_mono ((memLp_spikeTailCut hnoise R).integrable (by norm_num)).abs
        ((integrable_spikeTailSquare hnoise R).div_const R) (abs_spikeTailCut_le_div hR)
    _ = _ := integral_div R (spikeTailSquare R)

/-- The triangle inequality, deliberately using first rather than second moments. -/
theorem integral_abs_spikeTailSum_le (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν)
    {R : ℝ} (hR : 0 < R) (n : ℕ) :
    (∫ ω, |spikeTailSum R n ω| ∂iidLaw ℤ ν) ≤ (n : ℝ) * spikeTailEnergy ν R / R := by
  have hm (t : ℕ) : Integrable (fun ω : NoisePath ↦ |spikeTailCut R (ω (t : ℤ))|)
      (iidLaw ℤ ν) :=
    (((memLp_spikeTailCut hnoise R).comp_measurePreserving
      (measurePreserving_iid_eval ν (t : ℤ))).integrable (by norm_num)).abs
  calc
    _ ≤ ∫ ω : NoisePath, ∑ t ∈ Finset.range n, |spikeTailCut R (ω (t : ℤ))| ∂iidLaw ℤ ν :=
      integral_mono ((memLp_spikeTailSum ν hnoise R n).integrable (by norm_num)).abs
        (integrable_finset_sum _ fun t _ ↦ hm t)
        (fun ω ↦ Finset.abs_sum_le_sum_abs _ _)
    _ = (n : ℝ) * ∫ x, |spikeTailCut R x| ∂ν := by
      rw [integral_finset_sum _ fun t _ ↦ hm t]
      simp only [integral_comp_iid_eval ν _ (measurable_spikeTailCut R).abs,
        Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    _ ≤ (n : ℝ) * (spikeTailEnergy ν R / R) :=
      mul_le_mul_of_nonneg_left (integral_abs_spikeTailCut_le ν hnoise hR) (Nat.cast_nonneg n)
    _ = _ := by ring

end TailTest

section BoundedDrift

/-- A division-free form of the covariance lower-bound argument.  This also
covers a witness of variance zero. -/
theorem quarter_variance_le_of_half_variance_le_covariance
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsFiniteMeasure μ]
    {S T : Ω → ℝ} (hS : MemLp S 2 μ) (hT : MemLp T 2 μ)
    (hcov : variance T μ / 2 ≤ covariance S T μ) :
    variance T μ / 4 ≤ variance S μ := by
  have h := variance_nonneg (fun ω ↦ S ω - (1 / 2 : ℝ) * T ω) μ
  rw [variance_fun_sub hS (hT.const_mul (1 / 2)), covariance_const_mul_right,
    variance_const_mul] at h
  linarith

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- The error in testing a bounded drift against the tail witness. -/
theorem abs_integral_mul_spikeTailSum_le (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν)
    {D : NoisePath → ℝ} (hD : MemLp D 2 (iidLaw ℤ ν)) {A R : ℝ}
    (hA : 0 ≤ A) (hR : 0 < R) (hbound : ∀ ω, |D ω| ≤ A) (n : ℕ) :
    |∫ ω, D ω * spikeTailSum R n ω ∂iidLaw ℤ ν| ≤
      A * ((n : ℝ) * spikeTailEnergy ν R / R) := by
  have hT := memLp_spikeTailSum ν hnoise R n
  calc
    _ ≤ ∫ ω, |D ω * spikeTailSum R n ω| ∂iidLaw ℤ ν := by
      simpa only [Real.norm_eq_abs] using
        norm_integral_le_integral_norm (fun ω ↦ D ω * spikeTailSum R n ω)
    _ ≤ ∫ ω, A * |spikeTailSum R n ω| ∂iidLaw ℤ ν :=
      integral_mono (hD.integrable_mul hT).abs
        ((hT.integrable (by norm_num)).abs.const_mul A) (fun ω ↦ by
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_right (hbound ω) (abs_nonneg _))
    _ = A * ∫ ω, |spikeTailSum R n ω| ∂iidLaw ℤ ν := integral_const_mul _ _
    _ ≤ _ := mul_le_mul_of_nonneg_left (integral_abs_spikeTailSum_le ν hnoise hR n) hA

/-- The raw-sum covariance `n e` loses at most `A * n e / R` when an arbitrary
path-dependent drift of absolute size at most `A` is added. -/
theorem integral_mul_spikeTailSum_ge_of_bounded_drift
    (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν) (hν : SymmetricLaw ν) (n : ℕ)
    {S : NoisePath → ℝ} (hS : MemLp S 2 (iidLaw ℤ ν)) {A R : ℝ}
    (hA : 0 ≤ A) (hR : 0 < R) (hbound : ∀ ω, |S ω - sumInnovations n ω| ≤ A) :
    (n : ℝ) * spikeTailEnergy ν R * (1 - A / R) ≤
      ∫ ω, S ω * spikeTailSum R n ω ∂iidLaw ℤ ν := by
  have hX := memLp_sumInnovations ν hnoise n
  have hT := memLp_spikeTailSum ν hnoise R n
  have hD : MemLp (fun ω ↦ S ω - sumInnovations n ω) 2 (iidLaw ℤ ν) := hS.sub hX
  have he := abs_integral_mul_spikeTailSum_le ν hnoise hD hA hR hbound n
  have hdecomp : (∫ ω, S ω * spikeTailSum R n ω ∂iidLaw ℤ ν) =
      (n : ℝ) * spikeTailEnergy ν R +
        ∫ ω, (S ω - sumInnovations n ω) * spikeTailSum R n ω ∂iidLaw ℤ ν := by
    calc
      _ = ∫ ω, sumInnovations n ω * spikeTailSum R n ω +
          (S ω - sumInnovations n ω) * spikeTailSum R n ω ∂iidLaw ℤ ν := by
        apply integral_congr_ae
        exact ae_of_all _ fun ω ↦ by ring
      _ = _ := by
        simpa only [Pi.mul_apply, integral_sumInnovations_mul_spikeTailSum ν hnoise hν]
          using integral_add (hX.integrable_mul hT) (hD.integrable_mul hT)
  rw [hdecomp]
  calc
    _ = (n : ℝ) * spikeTailEnergy ν R - A * ((n : ℝ) * spikeTailEnergy ν R / R) := by ring
    _ ≤ _ := by linarith [(abs_le.mp he).1]

/-- **Bounded-total-drift variance lower bound.** No independence or
predictability of the drift, and no centering of `S`, is needed. -/
theorem variance_ge_tailEnergy_of_bounded_drift
    (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν) (hν : SymmetricLaw ν) (n : ℕ)
    {S : NoisePath → ℝ} (hS : MemLp S 2 (iidLaw ℤ ν)) {A R : ℝ}
    (hA : 0 ≤ A) (hR : 0 < R) (hbound : ∀ ω, |S ω - sumInnovations n ω| ≤ A)
    (hscale : 2 * A ≤ R) :
    (n : ℝ) * spikeTailEnergy ν R / 4 ≤ variance S (iidLaw ℤ ν) := by
  have hT := memLp_spikeTailSum ν hnoise R n
  have hratio : A / R ≤ (1 / 2 : ℝ) := (div_le_iff₀ hR).2 (by linarith)
  have hcov : variance (spikeTailSum R n) (iidLaw ℤ ν) / 2 ≤
      covariance S (spikeTailSum R n) (iidLaw ℤ ν) := by
    rw [variance_spikeTailSum ν hnoise hν, covariance_eq_sub hS hT,
      integral_spikeTailSum_eq_zero ν hν, mul_zero, sub_zero]
    calc
      (n : ℝ) * spikeTailEnergy ν R / 2 =
          (n : ℝ) * spikeTailEnergy ν R * (1 / 2) := by ring
      _ ≤ (n : ℝ) * spikeTailEnergy ν R * (1 - A / R) :=
        mul_le_mul_of_nonneg_left (by linarith)
          (mul_nonneg (Nat.cast_nonneg n) (spikeTailEnergy_nonneg ν R))
      _ ≤ _ := integral_mul_spikeTailSum_ge_of_bounded_drift ν hnoise hν n hS hA hR hbound
  simpa only [variance_spikeTailSum ν hnoise hν] using
    quarter_variance_le_of_half_variance_le_covariance hS hT hcov

/-- A bounded continuous correction gives the required total drift bound `n B`.
The cutoff need only satisfy `R ≥ 2 n B` and `R > 0`. -/
theorem variance_sumProcess_factor_ge_tailEnergy (K : Correction)
    (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν) (hν : SymmetricLaw ν) {B R : ℝ}
    (hK : ‖K‖ ≤ B) (n : ℕ) (hR : 0 < R) (hscale : 2 * (n : ℝ) * B ≤ R) :
    (n : ℝ) * spikeTailEnergy ν R / 4 ≤
      variance (sumProcess (factor K) n) (iidLaw ℤ ν) :=
  variance_ge_tailEnergy_of_bounded_drift ν hnoise hν n
    (memLp_sumProcess_factor ν K hnoise n)
    (mul_nonneg (Nat.cast_nonneg n) ((norm_nonneg K).trans hK)) hR
    (abs_sumProcess_factor_sub_sumInnovations_le K hK n) (by simpa only [mul_assoc] using hscale)

/-- The observation-scale cutoff used by the geometric spike construction. -/
theorem variance_sumProcess_factor_ge_tailEnergy_16n (K : Correction)
    (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν) (hν : SymmetricLaw ν)
    (hK : ‖K‖ ≤ 1) (n : ℕ) (hn : 1 ≤ n) :
    (n : ℝ) * spikeTailEnergy ν (16 * (n : ℝ)) / 4 ≤
      variance (sumProcess (factor K) n) (iidLaw ℤ ν) := by
  have hn' : (0 : ℝ) < n := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hn)
  exact variance_sumProcess_factor_ge_tailEnergy ν K hnoise hν hK n
    (by positivity) (by nlinarith)

end BoundedDrift

section VarianceDivergence

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- Tail-energy growth forces variance growth along the whole time sequence,
not just along selected spike scales. -/
theorem tendsto_variance_sumProcess_factor_of_tailEnergy (K : Correction)
    (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν) (hν : SymmetricLaw ν) (hK : ‖K‖ ≤ 1)
    (htail : Tendsto (fun n : ℕ ↦ (n : ℝ) * spikeTailEnergy ν (16 * (n : ℝ)))
      atTop atTop) :
    Tendsto (fun n : ℕ ↦ variance (sumProcess (factor K) n) (iidLaw ℤ ν)) atTop atTop :=
  tendsto_atTop_mono' atTop
    ((eventually_ge_atTop 1).mono fun n hn ↦
      variance_sumProcess_factor_ge_tailEnergy_16n ν K hnoise hν hK n hn)
    (htail.atTop_div_const (by norm_num : (0 : ℝ) < 4))

/-- The full geometric prescribed-energy noise has diverging process variance
for every correction of norm at most one.  The sizes need not be monotone. -/
theorem tendsto_variance_sumProcess_factor_geometricSpikeNoise
    (Q : ℕ → ℝ) (hQ : ∀ i, 1 ≤ Q i) (hg : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j)
    (K : Correction) (hK : ‖K‖ ≤ 1) :
    Tendsto (fun n : ℕ ↦ variance (sumProcess (factor K) n)
      (iidLaw ℤ (spikeNoise (geometricSpikeEnergy.forSizes Q hQ) Q))) atTop atTop :=
  tendsto_variance_sumProcess_factor_of_tailEnergy _ K
    (memLp_two_spikeNoise_forSizes geometricSpikeEnergy Q hQ)
    (symmetricLaw_spikeNoise _ _) hK (tendsto_mul_tailEnergy_geometricSpikeNoise Q hQ hg)

end VarianceDivergence

section VarianceNorm

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
  {S : Ω → ℝ}

/-- The variance/`L²` bridge with its mean term exposed.  `MemLp` rules out
using the default value `∞.toReal = 0` as an ordinary norm. -/
theorem variance_eq_toReal_eLpNorm_two_sq_sub (hS : MemLp S 2 μ) :
    variance S μ = (eLpNorm S 2 μ).toReal ^ 2 - (∫ ω, S ω ∂μ) ^ 2 := by
  simpa only [toReal_eLpNorm_two_sq hS, Pi.pow_apply] using variance_eq_sub hS

/-- The upper variance bound does not require centering. -/
theorem variance_le_toReal_eLpNorm_two_sq (hS : MemLp S 2 μ) :
    variance S μ ≤ (eLpNorm S 2 μ).toReal ^ 2 := by
  rw [variance_eq_toReal_eLpNorm_two_sq_sub hS]
  exact sub_le_self _ (sq_nonneg _)

/-- For a centered observable the variance is exactly its genuine squared `L²` norm. -/
theorem variance_eq_toReal_eLpNorm_two_sq_of_integral_eq_zero (hS : MemLp S 2 μ)
    (hzero : (∫ ω, S ω ∂μ) = 0) :
    variance S μ = (eLpNorm S 2 μ).toReal ^ 2 := by
  rw [variance_eq_toReal_eLpNorm_two_sq_sub hS, hzero]
  simp

end VarianceNorm

/-- The centered variance formula for the actual causal process. -/
theorem variance_sumProcess_factor_eq_toReal_eLpNorm_two_sq
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (K : Correction)
    (hnoise : MemLp (fun x : ℝ ↦ x) 2 ν) (hν : SymmetricLaw ν)
    (hK : Function.Odd (K : Past → ℝ)) (n : ℕ) :
    variance (sumProcess (factor K) n) (iidLaw ℤ ν) =
      (eLpNorm (sumProcess (factor K) n) 2 (iidLaw ℤ ν)).toReal ^ 2 :=
  variance_eq_toReal_eLpNorm_two_sq_of_integral_eq_zero
    (memLp_sumProcess_factor ν K hnoise n) (integral_sumProcess_factor_eq_zero ν K hν hK n)

section UpperVariance

variable {ν : Measure ℝ} [IsProbabilityMeasure ν] {F : Past → ℝ} {τ : ℝ}

/-- Absorb the fixed `UpperL2` boundary error into the square-root term.
If `C` is its boundary constant, `n ≥ (4 C / τ)²` is sufficient.  In fact
centering is unnecessary, since variance is bounded by the second moment. -/
theorem UpperL2.eventually_variance_le (h : UpperL2 ν F τ) (hτ : 0 < τ) :
    ∀ᶠ n : ℕ in atTop,
      variance (sumProcess F n) (iidLaw ℤ ν) ≤ 2 * (n : ℝ) * τ ^ 2 := by
  obtain ⟨C, _hC, hbound⟩ := h.bound
  filter_upwards [(tendsto_natCast_atTop_atTop (R := ℝ)).eventually_ge_atTop
    ((4 * C / τ) ^ 2)] with n hn
  have hs : 4 * C / τ ≤ Real.sqrt (n : ℝ) := Real.le_sqrt_of_sq_le hn
  have hscale : 4 * C ≤ τ * Real.sqrt (n : ℝ) := by
    simpa only [mul_comm] using (div_le_iff₀ hτ).1 hs
  have hb : (eLpNorm (sumProcess F n) 2 (iidLaw ℤ ν)).toReal ≤
      (5 / 4 : ℝ) * (τ * Real.sqrt (n : ℝ)) := by linarith [hbound n]
  have hsq := (sq_le_sq₀ ENNReal.toReal_nonneg (by positivity)).2 hb
  have htsq : (τ * Real.sqrt (n : ℝ)) ^ 2 = (n : ℝ) * τ ^ 2 := by
    rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg n), mul_comm]
  rw [mul_pow, htsq] at hsq
  calc
    _ ≤ (eLpNorm (sumProcess F n) 2 (iidLaw ℤ ν)).toReal ^ 2 :=
      variance_le_toReal_eLpNorm_two_sq (h.memLp n)
    _ ≤ _ := by nlinarith [mul_nonneg (Nat.cast_nonneg n) (sq_nonneg τ)]

/-- Threshold form for choosing the observation times of finite-stage signals. -/
theorem UpperL2.exists_eventual_variance_le (h : UpperL2 ν F τ) (hτ : 0 < τ) :
    ∃ N : ℕ, ∀ n ≥ N,
      variance (sumProcess F n) (iidLaw ℤ ν) ≤ 2 * (n : ℝ) * τ ^ 2 :=
  eventually_atTop.1 (h.eventually_variance_le hτ)

/-- A finite-core observation time can satisfy any previously imposed lower bound. -/
theorem UpperL2.exists_ge_variance_le (h : UpperL2 ν F τ) (hτ : 0 < τ) (m : ℕ) :
    ∃ n : ℕ, m ≤ n ∧
      variance (sumProcess F n) (iidLaw ℤ ν) ≤ 2 * (n : ℝ) * τ ^ 2 := by
  obtain ⟨N, hN⟩ := h.exists_eventual_variance_le hτ
  exact ⟨max m N, le_max_left _ _, hN _ (le_max_right _ _)⟩

end UpperVariance

end Cascade
end


/- Supporting development: Cascade.FinitePaths -/
section
set_option autoImplicit false

/-
# Finite causal paths with retained innovations

The internal path space `FinitePath A n` is the chronological recursive product
`A × (A × … × Unit)`.  A general measurable state update and a Markov transition
kernel give `finitePathKernel`.  In the causal specialization each output is
`(J, X)`, with `J ∼ ν` retained and `X = J + Z - H past`, where `Z` is an
independent standard Gaussian.  The public `pathLaw` forgets the latent `J`'s
and has type `Measure (Fin n → ℝ)`.

All starting histories are arbitrary elements of `Past`; no boundedness,
stationarity, or almost-everywhere restriction on the starting history is used.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal

namespace Cascade

/-- A chronological finite path, represented as a recursive product. -/
def FinitePath (A : Type) : ℕ → Type
  | 0 => Unit
  | n + 1 => A × FinitePath A n

instance finitePathMeasurableSpace (A : Type) [MeasurableSpace A] :
    (n : ℕ) → MeasurableSpace (FinitePath A n)
  | 0 => inferInstanceAs (MeasurableSpace Unit)
  | n + 1 => by
      letI := finitePathMeasurableSpace A n
      exact inferInstanceAs (MeasurableSpace (A × FinitePath A n))

namespace FinitePath

variable {A B S : Type}

/-- View a recursive path as a `Fin n`-indexed chronological path. -/
def toFn : (n : ℕ) → FinitePath A n → (Fin n → A)
  | 0, _ => Fin.elim0
  | n + 1, p => Fin.cases p.1 (toFn n p.2)

@[simp] theorem toFn_zero (p : FinitePath A 0) : toFn 0 p = Fin.elim0 := rfl

@[simp] theorem toFn_succ_zero (n : ℕ) (p : FinitePath A (n + 1)) :
    toFn (n + 1) p 0 = p.1 := rfl

@[simp] theorem toFn_succ_succ (n : ℕ) (p : FinitePath A (n + 1)) (i : Fin n) :
    toFn (n + 1) p i.succ = toFn n p.2 i := rfl

@[fun_prop] theorem measurable_toFn [MeasurableSpace A] (n : ℕ) : Measurable (toFn (A := A) n) := by
  induction n with
  | zero => exact measurable_pi_lambda _ fun i => Fin.elim0 i
  | succ n ih =>
      apply measurable_pi_lambda
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · exact measurable_fst
      · exact ((measurable_pi_apply j).comp ih).comp measurable_snd

/-- Update a state successively along a finite chronological path. -/
def advance (update : S × A → S) : (n : ℕ) → S → FinitePath A n → S
  | 0, s, _ => s
  | n + 1, s, p => advance update n (update (s, p.1)) p.2

@[simp] theorem advance_zero (update : S × A → S) (s : S) (p : FinitePath A 0) :
    advance update 0 s p = s := rfl

@[simp] theorem advance_succ (update : S × A → S) (n : ℕ) (s : S)
    (p : FinitePath A (n + 1)) :
    advance update (n + 1) s p = advance update n (update (s, p.1)) p.2 := rfl

/-- Joint measurability, including the initial state. -/
@[fun_prop] theorem measurable_advance [MeasurableSpace A] [MeasurableSpace S]
    {update : S × A → S} (hu : Measurable update)
    (n : ℕ) : Measurable (fun p : S × FinitePath A n => advance update n p.1 p.2) := by
  induction n with
  | zero => exact measurable_fst
  | succ n ih =>
      exact ih.comp ((hu.comp (measurable_fst.prodMk measurable_snd.fst)).prodMk
        measurable_snd.snd)

/-- Convert an ordinary finite function into a chronological recursive path. -/
def ofFn : (n : ℕ) → (Fin n → A) → FinitePath A n
  | 0, _ => ()
  | n + 1, p => (p 0, ofFn n (fun i => p i.succ))

@[simp] theorem toFn_ofFn (n : ℕ) (p : Fin n → A) : toFn n (ofFn n p) = p := by
  induction n with
  | zero => exact funext fun i => Fin.elim0 i
  | succ n ih =>
      funext i
      refine Fin.cases rfl (fun j => ?_) i
      exact congrFun (ih (fun k => p k.succ)) j

@[simp] theorem ofFn_toFn (n : ℕ) (p : FinitePath A n) : ofFn n (toFn n p) = p := by
  induction n with
  | zero => cases p; rfl
  | succ n ih =>
      change (p.1, ofFn n (toFn n p.2)) = p
      rw [ih]
      rfl

@[fun_prop] theorem measurable_ofFn [MeasurableSpace A] (n : ℕ) :
    Measurable (ofFn (A := A) n) := by
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
      exact (measurable_pi_apply 0).prodMk
        (ih.comp (measurable_pi_lambda _ fun i => measurable_pi_apply i.succ))

/-- A measurable equivalence with the usual `Fin n`-indexed path space. -/
def equivFn [MeasurableSpace A] (n : ℕ) : FinitePath A n ≃ᵐ (Fin n → A) where
  toFun := toFn n
  invFun := ofFn n
  left_inv := ofFn_toFn n
  right_inv := toFn_ofFn n
  measurable_toFun := measurable_toFn n
  measurable_invFun := measurable_ofFn n

/-- Apply an observation to every output in a recursive path. -/
def map (f : A → B) : (n : ℕ) → FinitePath A n → FinitePath B n
  | 0, _ => ()
  | n + 1, p => (f p.1, map f n p.2)

@[fun_prop] theorem measurable_map [MeasurableSpace A] [MeasurableSpace B]
    {f : A → B} (hf : Measurable f) (n : ℕ) : Measurable (map f n) := by
  induction n with
  | zero => exact measurable_const
  | succ n ih => exact (hf.comp measurable_fst).prodMk (ih.comp measurable_snd)

@[simp] theorem toFn_map (f : A → B) (n : ℕ) (p : FinitePath A n) :
    toFn n (map f n p) = fun i => f (toFn n p i) := by
  induction n with
  | zero => exact funext fun i => Fin.elim0 i
  | succ n ih =>
      funext i
      refine Fin.cases rfl (fun j => ?_) i
      exact congrFun (ih p.2) j

/-- Chronological concatenation.  The result is indexed by `m + n` so that
recursion on the first block is definitional; `n` is still the first block length. -/
def append : (n m : ℕ) → FinitePath A n → FinitePath A m → FinitePath A (m + n)
  | 0, _, _, q => q
  | n + 1, m, p, q => (p.1, append n m p.2 q)

@[simp] theorem append_zero (m : ℕ) (p : FinitePath A 0) (q : FinitePath A m) :
    append 0 m p q = q := rfl

@[simp] theorem append_succ (n m : ℕ) (p : FinitePath A (n + 1)) (q : FinitePath A m) :
    append (n + 1) m p q = (p.1, append n m p.2 q) := rfl

@[fun_prop] theorem measurable_append [MeasurableSpace A] (n m : ℕ) :
    Measurable (fun p : FinitePath A n × FinitePath A m => append n m p.1 p.2) := by
  induction n with
  | zero => exact measurable_snd
  | succ n ih =>
      exact measurable_fst.fst.prodMk
        (ih.comp (measurable_fst.snd.prodMk measurable_snd))

/-- Split a chronological path into its first `n` outputs and the following `m`. -/
def split : (n m : ℕ) → FinitePath A (m + n) → FinitePath A n × FinitePath A m
  | 0, _, p => ((), p)
  | n + 1, m, p => ((p.1, (split n m p.2).1), (split n m p.2).2)

@[simp] theorem split_append (n m : ℕ) (p : FinitePath A n) (q : FinitePath A m) :
    split n m (append n m p q) = (p, q) := by
  induction n with
  | zero => cases p; rfl
  | succ n ih =>
      simp only [append_succ, split, ih]
      rfl

@[simp] theorem append_split (n m : ℕ) (p : FinitePath A (m + n)) :
    append n m (split n m p).1 (split n m p).2 = p := by
  induction n with
  | zero => rfl
  | succ n ih =>
      change (p.1, append n m (split n m p.2).1 (split n m p.2).2) = p
      rw [ih]
      rfl

@[fun_prop] theorem measurable_split [MeasurableSpace A] (n m : ℕ) :
    Measurable (split (A := A) n m) := by
  induction n with
  | zero => exact measurable_const.prodMk measurable_id
  | succ n ih =>
      exact (measurable_fst.prodMk (ih.comp measurable_snd).fst).prodMk
        (ih.comp measurable_snd).snd

/-- Deterministic continuation is associative over consecutive finite blocks. -/
theorem advance_append (update : S × A → S) (n m : ℕ) (s : S)
    (p : FinitePath A n) (q : FinitePath A m) :
    advance update (m + n) s (append n m p q) =
      advance update m (advance update n s p) q := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih => exact ih _ p.2

/-- Mapping outputs does not alter states when the update factors through the
observation. -/
theorem advance_map (f : A → B) (update : S × A → S) (update' : S × B → S)
    (hupdate : ∀ s a, update (s, a) = update' (s, f a))
    (n : ℕ) (s : S) (p : FinitePath A n) :
    advance update' n s (map f n p) = advance update n s p := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
      change advance update' n (update' (s, f p.1)) (map f n p.2) =
        advance update n (update (s, p.1)) p.2
      rw [← hupdate, ih]

end FinitePath

section GeneralPaths

variable {S A : Type} [MeasurableSpace S] [MeasurableSpace A]

/-- Finite Markov output paths, allowing a deterministic measurable state update. -/
noncomputable def finitePathKernel (κ : Kernel S A) (update : S × A → S)
    (hu : Measurable update) : (n : ℕ) → Kernel S (FinitePath A n)
  | 0 => Kernel.const S (Measure.dirac ())
  | n + 1 => κ ⊗ₖ ((finitePathKernel κ update hu n).comap update hu)

instance isMarkovKernel_finitePathKernel (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n : ℕ) :
    IsMarkovKernel (finitePathKernel κ update hu n) := by
  induction n with
  | zero => unfold finitePathKernel; infer_instance
  | succ n ih =>
      letI := ih
      exact Kernel.IsMarkovKernel.compProd κ
        ((finitePathKernel κ update hu n).comap update hu)

@[simp] theorem finitePathKernel_zero (κ : Kernel S A) (update : S × A → S)
    (hu : Measurable update) (s : S) :
    finitePathKernel κ update hu 0 s = Measure.dirac () := rfl

/-- The restart kernel after a single output. -/
noncomputable def finiteContinuationKernel (κ : Kernel S A) (update : S × A → S)
    (hu : Measurable update) (n : ℕ) (s : S) : Kernel A (FinitePath A n) :=
  (finitePathKernel κ update hu n).comap (fun a => update (s, a))
    (hu.comp (measurable_const.prodMk measurable_id))

instance isMarkovKernel_finiteContinuationKernel (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n : ℕ) (s : S) :
    IsMarkovKernel (finiteContinuationKernel κ update hu n s) := by
  unfold finiteContinuationKernel
  infer_instance

@[simp] theorem finiteContinuationKernel_apply (κ : Kernel S A) (update : S × A → S)
    (hu : Measurable update) (n : ℕ) (s : S) (a : A) :
    finiteContinuationKernel κ update hu n s a =
      finitePathKernel κ update hu n (update (s, a)) := rfl

/-- Continuation identity as an equality of measures, retaining the first output. -/
theorem finitePathKernel_succ (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n : ℕ) (s : S) :
    finitePathKernel κ update hu (n + 1) s =
      (κ s) ⊗ₘ (finiteContinuationKernel κ update hu n s) := by
  exact Kernel.compProd_apply_eq_compProd_sectR κ
    ((finitePathKernel κ update hu n).comap update hu) s

/-- Iterated nonnegative integration over the first output and the restarted path. -/
theorem lintegral_finitePathKernel_succ (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n : ℕ) (s : S)
    {f : FinitePath A (n + 1) → ℝ≥0∞} (hf : Measurable f) :
    (∫⁻ p, f p ∂finitePathKernel κ update hu (n + 1) s) =
      ∫⁻ a, ∫⁻ p, f (a, p) ∂finitePathKernel κ update hu n (update (s, a)) ∂κ s := by
  rw [finitePathKernel_succ]
  exact Measure.lintegral_compProd hf

/-- Restart after a whole finite block, using the state obtained from that block. -/
noncomputable def finiteBlockContinuationKernel (κ : Kernel S A) (update : S × A → S)
    (hu : Measurable update) (n m : ℕ) (s : S) : Kernel (FinitePath A n) (FinitePath A m) :=
  (finitePathKernel κ update hu m).comap (FinitePath.advance update n s)
    ((FinitePath.measurable_advance hu n).comp (measurable_const.prodMk measurable_id))

instance isMarkovKernel_finiteBlockContinuationKernel (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n m : ℕ) (s : S) :
    IsMarkovKernel (finiteBlockContinuationKernel κ update hu n m s) := by
  unfold finiteBlockContinuationKernel
  infer_instance

@[simp] theorem finiteBlockContinuationKernel_apply (κ : Kernel S A) (update : S × A → S)
    (hu : Measurable update) (n m : ℕ) (s : S) (p : FinitePath A n) :
    finiteBlockContinuationKernel κ update hu n m s p =
      finitePathKernel κ update hu m (FinitePath.advance update n s p) := rfl

/-- Integrate first over a chronological block of `n` outputs and then over `m`
further outputs started at the updated state. -/
theorem lintegral_finitePathKernel_append (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n m : ℕ) (s : S)
    {f : FinitePath A (m + n) → ℝ≥0∞} (hf : Measurable f) :
    (∫⁻ r, f r ∂finitePathKernel κ update hu (m + n) s) =
      ∫⁻ p, ∫⁻ q, f (FinitePath.append n m p q)
        ∂finitePathKernel κ update hu m (FinitePath.advance update n s p)
        ∂finitePathKernel κ update hu n s := by
  induction n generalizing s with
  | zero =>
      change (∫⁻ r, f r ∂finitePathKernel κ update hu m s) =
        ∫⁻ _ : Unit, (∫⁻ r, f r ∂finitePathKernel κ update hu m s) ∂Measure.dirac ()
      simp
  | succ n ih =>
      have hG : Measurable (fun p : FinitePath A (n + 1) =>
          ∫⁻ q, f (FinitePath.append (n + 1) m p q)
            ∂finitePathKernel κ update hu m (FinitePath.advance update (n + 1) s p)) :=
        (hf.comp (FinitePath.measurable_append (n + 1) m)).lintegral_kernel_prod_right'
          (κ := finiteBlockContinuationKernel κ update hu (n + 1) m s)
      calc
        (∫⁻ r, f r ∂finitePathKernel κ update hu (m + (n + 1)) s) =
            ∫⁻ a, ∫⁻ r, f (a, r) ∂finitePathKernel κ update hu (m + n) (update (s, a))
              ∂κ s := lintegral_finitePathKernel_succ κ update hu (m + n) s hf
        _ = ∫⁻ a, ∫⁻ p, ∫⁻ q, f (a, FinitePath.append n m p q)
              ∂finitePathKernel κ update hu m (FinitePath.advance update n (update (s, a)) p)
              ∂finitePathKernel κ update hu n (update (s, a)) ∂κ s := by
          apply lintegral_congr
          intro a
          exact ih (update (s, a)) (hf.comp measurable_prodMk_left)
        _ = _ := (lintegral_finitePathKernel_succ κ update hu n s hG).symm

/-- Whole-block continuation, expressed by concatenating the retained first
block and the restarted second block. -/
theorem finitePathKernel_append (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n m : ℕ) (s : S) :
    finitePathKernel κ update hu (m + n) s =
      ((finitePathKernel κ update hu n s) ⊗ₘ
        finiteBlockContinuationKernel κ update hu n m s).map
          (fun p => FinitePath.append n m p.1 p.2) := by
  refine Measure.ext_of_lintegral _ fun f hf => ?_
  rw [lintegral_map hf (FinitePath.measurable_append n m)]
  have ha : Measurable (fun p : FinitePath A n × FinitePath A m =>
      f (FinitePath.append n m p.1 p.2)) := hf.comp (FinitePath.measurable_append n m)
  exact (lintegral_finitePathKernel_append κ update hu n m s hf).trans
    (Measure.lintegral_compProd (κ := finiteBlockContinuationKernel κ update hu n m s) ha).symm

/-- The prefix/suffix split has exactly the Markov continuation law. -/
theorem finitePathKernel_split (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n m : ℕ) (s : S) :
    (finitePathKernel κ update hu (m + n) s).map (FinitePath.split n m) =
      (finitePathKernel κ update hu n s) ⊗ₘ finiteBlockContinuationKernel κ update hu n m s := by
  rw [finitePathKernel_append, Measure.map_map (FinitePath.measurable_split n m)
    (FinitePath.measurable_append n m)]
  have heq : FinitePath.split n m ∘
      (fun p : FinitePath A n × FinitePath A m => FinitePath.append n m p.1 p.2) = id := by
    funext p
    exact FinitePath.split_append n m p.1 p.2
  rw [heq, Measure.map_id]

/-- A coordinatewise observation commutes with the finite Markov path
construction if the state update uses only that observation. -/
theorem finitePathKernel_map {B : Type} [MeasurableSpace B]
    (κ : Kernel S A) [IsMarkovKernel κ] (update : S × A → S) (hu : Measurable update)
    (obs : A → B) (hobs : Measurable obs) (update' : S × B → S) (hu' : Measurable update')
    (hupdate : ∀ s a, update (s, a) = update' (s, obs a)) (n : ℕ) (s : S) :
    (finitePathKernel κ update hu n s).map (FinitePath.map obs n) =
      finitePathKernel (κ.map obs) update' hu' n s := by
  letI := Kernel.IsMarkovKernel.map κ hobs
  induction n generalizing s with
  | zero =>
      change (Measure.dirac () : Measure Unit).map (fun _ : Unit => ()) = Measure.dirac ()
      exact Measure.map_dirac measurable_const ()
  | succ n ih =>
      refine Measure.ext_of_lintegral _ fun f hf => ?_
      rw [lintegral_map hf (FinitePath.measurable_map hobs (n + 1))]
      have hF : Measurable (fun p : FinitePath A (n + 1) => f (FinitePath.map obs (n + 1) p)) :=
        hf.comp (FinitePath.measurable_map hobs (n + 1))
      have hG : Measurable (fun b : B =>
          ∫⁻ p, f (b, p) ∂finitePathKernel (κ.map obs) update' hu' n (update' (s, b))) :=
        hf.lintegral_kernel_prod_right'
          (κ := finiteContinuationKernel (κ.map obs) update' hu' n s)
      calc
        (∫⁻ p, f (FinitePath.map obs (n + 1) p) ∂finitePathKernel κ update hu (n + 1) s) =
            ∫⁻ a, ∫⁻ p, f (obs a, FinitePath.map obs n p)
              ∂finitePathKernel κ update hu n (update (s, a)) ∂κ s :=
          lintegral_finitePathKernel_succ κ update hu n s hF
        _ = ∫⁻ a, ∫⁻ p, f (obs a, p)
              ∂finitePathKernel (κ.map obs) update' hu' n (update' (s, obs a)) ∂κ s := by
          apply lintegral_congr
          intro a
          have hfa : Measurable (fun p : FinitePath B n => f (obs a, p)) :=
            hf.comp measurable_prodMk_left
          rw [← lintegral_map hfa (FinitePath.measurable_map hobs n), ih, hupdate]
        _ = ∫⁻ b, ∫⁻ p, f (b, p)
              ∂finitePathKernel (κ.map obs) update' hu' n (update' (s, b)) ∂(κ.map obs) s := by
          rw [Kernel.map_apply _ hobs]
          exact (lintegral_map hG hobs).symm
        _ = ∫⁻ p, f p ∂finitePathKernel (κ.map obs) update' hu' (n + 1) s :=
          (lintegral_finitePathKernel_succ (κ.map obs) update' hu' n s hf).symm

end GeneralPaths

/-- Put a new observation at the front of a backwards-indexed history. -/
def prepend (z : ℝ) (x : Past) : Past
  | 0 => z
  | k + 1 => x k

@[simp] theorem prepend_zero (z : ℝ) (x : Past) : prepend z x 0 = z := rfl
@[simp] theorem prepend_succ (z : ℝ) (x : Past) (k : ℕ) : prepend z x (k + 1) = x k := rfl

/-- The initial history and the newly observed real are jointly measurable inputs. -/
@[fun_prop] theorem measurable_prepend :
    Measurable (fun p : ℝ × Past => prepend p.1 p.2) := by
  apply measurable_pi_lambda
  intro k
  cases k with
  | zero => exact measurable_fst
  | succ k => exact (measurable_pi_apply k).comp measurable_snd

/-- Agreement of the most recent `m` entries of two arbitrary real histories. -/
def AgreeFirst (m : ℕ) (x y : Past) : Prop := ∀ i < m, x i = y i

namespace AgreeFirst

@[simp] theorem zero (x y : Past) : AgreeFirst 0 x y := by intro i hi; omega

theorem prepend {m : ℕ} {x y : Past} (h : AgreeFirst m x y) (z : ℝ) :
    AgreeFirst (m + 1) (Cascade.prepend z x) (Cascade.prepend z y) := by
  intro i hi
  cases i with
  | zero => rfl
  | succ i => exact h i (by omega)

end AgreeFirst

abbrev AugmentedStep := ℝ × ℝ
abbrev AugmentedPath (n : ℕ) := FinitePath AugmentedStep n

/-- Only the observed coordinate, not the retained latent innovation, updates the past. -/
def causalUpdate (p : Past × AugmentedStep) : Past := prepend p.2.2 p.1

@[fun_prop] theorem measurable_causalUpdate : Measurable causalUpdate :=
  measurable_prepend.comp (measurable_snd.snd.prodMk measurable_fst)

/-- The backward history obtained by continuing along a common observed prefix. -/
def continuePast (n : ℕ) (x : Past) (p : AugmentedPath n) : Past :=
  FinitePath.advance causalUpdate n x p

@[fun_prop] theorem measurable_continuePast (n : ℕ) :
    Measurable (fun p : Past × AugmentedPath n => continuePast n p.1 p.2) :=
  FinitePath.measurable_advance measurable_causalUpdate n

@[simp] theorem continuePast_zero (x : Past) (p : AugmentedPath 0) : continuePast 0 x p = x := rfl

@[simp] theorem continuePast_succ (n : ℕ) (x : Past) (p : AugmentedPath (n + 1)) :
    continuePast (n + 1) x p = continuePast n (prepend p.1.2 x) p.2 := rfl

/-- A common prefix extends agreement by its length. -/
theorem AgreeFirst.continuePast {m : ℕ} {x y : Past} (h : AgreeFirst m x y)
    (n : ℕ) (p : AugmentedPath n) :
    AgreeFirst (m + n) (continuePast n x p) (continuePast n y p) := by
  induction n generalizing m x y with
  | zero => simpa using h
  | succ n ih =>
      simpa only [continuePast_succ, Nat.add_assoc, Nat.add_comm 1 n] using
        ih (h.prepend p.1.2) p.2

/-- The fresh-noise-to-output map at a fixed drift value. -/
def augmentedStepMap (b : ℝ) (p : ℝ × ℝ) : AugmentedStep := (p.1, p.1 + p.2 - b)

@[fun_prop] theorem measurable_augmentedStepMap_joint :
    Measurable (fun p : ℝ × (ℝ × ℝ) => augmentedStepMap p.1 p.2) := by
  unfold augmentedStepMap
  fun_prop

@[fun_prop] theorem measurable_augmentedStepMap (b : ℝ) : Measurable (augmentedStepMap b) :=
  measurable_augmentedStepMap_joint.comp (measurable_const.prodMk measurable_id)

/-- One-step augmented law: independent `J ∼ ν`, `Z ∼ N(0,1)`, output `(J,J+Z-b)`. -/
noncomputable def augmentedStepLaw (ν : Measure ℝ) (b : ℝ) : Measure AugmentedStep :=
  (ν.prod (gaussianReal 0 1)).map (augmentedStepMap b)

instance isProbabilityMeasure_augmentedStepLaw (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (b : ℝ) : IsProbabilityMeasure (augmentedStepLaw ν b) :=
  Measure.isProbabilityMeasure_map (measurable_augmentedStepMap b).aemeasurable

/-- The augmented one-step law, jointly measurable in its drift parameter. -/
noncomputable def gaussianAugmentedKernel (ν : Measure ℝ) : Kernel ℝ AugmentedStep :=
  ((Kernel.id : Kernel ℝ ℝ) ×ₖ (Kernel.const ℝ (ν.prod (gaussianReal 0 1)))).map
    (fun p => augmentedStepMap p.1 p.2)

instance isMarkovKernel_gaussianAugmentedKernel (ν : Measure ℝ) [IsProbabilityMeasure ν] :
    IsMarkovKernel (gaussianAugmentedKernel ν) :=
  Kernel.IsMarkovKernel.map _ measurable_augmentedStepMap_joint

@[simp] theorem gaussianAugmentedKernel_apply (ν : Measure ℝ) [IsProbabilityMeasure ν] (b : ℝ) :
    gaussianAugmentedKernel ν b = augmentedStepLaw ν b := by
  rw [gaussianAugmentedKernel, Kernel.map_apply _ measurable_augmentedStepMap_joint,
    Kernel.prod_apply, Kernel.id_apply, Kernel.const_apply, Measure.dirac_prod,
    Measure.map_map measurable_augmentedStepMap_joint measurable_prodMk_left]
  rfl

/-- The measurable causal one-step kernel from arbitrary pasts. -/
noncomputable def causalStepKernel (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) :
    Kernel Past AugmentedStep := (gaussianAugmentedKernel ν).comap H hH

instance isMarkovKernel_causalStepKernel (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] : IsMarkovKernel (causalStepKernel H hH ν) := by
  unfold causalStepKernel
  infer_instance

@[simp] theorem causalStepKernel_apply (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (x : Past) :
    causalStepKernel H hH ν x = augmentedStepLaw ν (H x) :=
  gaussianAugmentedKernel_apply ν (H x)

/-- The full finite causal law, retaining every latent `J`. -/
noncomputable def augmentedPathKernel (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ)
    (n : ℕ) : Kernel Past (AugmentedPath n) :=
  finitePathKernel (causalStepKernel H hH ν) causalUpdate measurable_causalUpdate n

instance isMarkovKernel_augmentedPathKernel (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) :
    IsMarkovKernel (augmentedPathKernel H hH ν n) := by
  unfold augmentedPathKernel
  infer_instance

/-- Forget the latent coordinates of a finite augmented path. -/
def observedPath (n : ℕ) (p : AugmentedPath n) : Fin n → ℝ :=
  fun i => (FinitePath.toFn n p i).2

@[fun_prop] theorem measurable_observedPath (n : ℕ) : Measurable (observedPath n) :=
  measurable_pi_lambda _ fun i =>
    (((measurable_pi_apply i).comp (FinitePath.measurable_toFn n)).snd)

/-- Observed finite paths as a Markov kernel, on the standard `Fin n → ℝ` space. -/
noncomputable def pathKernel (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ)
    (n : ℕ) : Kernel Past (Fin n → ℝ) :=
  (augmentedPathKernel H hH ν n).map (observedPath n)

instance isMarkovKernel_pathKernel (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) :
    IsMarkovKernel (pathKernel H hH ν n) :=
  Kernel.IsMarkovKernel.map _ (measurable_observedPath n)

/-- The exported law of `n` observed causal outputs from an arbitrary real past. -/
noncomputable def pathLaw (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ)
    (n : ℕ) (x : Past) : Measure (Fin n → ℝ) := pathKernel H hH ν n x

instance isProbabilityMeasure_pathLaw (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) (x : Past) :
    IsProbabilityMeasure (pathLaw H hH ν n x) := by
  unfold pathLaw
  infer_instance

@[simp] theorem pathLaw_eq_map (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ)
    (n : ℕ) (x : Past) :
    pathLaw H hH ν n x = (augmentedPathKernel H hH ν n x).map (observedPath n) :=
  Kernel.map_apply _ (measurable_observedPath n) _

/-- Continuation of the augmented causal law after its first output. -/
theorem augmentedPathKernel_succ (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) (x : Past) :
    augmentedPathKernel H hH ν (n + 1) x =
      augmentedStepLaw ν (H x) ⊗ₘ
        ((augmentedPathKernel H hH ν n).comap (fun a => prepend a.2 x)
          (measurable_prepend.comp (measurable_snd.prodMk measurable_const))) := by
  simpa only [augmentedPathKernel, causalStepKernel_apply, finiteContinuationKernel,
    causalUpdate] using
    finitePathKernel_succ (causalStepKernel H hH ν) causalUpdate measurable_causalUpdate n x

/-- Continuing along two consecutive common prefixes is associative. -/
theorem continuePast_append (n m : ℕ) (x : Past) (p : AugmentedPath n) (q : AugmentedPath m) :
    continuePast (m + n) x (FinitePath.append n m p q) =
      continuePast m (continuePast n x p) q :=
  FinitePath.advance_append causalUpdate n m x p q

/-- The complete finite-block continuation identity for causal augmented paths. -/
theorem augmentedPathKernel_split (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n m : ℕ) (x : Past) :
    (augmentedPathKernel H hH ν (m + n) x).map (FinitePath.split n m) =
      augmentedPathKernel H hH ν n x ⊗ₘ
        ((augmentedPathKernel H hH ν m).comap (continuePast n x)
          ((measurable_continuePast n).comp (measurable_const.prodMk measurable_id))) :=
  finitePathKernel_split (causalStepKernel H hH ν) causalUpdate measurable_causalUpdate n m x

/-- State update when only the observed output is retained. -/
def observedUpdate (p : Past × ℝ) : Past := prepend p.2 p.1

@[fun_prop] theorem measurable_observedUpdate : Measurable observedUpdate :=
  measurable_prepend.comp (measurable_snd.prodMk measurable_fst)

/-- One-step observation law, without the latent innovation. -/
noncomputable def observedStepLaw (ν : Measure ℝ) (b : ℝ) : Measure ℝ :=
  (augmentedStepLaw ν b).map Prod.snd

instance isProbabilityMeasure_observedStepLaw (ν : Measure ℝ) [IsProbabilityMeasure ν] (b : ℝ) :
    IsProbabilityMeasure (observedStepLaw ν b) := Measure.isProbabilityMeasure_map measurable_snd.aemeasurable

/-- The real-valued observed transition kernel. -/
noncomputable def observedStepKernel (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) :
    Kernel Past ℝ := (causalStepKernel H hH ν).map Prod.snd

instance isMarkovKernel_observedStepKernel (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] : IsMarkovKernel (observedStepKernel H hH ν) :=
  Kernel.IsMarkovKernel.map _ measurable_snd

@[simp] theorem observedStepKernel_apply (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (x : Past) :
    observedStepKernel H hH ν x = observedStepLaw ν (H x) := by
  rw [observedStepKernel, Kernel.map_apply _ measurable_snd, causalStepKernel_apply]
  rfl

/-- Continue an arbitrary real past along an ordinary observed finite prefix. -/
def continueObservedPast (n : ℕ) (x : Past) (p : Fin n → ℝ) : Past :=
  FinitePath.advance observedUpdate n x (FinitePath.ofFn n p)

@[fun_prop] theorem measurable_continueObservedPast (n : ℕ) :
    Measurable (fun p : Past × (Fin n → ℝ) => continueObservedPast n p.1 p.2) :=
  (FinitePath.measurable_advance measurable_observedUpdate n).comp
    (measurable_fst.prodMk ((FinitePath.measurable_ofFn n).comp measurable_snd))

@[simp] theorem continueObservedPast_zero (x : Past) (p : Fin 0 → ℝ) :
    continueObservedPast 0 x p = x := rfl

@[simp] theorem continueObservedPast_succ (n : ℕ) (x : Past) (p : Fin (n + 1) → ℝ) :
    continueObservedPast (n + 1) x p =
      continueObservedPast n (prepend (p 0) x) (fun i => p i.succ) := rfl

theorem observedPath_eq_toFn_map (n : ℕ) (p : AugmentedPath n) :
    observedPath n p = FinitePath.toFn n (FinitePath.map Prod.snd n p) :=
  (FinitePath.toFn_map Prod.snd n p).symm

/-- Latent innovations have no effect on history continuation. -/
theorem continuePast_eq_continueObservedPast (n : ℕ) (x : Past) (p : AugmentedPath n) :
    continuePast n x p = continueObservedPast n x (observedPath n p) := by
  rw [continueObservedPast, observedPath_eq_toFn_map, FinitePath.ofFn_toFn]
  exact (FinitePath.advance_map Prod.snd causalUpdate observedUpdate (fun _ _ => rfl) n x p).symm

/-- A common observed prefix extends agreement by its entire length. -/
theorem AgreeFirst.continueObservedPast {m : ℕ} {x y : Past} (h : AgreeFirst m x y)
    (n : ℕ) (p : Fin n → ℝ) :
    AgreeFirst (m + n) (continueObservedPast n x p) (continueObservedPast n y p) := by
  induction n generalizing m x y with
  | zero => simpa using h
  | succ n ih =>
      simpa only [continueObservedPast_succ, Nat.add_assoc, Nat.add_comm 1 n] using
        ih (h.prepend (p 0)) (fun i => p i.succ)

/-- The exported law is also the ordinary observed Markov path law.  Thus
bounds on observed transition laws alone suffice for finite-path perturbation. -/
theorem pathLaw_eq_observed_finitePathKernel (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) (x : Past) :
    pathLaw H hH ν n x =
      (finitePathKernel (observedStepKernel H hH ν) observedUpdate measurable_observedUpdate n x).map
        (FinitePath.toFn n) := by
  have hp : (augmentedPathKernel H hH ν n x).map (FinitePath.map Prod.snd n) =
      finitePathKernel (observedStepKernel H hH ν) observedUpdate measurable_observedUpdate n x :=
    finitePathKernel_map (causalStepKernel H hH ν) causalUpdate measurable_causalUpdate
      Prod.snd measurable_snd observedUpdate measurable_observedUpdate (fun _ _ => rfl) n x
  rw [pathLaw_eq_map, ← hp, Measure.map_map (FinitePath.measurable_toFn n)
    (FinitePath.measurable_map measurable_snd n)]
  congr 1
  funext p
  exact observedPath_eq_toFn_map n p

section Perturbation

namespace TestClose

variable {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]

/-- A common Markov kernel contracts test distance in its input law, even when
that input is retained in the output. -/
theorem compProd_left {P Q : Measure α} [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {e : ℝ} (h : TestClose P Q e) (κ : Kernel α β) [IsMarkovKernel κ] :
    TestClose (P ⊗ₘ κ) (Q ⊗ₘ κ) e := by
  intro f hf hf01
  rw [Measure.integral_compProd (integrable_of_test _ hf hf01),
    Measure.integral_compProd (integrable_of_test _ hf hf01)]
  exact h (fun x => ∫ y, f (x, y) ∂κ x)
    hf.stronglyMeasurable.integral_kernel_prod_right'.measurable
    (fun x => integral_test_mem_Icc (κ x)
      (hf.comp (measurable_const.prodMk measurable_id)) (fun y => hf01 (x, y)))

/-- Simultaneous perturbation of a base probability and its conditional kernel. -/
theorem compProd_triangle {P Q : Measure α} [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {κ η : Kernel α β} [IsMarkovKernel κ] [IsMarkovKernel η] {e d : ℝ}
    (hPQ : TestClose P Q e) (hκη : ∀ᵐ x ∂Q, TestClose (κ x) (η x) d) :
    TestClose (P ⊗ₘ κ) (Q ⊗ₘ η) (e + d) :=
  (hPQ.compProd_left κ).triangle (TestClose.compProd hκη)

/-- A common independent factor does not enlarge test distance. -/
theorem prod_left {P Q : Measure α} [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {e : ℝ} (h : TestClose P Q e) (R : Measure β) [IsProbabilityMeasure R] :
    TestClose (P.prod R) (Q.prod R) e := by
  simpa only [Measure.compProd_const] using h.compProd_left (Kernel.const α R)

/-- The analogous contraction for the second independent factor. -/
theorem prod_right (P : Measure α) [IsProbabilityMeasure P] {Q R : Measure β}
    [IsProbabilityMeasure Q] [IsProbabilityMeasure R] {e : ℝ} (h : TestClose Q R e) :
    TestClose (P.prod Q) (P.prod R) e := by
  simpa only [Measure.compProd_const, Kernel.const_apply] using
    (TestClose.compProd (μ := P) (κ := Kernel.const α Q) (η := Kernel.const α R)
      (ae_of_all _ fun _ => h))

end TestClose

/-- Telescoping bound for any finite Markov output recursion.  The same initial
state and update are used, while the transition kernel changes uniformly. -/
theorem testClose_finitePathKernel {S A : Type} [MeasurableSpace S] [MeasurableSpace A]
    {κ η : Kernel S A} [IsMarkovKernel κ] [IsMarkovKernel η]
    (update : S × A → S) (hu : Measurable update) {e : ℝ}
    (hstep : ∀ s, TestClose (κ s) (η s) e) (n : ℕ) (s : S) :
    TestClose (finitePathKernel κ update hu n s) (finitePathKernel η update hu n s)
      ((n : ℝ) * e) := by
  induction n generalizing s with
  | zero => simpa only [finitePathKernel_zero, Nat.cast_zero, zero_mul] using
      TestClose.refl (Measure.dirac ())
  | succ n ih =>
      rw [finitePathKernel_succ, finitePathKernel_succ]
      have htail : ∀ᵐ a ∂η s,
          TestClose (finiteContinuationKernel κ update hu n s a)
            (finiteContinuationKernel η update hu n s a) ((n : ℝ) * e) :=
        ae_of_all _ fun a => ih (update (s, a))
      convert (hstep s).compProd_triangle htail using 1
      push_cast
      ring

/-- Reexpress the augmented law using any chosen reference drift `c`. -/
theorem augmentedStepLaw_eq_shifted (ν : Measure ℝ) [IsProbabilityMeasure ν] (b c : ℝ) :
    augmentedStepLaw ν b =
      (ν.prod (gaussianReal (c - b) 1)).map (augmentedStepMap c) := by
  have hg : (gaussianReal 0 1).map (fun z => z + (c - b)) = gaussianReal (c - b) 1 := by
    simp only [gaussianReal_map_add_const, zero_add]
  rw [← hg]
  have hp := Measure.map_prod_map ν (gaussianReal 0 1) measurable_id
    (measurable_id.add_const (c - b))
  simp only [Measure.map_id, id_eq] at hp
  rw [hp, Measure.map_map (measurable_augmentedStepMap c)
    (measurable_id.prodMap (measurable_id'.add_const (c - b)))]
  unfold augmentedStepLaw
  congr 1
  funext p
  change (p.1, p.1 + p.2 - b) = (p.1, p.1 + (p.2 + (c - b)) - c)
  congr 1
  ring

/-- Drift perturbations of the augmented law have the Gaussian shift bound;
retaining `J` costs nothing. -/
theorem testClose_augmentedStepLaw_drift (ν : Measure ℝ) [IsProbabilityMeasure ν] (b c : ℝ) :
    TestClose (augmentedStepLaw ν b) (augmentedStepLaw ν c) |b - c| := by
  rw [augmentedStepLaw_eq_shifted ν b c]
  exact ((TestClose.prod_right ν (testClose_stdGaussian_shift (c - b))).symm.map
    (measurable_augmentedStepMap c)).mono (by rw [abs_sub_comm])

/-- Perturbing the non-Gaussian innovation law, with a fixed drift. -/
theorem testClose_augmentedStepLaw_noise {ν ν' : Measure ℝ}
    [IsProbabilityMeasure ν] [IsProbabilityMeasure ν'] {e : ℝ}
    (hν : TestClose ν ν' e) (b : ℝ) :
    TestClose (augmentedStepLaw ν b) (augmentedStepLaw ν' b) e :=
  (hν.prod_left (gaussianReal 0 1)).map (measurable_augmentedStepMap b)

/-- Simultaneous one-step perturbation of the drift and innovation law. -/
theorem testClose_augmentedStepLaw {ν ν' : Measure ℝ}
    [IsProbabilityMeasure ν] [IsProbabilityMeasure ν'] {e δ : ℝ}
    (hν : TestClose ν ν' e) {b c : ℝ} (hbc : |b - c| ≤ δ) :
    TestClose (augmentedStepLaw ν b) (augmentedStepLaw ν' c) (δ + e) :=
  ((testClose_augmentedStepLaw_drift ν b c).mono hbc).triangle
    (testClose_augmentedStepLaw_noise hν c)

/-- Uniform one-step bounds telescope along the augmented causal path. -/
theorem testClose_augmentedPathKernel_of_step
    (H H' : Past → ℝ) (hH : Measurable H) (hH' : Measurable H')
    (ν ν' : Measure ℝ) [IsProbabilityMeasure ν] [IsProbabilityMeasure ν'] {e : ℝ}
    (hstep : ∀ x, TestClose (augmentedStepLaw ν (H x)) (augmentedStepLaw ν' (H' x)) e)
    (n : ℕ) (x : Past) :
    TestClose (augmentedPathKernel H hH ν n x) (augmentedPathKernel H' hH' ν' n x)
      ((n : ℝ) * e) := by
  apply testClose_finitePathKernel causalUpdate measurable_causalUpdate
  simpa only [causalStepKernel_apply] using hstep

/-- Uniform one-step bounds telescope along the exported observed path law. -/
theorem testClose_pathLaw_of_step
    (H H' : Past → ℝ) (hH : Measurable H) (hH' : Measurable H')
    (ν ν' : Measure ℝ) [IsProbabilityMeasure ν] [IsProbabilityMeasure ν'] {e : ℝ}
    (hstep : ∀ x, TestClose (augmentedStepLaw ν (H x)) (augmentedStepLaw ν' (H' x)) e)
    (n : ℕ) (x : Past) :
    TestClose (pathLaw H hH ν n x) (pathLaw H' hH' ν' n x) ((n : ℝ) * e) := by
  rw [pathLaw_eq_map, pathLaw_eq_map]
  exact (testClose_augmentedPathKernel_of_step H H' hH hH' ν ν' hstep n x).map
    (measurable_observedPath n)

/-- Finite-path stability under uniformly close drifts and innovation laws. -/
theorem testClose_pathLaw_perturbation
    (H H' : Past → ℝ) (hH : Measurable H) (hH' : Measurable H')
    {ν ν' : Measure ℝ} [IsProbabilityMeasure ν] [IsProbabilityMeasure ν'] {δ e : ℝ}
    (hHclose : ∀ x, |H x - H' x| ≤ δ) (hν : TestClose ν ν' e) (n : ℕ) (x : Past) :
    TestClose (pathLaw H hH ν n x) (pathLaw H' hH' ν' n x) ((n : ℝ) * (δ + e)) :=
  testClose_pathLaw_of_step H H' hH hH' ν ν'
    (fun x => testClose_augmentedStepLaw hν (hHclose x)) n x

/-- Uniform one-step bounds for the observed transitions telescope, without
any assumption that the augmented (latent-retaining) transitions are close. -/
theorem testClose_pathLaw_of_observed_step
    (H H' : Past → ℝ) (hH : Measurable H) (hH' : Measurable H')
    (ν ν' : Measure ℝ) [IsProbabilityMeasure ν] [IsProbabilityMeasure ν'] {e : ℝ}
    (hstep : ∀ x, TestClose (observedStepLaw ν (H x)) (observedStepLaw ν' (H' x)) e)
    (n : ℕ) (x : Past) :
    TestClose (pathLaw H hH ν n x) (pathLaw H' hH' ν' n x) ((n : ℝ) * e) := by
  rw [pathLaw_eq_observed_finitePathKernel, pathLaw_eq_observed_finitePathKernel]
  apply TestClose.map _ (FinitePath.measurable_toFn n)
  apply testClose_finitePathKernel observedUpdate measurable_observedUpdate
  simpa only [observedStepKernel_apply] using hstep

end Perturbation

end Cascade
end


/- Supporting development: Cascade.PathLikelihood -/
section
set_option autoImplicit false

/-
# Explicit half-likelihoods for finite causal paths

The retained latent innovation makes the reference Gaussian residual observable:
`z = X + H(reference past) - J`.  A drift change from `c` to `b` therefore has
half-likelihood `gaussianHalfLikelihood (c - b) z`.  We multiply these factors
along a common chronological output path.  Density identities and conditional
Gaussian moments, not entropy or an infinite-dimensional change-of-measure
formula, give the finite-prefix square-sum estimate.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal

namespace Cascade

section DensityTools

variable {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]

/-- A density depending only on an observation commutes with its pushforward. -/
theorem withDensity_map_eq_map_withDensity (P : Measure α) {f : α → β} (hf : Measurable f)
    {D : β → ℝ≥0∞} (hD : Measurable D) :
    (P.map f).withDensity D = (P.withDensity (fun x => D (f x))).map f := by
  refine Measure.ext_of_lintegral _ fun g hg => ?_
  have hDf : Measurable (fun x => D (f x)) := hD.comp hf
  have hgf : Measurable (fun x => g (f x)) := hg.comp hf
  rw [lintegral_withDensity_eq_lintegral_mul _ hD hg]
  simp only [Pi.mul_apply]
  rw [lintegral_map (hD.mul hg) hf, lintegral_map hg hf,
    lintegral_withDensity_eq_lintegral_mul _ hDf hgf]
  rfl

/-- Density gluing for a base law and conditional kernels, with both coordinates
retained.  The assumptions give genuine probability measures on both sides. -/
theorem compProd_eq_withDensity_mul {P Q : Measure α}
    [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {κ η : Kernel α β} [IsMarkovKernel κ] [IsMarkovKernel η]
    {D : α → ℝ≥0∞} {E : α × β → ℝ≥0∞}
    (hD : Measurable D) (hE : Measurable E)
    (hQ : Q = P.withDensity D)
    (hη : ∀ a, η a = (κ a).withDensity (fun b => E (a, b))) :
    Q ⊗ₘ η = (P ⊗ₘ κ).withDensity (fun p => D p.1 * E p) := by
  refine Measure.ext_of_lintegral _ fun f hf => ?_
  have hDE : Measurable (fun p : α × β => D p.1 * E p) :=
    (hD.comp measurable_fst).mul hE
  rw [Measure.lintegral_compProd hf, hQ,
    lintegral_withDensity_eq_lintegral_mul _ hD hf.lintegral_kernel_prod_right',
    lintegral_withDensity_eq_lintegral_mul _ hDE hf]
  simp only [Pi.mul_apply]
  rw [Measure.lintegral_compProd (hDE.mul hf)]
  apply lintegral_congr
  intro a
  have hEa : Measurable (fun b => E (a, b)) := hE.comp measurable_prodMk_left
  have hfa : Measurable (fun b => f (a, b)) := hf.comp measurable_prodMk_left
  rw [hη a, lintegral_withDensity_eq_lintegral_mul _ hEa hfa]
  simp only [Pi.mul_apply]
  rw [← lintegral_const_mul _ (hEa.mul hfa)]
  congr 1
  funext b
  exact (mul_assoc _ _ _).symm

/-- Normalization follows from the mass of the changed probability law. -/
theorem integral_sq_eq_one_of_withDensity {P Q : Measure α} [IsProbabilityMeasure Q]
    {U : α → ℝ} (hU : Measurable U)
    (hQ : Q = P.withDensity (fun x => ENNReal.ofReal (U x ^ 2))) :
    (∫ x, U x ^ 2 ∂P) = 1 := by
  have hm : (∫⁻ x, ENNReal.ofReal (U x ^ 2) ∂P) = 1 := by
    have hh := congrArg (fun μ : Measure α => μ Set.univ) hQ
    simpa only [measure_univ, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
      using hh.symm
  rw [integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun x => sq_nonneg (U x))
    (hU.pow_const 2).aestronglyMeasurable, hm, ENNReal.toReal_one]

/-- Square normalization gives integrability of the half-likelihood under a
probability reference, without any separate boundedness hypothesis. -/
theorem integrable_of_integral_sq_eq_one {P : Measure α} [IsProbabilityMeasure P]
    {U : α → ℝ} (hU : Measurable U) (hU2 : (∫ x, U x ^ 2 ∂P) = 1) : Integrable U P := by
  have hi : Integrable (fun x => U x ^ 2) P := by
    by_contra h
    rw [integral_undef h] at hU2
    norm_num at hU2
  exact ((memLp_two_iff_integrable_sq hU.aestronglyMeasurable).mpr hi).integrable (by norm_num)

end DensityTools

/-- The Gaussian half-likelihood is jointly measurable in shift and residual. -/
@[fun_prop] theorem measurable_gaussianHalfLikelihood_joint :
    Measurable (fun p : ℝ × ℝ => gaussianHalfLikelihood p.1 p.2) := by
  unfold gaussianHalfLikelihood
  fun_prop

/-- Half-likelihood of the law with drift `b`, relative to the law with drift `c`. -/
noncomputable def augmentedHalfLikelihood (b c : ℝ) (p : AugmentedStep) : ℝ :=
  gaussianHalfLikelihood (c - b) (p.2 + c - p.1)

@[fun_prop] theorem measurable_augmentedHalfLikelihood_joint :
    Measurable (fun p : (ℝ × ℝ) × AugmentedStep => augmentedHalfLikelihood p.1.1 p.1.2 p.2) :=
  measurable_gaussianHalfLikelihood_joint.comp
    ((measurable_fst.snd.sub measurable_fst.fst).prodMk
      ((measurable_snd.snd.add measurable_fst.snd).sub measurable_snd.fst))

@[fun_prop] theorem measurable_augmentedHalfLikelihood (b c : ℝ) :
    Measurable (augmentedHalfLikelihood b c) :=
  measurable_augmentedHalfLikelihood_joint.comp
    ((measurable_const (a := (b, c))).prodMk measurable_id)

theorem augmentedHalfLikelihood_pos (b c : ℝ) (p : AugmentedStep) :
    0 < augmentedHalfLikelihood b c p := gaussianHalfLikelihood_pos _ _

@[simp] theorem augmentedHalfLikelihood_map (b c : ℝ) (p : ℝ × ℝ) :
    augmentedHalfLikelihood b c (augmentedStepMap c p) = gaussianHalfLikelihood (c - b) p.2 := by
  unfold augmentedHalfLikelihood augmentedStepMap
  congr 1
  ring

/-- The explicit one-step likelihood identity, including an arbitrary latent law. -/
theorem augmentedStepLaw_withDensity_halfLikelihood (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (b c : ℝ) :
    augmentedStepLaw ν b = (augmentedStepLaw ν c).withDensity
      (fun p => ENNReal.ofReal (augmentedHalfLikelihood b c p ^ 2)) := by
  rw [augmentedStepLaw_eq_shifted ν b c]
  change _ = ((ν.prod (gaussianReal 0 1)).map (augmentedStepMap c)).withDensity _
  rw [withDensity_map_eq_map_withDensity _ (measurable_augmentedStepMap c)
    ((measurable_augmentedHalfLikelihood b c).pow_const 2).ennreal_ofReal]
  simp only [augmentedHalfLikelihood_map]
  rw [← prod_withDensity_right ((measurable_gaussianHalfLikelihood (c - b)).pow_const 2).ennreal_ofReal,
    stdGaussian_withDensity_halfLikelihood]

/-- The one-step affinity is exactly the Gaussian affinity, independently of `ν`. -/
theorem integral_augmentedHalfLikelihood (ν : Measure ℝ) [IsProbabilityMeasure ν] (b c : ℝ) :
    (∫ p, augmentedHalfLikelihood b c p ∂augmentedStepLaw ν c) =
      Real.exp (-((c - b) ^ 2) / 8) := by
  rw [augmentedStepLaw, integral_map_of_stronglyMeasurable (measurable_augmentedStepMap c)
    (measurable_augmentedHalfLikelihood b c).stronglyMeasurable]
  simp only [augmentedHalfLikelihood_map]
  rw [integral_prod _ ((integrable_gaussianHalfLikelihood (c - b)).comp_snd ν)]
  simp only [integral_gaussianHalfLikelihood, integral_const, probReal_univ, smul_eq_mul, one_mul]

theorem integral_augmentedHalfLikelihood_sq (ν : Measure ℝ) [IsProbabilityMeasure ν] (b c : ℝ) :
    (∫ p, augmentedHalfLikelihood b c p ^ 2 ∂augmentedStepLaw ν c) = 1 :=
  integral_sq_eq_one_of_withDensity (measurable_augmentedHalfLikelihood b c)
    (augmentedStepLaw_withDensity_halfLikelihood ν b c)

theorem integrable_augmentedHalfLikelihood (ν : Measure ℝ) [IsProbabilityMeasure ν] (b c : ℝ) :
    Integrable (augmentedHalfLikelihood b c) (augmentedStepLaw ν c) :=
  integrable_of_integral_sq_eq_one (measurable_augmentedHalfLikelihood b c)
    (integral_augmentedHalfLikelihood_sq ν b c)

/-- Product of the explicit Gaussian half-likelihoods along a common observed
path.  The first past is the changed law, and the second is the reference law. -/
noncomputable def pathHalfLikelihood (H : Past → ℝ) :
    (n : ℕ) → Past → Past → AugmentedPath n → ℝ
  | 0, _, _, _ => 1
  | n + 1, x, y, p => augmentedHalfLikelihood (H x) (H y) p.1 *
      pathHalfLikelihood H n (prepend p.1.2 x) (prepend p.1.2 y) p.2

@[simp] theorem pathHalfLikelihood_zero (H : Past → ℝ) (x y : Past) (p : AugmentedPath 0) :
    pathHalfLikelihood H 0 x y p = 1 := rfl

@[simp] theorem pathHalfLikelihood_succ (H : Past → ℝ) (n : ℕ) (x y : Past)
    (p : AugmentedPath (n + 1)) :
    pathHalfLikelihood H (n + 1) x y p = augmentedHalfLikelihood (H x) (H y) p.1 *
      pathHalfLikelihood H n (prepend p.1.2 x) (prepend p.1.2 y) p.2 := rfl

/-- Joint measurability in both initial pasts and the common augmented path. -/
@[fun_prop] theorem measurable_pathHalfLikelihood_joint {H : Past → ℝ} (hH : Measurable H)
    (n : ℕ) :
    Measurable (fun p : (Past × Past) × AugmentedPath n =>
      pathHalfLikelihood H n p.1.1 p.1.2 p.2) := by
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
      have hx : Measurable (fun p : (Past × Past) × AugmentedPath (n + 1) =>
          prepend p.2.1.2 p.1.1) :=
        measurable_prepend.comp (measurable_snd.fst.snd.prodMk measurable_fst.fst)
      have hy : Measurable (fun p : (Past × Past) × AugmentedPath (n + 1) =>
          prepend p.2.1.2 p.1.2) :=
        measurable_prepend.comp (measurable_snd.fst.snd.prodMk measurable_fst.snd)
      exact (measurable_augmentedHalfLikelihood_joint.comp
        (((hH.comp measurable_fst.fst).prodMk (hH.comp measurable_fst.snd)).prodMk
          measurable_snd.fst)).mul
        (ih.comp ((hx.prodMk hy).prodMk measurable_snd.snd))

@[fun_prop] theorem measurable_pathHalfLikelihood {H : Past → ℝ} (hH : Measurable H)
    (n : ℕ) (x y : Past) : Measurable (pathHalfLikelihood H n x y) :=
  (measurable_pathHalfLikelihood_joint hH n).comp
    ((measurable_const (a := (x, y))).prodMk measurable_id)

theorem pathHalfLikelihood_pos (H : Past → ℝ) (n : ℕ) (x y : Past) (p : AugmentedPath n) :
    0 < pathHalfLikelihood H n x y p := by
  induction n generalizing x y with
  | zero => exact zero_lt_one
  | succ n ih => exact mul_pos (augmentedHalfLikelihood_pos _ _ _) (ih _ _ _)

@[simp] theorem abs_pathHalfLikelihood (H : Past → ℝ) (n : ℕ) (x y : Past)
    (p : AugmentedPath n) : |pathHalfLikelihood H n x y p| = pathHalfLikelihood H n x y p :=
  abs_of_pos (pathHalfLikelihood_pos H n x y p)

/-- Jointly measurable tail half-likelihood after a common first observation. -/
@[fun_prop] theorem measurable_pathHalfLikelihood_tail {H : Past → ℝ} (hH : Measurable H)
    (n : ℕ) (x y : Past) :
    Measurable (fun p : AugmentedStep × AugmentedPath n =>
      pathHalfLikelihood H n (prepend p.1.2 x) (prepend p.1.2 y) p.2) := by
  have hx : Measurable (fun p : AugmentedStep × AugmentedPath n => prepend p.1.2 x) :=
    measurable_prepend.comp (measurable_fst.snd.prodMk measurable_const)
  have hy : Measurable (fun p : AugmentedStep × AugmentedPath n => prepend p.1.2 y) :=
    measurable_prepend.comp (measurable_fst.snd.prodMk measurable_const)
  exact (measurable_pathHalfLikelihood_joint hH n).comp ((hx.prodMk hy).prodMk measurable_snd)

/-- The finite-path change of measure is the square of the explicit product
half-likelihood.  This holds at every pair of real initial histories. -/
theorem augmentedPathKernel_withDensity_halfLikelihood (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) (x y : Past) :
    augmentedPathKernel H hH ν n x = (augmentedPathKernel H hH ν n y).withDensity
      (fun p => ENNReal.ofReal (pathHalfLikelihood H n x y p ^ 2)) := by
  induction n generalizing x y with
  | zero => simp [augmentedPathKernel, finitePathKernel, pathHalfLikelihood]
  | succ n ih =>
      rw [augmentedPathKernel_succ, augmentedPathKernel_succ]
      simp only [pathHalfLikelihood_succ, mul_pow, ENNReal.ofReal_mul (sq_nonneg _)]
      apply compProd_eq_withDensity_mul
        ((measurable_augmentedHalfLikelihood (H x) (H y)).pow_const 2).ennreal_ofReal
        ((measurable_pathHalfLikelihood_tail hH n x y).pow_const 2).ennreal_ofReal
        (augmentedStepLaw_withDensity_halfLikelihood ν (H x) (H y))
      intro a
      exact ih _ _

/-- The likelihood is exactly normalized, even when the drift is merely measurable. -/
theorem integral_pathHalfLikelihood_sq (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) (x y : Past) :
    (∫ p, pathHalfLikelihood H n x y p ^ 2 ∂augmentedPathKernel H hH ν n y) = 1 :=
  integral_sq_eq_one_of_withDensity (measurable_pathHalfLikelihood hH n x y)
    (augmentedPathKernel_withDensity_halfLikelihood H hH ν n x y)

theorem integrable_pathHalfLikelihood (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) (x y : Past) :
    Integrable (pathHalfLikelihood H n x y) (augmentedPathKernel H hH ν n y) :=
  integrable_of_integral_sq_eq_one (measurable_pathHalfLikelihood hH n x y)
    (integral_pathHalfLikelihood_sq H hH ν n x y)

/-- Conditional integration exposes precisely one fresh Gaussian factor. -/
theorem integral_pathHalfLikelihood_succ (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) (x y : Past) :
    (∫ p, pathHalfLikelihood H (n + 1) x y p ∂augmentedPathKernel H hH ν (n + 1) y) =
      ∫ a, augmentedHalfLikelihood (H x) (H y) a *
        (∫ p, pathHalfLikelihood H n (prepend a.2 x) (prepend a.2 y) p
          ∂augmentedPathKernel H hH ν n (prepend a.2 y)) ∂augmentedStepLaw ν (H y) := by
  have hi := integrable_pathHalfLikelihood H hH ν (n + 1) x y
  rw [augmentedPathKernel_succ] at hi ⊢
  have hh := Measure.integral_compProd hi
  simpa only [pathHalfLikelihood_succ, Kernel.comap_apply, integral_const_mul] using hh

/-- The conditional affinity times its first factor is integrable. -/
theorem integrable_pathHalfLikelihood_conditional (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (n : ℕ) (x y : Past) :
    Integrable (fun a => augmentedHalfLikelihood (H x) (H y) a *
      (∫ p, pathHalfLikelihood H n (prepend a.2 x) (prepend a.2 y) p
        ∂augmentedPathKernel H hH ν n (prepend a.2 y))) (augmentedStepLaw ν (H y)) := by
  have hi := integrable_pathHalfLikelihood H hH ν (n + 1) x y
  rw [augmentedPathKernel_succ] at hi
  have hh := ((Measure.integrable_compProd_iff hi.aestronglyMeasurable).mp hi).2
  simp only [Real.norm_eq_abs, abs_pathHalfLikelihood] at hh
  simpa only [pathHalfLikelihood_succ, Kernel.comap_apply, integral_const_mul] using hh

/-- A deterministic bound on variation after agreement of the first `k` past entries. -/
def HasVariationMajorant (H : Past → ℝ) (d : ℕ → ℝ) : Prop :=
  ∀ (k : ℕ) (x y : Past), AgreeFirst k x y → |H x - H y| ≤ d k

/-- Squared variation accumulated along a common prefix of length `n`. -/
noncomputable def variationEnergy (d : ℕ → ℝ) (m n : ℕ) : ℝ :=
  ∑ j ∈ Finset.range n, d (m + j) ^ 2

@[simp] theorem variationEnergy_zero (d : ℕ → ℝ) (m : ℕ) : variationEnergy d m 0 = 0 := by
  simp [variationEnergy]

theorem variationEnergy_nonneg (d : ℕ → ℝ) (m n : ℕ) : 0 ≤ variationEnergy d m n :=
  Finset.sum_nonneg fun _ _ => sq_nonneg _

/-- Peel off the earliest factor, rather than the last factor, in the variation sum. -/
theorem variationEnergy_succ (d : ℕ → ℝ) (m n : ℕ) :
    variationEnergy d m (n + 1) = d m ^ 2 + variationEnergy d (m + 1) n := by
  simp only [variationEnergy, Finset.sum_range_succ', Nat.add_zero]
  rw [add_comm]
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  rw [show m + (j + 1) = m + 1 + j by omega]

/-- The finite-path affinity lower bound from iterated conditional Gaussian
moments.  No monotonicity or summability of the variation majorant is assumed. -/
theorem integral_pathHalfLikelihood_ge (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] {d : ℕ → ℝ}
    (hd : ∀ k, 0 ≤ d k) (hvar : HasVariationMajorant H d)
    (n m : ℕ) {x y : Past} (hxy : AgreeFirst m x y) :
    Real.exp (-variationEnergy d m n / 8) ≤
      ∫ p, pathHalfLikelihood H n x y p ∂augmentedPathKernel H hH ν n y := by
  induction n generalizing m x y with
  | zero => simp [augmentedPathKernel, finitePathKernel]
  | succ n ih =>
      have hsq : (H y - H x) ^ 2 ≤ d m ^ 2 := by
        have hh := (sq_le_sq₀ (abs_nonneg (H x - H y)) (hd m)).mpr (hvar m x y hxy)
        simpa only [sq_abs, ← neg_sub (H x) (H y), even_two, Even.neg_pow] using hh
      have htail (a : AugmentedStep) :
          Real.exp (-variationEnergy d (m + 1) n / 8) ≤
            ∫ p, pathHalfLikelihood H n (prepend a.2 x) (prepend a.2 y) p
              ∂augmentedPathKernel H hH ν n (prepend a.2 y) :=
        ih (m + 1) (hxy.prepend a.2)
      calc
        Real.exp (-variationEnergy d m (n + 1) / 8) ≤
            Real.exp (-((H y - H x) ^ 2) / 8) *
              Real.exp (-variationEnergy d (m + 1) n / 8) := by
          rw [variationEnergy_succ, ← Real.exp_add]
          apply Real.exp_le_exp.mpr
          linarith
        _ = ∫ a, augmentedHalfLikelihood (H x) (H y) a *
              Real.exp (-variationEnergy d (m + 1) n / 8) ∂augmentedStepLaw ν (H y) := by
          rw [integral_mul_const, integral_augmentedHalfLikelihood]
        _ ≤ ∫ a, augmentedHalfLikelihood (H x) (H y) a *
            (∫ p, pathHalfLikelihood H n (prepend a.2 x) (prepend a.2 y) p
              ∂augmentedPathKernel H hH ν n (prepend a.2 y)) ∂augmentedStepLaw ν (H y) :=
          integral_mono
            ((integrable_augmentedHalfLikelihood ν (H x) (H y)).mul_const _)
            (integrable_pathHalfLikelihood_conditional H hH ν n x y)
            (fun a => mul_le_mul_of_nonneg_left (htail a) (augmentedHalfLikelihood_pos _ _ _).le)
        _ = ∫ p, pathHalfLikelihood H (n + 1) x y p
              ∂augmentedPathKernel H hH ν (n + 1) y :=
          (integral_pathHalfLikelihood_succ H hH ν n x y).symm

/-- Finite-prefix square-sum bound on the augmented law, with all latent
innovations retained. -/
theorem testClose_augmentedPathKernel_of_agree (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] {d : ℕ → ℝ}
    (hd : ∀ k, 0 ≤ d k) (hvar : HasVariationMajorant H d)
    (n m : ℕ) {x y : Past} (hxy : AgreeFirst m x y) :
    TestClose (augmentedPathKernel H hH ν n x) (augmentedPathKernel H hH ν n y)
      (Real.sqrt (∑ j ∈ Finset.range n, d (m + j) ^ 2)) :=
  (testClose_of_halfLikelihood (measurable_pathHalfLikelihood hH n x y)
    (augmentedPathKernel_withDensity_halfLikelihood H hH ν n x y)
    (integral_pathHalfLikelihood_sq H hH ν n x y)
    (integral_pathHalfLikelihood_ge H hH ν hd hvar n m hxy)).symm

/-- Main finite-prefix estimate on the exported observed path law.  Starting
pasts agreeing in their most recent `m` entries have `n`-prefix distance at most
`sqrt (∑ j < n, d (m+j)^2)`. -/
theorem testClose_pathLaw_of_agree (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] {d : ℕ → ℝ}
    (hd : ∀ k, 0 ≤ d k) (hvar : HasVariationMajorant H d)
    (n m : ℕ) {x y : Past} (hxy : AgreeFirst m x y) :
    TestClose (pathLaw H hH ν n x) (pathLaw H hH ν n y)
      (Real.sqrt (∑ j ∈ Finset.range n, d (m + j) ^ 2)) := by
  rw [pathLaw_eq_map, pathLaw_eq_map]
  exact (testClose_augmentedPathKernel_of_agree H hH ν hd hvar n m hxy).map
    (measurable_observedPath n)

end Cascade
end


/- Supporting development: Cascade.BlockRefresh -/
section
set_option autoImplicit false

/-
# Common output blocks and finite-kernel refresh

The common law below is a law on *all* outputs in a chronological block, not
just on the final state.  Its complement is defined by subtraction of measures
and normalized to a probability.  The refresh estimate uses only integration
and a cross-oscillation bound; no maximal coupling is chosen.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal

namespace Cascade

section MeasureTools

variable {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]

/-- Order gluing for a measure and its conditional kernel. -/
theorem compProd_mono_of_le {P Q : Measure α} [SFinite P] [SFinite Q]
    {κ η : Kernel α β} [IsSFiniteKernel κ] [IsSFiniteKernel η]
    (hPQ : P ≤ Q) (hκη : ∀ x, κ x ≤ η x) : P ⊗ₘ κ ≤ Q ⊗ₘ η := by
  apply Measure.le_iff.mpr
  intro s hs
  rw [Measure.compProd_apply hs, Measure.compProd_apply hs]
  exact lintegral_mono' hPQ (fun x => hκη x _)

/-- The corresponding order statement for independent product measures. -/
theorem prod_mono_of_le {P Q : Measure α} {R S : Measure β}
    [SFinite R] [SFinite S] (hPQ : P ≤ Q) (hRS : R ≤ S) : P.prod R ≤ Q.prod S := by
  apply Measure.le_iff.mpr
  intro s hs
  rw [Measure.prod_apply hs, Measure.prod_apply hs]
  exact lintegral_mono' hPQ (fun x => hRS _)

/-- Cross-oscillation controls expectations under two unrelated probabilities.
The two functions can even have different domains. -/
theorem abs_integral_sub_integral_le_of_cross {P : Measure α} {Q : Measure β}
    [IsProbabilityMeasure P] [IsProbabilityMeasure Q] {f : α → ℝ} {g : β → ℝ}
    (hf : Integrable f P) (hg : Integrable g Q) {e : ℝ}
    (hfg : ∀ x y, |f x - g y| ≤ e) :
    |(∫ x, f x ∂P) - ∫ y, g y ∂Q| ≤ e := by
  have hu (x : α) : f x ≤ (∫ y, g y ∂Q) + e := by
    have h := integral_mono (μ := Q) (integrable_const (f x - e)) hg
      (fun y => by have hh := (abs_le.mp (hfg x y)).2; linarith)
    simp only [integral_const, probReal_univ, one_smul] at h
    linarith
  have hl (x : α) : (∫ y, g y ∂Q) - e ≤ f x := by
    have h := integral_mono (μ := Q) hg (integrable_const (f x + e))
      (fun y => by have hh := (abs_le.mp (hfg x y)).1; linarith)
    simp only [integral_const, probReal_univ, one_smul] at h
    linarith
  have hu' := integral_mono hf (integrable_const ((∫ y, g y ∂Q) + e)) hu
  have hl' := integral_mono (integrable_const ((∫ y, g y ∂Q) - e)) hf hl
  simp only [integral_const, probReal_univ, one_smul] at hu' hl'
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- Pointwise comparison can be integrated against a common probability. -/
theorem abs_integral_sub_integral_le_of_pointwise {P : Measure α}
    [IsProbabilityMeasure P] {f g : α → ℝ} (hf : Integrable f P) (hg : Integrable g P)
    {e : ℝ} (hfg : ∀ x, |f x - g x| ≤ e) :
    |(∫ x, f x ∂P) - ∫ x, g x ∂P| ≤ e := by
  rw [← integral_sub hf hg]
  have hb : ∀ᵐ x ∂P, ‖f x - g x‖ ≤ e :=
    ae_of_all _ fun x => by simpa only [Real.norm_eq_abs] using hfg x
  simpa only [Real.norm_eq_abs, probReal_univ, mul_one] using
    norm_integral_le_of_norm_le_const hb

/-- The nonnegative residual after removing a common subprobability. -/
noncomputable def refreshResidual (P ρ : Measure α) (a : ℝ) : Measure α :=
  P - ENNReal.ofReal a • ρ

instance isFiniteMeasure_refreshResidual (P ρ : Measure α) [IsFiniteMeasure P] (a : ℝ) :
    IsFiniteMeasure (refreshResidual P ρ a) := by
  unfold refreshResidual
  infer_instance

/-- The normalized residual.  Probability is asserted only with the required
minorization and `a < 1`, so the zero-mass case is never silently normalized. -/
noncomputable def normalizedRefreshResidual (P ρ : Measure α) (a : ℝ) : Measure α :=
  (ENNReal.ofReal (1 - a))⁻¹ • refreshResidual P ρ a

/-- Residual measures vary measurably with the parameter when the submeasure
is fixed and the minorization holds at every parameter. -/
theorem measurable_refreshResidual {P : β → Measure α} (hP : Measurable P)
    (ρ : Measure α) [IsFiniteMeasure ρ] (a : ℝ)
    (hminor : ∀ x, ENNReal.ofReal a • ρ ≤ P x) :
    Measurable (fun x => refreshResidual (P x) ρ a) := by
  letI := ρ.smul_finite (c := ENNReal.ofReal a) ENNReal.ofReal_ne_top
  apply Measure.measurable_of_measurable_coe
  intro s hs
  have heq : (fun x => (refreshResidual (P x) ρ a) s) =
      fun x => (P x) s - (ENNReal.ofReal a • ρ) s :=
    funext fun x => Measure.sub_apply hs (hminor x)
  rw [heq]
  exact ((Measure.measurable_coe hs).comp hP).sub measurable_const

/-- Normalization by the fixed residual mass also preserves parameter
measurability.  Positivity of that mass is only needed for probability. -/
theorem measurable_normalizedRefreshResidual {P : β → Measure α} (hP : Measurable P)
    (ρ : Measure α) [IsFiniteMeasure ρ] (a : ℝ)
    (hminor : ∀ x, ENNReal.ofReal a • ρ ≤ P x) :
    Measurable (fun x => normalizedRefreshResidual (P x) ρ a) := by
  apply Measure.measurable_of_measurable_coe
  intro s hs
  simp only [normalizedRefreshResidual, Measure.smul_apply, smul_eq_mul]
  exact measurable_const.mul ((Measure.measurable_coe hs).comp
    (measurable_refreshResidual hP ρ a hminor))

theorem refreshResidual_univ {P ρ : Measure α}
    [IsProbabilityMeasure P] [IsProbabilityMeasure ρ] {a : ℝ} (ha : 0 ≤ a)
    (hminor : ENNReal.ofReal a • ρ ≤ P) :
    refreshResidual P ρ a Set.univ = ENNReal.ofReal (1 - a) := by
  letI := ρ.smul_finite (c := ENNReal.ofReal a) ENNReal.ofReal_ne_top
  rw [refreshResidual, Measure.sub_apply MeasurableSet.univ hminor,
    measure_univ, Measure.smul_apply, measure_univ, smul_eq_mul, mul_one,
    ENNReal.ofReal_sub 1 ha, ENNReal.ofReal_one]

theorem isProbabilityMeasure_normalizedRefreshResidual {P ρ : Measure α}
    [IsProbabilityMeasure P] [IsProbabilityMeasure ρ] {a : ℝ}
    (ha : 0 ≤ a) (ha1 : a < 1) (hminor : ENNReal.ofReal a • ρ ≤ P) :
    IsProbabilityMeasure (normalizedRefreshResidual P ρ a) := by
  constructor
  rw [normalizedRefreshResidual, Measure.smul_apply, smul_eq_mul,
    refreshResidual_univ ha hminor]
  exact ENNReal.inv_mul_cancel (ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr ha1))
    ENNReal.ofReal_ne_top

theorem smul_normalizedRefreshResidual (P ρ : Measure α) {a : ℝ} (ha1 : a < 1) :
    ENNReal.ofReal (1 - a) • normalizedRefreshResidual P ρ a = refreshResidual P ρ a := by
  rw [normalizedRefreshResidual, smul_smul,
    ENNReal.mul_inv_cancel (ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr ha1))
      ENNReal.ofReal_ne_top, one_smul]

/-- The common and residual masses are exactly `a` and `1-a`. -/
theorem eq_common_add_normalizedRefreshResidual {P ρ : Measure α}
    [IsProbabilityMeasure P] [IsProbabilityMeasure ρ] {a : ℝ} (ha1 : a < 1)
    (hminor : ENNReal.ofReal a • ρ ≤ P) :
    P = ENNReal.ofReal a • ρ +
      ENNReal.ofReal (1 - a) • normalizedRefreshResidual P ρ a := by
  letI := ρ.smul_finite (c := ENNReal.ofReal a) ENNReal.ofReal_ne_top
  rw [smul_normalizedRefreshResidual P ρ ha1, refreshResidual, add_comm]
  exact (Measure.sub_add_cancel_of_le hminor).symm

/-- Expectation decomposition, with real weights and bounded measurable tests. -/
theorem integral_eq_common_add_residual {P ρ : Measure α}
    [IsProbabilityMeasure P] [IsProbabilityMeasure ρ] {a : ℝ}
    (ha : 0 ≤ a) (ha1 : a < 1) (hminor : ENNReal.ofReal a • ρ ≤ P)
    {f : α → ℝ} (hf : Measurable f) (hf01 : ∀ x, 0 ≤ f x ∧ f x ≤ 1) :
    (∫ x, f x ∂P) = a * (∫ x, f x ∂ρ) +
      (1 - a) * (∫ x, f x ∂normalizedRefreshResidual P ρ a) := by
  letI := isProbabilityMeasure_normalizedRefreshResidual ha ha1 hminor
  calc
    (∫ x, f x ∂P) = ∫ x, f x ∂(ENNReal.ofReal a • ρ +
        ENNReal.ofReal (1 - a) • normalizedRefreshResidual P ρ a) :=
      congrArg (fun μ : Measure α => ∫ x, f x ∂μ)
        (eq_common_add_normalizedRefreshResidual ha1 hminor)
    _ = _ := by
      rw [integral_add_measure
        ((integrable_of_test ρ hf hf01).smul_measure ENNReal.ofReal_ne_top)
        ((integrable_of_test (normalizedRefreshResidual P ρ a) hf hf01).smul_measure
          ENNReal.ofReal_ne_top)]
      simp only [integral_smul_measure, ENNReal.toReal_ofReal ha,
        ENNReal.toReal_ofReal (sub_nonneg.mpr ha1.le), smul_eq_mul]

/-- The refresh arithmetic: compare the functions on the SAME common output,
then use cross-oscillation on the two normalized residual probabilities. -/
theorem abs_integral_sub_le_refresh {P Q ρ : Measure α}
    [IsProbabilityMeasure P] [IsProbabilityMeasure Q] [IsProbabilityMeasure ρ]
    {a δ e : ℝ} (ha : 0 ≤ a) (ha1 : a < 1)
    (hP : ENNReal.ofReal a • ρ ≤ P) (hQ : ENNReal.ofReal a • ρ ≤ Q)
    {f g : α → ℝ} (hf : Measurable f) (hg : Measurable g)
    (hf01 : ∀ x, 0 ≤ f x ∧ f x ≤ 1) (hg01 : ∀ x, 0 ≤ g x ∧ g x ≤ 1)
    (hdiag : ∀ x, |f x - g x| ≤ δ) (hcross : ∀ x y, |f x - g y| ≤ e) :
    |(∫ x, f x ∂P) - ∫ x, g x ∂Q| ≤ a * δ + (1 - a) * e := by
  letI := isProbabilityMeasure_normalizedRefreshResidual ha ha1 hP
  letI := isProbabilityMeasure_normalizedRefreshResidual ha ha1 hQ
  have hc := abs_integral_sub_integral_le_of_pointwise
    (integrable_of_test ρ hf hf01) (integrable_of_test ρ hg hg01) hdiag
  have hr := abs_integral_sub_integral_le_of_cross
    (integrable_of_test (normalizedRefreshResidual P ρ a) hf hf01)
    (integrable_of_test (normalizedRefreshResidual Q ρ a) hg hg01) hcross
  rw [integral_eq_common_add_residual ha ha1 hP hf hf01,
    integral_eq_common_add_residual ha ha1 hQ hg hg01]
  calc
    |a * (∫ x, f x ∂ρ) + (1 - a) * (∫ x, f x ∂normalizedRefreshResidual P ρ a) -
        (a * (∫ x, g x ∂ρ) + (1 - a) * (∫ x, g x ∂normalizedRefreshResidual Q ρ a))| =
        |a * ((∫ x, f x ∂ρ) - ∫ x, g x ∂ρ) + (1 - a) *
          ((∫ x, f x ∂normalizedRefreshResidual P ρ a) -
            ∫ x, g x ∂normalizedRefreshResidual Q ρ a)| := by congr 1; ring
    _ ≤ |a * ((∫ x, f x ∂ρ) - ∫ x, g x ∂ρ)| +
        |(1 - a) * ((∫ x, f x ∂normalizedRefreshResidual P ρ a) -
          ∫ x, g x ∂normalizedRefreshResidual Q ρ a)| := abs_add_le _ _
    _ ≤ a * δ + (1 - a) * e := by
      rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg (sub_nonneg.mpr ha1.le)]
      exact add_le_add (mul_le_mul_of_nonneg_left hc ha)
        (mul_le_mul_of_nonneg_left hr (sub_nonneg.mpr ha1.le))

/-- Any two probability measures are within one in test distance. -/
theorem testClose_one (P Q : Measure α) [IsProbabilityMeasure P] [IsProbabilityMeasure Q] :
    TestClose P Q 1 := by
  intro f hf hf01
  have hP := integral_test_mem_Icc P hf hf01
  have hQ := integral_test_mem_Icc Q hf hf01
  exact abs_le.mpr ⟨by linarith, by linarith⟩

end MeasureTools

section ProductPaths

variable {S A : Type} [MeasurableSpace S] [MeasurableSpace A]

/-- Independent chronological outputs with common law `ρ`, including the empty block. -/
noncomputable def productPathLaw (ρ : Measure A) : (n : ℕ) → Measure (FinitePath A n)
  | 0 => Measure.dirac ()
  | n + 1 => ρ.prod (productPathLaw ρ n)

instance isProbabilityMeasure_productPathLaw (ρ : Measure A) [IsProbabilityMeasure ρ] :
    (n : ℕ) → IsProbabilityMeasure (productPathLaw ρ n)
  | 0 => by unfold productPathLaw; infer_instance
  | n + 1 => by
      letI := isProbabilityMeasure_productPathLaw ρ n
      exact inferInstanceAs (IsProbabilityMeasure (ρ.prod (productPathLaw ρ n)))

/-- A one-output common minorizer gives a common law on the ENTIRE output block.
There is no restriction on the state update or on the initial state. -/
theorem finitePathKernel_minorization (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update)
    (ρ : Measure A) [IsProbabilityMeasure ρ] (a : ℝ≥0∞)
    (hminor : ∀ s, a • ρ ≤ κ s) (n : ℕ) (s : S) :
    a ^ n • productPathLaw ρ n ≤ finitePathKernel κ update hu n s := by
  induction n generalizing s with
  | zero => simp [productPathLaw]
  | succ n ih =>
      rw [finitePathKernel_succ]
      calc
        a ^ (n + 1) • productPathLaw ρ (n + 1) =
            (a • ρ) ⊗ₘ Kernel.const A (a ^ n • productPathLaw ρ n) := by
          rw [Measure.compProd_const, Measure.prod_smul_left, Measure.prod_smul_right, smul_smul]
          simp only [productPathLaw, pow_succ']
        _ ≤ (κ s) ⊗ₘ finiteContinuationKernel κ update hu n s :=
          compProd_mono_of_le (hminor s) (fun x => ih (update (s, x)))

end ProductPaths


namespace FinitePath
variable {A : Type}
/-- Drop the first `N` chronological outputs, retaining the next `T`. -/
def suffix (N T : ℕ) (p : FinitePath A (T + N)) : FinitePath A T :=
  (split N T p).2
@[fun_prop] theorem measurable_suffix [MeasurableSpace A] (N T : ℕ) : Measurable (suffix (A := A) N T) :=
  (measurable_split N T).snd
@[simp] theorem suffix_append (N T : ℕ) (p : FinitePath A N) (q : FinitePath A T) :
    suffix N T (append N T p q) = q := by simp [suffix]
@[simp] theorem suffix_zero (T : ℕ) (p : FinitePath A (T + 0)) : suffix 0 T p = p := rfl
@[simp] theorem toFn_suffix (N T : ℕ) (p : FinitePath A (T + N)) (i : Fin T) :
    toFn T (suffix N T p) i = toFn (T + N) p (i.addNat N) := by
  induction N with
  | zero => rfl
  | succ N ih => exact ih p.2
end FinitePath

section FuturePaths

variable {S A : Type} [MeasurableSpace S] [MeasurableSpace A]
/-- The state obtained after a complete finite output block. -/
noncomputable def finiteStateKernel (κ : Kernel S A) (update : S × A → S)
    (hu : Measurable update) (n : ℕ) : Kernel S S :=
  ((Kernel.id : Kernel S S) ×ₖ finitePathKernel κ update hu n).map
    (fun p : S × FinitePath A n => FinitePath.advance update n p.1 p.2)
instance isMarkovKernel_finiteStateKernel (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n : ℕ) :
    IsMarkovKernel (finiteStateKernel κ update hu n) :=
  Kernel.IsMarkovKernel.map _ (FinitePath.measurable_advance hu n)
/-- Final-state law as the pushforward of the retained chronological path. -/
theorem finiteStateKernel_apply (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n : ℕ) (s : S) :
    finiteStateKernel κ update hu n s =
      (finitePathKernel κ update hu n s).map (FinitePath.advance update n s) := by
  rw [finiteStateKernel, Kernel.map_apply _ (FinitePath.measurable_advance hu n),
    Kernel.prod_apply, Kernel.id_apply, Measure.dirac_prod,
    Measure.map_map (FinitePath.measurable_advance hu n) measurable_prodMk_left]
  rfl

@[simp] theorem finiteStateKernel_zero (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) :
    finiteStateKernel κ update hu 0 = Kernel.id := by
  apply Kernel.ext
  intro s
  rw [finiteStateKernel_apply, finitePathKernel_zero, Kernel.id_apply]
  exact Measure.map_dirac measurable_const ()

/-- Nonnegative final-state expectations expressed in output coordinates. -/
theorem lintegral_finiteStateKernel (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n : ℕ) (s : S)
    {f : S → ℝ≥0∞} (hf : Measurable f) :
    (∫⁻ t, f t ∂finiteStateKernel κ update hu n s) =
      ∫⁻ p, f (FinitePath.advance update n s p) ∂finitePathKernel κ update hu n s := by
  rw [finiteStateKernel_apply]
  exact lintegral_map hf ((FinitePath.measurable_advance hu n).comp
    (measurable_const.prodMk measurable_id))

/-- State evolution through consecutive blocks is kernel composition. -/
theorem finiteStateKernel_add (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n m : ℕ) :
    finiteStateKernel κ update hu (n + m) =
      finiteStateKernel κ update hu n ∘ₖ finiteStateKernel κ update hu m := by
  apply Kernel.ext
  intro s
  refine Measure.ext_of_lintegral _ fun f hf => ?_
  rw [lintegral_finiteStateKernel _ _ _ _ _ hf, Kernel.lintegral_comp _ _ _ hf,
    lintegral_finiteStateKernel _ _ _ _ _ hf.lintegral_kernel]
  have hfs : Measurable (fun p => f (FinitePath.advance update (n + m) s p)) :=
    hf.comp ((FinitePath.measurable_advance hu (n + m)).comp
      ((measurable_const (a := s)).prodMk measurable_id))
  rw [lintegral_finitePathKernel_append κ update hu m n s hfs]
  simp only [FinitePath.advance_append]
  apply lintegral_congr
  intro p
  exact (lintegral_finiteStateKernel κ update hu n
    (FinitePath.advance update m s p) hf).symm


/-- Measurable real final-state expectations expressed in output coordinates. -/
theorem integral_finiteStateKernel (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (n : ℕ) (s : S)
    {f : S → ℝ} (hf : Measurable f) :
    (∫ t, f t ∂finiteStateKernel κ update hu n s) =
      ∫ p, f (FinitePath.advance update n s p) ∂finitePathKernel κ update hu n s := by
  rw [finiteStateKernel_apply]
  exact integral_map_of_stronglyMeasurable ((FinitePath.measurable_advance hu n).comp
    (measurable_const.prodMk measurable_id)) hf.stronglyMeasurable

/-- Law of the next `T` outputs after `N` unobserved burn-in steps. -/
noncomputable def finiteFutureKernel (κ : Kernel S A) (update : S × A → S)
    (hu : Measurable update) (N T : ℕ) : Kernel S (FinitePath A T) :=
  finitePathKernel κ update hu T ∘ₖ finiteStateKernel κ update hu N

instance isMarkovKernel_finiteFutureKernel (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (N T : ℕ) :
    IsMarkovKernel (finiteFutureKernel κ update hu N T) := by
  unfold finiteFutureKernel
  infer_instance

@[simp] theorem finiteFutureKernel_zero (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (T : ℕ) :
    finiteFutureKernel κ update hu 0 T = finitePathKernel κ update hu T := by
  rw [finiteFutureKernel, finiteStateKernel_zero, Kernel.comp_id]

/-- Restart after the earliest `m` burn-in steps. -/
theorem finiteFutureKernel_add (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (N m T : ℕ) :
    finiteFutureKernel κ update hu (N + m) T =
      finiteFutureKernel κ update hu N T ∘ₖ finiteStateKernel κ update hu m := by
  simp only [finiteFutureKernel, finiteStateKernel_add, Kernel.comp_assoc]

/-- Block recursion for bounded measurable future tests. -/
theorem integral_finiteFutureKernel_add (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (N m T : ℕ) (s : S)
    {f : FinitePath A T → ℝ} (hf : Measurable f) (hf01 : ∀ p, 0 ≤ f p ∧ f p ≤ 1) :
    (∫ p, f p ∂finiteFutureKernel κ update hu (N + m) T s) =
      ∫ p, (∫ q, f q ∂finiteFutureKernel κ update hu N T
        (FinitePath.advance update m s p)) ∂finitePathKernel κ update hu m s := by
  rw [finiteFutureKernel_add, Kernel.integral_comp (integrable_of_test _ hf hf01)]
  exact integral_finiteStateKernel κ update hu m s hf.stronglyMeasurable.integral_kernel.measurable

/-- The future kernel is precisely the suffix marginal of the full finite path. -/
theorem finiteFutureKernel_eq_map_suffix (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (N T : ℕ) (s : S) :
    finiteFutureKernel κ update hu N T s =
      (finitePathKernel κ update hu (T + N) s).map (FinitePath.suffix N T) := by
  refine Measure.ext_of_lintegral _ fun f hf => ?_
  rw [finiteFutureKernel, Kernel.lintegral_comp _ _ _ hf,
    lintegral_finiteStateKernel _ _ _ _ _ hf.lintegral_kernel,
    lintegral_map hf (FinitePath.measurable_suffix N T)]
  simpa only [Function.comp_apply, FinitePath.suffix_append] using
    (lintegral_finitePathKernel_append κ update hu N T s
      (hf.comp (FinitePath.measurable_suffix N T))).symm



/-- One refresh block gives the recursion `a * δ + (1-a) * oldBound`.
The common estimate is applied after the SAME complete output prefix. -/
theorem testClose_finiteFutureKernel_refresh (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (N m T : ℕ)
    (ρ : Measure (FinitePath A m)) [IsProbabilityMeasure ρ] {a δ e : ℝ}
    (ha : 0 ≤ a) (ha1 : a < 1)
    (hminor : ∀ s, ENNReal.ofReal a • ρ ≤ finitePathKernel κ update hu m s)
    (hcommon : ∀ s t p,
      TestClose (finitePathKernel κ update hu (T + N) (FinitePath.advance update m s p))
        (finitePathKernel κ update hu (T + N) (FinitePath.advance update m t p)) δ)
    (hold : ∀ s t, TestClose (finiteFutureKernel κ update hu N T s)
      (finiteFutureKernel κ update hu N T t) e) (s t : S) :
    TestClose (finiteFutureKernel κ update hu (N + m) T s)
      (finiteFutureKernel κ update hu (N + m) T t) (a * δ + (1 - a) * e) := by
  intro f hf hf01
  rw [integral_finiteFutureKernel_add κ update hu N m T s hf hf01,
    integral_finiteFutureKernel_add κ update hu N m T t hf hf01]
  have hF (s : S) : Measurable (fun p : FinitePath A m =>
      ∫ q, f q ∂finiteFutureKernel κ update hu N T (FinitePath.advance update m s p)) :=
    (hf.stronglyMeasurable.integral_kernel.measurable).comp
      ((FinitePath.measurable_advance hu m).comp (measurable_const.prodMk measurable_id))
  have hF01 (s : S) (p : FinitePath A m) :
      0 ≤ (∫ q, f q ∂finiteFutureKernel κ update hu N T (FinitePath.advance update m s p)) ∧
        (∫ q, f q ∂finiteFutureKernel κ update hu N T (FinitePath.advance update m s p)) ≤ 1 :=
    integral_test_mem_Icc _ hf hf01
  apply abs_integral_sub_le_refresh ha ha1 (hminor s) (hminor t)
    (hF s) (hF t) (hF01 s) (hF01 t)
  · intro p
    have hc : TestClose
        (finiteFutureKernel κ update hu N T (FinitePath.advance update m s p))
        (finiteFutureKernel κ update hu N T (FinitePath.advance update m t p)) δ := by
      rw [finiteFutureKernel_eq_map_suffix, finiteFutureKernel_eq_map_suffix]
      exact (hcommon s t p).map (FinitePath.measurable_suffix N T)
    exact hc f hf hf01
  · intro p q
    exact hold (FinitePath.advance update m s p) (FinitePath.advance update m t q) f hf hf01

/-- Once a future-kernel diameter is uniform over all initial states, any
additional burn-in preserves that bound.  The two initial block laws need not
have any common part for this assertion. -/
theorem testClose_finiteFutureKernel_add_of_uniform (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (N m T : ℕ) {e : ℝ}
    (hold : ∀ s t, TestClose (finiteFutureKernel κ update hu N T s)
      (finiteFutureKernel κ update hu N T t) e) (s t : S) :
    TestClose (finiteFutureKernel κ update hu (N + m) T s)
      (finiteFutureKernel κ update hu (N + m) T t) e := by
  intro f hf hf01
  rw [integral_finiteFutureKernel_add κ update hu N m T s hf hf01,
    integral_finiteFutureKernel_add κ update hu N m T t hf hf01]
  have hF (s : S) : Measurable (fun p : FinitePath A m =>
      ∫ q, f q ∂finiteFutureKernel κ update hu N T (FinitePath.advance update m s p)) :=
    (hf.stronglyMeasurable.integral_kernel.measurable).comp
      ((FinitePath.measurable_advance hu m).comp (measurable_const.prodMk measurable_id))
  have hF01 (s : S) (p : FinitePath A m) :
      0 ≤ (∫ q, f q ∂finiteFutureKernel κ update hu N T (FinitePath.advance update m s p)) ∧
        (∫ q, f q ∂finiteFutureKernel κ update hu N T (FinitePath.advance update m s p)) ≤ 1 :=
    integral_test_mem_Icc _ hf hf01
  exact abs_integral_sub_integral_le_of_cross
    (integrable_of_test _ (hF s) (hF01 s)) (integrable_of_test _ (hF t) (hF01 t))
    (fun p q => hold (FinitePath.advance update m s p) (FinitePath.advance update m t q) f hf hf01)

/-- Iterating `K` refresh blocks gives a bound independent of the target length
whenever the common-prefix continuation bound is uniform in that length. -/
theorem testClose_finiteFutureKernel_blocks (κ : Kernel S A) [IsMarkovKernel κ]
    (update : S × A → S) (hu : Measurable update) (m : ℕ)
    (ρ : Measure (FinitePath A m)) [IsProbabilityMeasure ρ] {a δ : ℝ}
    (ha : 0 ≤ a) (ha1 : a < 1) (hδ : 0 ≤ δ)
    (hminor : ∀ s, ENNReal.ofReal a • ρ ≤ finitePathKernel κ update hu m s)
    (hcommon : ∀ T s t p,
      TestClose (finitePathKernel κ update hu T (FinitePath.advance update m s p))
        (finitePathKernel κ update hu T (FinitePath.advance update m t p)) δ)
    (K T : ℕ) (s t : S) :
    TestClose (finiteFutureKernel κ update hu (K * m) T s)
      (finiteFutureKernel κ update hu (K * m) T t) (δ + (1 - a) ^ K) := by
  induction K generalizing s t with
  | zero =>
      exact (testClose_one _ _).mono (by simp only [pow_zero]; linarith)
  | succ K ih =>
      rw [Nat.succ_mul]
      have hh := testClose_finiteFutureKernel_refresh κ update hu (K * m) m T ρ
        ha ha1 hminor (hcommon (T + K * m)) ih s t
      convert hh using 1
      rw [pow_succ]
      ring

end FuturePaths

end Cascade
end


/- Supporting development: Cascade.Forgetting -/
section
set_option autoImplicit false

/-
# Uniform forgetting on every finite future block

Bounded drift gives a history-independent common law on complete augmented
output blocks.  A successful common block makes the two histories agree on
that whole prefix; the half-likelihood estimate then bounds every finite
continuation.  Subtracting and normalizing the common measure controls the
remaining branch by its previous oscillation.

All initial histories are arbitrary real histories.  No stationary process,
infinite-future measure, or coupling theorem is used here.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology

namespace Cascade

/-- The history-independent refresh output: `J ∼ ν`, `Z ∼ N(0,1/2)`, and
output `(J,J+Z)`.  In particular the drift does not occur in this law. -/
noncomputable def augmentedRefreshLaw (ν : Measure ℝ) : Measure AugmentedStep :=
  (ν.prod (gaussianReal 0 (1 / 2))).map (augmentedStepMap 0)

theorem augmentedRefreshLaw_eq (ν : Measure ℝ) :
    augmentedRefreshLaw ν =
      (ν.prod (gaussianReal 0 (1 / 2))).map (fun p : ℝ × ℝ => (p.1, p.1 + p.2)) := by
  unfold augmentedRefreshLaw
  congr 1
  funext p
  simp only [augmentedStepMap, sub_zero]

instance isProbabilityMeasure_augmentedRefreshLaw (ν : Measure ℝ) [IsProbabilityMeasure ν] :
    IsProbabilityMeasure (augmentedRefreshLaw ν) :=
  Measure.isProbabilityMeasure_map (measurable_augmentedStepMap 0).aemeasurable

/-- Uniform one-step minorization with the latent innovation retained. -/
theorem augmentedStepLaw_minorization (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B b : ℝ} (hB : 0 ≤ B) (hb : |b| ≤ B) :
    ENNReal.ofReal (gaussianMinorizationCoeff B) • augmentedRefreshLaw ν ≤
      augmentedStepLaw ν b := by
  rw [augmentedStepLaw_eq_shifted ν b 0, augmentedRefreshLaw,
    ← Measure.map_smul, ← Measure.prod_smul_right]
  exact Measure.map_mono
    (prod_mono_of_le le_rfl (gaussianReal_minorization hB (by simpa using hb)))
    (measurable_augmentedStepMap 0)

/-- The independent common law on every augmented output of an entire block. -/
noncomputable def augmentedRefreshBlockLaw (ν : Measure ℝ) (n : ℕ) : Measure (AugmentedPath n) :=
  productPathLaw (augmentedRefreshLaw ν) n

instance isProbabilityMeasure_augmentedRefreshBlockLaw (ν : Measure ℝ)
    [IsProbabilityMeasure ν] (n : ℕ) : IsProbabilityMeasure (augmentedRefreshBlockLaw ν n) := by
  unfold augmentedRefreshBlockLaw
  infer_instance

/-- Every augmented path block dominates the same product output law with
weight exactly `q^n`, where `q = gaussianMinorizationCoeff B`. -/
theorem augmentedPathKernel_minorization (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] {B : ℝ} (hB : 0 ≤ B)
    (hbound : ∀ x, |H x| ≤ B) (n : ℕ) (x : Past) :
    ENNReal.ofReal (gaussianMinorizationCoeff B ^ n) • augmentedRefreshBlockLaw ν n ≤
      augmentedPathKernel H hH ν n x := by
  rw [ENNReal.ofReal_pow (gaussianMinorizationCoeff_pos B).le]
  exact finitePathKernel_minorization (causalStepKernel H hH ν) causalUpdate
    measurable_causalUpdate (augmentedRefreshLaw ν)
    (ENNReal.ofReal (gaussianMinorizationCoeff B))
    (fun y => by
      rw [causalStepKernel_apply]
      exact augmentedStepLaw_minorization ν hB (hbound y)) n x

/-- Subtraction of the full common block law, before normalization. -/
noncomputable def augmentedBlockResidual (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) (B : ℝ) (m : ℕ) (x : Past) : Measure (AugmentedPath m) :=
  refreshResidual (augmentedPathKernel H hH ν m x) (augmentedRefreshBlockLaw ν m)
    (gaussianMinorizationCoeff B ^ m)

/-- The corresponding probability residual for a positive refresh block length. -/
noncomputable def normalizedAugmentedBlockResidual (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) (B : ℝ) (m : ℕ) (x : Past) : Measure (AugmentedPath m) :=
  normalizedRefreshResidual (augmentedPathKernel H hH ν m x) (augmentedRefreshBlockLaw ν m)
    (gaussianMinorizationCoeff B ^ m)

theorem augmentedBlockResidual_univ (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] {B : ℝ} (hB : 0 ≤ B)
    (hbound : ∀ x, |H x| ≤ B) (m : ℕ) (x : Past) :
    augmentedBlockResidual H hH ν B m x Set.univ =
      ENNReal.ofReal (1 - gaussianMinorizationCoeff B ^ m) :=
  refreshResidual_univ (pow_pos (gaussianMinorizationCoeff_pos B) m).le
    (augmentedPathKernel_minorization H hH ν hB hbound m x)

theorem isProbabilityMeasure_normalizedAugmentedBlockResidual
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B) {m : ℕ} (hm : 0 < m) (x : Past) :
    IsProbabilityMeasure (normalizedAugmentedBlockResidual H hH ν B m x) :=
  isProbabilityMeasure_normalizedRefreshResidual
    (pow_pos (gaussianMinorizationCoeff_pos B) m).le
    (pow_lt_one₀ (gaussianMinorizationCoeff_pos B).le (gaussianMinorizationCoeff_lt_one B)
      (Nat.ne_of_gt hm))
    (augmentedPathKernel_minorization H hH ν hB hbound m x)


/-- The residual family is measurable in the arbitrary initial history. -/
@[fun_prop] theorem measurable_augmentedBlockResidual
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B) (m : ℕ) :
    Measurable (augmentedBlockResidual H hH ν B m) :=
  measurable_refreshResidual (augmentedPathKernel H hH ν m).measurable
    (augmentedRefreshBlockLaw ν m) (gaussianMinorizationCoeff B ^ m)
    (augmentedPathKernel_minorization H hH ν hB hbound m)

/-- The normalized residual family is measurable in the initial history too. -/
@[fun_prop] theorem measurable_normalizedAugmentedBlockResidual
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B) (m : ℕ) :
    Measurable (normalizedAugmentedBlockResidual H hH ν B m) :=
  measurable_normalizedRefreshResidual (augmentedPathKernel H hH ν m).measurable
    (augmentedRefreshBlockLaw ν m) (gaussianMinorizationCoeff B ^ m)
    (augmentedPathKernel_minorization H hH ν hB hbound m)

/-- Scaling the probability residual restores exactly the subtracted block measure. -/
theorem smul_normalizedAugmentedBlockResidual
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) (B : ℝ)
    {m : ℕ} (hm : 0 < m) (x : Past) :
    ENNReal.ofReal (1 - gaussianMinorizationCoeff B ^ m) •
        normalizedAugmentedBlockResidual H hH ν B m x = augmentedBlockResidual H hH ν B m x :=
  smul_normalizedRefreshResidual _ _
    (pow_lt_one₀ (gaussianMinorizationCoeff_pos B).le (gaussianMinorizationCoeff_lt_one B)
      (Nat.ne_of_gt hm))

/-- Exact common/residual decomposition with the weights used in the recursion. -/
theorem augmentedPathKernel_eq_refresh_add_residual
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B) {m : ℕ} (hm : 0 < m) (x : Past) :
    augmentedPathKernel H hH ν m x =
      ENNReal.ofReal (gaussianMinorizationCoeff B ^ m) • augmentedRefreshBlockLaw ν m +
        ENNReal.ofReal (1 - gaussianMinorizationCoeff B ^ m) •
          normalizedAugmentedBlockResidual H hH ν B m x :=
  eq_common_add_normalizedRefreshResidual
    (pow_lt_one₀ (gaussianMinorizationCoeff_pos B).le (gaussianMinorizationCoeff_lt_one B)
      (Nat.ne_of_gt hm))
    (augmentedPathKernel_minorization H hH ν hB hbound m x)

/- ## Suffix laws and agreement bounds -/

/-- Drop the first `N` chronological coordinates of a finite function.  The
remaining coordinate `i` is the old coordinate `N+i` (written `i+N` in `Fin`). -/
def dropFirst {A : Type} (N T : ℕ) (p : Fin (T + N) → A) : Fin T → A :=
  fun i => p (i.addNat N)

/-- Explicit indexing: the new coordinate `i` is the old coordinate `N+i`. -/
theorem dropFirst_apply {A : Type} (N T : ℕ) (p : Fin (T + N) → A) (i : Fin T) :
    dropFirst N T p i = p ⟨N + (i : ℕ), by omega⟩ := by
  apply congrArg p
  exact Fin.ext (Nat.add_comm _ _)

@[fun_prop] theorem measurable_dropFirst {A : Type} [MeasurableSpace A] (N T : ℕ) :
    Measurable (dropFirst (A := A) N T) :=
  measurable_pi_lambda _ fun i => measurable_pi_apply (i.addNat N)

/-- Observation commutes with removal of an initial chronological block. -/
theorem observedPath_suffix (N T : ℕ) (p : AugmentedPath (T + N)) :
    observedPath T (FinitePath.suffix N T p) = dropFirst N T (observedPath (T + N) p) := by
  funext i
  exact congrArg Prod.snd (FinitePath.toFn_suffix N T p i)

/-- The full augmented law on `T` future outputs, after `N` unobserved steps. -/
noncomputable def augmentedFutureKernel (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) (N T : ℕ) : Kernel Past (AugmentedPath T) :=
  finiteFutureKernel (causalStepKernel H hH ν) causalUpdate measurable_causalUpdate N T

instance isMarkovKernel_augmentedFutureKernel (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (N T : ℕ) :
    IsMarkovKernel (augmentedFutureKernel H hH ν N T) := by
  unfold augmentedFutureKernel
  infer_instance

/-- The suffix marginal of the public observed path law. -/
noncomputable def pathSuffixLaw (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) (N T : ℕ) (x : Past) : Measure (Fin T → ℝ) :=
  (pathLaw H hH ν (T + N) x).map (dropFirst N T)

instance isProbabilityMeasure_pathSuffixLaw (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (N T : ℕ) (x : Past) :
    IsProbabilityMeasure (pathSuffixLaw H hH ν N T x) :=
  Measure.isProbabilityMeasure_map (measurable_dropFirst N T).aemeasurable

/-- The observed suffix law is exactly the observation of the augmented future
kernel, not a newly constructed or conditionally specified law. -/
theorem pathSuffixLaw_eq_map (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (N T : ℕ) (x : Past) :
    pathSuffixLaw H hH ν N T x =
      (augmentedFutureKernel H hH ν N T x).map (observedPath T) := by
  rw [pathSuffixLaw, pathLaw_eq_map,
    Measure.map_map (measurable_dropFirst N T) (measurable_observedPath (T + N)),
    augmentedFutureKernel, finiteFutureKernel_eq_map_suffix,
    Measure.map_map (measurable_observedPath T) (FinitePath.measurable_suffix N T)]
  congr 1
  funext p
  exact (observedPath_suffix N T p).symm

/-- Agreement can be shortened. -/
theorem AgreeFirst.mono {m n : ℕ} {x y : Past} (h : AgreeFirst n x y) (hmn : m ≤ n) :
    AgreeFirst m x y := fun i hi => h i (lt_of_lt_of_le hi hmn)

/-- A variation majorant is automatically nonnegative, by comparison of any
history with itself. -/
theorem HasVariationMajorant.nonneg {H : Past → ℝ} {d : ℕ → ℝ}
    (hvar : HasVariationMajorant H d) (k : ℕ) : 0 ≤ d k := by
  simpa only [sub_self, abs_zero] using
    hvar k (fun _ => 0) (fun _ => 0) (fun _ _ => rfl)

/-- Square-sum variation left after a common prefix of length `m`. -/
noncomputable def variationTailBound (d : ℕ → ℝ) (m : ℕ) : ℝ :=
  Real.sqrt (∑' j : ℕ, d (m + j) ^ 2)

theorem variationTailBound_nonneg (d : ℕ → ℝ) (m : ℕ) : 0 ≤ variationTailBound d m :=
  Real.sqrt_nonneg _

theorem summable_variation_tail {d : ℕ → ℝ} (hsum : Summable (fun j => d j ^ 2)) (m : ℕ) :
    Summable (fun j => d (m + j) ^ 2) := by
  simpa only [Nat.add_comm] using (summable_nat_add_iff m).mpr hsum

/-- Every finite continuation energy is bounded by the same infinite square tail. -/
theorem variationEnergy_le_tail {d : ℕ → ℝ} (hsum : Summable (fun j => d j ^ 2)) (m n : ℕ) :
    variationEnergy d m n ≤ ∑' j : ℕ, d (m + j) ^ 2 :=
  Summable.sum_le_tsum (Finset.range n) (fun j _ => sq_nonneg (d (m + j)))
    (summable_variation_tail hsum m)

/-- Affinity bounds ALL finite continuation lengths by the square tail at the
agreement length.  There is no supremum over target lengths in the hypotheses. -/
theorem testClose_augmentedPathKernel_of_agree_tail
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {d : ℕ → ℝ} (hvar : HasVariationMajorant H d) (hsum : Summable (fun j => d j ^ 2))
    (n m : ℕ) {x y : Past} (hxy : AgreeFirst m x y) :
    TestClose (augmentedPathKernel H hH ν n x) (augmentedPathKernel H hH ν n y)
      (variationTailBound d m) :=
  (testClose_augmentedPathKernel_of_agree H hH ν hvar.nonneg hvar n m hxy).mono
    (Real.sqrt_le_sqrt (variationEnergy_le_tail hsum m n))

/-- Agreement with a finite-memory drift gives equality of complete augmented
continuation laws, not merely a zero upper bound on observed tests. -/
theorem augmentedPathKernel_eq_of_hasMemory_agree
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {M : ℕ} (hmem : HasMemory H M) (n : ℕ) {x y : Past} (hxy : AgreeFirst M x y) :
    augmentedPathKernel H hH ν n x = augmentedPathKernel H hH ν n y := by
  induction n generalizing x y with
  | zero => rfl
  | succ n ih =>
      rw [augmentedPathKernel_succ, augmentedPathKernel_succ, hmem x y hxy]
      congr 1
      apply Kernel.ext
      intro a
      exact ih ((hxy.prepend a.2).mono (Nat.le_succ M))

/-- Observed finite continuation laws are also exactly equal after agreement
on the whole memory of the drift. -/
theorem pathLaw_eq_of_hasMemory_agree
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {M : ℕ} (hmem : HasMemory H M) (n : ℕ) {x y : Past} (hxy : AgreeFirst M x y) :
    pathLaw H hH ν n x = pathLaw H hH ν n y := by
  rw [pathLaw_eq_map, pathLaw_eq_map, augmentedPathKernel_eq_of_hasMemory_agree H hH ν hmem n hxy]

/- ## Iterated refresh and finite-future forgetting -/

/-- A uniform continuation estimate after agreement of `m` past entries gives
uniform finite-future forgetting after `K*m` burn-in steps. -/
theorem testClose_augmentedFutureKernel_of_agreement
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B) {m : ℕ} (hm : 0 < m)
    {δ : ℝ} (hδ : 0 ≤ δ)
    (hcont : ∀ n x y, AgreeFirst m x y →
      TestClose (augmentedPathKernel H hH ν n x) (augmentedPathKernel H hH ν n y) δ)
    (K T : ℕ) (x y : Past) :
    TestClose (augmentedFutureKernel H hH ν (K * m) T x)
      (augmentedFutureKernel H hH ν (K * m) T y)
      (δ + (1 - gaussianMinorizationCoeff B ^ m) ^ K) := by
  apply testClose_finiteFutureKernel_blocks (causalStepKernel H hH ν) causalUpdate
    measurable_causalUpdate m (augmentedRefreshBlockLaw ν m)
    (pow_pos (gaussianMinorizationCoeff_pos B) m).le
    (pow_lt_one₀ (gaussianMinorizationCoeff_pos B).le (gaussianMinorizationCoeff_lt_one B)
      (Nat.ne_of_gt hm)) hδ
    (augmentedPathKernel_minorization H hH ν hB hbound m)
  intro n s t p
  exact hcont n _ _ (by simpa only [Nat.zero_add] using (AgreeFirst.zero s t).continuePast m p)

/-- The same abstract agreement-to-forgetting implication, on the public
observed suffix law. -/
theorem testClose_pathLaw_suffix_of_agreement
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B) {m : ℕ} (hm : 0 < m)
    {δ : ℝ} (hδ : 0 ≤ δ)
    (hcont : ∀ n x y, AgreeFirst m x y →
      TestClose (augmentedPathKernel H hH ν n x) (augmentedPathKernel H hH ν n y) δ)
    (K T : ℕ) (x y : Past) :
    TestClose (pathSuffixLaw H hH ν (K * m) T x) (pathSuffixLaw H hH ν (K * m) T y)
      (δ + (1 - gaussianMinorizationCoeff B ^ m) ^ K) := by
  rw [pathSuffixLaw_eq_map, pathSuffixLaw_eq_map]
  exact (testClose_augmentedFutureKernel_of_agreement H hH ν hB hbound hm hδ hcont K T x y).map
    (measurable_observedPath T)

/-- Square-summable variations give the augmented finite-future bound,
uniformly over the length of the future block and all initial histories. -/
theorem testClose_augmentedFutureKernel
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B)
    {d : ℕ → ℝ} (hvar : HasVariationMajorant H d) (hsum : Summable (fun j => d j ^ 2))
    {m : ℕ} (hm : 0 < m) (K T : ℕ) (x y : Past) :
    TestClose (augmentedFutureKernel H hH ν (K * m) T x)
      (augmentedFutureKernel H hH ν (K * m) T y)
      (variationTailBound d m + (1 - gaussianMinorizationCoeff B ^ m) ^ K) :=
  testClose_augmentedFutureKernel_of_agreement H hH ν hB hbound hm
    (variationTailBound_nonneg d m)
    (fun n _ _ hxy => testClose_augmentedPathKernel_of_agree_tail H hH ν hvar hsum n m hxy)
    K T x y

/-- **Uniform finite-future forgetting.** Drop `K*m` burn-in outputs from the
public path law and retain the next `T` outputs.  For every pair of arbitrary
initial histories the error is at most `sqrt (∑ j≥m, d j²) + (1-q^m)^K`.
Neither term depends on `T`. -/
theorem testClose_pathLaw_suffix
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B)
    {d : ℕ → ℝ} (hvar : HasVariationMajorant H d) (hsum : Summable (fun j => d j ^ 2))
    {m : ℕ} (hm : 0 < m) (K T : ℕ) (x y : Past) :
    TestClose ((pathLaw H hH ν (T + K * m) x).map (dropFirst (K * m) T))
      ((pathLaw H hH ν (T + K * m) y).map (dropFirst (K * m) T))
      (variationTailBound d m + (1 - gaussianMinorizationCoeff B ^ m) ^ K) :=
  testClose_pathLaw_suffix_of_agreement H hH ν hB hbound hm
    (variationTailBound_nonneg d m)
    (fun n _ _ hxy => testClose_augmentedPathKernel_of_agree_tail H hH ν hvar hsum n m hxy)
    K T x y

/-- The finite-memory geometric bound also holds with all latent innovations
retained in the future block.  Zero memory is allowed. -/
theorem testClose_augmentedFutureKernel_of_hasMemory
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B)
    {M : ℕ} (hmem : HasMemory H M) (K T : ℕ) (x y : Past) :
    TestClose (augmentedFutureKernel H hH ν (K * M) T x)
      (augmentedFutureKernel H hH ν (K * M) T y)
      ((1 - gaussianMinorizationCoeff B ^ M) ^ K) := by
  by_cases hM : M = 0
  · subst M
    simp only [augmentedFutureKernel, finiteFutureKernel_eq_map_suffix]
    change TestClose
      ((augmentedPathKernel H hH ν (T + K * 0) x).map (FinitePath.suffix (K * 0) T))
      ((augmentedPathKernel H hH ν (T + K * 0) y).map (FinitePath.suffix (K * 0) T)) _
    rw [augmentedPathKernel_eq_of_hasMemory_agree H hH ν hmem (T + K * 0) (AgreeFirst.zero x y)]
    exact (TestClose.refl _).mono (by simp)
  · have hh := testClose_augmentedFutureKernel_of_agreement H hH ν hB hbound (Nat.pos_of_ne_zero hM)
      (δ := 0) le_rfl
      (fun n x y hxy => by
        rw [augmentedPathKernel_eq_of_hasMemory_agree H hH ν hmem n hxy]
        exact TestClose.refl _) K T x y
    simpa only [zero_add] using hh

/-- **Finite-memory forgetting.** Agreement on the whole memory makes the
common branch exact, so only the geometric residual weight remains.
The memory-zero case is included and handled by exact equality. -/
theorem testClose_pathLaw_suffix_of_hasMemory
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B)
    {M : ℕ} (hmem : HasMemory H M) (K T : ℕ) (x y : Past) :
    TestClose ((pathLaw H hH ν (T + K * M) x).map (dropFirst (K * M) T))
      ((pathLaw H hH ν (T + K * M) y).map (dropFirst (K * M) T))
      ((1 - gaussianMinorizationCoeff B ^ M) ^ K) := by
  change TestClose (pathSuffixLaw H hH ν (K * M) T x) (pathSuffixLaw H hH ν (K * M) T y) _
  rw [pathSuffixLaw_eq_map, pathSuffixLaw_eq_map]
  exact (testClose_augmentedFutureKernel_of_hasMemory H hH ν hB hbound hmem K T x y).map
    (measurable_observedPath T)

/- ## Burn-in chosen independently of the observed future length -/

/-- The square-tail error tends to zero under square summability. -/
theorem tendsto_variationTailBound_zero {d : ℕ → ℝ} (hsum : Summable (fun j => d j ^ 2)) :
    Tendsto (variationTailBound d) atTop (𝓝 0) := by
  have heq (m : ℕ) : (∑' j : ℕ, d (m + j) ^ 2) =
      (∑' j : ℕ, d j ^ 2) - ∑ j ∈ Finset.range m, d j ^ 2 := by
    have h := Summable.sum_add_tsum_nat_add m hsum
    simp only [Nat.add_comm] at h
    linarith
  have ht : Tendsto (fun m => ∑' j : ℕ, d (m + j) ^ 2) atTop (𝓝 0) := by
    simp_rw [heq]
    have hc : Tendsto (fun _ : ℕ => ∑' j : ℕ, d j ^ 2) atTop (𝓝 (∑' j : ℕ, d j ^ 2)) :=
      tendsto_const_nhds
    simpa only [sub_self] using hc.sub hsum.hasSum.tendsto_sum_nat
  simpa only [variationTailBound, Real.sqrt_zero] using ht.sqrt

/-- First choose a positive refresh length to make the affinity tail small,
then a number of blocks to make the residual weight small.  Neither choice
mentions a target future length or an initial history. -/
theorem exists_refresh_blocks {d : ℕ → ℝ} (hsum : Summable (fun j => d j ^ 2))
    (B : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∃ m : ℕ, 0 < m ∧ ∃ K : ℕ,
      variationTailBound d m + (1 - gaussianMinorizationCoeff B ^ m) ^ K < ε := by
  have htail := (tendsto_variationTailBound_zero hsum).eventually_lt_const (half_pos hε)
  obtain ⟨m, hmδ, hm⟩ := (htail.and (eventually_gt_atTop 0)).exists
  have ha : 0 < gaussianMinorizationCoeff B ^ m := pow_pos (gaussianMinorizationCoeff_pos B) m
  have ha1 : gaussianMinorizationCoeff B ^ m < 1 :=
    pow_lt_one₀ (gaussianMinorizationCoeff_pos B).le (gaussianMinorizationCoeff_lt_one B)
      (Nat.ne_of_gt hm)
  have hp := tendsto_pow_atTop_nhds_zero_of_lt_one (sub_nonneg.mpr ha1.le)
    (show 1 - gaussianMinorizationCoeff B ^ m < 1 by linarith)
  obtain ⟨K, hK⟩ := (hp.eventually_lt_const (half_pos hε)).exists
  exact ⟨m, hm, K, by linarith⟩

/-- Uniform augmented finite-future forgetting with an arbitrarily prescribed
error.  The same burn-in threshold works for EVERY later burn-in time, EVERY
finite target length, and EVERY pair of initial histories. -/
theorem exists_burnin_testClose_augmentedFutureKernel
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B)
    {d : ℕ → ℝ} (hvar : HasVariationMajorant H d) (hsum : Summable (fun j => d j ^ 2))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ N : ℕ, ∀ n ≥ N, ∀ T : ℕ, ∀ x y : Past,
      TestClose (augmentedFutureKernel H hH ν n T x) (augmentedFutureKernel H hH ν n T y) ε := by
  obtain ⟨m, hm, K, hK⟩ := exists_refresh_blocks hsum B hε
  refine ⟨K * m, fun n hn T x y => ?_⟩
  have hh := testClose_finiteFutureKernel_add_of_uniform (causalStepKernel H hH ν) causalUpdate
    measurable_causalUpdate (K * m) (n - K * m) T
    (fun s t => testClose_augmentedFutureKernel H hH ν hB hbound hvar hsum hm K T s t) x y
  change TestClose (augmentedFutureKernel H hH ν (K * m + (n - K * m)) T x)
    (augmentedFutureKernel H hH ν (K * m + (n - K * m)) T y) _ at hh
  rw [show K * m + (n - K * m) = n by omega] at hh
  exact hh.mono hK.le

/-- **Uniform ε-burn-in for public finite suffix laws.** The threshold is
chosen BEFORE the target length and the two initial histories.  This
quantifier order permits subsequent diagonal arguments without a hidden
dependence of the burn-in on the length of the observed future. -/
theorem exists_burnin_testClose_pathLaw_suffix
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B)
    {d : ℕ → ℝ} (hvar : HasVariationMajorant H d) (hsum : Summable (fun j => d j ^ 2))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ N : ℕ, ∀ n ≥ N, ∀ T : ℕ, ∀ x y : Past,
      TestClose ((pathLaw H hH ν (T + n) x).map (dropFirst n T))
        ((pathLaw H hH ν (T + n) y).map (dropFirst n T)) ε := by
  obtain ⟨N, hN⟩ := exists_burnin_testClose_augmentedFutureKernel H hH ν hB hbound hvar hsum hε
  refine ⟨N, fun n hn T x y => ?_⟩
  change TestClose (pathSuffixLaw H hH ν n T x) (pathSuffixLaw H hH ν n T y) ε
  rw [pathSuffixLaw_eq_map, pathSuffixLaw_eq_map]
  exact (hN n hn T x y).map (measurable_observedPath T)

/-- Uniform ε-burn-in for a finite-memory drift, including zero memory.
No variation majorant or summability hypothesis is needed. -/
theorem exists_burnin_testClose_pathLaw_suffix_of_hasMemory
    (H : Past → ℝ) (hH : Measurable H) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H x| ≤ B)
    {M : ℕ} (hmem : HasMemory H M) {ε : ℝ} (hε : 0 < ε) :
    ∃ N : ℕ, ∀ n ≥ N, ∀ T : ℕ, ∀ x y : Past,
      TestClose ((pathLaw H hH ν (T + n) x).map (dropFirst n T))
        ((pathLaw H hH ν (T + n) y).map (dropFirst n T)) ε := by
  have ha : 0 < gaussianMinorizationCoeff B ^ M := pow_pos (gaussianMinorizationCoeff_pos B) M
  have ha1 : gaussianMinorizationCoeff B ^ M ≤ 1 :=
    pow_le_one₀ (gaussianMinorizationCoeff_pos B).le (gaussianMinorizationCoeff_lt_one B).le
  have hp := tendsto_pow_atTop_nhds_zero_of_lt_one (sub_nonneg.mpr ha1)
    (show 1 - gaussianMinorizationCoeff B ^ M < 1 by linarith)
  obtain ⟨K, hK⟩ := (hp.eventually_lt_const hε).exists
  refine ⟨K * M, fun n hn T x y => ?_⟩
  have hh := testClose_finiteFutureKernel_add_of_uniform (causalStepKernel H hH ν) causalUpdate
    measurable_causalUpdate (K * M) (n - K * M) T
    (fun s t => testClose_augmentedFutureKernel_of_hasMemory H hH ν hB hbound hmem K T s t) x y
  change TestClose (augmentedFutureKernel H hH ν (K * M + (n - K * M)) T x)
    (augmentedFutureKernel H hH ν (K * M + (n - K * M)) T y) _ at hh
  rw [show K * M + (n - K * M) = n by omega] at hh
  change TestClose (pathSuffixLaw H hH ν n T x) (pathSuffixLaw H hH ν n T y) ε
  rw [pathSuffixLaw_eq_map, pathSuffixLaw_eq_map]
  exact (hh.mono hK.le).map (measurable_observedPath T)

end Cascade
end


/- Supporting development: Cascade.VariationCost -/
section
set_option autoImplicit false

/-
# Square variation of finite cascades and their limits

The layer amplitudes bound the *increments* of the inverse kernel, including
changes of older controller terms.  Doubling the cumulative memory gives a
uniform diagonal-cost bound for the square of the sum of all active layers.
The proof below retains the cross terms through a first-moment energy invariant.
-/

open Filter Topology
open scoped BoundedContinuousFunction

namespace Cascade.InverseCascade

open Controller (Params)

section Bookkeeping

@[simp] theorem amplitude_nil : amplitude [] = 0 := by simp [amplitude]
@[simp] theorem cost_nil : cost [] = 0 := by simp [cost]
@[simp] theorem profile_nil (m : ℕ) : profile [] m = 0 := by simp [profile]

/-- Old layer amplitudes are unchanged by appending controllers. -/
theorem layerAmplitude_append (cs ds : List Params) (i : Fin cs.length) :
    layerAmplitude (cs ++ ds) (i.castLE (by simp)) = layerAmplitude cs i := by
  simp only [layerAmplitude, List.get_eq_getElem, Fin.val_castLE]
  rw [List.take_append_of_le_length i.isLt.le, List.getElem_append_left i.isLt]

/-- Old layer memories are unchanged by appending controllers. -/
theorem layerMemory_append (cs ds : List Params) (i : Fin cs.length) :
    layerMemory (cs ++ ds) (i.castLE (by simp)) = layerMemory cs i := by
  simp only [layerMemory, Fin.val_castLE]
  rw [List.take_append_of_le_length i.isLt]

theorem layerMemory_eq (cs : List Params) (i : Fin cs.length) :
    layerMemory cs i = memory (cs.take i.val) + (cs.get i).N := by
  simp only [layerMemory, List.take_succ_eq_append_getElem i.isLt,
    memory_append_singleton, List.get_eq_getElem]

@[simp] theorem amplitude_append_singleton (cs : List Params) (c : Params) :
    amplitude (cs ++ [c]) = amplitude cs + gainProduct cs * c.budget := by
  unfold amplitude
  have hl : (cs ++ [c]).length = cs.length + 1 := by simp
  rw [← Equiv.sum_comp (finCongr hl.symm) (layerAmplitude (cs ++ [c])),
    Fin.sum_univ_castSucc]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    simp only [layerAmplitude, List.get_eq_getElem, Fin.val_castSucc, Fin.val_cast,
      finCongr_apply]
    rw [List.take_append_of_le_length i.isLt.le, List.getElem_append_left i.isLt]
  · simp [layerAmplitude, List.get_eq_getElem, List.getElem_append_right]

@[simp] theorem cost_append_singleton (cs : List Params) (c : Params) :
    cost (cs ++ [c]) = cost cs + ((memory cs + c.N : ℕ) : ℝ) *
      (gainProduct cs * c.budget) ^ 2 := by
  unfold cost
  have hl : (cs ++ [c]).length = cs.length + 1 := by simp
  rw [← Equiv.sum_comp (finCongr hl.symm)
    (fun i ↦ (layerMemory (cs ++ [c]) i : ℝ) * layerAmplitude (cs ++ [c]) i ^ 2),
    Fin.sum_univ_castSucc]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    simp only [layerMemory, layerAmplitude, List.get_eq_getElem, Fin.val_castSucc,
      Fin.val_cast, finCongr_apply]
    rw [List.take_append_of_le_length i.isLt.le,
      List.take_append_of_le_length i.isLt, List.getElem_append_left i.isLt]
  · have ht : cs.take (cs.length + 1) = cs := List.take_of_length_le (by omega)
    simp [layerMemory, layerAmplitude, List.get_eq_getElem, List.take_append,
      List.getElem_append_right, ht, memory]

@[simp] theorem profile_append_singleton (cs : List Params) (c : Params) (m : ℕ) :
    profile (cs ++ [c]) m = profile cs m +
      if m < memory cs + c.N then 2 * (gainProduct cs * c.budget) else 0 := by
  unfold profile
  have hl : (cs ++ [c]).length = cs.length + 1 := by simp
  rw [← Equiv.sum_comp (finCongr hl.symm)
    (fun i ↦ if m < layerMemory (cs ++ [c]) i then layerAmplitude (cs ++ [c]) i else 0),
    Fin.sum_univ_castSucc, mul_add]
  congr 1
  · congr 1
    apply Finset.sum_congr rfl
    intro i _
    simp only [layerMemory, layerAmplitude, List.get_eq_getElem, Fin.val_castSucc,
      Fin.val_cast, finCongr_apply]
    rw [List.take_append_of_le_length i.isLt.le,
      List.take_append_of_le_length i.isLt, List.getElem_append_left i.isLt]
  · have ht : cs.take (cs.length + 1) = cs := List.take_of_length_le (by omega)
    simp only [layerMemory, layerAmplitude, finCongr_apply, Fin.val_cast, Fin.val_last]
    simp [List.get_eq_getElem, List.take_append, List.getElem_append_right, ht,
      memory, mul_ite]

/-- A batch's amplitudes acquire exactly the gain product of the old prefix. -/
theorem amplitude_append (cs ds : List Params) :
    amplitude (cs ++ ds) = amplitude cs + gainProduct cs * amplitude ds := by
  induction ds using List.reverseRecOn with
  | nil => simp
  | append_singleton ds c ih =>
    rw [← List.append_assoc, amplitude_append_singleton, amplitude_append_singleton,
      gainProduct_append, ih]
    ring

theorem layerAmplitude_nonneg (cs : List Params) (i : Fin cs.length) :
    0 ≤ layerAmplitude cs i :=
  mul_nonneg (gainProduct_nonneg _) (cs.get i).budget_nonneg

theorem amplitude_nonneg (cs : List Params) : 0 ≤ amplitude cs :=
  Finset.sum_nonneg fun i _ ↦ layerAmplitude_nonneg cs i

theorem cost_nonneg (cs : List Params) : 0 ≤ cost cs :=
  Finset.sum_nonneg fun _ _ ↦ mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _)

theorem profile_nonneg (cs : List Params) (m : ℕ) : 0 ≤ profile cs m := by
  apply mul_nonneg (by norm_num)
  exact Finset.sum_nonneg fun i _ ↦ by split_ifs <;> simp [layerAmplitude_nonneg]

theorem profile_le_two_amplitude (cs : List Params) (m : ℕ) :
    profile cs m ≤ 2 * amplitude cs := by
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  exact Finset.sum_le_sum fun i _ ↦ by split_ifs <;> simp [layerAmplitude_nonneg]

theorem amplitude_le_amplitude_append (cs ds : List Params) :
    amplitude cs ≤ amplitude (cs ++ ds) := by
  rw [amplitude_append]
  exact le_add_of_nonneg_right (mul_nonneg (gainProduct_nonneg cs) (amplitude_nonneg ds))

theorem cost_le_cost_append (cs ds : List Params) : cost cs ≤ cost (cs ++ ds) := by
  induction ds using List.reverseRecOn with
  | nil => simp
  | append_singleton ds c ih =>
    rw [← List.append_assoc, cost_append_singleton]
    exact ih.trans (le_add_of_nonneg_right (mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _)))

theorem memory_take_le (cs : List Params) (n : ℕ) : memory (cs.take n) ≤ memory cs := by
  have h := memory_append (cs.take n) (cs.drop n)
  rw [List.take_append_drop] at h
  omega

theorem layerMemory_le (cs : List Params) (i : Fin cs.length) :
    layerMemory cs i ≤ memory cs := memory_take_le cs _

theorem profile_eq_zero_of_memory_le (cs : List Params) {m : ℕ}
    (hm : memory cs ≤ m) : profile cs m = 0 := by
  unfold profile
  have hi (i : Fin cs.length) : ¬m < layerMemory cs i := by
    have := layerMemory_le cs i
    omega
  simp only [if_neg (hi _), Finset.sum_const_zero, mul_zero]

@[simp] theorem doublingMemory_nil : DoublingMemory [] := by
  intro i
  exact Fin.elim0 i

theorem DoublingMemory.of_append {cs ds : List Params} (h : DoublingMemory (cs ++ ds)) :
    DoublingMemory cs := by
  intro i
  have hh := h (i.castLE (by simp))
  simpa only [Fin.val_castLE, List.take_append_of_le_length i.isLt.le,
    List.get_eq_getElem, List.getElem_append_left i.isLt] using hh

theorem DoublingMemory.append_singleton {cs : List Params} (hc : DoublingMemory cs)
    (c : Params) (hN : memory cs ≤ c.N) : DoublingMemory (cs ++ [c]) := by
  intro i
  by_cases hi : i.val < cs.length
  · have hh := hc ⟨i.val, hi⟩
    simpa only [List.take_append_of_le_length hi.le, List.get_eq_getElem,
      List.getElem_append_left hi] using hh
  · have heq : i.val = cs.length := by
      have := i.isLt
      simp only [List.length_append, List.length_singleton] at this
      omega
    simpa [heq, List.get_eq_getElem, List.take_append, List.getElem_append_right] using hN

theorem doublingMemory_append_singleton_iff (cs : List Params) (c : Params) :
    DoublingMemory (cs ++ [c]) ↔ DoublingMemory cs ∧ memory cs ≤ c.N := by
  refine ⟨fun h ↦ ⟨h.of_append, ?_⟩, fun h ↦ h.1.append_singleton c h.2⟩
  have hh := h ⟨cs.length, by simp⟩
  simpa [List.get_eq_getElem, List.take_append, List.getElem_append_right] using hh

theorem DoublingMemory.take {cs : List Params} (h : DoublingMemory cs) (n : ℕ) :
    DoublingMemory (cs.take n) := by
  have hh : DoublingMemory (cs.take n ++ cs.drop n) := by simpa using h
  exact hh.of_append

theorem DoublingMemory.of_isPrefix {cs ds : List Params}
    (h : DoublingMemory ds) (hp : cs <+: ds) : DoublingMemory cs := by
  obtain ⟨es, rfl⟩ := hp
  exact h.of_append

/-- Profiles increase when a new finite batch is appended. -/
theorem profile_le_profile_append (cs ds : List Params) (m : ℕ) :
    profile cs m ≤ profile (cs ++ ds) m := by
  induction ds using List.reverseRecOn with
  | nil => simp
  | append_singleton ds c ih =>
    rw [← List.append_assoc, profile_append_singleton]
    refine ih.trans (le_add_of_nonneg_right ?_)
    split_ifs
    · exact mul_nonneg (by norm_num) (mul_nonneg (gainProduct_nonneg _) c.budget_nonneg)
    · rfl

theorem profile_mono_of_isPrefix {cs ds : List Params} (hp : cs <+: ds) (m : ℕ) :
    profile cs m ≤ profile ds m := by
  obtain ⟨es, rfl⟩ := hp
  exact profile_le_profile_append cs es m

theorem totalBudget_le_amplitude (cs : List Params) : totalBudget cs ≤ amplitude cs := by
  induction cs using List.reverseRecOn with
  | nil => simp
  | append_singleton cs c ih =>
    rw [totalBudget_append_singleton, amplitude_append_singleton]
    exact add_le_add ih (le_mul_of_one_le_left c.budget_nonneg (one_le_gainProduct cs))

theorem inverseKernel_norm_le_amplitude (cs : List Params) :
    ‖inverseKernel cs‖ ≤ amplitude cs :=
  (inverseKernel_norm_le cs).trans (totalBudget_le_amplitude cs)

theorem forward_zero_norm_le_amplitude (cs : List Params) :
    ‖forward cs 0‖ ≤ amplitude cs := by
  simpa using (norm_forward_le cs 0).trans (by simpa using totalBudget_le_amplitude cs)

/-- Inverse kernels of two prefixes differ by at most the new amplitude. -/
theorem inverseKernel_append_norm_sub_le_amplitude (cs ds : List Params) :
    ‖inverseKernel (cs ++ ds) - inverseKernel cs‖ ≤
      amplitude (cs ++ ds) - amplitude cs := by
  rw [amplitude_append, add_sub_cancel_left]
  exact (inverseKernel_append_norm_sub_le cs ds).trans
    (mul_le_mul_of_nonneg_left (totalBudget_le_amplitude ds) (gainProduct_nonneg cs))

/-- The same amplitude increment controls the forward kernels. -/
theorem forward_append_norm_sub_le_amplitude (cs ds : List Params) (oldK : Correction) :
    ‖forward (cs ++ ds) oldK - forward cs oldK‖ ≤
      amplitude (cs ++ ds) - amplitude cs := by
  rw [forward_append, amplitude_append, add_sub_cancel_left]
  exact (forward_norm_sub_le ds _).trans ((totalBudget_le_amplitude ds).trans
    (le_mul_of_one_le_left (amplitude_nonneg ds) (one_le_gainProduct cs)))

end Bookkeeping

section FiniteVariation

/-- Memory and a sup-norm bound give the elementary step-function majorant. -/
theorem hasVariationMajorant_of_memory_norm (F : Correction) {M : ℕ} {a : ℝ}
    (hM : HasMemory (F : Past → ℝ) M) (ha : ‖F‖ ≤ a) :
    HasVariationMajorant F (fun m ↦ if m < M then 2 * a else 0) := by
  intro m x y hxy
  change |F x - F y| ≤ if m < M then 2 * a else 0
  by_cases hm : m < M
  · rw [if_pos hm]
    calc
      |F x - F y| ≤ |F x| + |F y| := abs_sub _ _
      _ ≤ a + a := add_le_add ((F.norm_coe_le_norm x).trans ha)
        ((F.norm_coe_le_norm y).trans ha)
      _ = 2 * a := by ring
  · rw [if_neg hm, hM x y (fun i hi ↦ hxy i (by omega)), sub_self, abs_zero]

/-- The finite inverse kernel is controlled by the sum of its active increments. -/
theorem inverseKernel_hasVariationMajorant (cs : List Params) :
    HasVariationMajorant (inverseKernel cs) (profile cs) := by
  induction cs using List.reverseRecOn with
  | nil => intro m x y _; simp
  | append_singleton cs c ih =>
    intro m x y hxy
    have hi := hasVariationMajorant_of_memory_norm (increment cs c)
      (increment_hasMemory cs c) (increment_norm_le cs c) m x y hxy
    calc
      |inverseKernel (cs ++ [c]) x - inverseKernel (cs ++ [c]) y| =
          |(inverseKernel cs x - inverseKernel cs y) +
            (increment cs c x - increment cs c y)| := by
        simp only [increment_apply]
        congr 1
        ring
      _ ≤ |inverseKernel cs x - inverseKernel cs y| +
          |increment cs c x - increment cs c y| := abs_add_le _ _
      _ ≤ profile cs m +
          (if m < memory cs + c.N then 2 * (gainProduct cs * c.budget) else 0) :=
        add_le_add (ih m x y hxy) hi
      _ = profile (cs ++ [c]) m := (profile_append_singleton cs c m).symm

/-- Every finite profile has finite support, without a doubling assumption. -/
theorem summable_profile_sq (cs : List Params) : Summable (fun m ↦ profile cs m ^ 2) := by
  apply summable_of_ne_finset_zero (s := Finset.range (memory cs))
  intro m hm
  rw [profile_eq_zero_of_memory_le cs (by simpa using hm), zero_pow (by decide)]

theorem tsum_profile_sq_eq_sum (cs : List Params) :
    (∑' m, profile cs m ^ 2) = ∑ m ∈ Finset.range (memory cs), profile cs m ^ 2 := by
  apply tsum_eq_sum
  intro m hm
  rw [profile_eq_zero_of_memory_le cs (by simpa using hm), zero_pow (by decide)]

end FiniteVariation

section SquareCost

/-- First moment of the finite nonnegative profile. -/
def profileMass (cs : List Params) : ℝ :=
  ∑ m ∈ Finset.range (memory cs), profile cs m

/-- Full square sum of the finite profile, written as a finite sum. -/
def profileEnergy (cs : List Params) : ℝ :=
  ∑ m ∈ Finset.range (memory cs), profile cs m ^ 2

@[simp] theorem profileMass_nil : profileMass [] = 0 := by simp [profileMass]
@[simp] theorem profileEnergy_nil : profileEnergy [] = 0 := by simp [profileEnergy]

theorem profileMass_nonneg (cs : List Params) : 0 ≤ profileMass cs :=
  Finset.sum_nonneg fun m _ ↦ profile_nonneg cs m

theorem profileEnergy_nonneg (cs : List Params) : 0 ≤ profileEnergy cs :=
  Finset.sum_nonneg fun _ _ ↦ sq_nonneg _

theorem sum_profile_of_memory_le (cs : List Params) {L : ℕ} (hL : memory cs ≤ L) :
    (∑ m ∈ Finset.range L, profile cs m) = profileMass cs := by
  symm
  apply Finset.sum_subset (Finset.range_mono hL)
  intro m _ hm
  exact profile_eq_zero_of_memory_le cs (by simpa using hm)

theorem sum_profile_sq_of_memory_le (cs : List Params) {L : ℕ} (hL : memory cs ≤ L) :
    (∑ m ∈ Finset.range L, profile cs m ^ 2) = profileEnergy cs := by
  symm
  apply Finset.sum_subset (Finset.range_mono hL)
  intro m _ hm
  rw [profile_eq_zero_of_memory_le cs (by simpa using hm), zero_pow (by decide)]

@[simp] theorem profileMass_append_singleton (cs : List Params) (c : Params) :
    profileMass (cs ++ [c]) = profileMass cs +
      2 * ((memory cs + c.N : ℕ) : ℝ) * (gainProduct cs * c.budget) := by
  rw [profileMass, memory_append_singleton]
  calc
    (∑ m ∈ Finset.range (memory cs + c.N), profile (cs ++ [c]) m) =
        ∑ m ∈ Finset.range (memory cs + c.N),
          (profile cs m + 2 * (gainProduct cs * c.budget)) := by
      apply Finset.sum_congr rfl
      intro m hm
      rw [profile_append_singleton, if_pos (Finset.mem_range.mp hm)]
    _ = _ := by
      simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range,
        nsmul_eq_mul, sum_profile_of_memory_le cs (Nat.le_add_right _ _)]
      ring

/-- The exact energy recurrence.  The middle term is the sum of all cross
terms with the newly appended layer; it cannot be discarded. -/
@[simp] theorem profileEnergy_append_singleton (cs : List Params) (c : Params) :
    profileEnergy (cs ++ [c]) = profileEnergy cs +
      4 * (gainProduct cs * c.budget) * profileMass cs +
      4 * ((memory cs + c.N : ℕ) : ℝ) * (gainProduct cs * c.budget) ^ 2 := by
  rw [profileEnergy, memory_append_singleton]
  calc
    (∑ m ∈ Finset.range (memory cs + c.N), profile (cs ++ [c]) m ^ 2) =
        ∑ m ∈ Finset.range (memory cs + c.N),
          (profile cs m ^ 2 + 4 * (gainProduct cs * c.budget) * profile cs m +
            4 * (gainProduct cs * c.budget) ^ 2) := by
      apply Finset.sum_congr rfl
      intro m hm
      rw [profile_append_singleton, if_pos (Finset.mem_range.mp hm)]
      ring
    _ = _ := by
      simp only [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const,
        Finset.card_range, nsmul_eq_mul,
        sum_profile_of_memory_le cs (Nat.le_add_right _ _),
        sum_profile_sq_of_memory_le cs (Nat.le_add_right _ _)]
      ring

/-- Strengthened square-cost estimate.  Keeping the first-moment reserve is
what controls cross terms uniformly in the number of layers.  The parameter
`R` also makes the empty cascade harmless (no division by zero is needed).

At a new cumulative memory `M`, doubling allows the old estimate at `M / 2`.
The remaining inequality is exactly `(profileMass cs - 4 * M * a)² ≥ 0`. -/
theorem profileEnergy_add_mass_sq_div_le (cs : List Params) (hcs : DoublingMemory cs)
    (R : ℝ) (hR : (memory cs : ℝ) ≤ R) (hRpos : 0 < R) :
    profileEnergy cs + profileMass cs ^ 2 / R ≤ 24 * cost cs := by
  induction cs using List.reverseRecOn generalizing R with
  | nil => simp
  | append_singleton cs c ih =>
    obtain ⟨hcs, hN⟩ := (doublingMemory_append_singleton_iff cs c).mp hcs
    let M : ℝ := ((memory cs + c.N : ℕ) : ℝ)
    let a : ℝ := gainProduct cs * c.budget
    have hMpos : 0 < M := by
      dsimp [M]
      exact_mod_cast Nat.lt_add_left (memory cs) c.N_pos
    have hmem : (memory cs : ℝ) ≤ M / 2 := by
      have hN' : (memory cs : ℝ) ≤ (c.N : ℝ) := by exact_mod_cast hN
      dsimp [M]
      push_cast
      linarith
    have hi := ih hcs (M / 2) hmem (half_pos hMpos)
    have hreserve : 2 * profileMass cs ^ 2 ≤ M * (24 * cost cs - profileEnergy cs) := by
      have hh : profileMass cs ^ 2 / (M / 2) ≤ 24 * cost cs - profileEnergy cs := by
        linarith
      have hh' := (div_le_iff₀ (half_pos hMpos)).mp hh
      nlinarith
    have hMR : M ≤ R := by simpa only [memory_append_singleton] using hR
    calc
      profileEnergy (cs ++ [c]) + profileMass (cs ++ [c]) ^ 2 / R ≤
          profileEnergy (cs ++ [c]) + profileMass (cs ++ [c]) ^ 2 / M :=
        add_le_add le_rfl (div_le_div_of_nonneg_left (sq_nonneg _) hMpos hMR)
      _ ≤ 24 * cost (cs ++ [c]) := by
        rw [profileEnergy_append_singleton, profileMass_append_singleton,
          cost_append_singleton]
        change profileEnergy cs + 4 * a * profileMass cs + 4 * M * a ^ 2 +
          (profileMass cs + 2 * M * a) ^ 2 / M ≤ 24 * (cost cs + M * a ^ 2)
        have hh : (profileMass cs + 2 * M * a) ^ 2 / M ≤
            24 * (cost cs + M * a ^ 2) -
              (profileEnergy cs + 4 * a * profileMass cs + 4 * M * a ^ 2) := by
          apply (div_le_iff₀ hMpos).mpr
          nlinarith [sq_nonneg (profileMass cs - 4 * M * a)]
        linarith

/-- The diagonal layer cost controls the full square energy, cross terms included. -/
theorem profileEnergy_le_cost (cs : List Params) (hcs : DoublingMemory cs) :
    profileEnergy cs ≤ 24 * cost cs := by
  have h := profileEnergy_add_mass_sq_div_le cs hcs ((memory cs : ℝ) + 1)
    (by linarith) (by positivity)
  exact (le_add_of_nonneg_right (div_nonneg (sq_nonneg _) (by positivity))).trans h

/-- Square summability with a universal cost bound (in fact, `24` suffices). -/
theorem tsum_profile_sq_le_cost (cs : List Params) (hcs : DoublingMemory cs) :
    (∑' m, profile cs m ^ 2) ≤ 24 * cost cs := by
  rw [tsum_profile_sq_eq_sum]
  exact profileEnergy_le_cost cs hcs

/-- The requested `28`-constant version of the square-cost estimate. -/
theorem tsum_profile_sq_le_twentyEight_cost (cs : List Params) (hcs : DoublingMemory cs) :
    (∑' m, profile cs m ^ 2) ≤ 28 * cost cs :=
  (tsum_profile_sq_le_cost cs hcs).trans (by nlinarith [cost_nonneg cs])

end SquareCost

section LimitVariation

/-- The monotone envelope of all finite-stage profiles. -/
noncomputable def limitProfile (cs : ℕ → List Params) (m : ℕ) : ℝ :=
  ⨆ j, profile (cs j) m

theorem profile_monotone (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) (m : ℕ) :
    Monotone (fun j ↦ profile (cs j) m) :=
  monotone_nat_of_le_succ fun j ↦ profile_mono_of_isPrefix (hp j) m

theorem bddAbove_range_profile (cs : ℕ → List Params) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) (m : ℕ) :
    BddAbove (Set.range (fun j ↦ profile (cs j) m)) := by
  refine ⟨2 * B, ?_⟩
  rintro _ ⟨j, rfl⟩
  exact (profile_le_two_amplitude (cs j) m).trans
    (mul_le_mul_of_nonneg_left (hB j) (by norm_num))

theorem profile_le_limitProfile (cs : ℕ → List Params) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) (m j : ℕ) :
    profile (cs j) m ≤ limitProfile cs m :=
  le_ciSup (bddAbove_range_profile cs hB m) j

theorem limitProfile_nonneg (cs : ℕ → List Params) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) (m : ℕ) : 0 ≤ limitProfile cs m :=
  (profile_nonneg (cs 0) m).trans (profile_le_limitProfile cs hB m 0)

theorem limitProfile_le_two_mul (cs : ℕ → List Params) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) (m : ℕ) : limitProfile cs m ≤ 2 * B :=
  ciSup_le fun j ↦ (profile_le_two_amplitude (cs j) m).trans
    (mul_le_mul_of_nonneg_left (hB j) (by norm_num))

/-- Every profile coordinate converges monotonically to its bounded supremum. -/
theorem tendsto_profile_limitProfile (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) (m : ℕ) :
    Tendsto (fun j ↦ profile (cs j) m) atTop (𝓝 (limitProfile cs m)) :=
  tendsto_atTop_ciSup (profile_monotone cs hp m) (bddAbove_range_profile cs hB m)

/-- Passing to the limit only in a finite sum avoids any interchange of
conditionally convergent series or any flattening of variable-length batches. -/
theorem sum_limitProfile_sq_le (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) (hd : ∀ j, DoublingMemory (cs j))
    {C B : ℝ} (hC : ∀ j, cost (cs j) ≤ C) (hB : ∀ j, amplitude (cs j) ≤ B)
    (s : Finset ℕ) : (∑ m ∈ s, limitProfile cs m ^ 2) ≤ 24 * C := by
  apply le_of_tendsto' (tendsto_finset_sum s
    (fun m _ ↦ (tendsto_profile_limitProfile cs hp hB m).pow 2))
  intro j
  exact ((summable_profile_sq (cs j)).sum_le_tsum s (fun _ _ ↦ sq_nonneg _)).trans
    ((tsum_profile_sq_le_cost (cs j) (hd j)).trans
      (mul_le_mul_of_nonneg_left (hC j) (by norm_num)))

theorem summable_limitProfile_sq (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) (hd : ∀ j, DoublingMemory (cs j))
    {C B : ℝ} (hC : ∀ j, cost (cs j) ≤ C) (hB : ∀ j, amplitude (cs j) ≤ B) :
    Summable (fun m ↦ limitProfile cs m ^ 2) :=
  summable_of_sum_le (fun _ ↦ sq_nonneg _) (sum_limitProfile_sq_le cs hp hd hC hB)

theorem tsum_limitProfile_sq_le (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) (hd : ∀ j, DoublingMemory (cs j))
    {C B : ℝ} (hC : ∀ j, cost (cs j) ≤ C) (hB : ∀ j, amplitude (cs j) ≤ B) :
    (∑' m, limitProfile cs m ^ 2) ≤ 24 * C :=
  Real.tsum_le_of_sum_range_le (fun _ ↦ sq_nonneg _)
    (fun M ↦ sum_limitProfile_sq_le cs hp hd hC hB (Finset.range M))

/-- Pointwise convergence already suffices to pass the variation inequalities.
The stronger bounded-continuous-function convergence is used by the wrapper below. -/
theorem limitProfile_hasVariationMajorant (cs : ℕ → List Params) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) {H : Past → ℝ}
    (hH : ∀ x, Tendsto (fun j ↦ inverseKernel (cs j) x) atTop (𝓝 (H x))) :
    HasVariationMajorant H (limitProfile cs) := by
  intro m x y hxy
  apply le_of_tendsto' (((hH x).sub (hH y)).abs)
  intro j
  exact (inverseKernel_hasVariationMajorant (cs j) m x y hxy).trans
    (profile_le_limitProfile cs hB m j)

/-- Quantitative limit certificate for a sequence of genuine finite prefixes.
It supplies a nonnegative majorant with square sum at most `24 * C`. -/
theorem limitProfile_certificate (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) (hd : ∀ j, DoublingMemory (cs j))
    {C B : ℝ} (hC : ∀ j, cost (cs j) ≤ C) (hB : ∀ j, amplitude (cs j) ≤ B)
    {H : Correction} (hH : Tendsto (fun j ↦ inverseKernel (cs j)) atTop (𝓝 H)) :
    (∀ m, 0 ≤ limitProfile cs m) ∧
      HasVariationMajorant H (limitProfile cs) ∧
      Summable (fun m ↦ limitProfile cs m ^ 2) ∧
      (∑' m, limitProfile cs m ^ 2) ≤ 24 * C :=
  ⟨limitProfile_nonneg cs hB,
    limitProfile_hasVariationMajorant cs hB (fun x ↦ hH.eval_const x),
    summable_limitProfile_sq cs hp hd hC hB,
    tsum_limitProfile_sq_le cs hp hd hC hB⟩

/-- Main existence form: a BCF limit of uniformly cheap, uniformly bounded
finite prefixes has a square-summable variation majorant. -/
theorem exists_squareSummable_variationMajorant (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) (hd : ∀ j, DoublingMemory (cs j))
    {C B : ℝ} (hC : ∀ j, cost (cs j) ≤ C) (hB : ∀ j, amplitude (cs j) ≤ B)
    {H : Correction} (hH : Tendsto (fun j ↦ inverseKernel (cs j)) atTop (𝓝 H)) :
    ∃ d : ℕ → ℝ, HasVariationMajorant H d ∧ Summable (fun m ↦ d m ^ 2) := by
  have h := limitProfile_certificate cs hp hd hC hB hH
  exact ⟨limitProfile cs, h.2.1, h.2.2.1⟩

/-- Convenience form when prefix extension is given by explicit appended batches. -/
theorem exists_squareSummable_variationMajorant_of_append (cs : ℕ → List Params)
    (hp : ∀ j, ∃ ds, cs (j + 1) = cs j ++ ds) (hd : ∀ j, DoublingMemory (cs j))
    {C B : ℝ} (hC : ∀ j, cost (cs j) ≤ C) (hB : ∀ j, amplitude (cs j) ≤ B)
    {H : Correction} (hH : Tendsto (fun j ↦ inverseKernel (cs j)) atTop (𝓝 H)) :
    ∃ d : ℕ → ℝ, HasVariationMajorant H d ∧ Summable (fun m ↦ d m ^ 2) := by
  apply exists_squareSummable_variationMajorant cs _ hd hC hB hH
  intro j
  obtain ⟨ds, hds⟩ := hp j
  exact ⟨ds, hds.symm⟩

end LimitVariation

end Cascade.InverseCascade
end


/- Supporting development: Cascade.KernelLimit -/
section
set_option autoImplicit false

/-
# Bounded-continuous limits of prefix cascades

Uniformly bounded amplitudes are enough: the amplitudes increase along prefixes,
so their differences tend to zero and control both kernel sequences.  The
reconstruction identity passes to the limit by continuous evaluation of bounded
continuous functions, with no use of growing finite-stage Lipschitz constants.
-/

open Filter Topology
open scoped BoundedContinuousFunction

namespace Cascade.InverseCascade

open Controller (Params)

section PrefixLimits

theorem isPrefix_of_le (cs : ℕ → List Params) (hp : ∀ j, cs j <+: cs (j + 1))
    {i j : ℕ} (hij : i ≤ j) : cs i <+: cs j := by
  induction j, hij using Nat.le_induction with
  | base => exact List.prefix_refl _
  | succ j _ ih => exact ih.trans (hp j)

theorem amplitude_mono_of_isPrefix {cs ds : List Params} (hp : cs <+: ds) :
    amplitude cs ≤ amplitude ds := by
  obtain ⟨es, rfl⟩ := hp
  exact amplitude_le_amplitude_append cs es

theorem amplitude_monotone (cs : ℕ → List Params) (hp : ∀ j, cs j <+: cs (j + 1)) :
    Monotone (fun j ↦ amplitude (cs j)) :=
  monotone_nat_of_le_succ fun j ↦ amplitude_mono_of_isPrefix (hp j)

theorem inverseKernel_norm_sub_le_of_isPrefix {cs ds : List Params} (hp : cs <+: ds) :
    ‖inverseKernel ds - inverseKernel cs‖ ≤ amplitude ds - amplitude cs := by
  obtain ⟨es, rfl⟩ := hp
  exact inverseKernel_append_norm_sub_le_amplitude cs es

theorem forward_norm_sub_le_of_isPrefix {cs ds : List Params} (hp : cs <+: ds)
    (oldK : Correction) :
    ‖forward ds oldK - forward cs oldK‖ ≤ amplitude ds - amplitude cs := by
  obtain ⟨es, rfl⟩ := hp
  exact forward_append_norm_sub_le_amplitude cs es oldK

/-- Total limiting amplitude, defined without choosing a limit of the kernels. -/
noncomputable def limitAmplitude (cs : ℕ → List Params) : ℝ := ⨆ j, amplitude (cs j)

theorem bddAbove_range_amplitude (cs : ℕ → List Params) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) : BddAbove (Set.range (fun j ↦ amplitude (cs j))) := by
  refine ⟨B, ?_⟩
  rintro _ ⟨j, rfl⟩
  exact hB j

theorem amplitude_le_limitAmplitude (cs : ℕ → List Params) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) (j : ℕ) :
    amplitude (cs j) ≤ limitAmplitude cs := le_ciSup (bddAbove_range_amplitude cs hB) j

theorem limitAmplitude_le (cs : ℕ → List Params) {B : ℝ}
    (hB : ∀ j, amplitude (cs j) ≤ B) : limitAmplitude cs ≤ B := ciSup_le hB

theorem tendsto_amplitude_limitAmplitude (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) {B : ℝ} (hB : ∀ j, amplitude (cs j) ≤ B) :
    Tendsto (fun j ↦ amplitude (cs j)) atTop (𝓝 (limitAmplitude cs)) :=
  tendsto_atTop_ciSup (amplitude_monotone cs hp) (bddAbove_range_amplitude cs hB)

/-- No summability assumption beyond bounded monotone amplitudes is necessary. -/
theorem cauchySeq_inverseKernel (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) {B : ℝ} (hB : ∀ j, amplitude (cs j) ≤ B) :
    CauchySeq (fun j ↦ inverseKernel (cs j)) := by
  apply cauchySeq_of_le_tendsto_0' (fun j ↦ limitAmplitude cs - amplitude (cs j))
  · intro i j hij
    rw [dist_eq_norm, norm_sub_rev]
    exact (inverseKernel_norm_sub_le_of_isPrefix (isPrefix_of_le cs hp hij)).trans
      (sub_le_sub_right (amplitude_le_limitAmplitude cs hB j) _)
  · simpa using (tendsto_const_nhds (x := limitAmplitude cs)).sub
      (tendsto_amplitude_limitAmplitude cs hp hB)

theorem cauchySeq_forward (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) {B : ℝ} (hB : ∀ j, amplitude (cs j) ≤ B)
    (oldK : Correction) : CauchySeq (fun j ↦ forward (cs j) oldK) := by
  apply cauchySeq_of_le_tendsto_0' (fun j ↦ limitAmplitude cs - amplitude (cs j))
  · intro i j hij
    rw [dist_eq_norm, norm_sub_rev]
    exact (forward_norm_sub_le_of_isPrefix (isPrefix_of_le cs hp hij) oldK).trans
      (sub_le_sub_right (amplitude_le_limitAmplitude cs hB j) _)
  · simpa using (tendsto_const_nhds (x := limitAmplitude cs)).sub
      (tendsto_amplitude_limitAmplitude cs hp hB)

/-- A useful quantitative tail estimate for any inverse-kernel limit. -/
theorem norm_limit_sub_inverseKernel_le (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) {B : ℝ} (hB : ∀ j, amplitude (cs j) ≤ B)
    {H : Correction} (hH : Tendsto (fun j ↦ inverseKernel (cs j)) atTop (𝓝 H)) (i : ℕ) :
    ‖H - inverseKernel (cs i)‖ ≤ B - amplitude (cs i) := by
  apply le_of_tendsto (hH.sub tendsto_const_nhds).norm
  refine eventually_atTop.mpr ⟨i, fun j hij ↦ ?_⟩
  exact (inverseKernel_norm_sub_le_of_isPrefix (isPrefix_of_le cs hp hij)).trans
    (sub_le_sub_right (hB j) _)

/-- The analogous quantitative tail bound for forward kernels. -/
theorem norm_limit_sub_forward_le (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) {B : ℝ} (hB : ∀ j, amplitude (cs j) ≤ B)
    (oldK : Correction) {K : Correction}
    (hK : Tendsto (fun j ↦ forward (cs j) oldK) atTop (𝓝 K)) (i : ℕ) :
    ‖K - forward (cs i) oldK‖ ≤ B - amplitude (cs i) := by
  apply le_of_tendsto (hK.sub tendsto_const_nhds).norm
  refine eventually_atTop.mpr ⟨i, fun j hij ↦ ?_⟩
  exact (forward_norm_sub_le_of_isPrefix (isPrefix_of_le cs hp hij) oldK).trans
    (sub_le_sub_right (hB j) _)

end PrefixLimits

section LimitIdentities

/-- Oddness is closed under BCF convergence. -/
theorem odd_of_tendsto {F : ℕ → Correction} {K : Correction}
    (hF : Tendsto F atTop (𝓝 K)) (ho : ∀ j, Function.Odd (F j : Past → ℝ)) :
    Function.Odd (K : Past → ℝ) := by
  intro x
  apply tendsto_nhds_unique (hF.eval_const (-x))
  have heq : (fun j ↦ F j (-x)) = (fun j ↦ -(F j x)) := funext fun j ↦ ho j x
  rw [heq]
  exact (hF.eval_const x).neg

theorem tendsto_factor {F : ℕ → Correction} {K : Correction}
    (hF : Tendsto F atTop (𝓝 K)) (x : Past) :
    Tendsto (fun j ↦ factor (F j) x) atTop (𝓝 (factor K x)) :=
  tendsto_const_nhds.add (hF.eval_const (dropPast 1 x))

/-- Output histories converge coordinatewise, which is precisely the topology
of `Past`.  Neither the histories nor their coordinates need to be bounded. -/
theorem tendsto_factorHistory {F : ℕ → Correction} {K : Correction}
    (hF : Tendsto F atTop (𝓝 K)) (x : Past) :
    Tendsto (fun j ↦ Controller.factorHistory (F j) x) atTop
      (𝓝 (Controller.factorHistory K x)) := by
  apply tendsto_pi_nhds.mpr
  intro k
  exact tendsto_factor hF (dropPast k x)

/-- The everywhere reconstruction identity survives BCF limits.  Joint
continuous evaluation uses the fixed limiting continuous kernel and uniform
convergence, rather than a Lipschitz constant depending on the stage. -/
theorem reconstruct_of_tendsto (cs : ℕ → List Params) {K H : Correction}
    (hK : Tendsto (fun j ↦ forward (cs j) 0) atTop (𝓝 K))
    (hH : Tendsto (fun j ↦ inverseKernel (cs j)) atTop (𝓝 H)) (x : Past) :
    factor K x + H (dropPast 1 (Controller.factorHistory K x)) = x 0 := by
  have hY := ((continuous_dropPast 1).tendsto _).comp (tendsto_factorHistory hK x)
  have hlim := (tendsto_factor hK x).add (hH.eval hY)
  have hc : Tendsto (fun j ↦ factor (forward (cs j) 0) x +
      inverseKernel (cs j) (dropPast 1 (Controller.factorHistory (forward (cs j) 0) x)))
      atTop (𝓝 (x 0)) := by
    simpa only [reconstruct_current] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ x 0) atTop (𝓝 (x 0)))
  exact tendsto_nhds_unique hlim hc

theorem factorHistory_dropPast (K : Correction) (n : ℕ) (x : Past) :
    Controller.factorHistory K (dropPast n x) = dropPast n (Controller.factorHistory K x) := by
  funext k
  change factor K (dropPast k (dropPast n x)) = factor K (dropPast (k + n) x)
  rw [dropPast_dropPast]

/-- The scalar reconstruction identity implies reconstruction of the full history. -/
theorem leftInverse_factorHistory_of_reconstruct (K H : Correction)
    (h : ∀ x, factor K x + H (dropPast 1 (Controller.factorHistory K x)) = x 0) :
    Function.LeftInverse (Controller.factorHistory H) (Controller.factorHistory K) := by
  intro x
  funext k
  change factor H (dropPast k (Controller.factorHistory K x)) = x k
  rw [← factorHistory_dropPast]
  simpa only [factor, Controller.factorHistory, dropPast_zero, dropPast, Nat.zero_add]
    using h (dropPast k x)

end LimitIdentities

/-- An actual pair of bounded continuous limiting kernels, with all deterministic
properties needed by the causal-law construction. -/
structure KernelLimit (cs : ℕ → List Params) (B : ℝ) where
  K : Correction
  H : Correction
  tendsto_forward : Tendsto (fun j ↦ forward (cs j) 0) atTop (𝓝 K)
  tendsto_inverse : Tendsto (fun j ↦ inverseKernel (cs j)) atTop (𝓝 H)
  norm_K_le : ‖K‖ ≤ B
  norm_H_le : ‖H‖ ≤ B
  odd_K : Function.Odd (K : Past → ℝ)
  odd_H : Function.Odd (H : Past → ℝ)
  reconstruct : ∀ x, factor K x + H (dropPast 1 (Controller.factorHistory K x)) = x 0

/-- Bounded amplitudes along finite prefixes produce genuine BCF limits. -/
theorem nonempty_kernelLimit (cs : ℕ → List Params)
    (hp : ∀ j, cs j <+: cs (j + 1)) {B : ℝ} (hB : ∀ j, amplitude (cs j) ≤ B) :
    Nonempty (KernelLimit cs B) := by
  obtain ⟨K, hK⟩ := cauchySeq_tendsto_of_complete (cauchySeq_forward cs hp hB 0)
  obtain ⟨H, hH⟩ := cauchySeq_tendsto_of_complete (cauchySeq_inverseKernel cs hp hB)
  refine ⟨⟨K, H, hK, hH, ?_, ?_, ?_, ?_, reconstruct_of_tendsto cs hK hH⟩⟩
  · exact le_of_tendsto' hK.norm fun j ↦ (forward_zero_norm_le_amplitude (cs j)).trans (hB j)
  · exact le_of_tendsto' hH.norm fun j ↦ (inverseKernel_norm_le_amplitude (cs j)).trans (hB j)
  · exact odd_of_tendsto hK fun j ↦ forward_odd (cs j) 0 (by intro x; simp)
  · exact odd_of_tendsto hH fun j ↦ inverseKernel_odd (cs j)

namespace KernelLimit

/-- Reconstruction holds simultaneously at every coordinate. -/
theorem leftInverse {cs : ℕ → List Params} {B : ℝ} (L : KernelLimit cs B) :
    Function.LeftInverse (Controller.factorHistory L.H) (Controller.factorHistory L.K) :=
  leftInverse_factorHistory_of_reconstruct L.K L.H L.reconstruct

/-- Attach the square-variation certificate to the actual inverse BCF limit. -/
theorem variation_certificate {cs : ℕ → List Params} {B : ℝ} (L : KernelLimit cs B)
    (hp : ∀ j, cs j <+: cs (j + 1)) (hd : ∀ j, DoublingMemory (cs j))
    {C : ℝ} (hC : ∀ j, cost (cs j) ≤ C) (hB : ∀ j, amplitude (cs j) ≤ B) :
    (∀ m, 0 ≤ limitProfile cs m) ∧
      HasVariationMajorant L.H (limitProfile cs) ∧
      Summable (fun m ↦ limitProfile cs m ^ 2) ∧
      (∑' m, limitProfile cs m ^ 2) ≤ 24 * C :=
  limitProfile_certificate cs hp hd hC hB L.tendsto_inverse

end KernelLimit

end Cascade.InverseCascade
end


/- Supporting development: Cascade.StageChoice -/
section
set_option autoImplicit false

/-
# A noncircular finite choice for the diagonal cascade

The state at the beginning of stage `j` contains only the sizes already chosen.
Its core law retains precisely the spikes with indices `< j`.  We first extend
the controllers, then choose the observation time and a uniform burn-in, then
the next positive amplitude budget, and only then the new spike size.  Thus no
attenuation or forgetting certificate is requested for a law that depends on
the spike size still to be chosen.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal BoundedContinuousFunction

namespace Cascade.Diagonal

open InverseCascade
open Controller (Params)

/-- Both the stage cost allowance and the comparison error. -/
noncomputable def error (j : ℕ) : ℝ := (1 / 2 : ℝ) ^ (j + 1)

/-- The upper `L²` slope requested at stage `j`. -/
noncomputable def target (j : ℕ) : ℝ := (1 / 2 : ℝ) ^ (2 * (j + 1))

theorem error_pos (j : ℕ) : 0 < error j := by unfold error; positivity

theorem target_pos (j : ℕ) : 0 < target j := by unfold target; positivity

/-- Information available before stage `j` is performed. -/
structure State where
  cs : List Params
  q : ℕ → ℝ
  one_le_q : ∀ i, 1 ≤ q i
  r : ℝ
  r_pos : 0 < r
  lastn : ℕ
  doubling : DoublingMemory cs

namespace State

/-- The temporary probabilities are computed from the temporary sizes. -/
noncomputable def weights (s : State) : SpikeWeights :=
  geometricSpikeEnergy.forSizes s.q s.one_le_q

/-- Only earlier spikes are retained; all other mass is at zero. -/
noncomputable def coreSpike (s : State) (j : ℕ) : Measure ℝ :=
  spikeLawStage s.weights s.q j

/-- Gaussian smoothing of the finite latent core. -/
noncomputable def coreNoise (s : State) (j : ℕ) : Measure ℝ :=
  spikeNoiseStage s.weights s.q j

instance (s : State) (j : ℕ) : IsProbabilityMeasure (s.coreSpike j) :=
  isProbabilityMeasure_spikeLawStage _ _ _

instance (s : State) (j : ℕ) : IsProbabilityMeasure (s.coreNoise j) :=
  isProbabilityMeasure_spikeNoiseStage _ _ _

/-- Empty controllers, unit placeholder sizes, and the initial budget `1/16`. -/
noncomputable def initial : State where
  cs := []
  q := fun _ ↦ 1
  one_le_q := fun _ ↦ le_rfl
  r := 1 / 16
  r_pos := by norm_num
  lastn := 0
  doubling := by intro i; exact Fin.elim0 i

end State

/-- All choices and certificates from one stage, before any later choice.
The burn-in is uniform in *every* later burn-in time, target length, and pair
of arbitrary real histories. -/
structure Step (j : ℕ) (s : State) where
  ds : List Params
  ds_ne_nil : ds ≠ []
  n : ℕ
  T : ℕ
  rnext : ℝ
  Q : ℝ
  doubling : DoublingMemory (s.cs ++ ds)
  upper : UpperL2 (s.coreNoise j) (factor (forward (s.cs ++ ds) 0)) (target j)
  cost_le : cost (s.cs ++ ds) ≤ cost s.cs + error j
  amplitude_le : amplitude (s.cs ++ ds) ≤ amplitude s.cs + s.r
  lastn_lt : s.lastn + 1 ≤ n
  stage_le_n : j + 1 ≤ n
  variance_le : variance (sumProcess (factor (forward (s.cs ++ ds) 0)) n)
    (iidLaw ℤ (s.coreNoise j)) ≤ 2 * (n : ℝ) * target j ^ 2
  burnin : ∀ b ≥ T, ∀ L : ℕ, ∀ x y : Past,
    TestClose
      (pathSuffixLaw (inverseKernel (s.cs ++ ds)) (inverseKernel (s.cs ++ ds)).continuous.measurable
        (s.coreSpike j) b L x)
      (pathSuffixLaw (inverseKernel (s.cs ++ ds)) (inverseKernel (s.cs ++ ds)).continuous.measurable
        (s.coreSpike j) b L y) (error j / 2)
  rnext_pos : 0 < rnext
  rnext_quarter : rnext ≤ s.r / 4
  rnext_small : rnext ≤ error j / (16 * ((T + n + 1 : ℕ) : ℝ))
  one_le_Q : 1 ≤ Q
  growth_Q : (4 : ℝ) ^ (j + 1) ≤ Q
  large_Q : 16 * (n : ℝ) < Q
  probability_le : (geometricSpikeEnergy.p j : ℝ) / Q ^ 2 ≤ rnext

/-- An arbitrarily large size can make its prescribed-energy probability
smaller than any positive budget.  A natural size suffices. -/
theorem exists_large_size (j n : ℕ) {r : ℝ} (hr : 0 < r) :
    ∃ Q : ℝ, 1 ≤ Q ∧ (4 : ℝ) ^ (j + 1) ≤ Q ∧ 16 * (n : ℝ) < Q ∧
      (geometricSpikeEnergy.p j : ℝ) / Q ^ 2 ≤ r := by
  obtain ⟨m, hm⟩ := exists_nat_gt
    (max (max (1 : ℝ) ((4 : ℝ) ^ (j + 1)))
      (max (16 * (n : ℝ)) ((geometricSpikeEnergy.p j : ℝ) / r)))
  have h1 : 1 ≤ (m : ℝ) := ((le_max_left _ _).trans (le_max_left _ _)).trans hm.le
  have hg : (4 : ℝ) ^ (j + 1) ≤ (m : ℝ) :=
    ((le_max_right _ _).trans (le_max_left _ _)).trans hm.le
  have hn : 16 * (n : ℝ) < (m : ℝ) :=
    ((le_max_left _ _).trans (le_max_right _ _)).trans_lt hm
  have hp : (geometricSpikeEnergy.p j : ℝ) / r ≤ (m : ℝ) :=
    ((le_max_right _ _).trans (le_max_right _ _)).trans hm.le
  have hm0 : 0 < (m : ℝ) := by linarith
  have hm2 : (m : ℝ) ≤ (m : ℝ) ^ 2 := by nlinarith
  refine ⟨m, h1, hg, hn, (div_le_iff₀ (sq_pos_of_pos hm0)).2 ?_⟩
  have hh := (div_le_iff₀ hr).1 (hp.trans hm2)
  nlinarith only [hh]

/-- The substantive finite existence step.  In particular `rnext` and `Q`
are chosen only after `n` and the uniform burn-in `T` have been obtained. -/
theorem nonempty_step (j : ℕ) (s : State) : Nonempty (Step j s) := by
  obtain ⟨ds, hds, hu, hd, hc, ha⟩ := exists_attenuating_extension (s.coreNoise j)
    (memLp_two_spikeNoiseStage s.weights s.q j)
    (symmetricLaw_spikeNoiseStage s.weights s.q j) s.cs s.doubling
    (target_pos j) (error_pos j) s.r_pos
  obtain ⟨n, hn, hv⟩ := hu.exists_ge_variance_le (target_pos j) (max (s.lastn + 1) (j + 1))
  obtain ⟨T, hT⟩ := exists_burnin_testClose_pathLaw_suffix_of_hasMemory
    (inverseKernel (s.cs ++ ds)) (inverseKernel (s.cs ++ ds)).continuous.measurable
    (s.coreSpike j) (amplitude_nonneg (s.cs ++ ds))
    (fun x ↦ (show |inverseKernel (s.cs ++ ds) x| ≤ ‖inverseKernel (s.cs ++ ds)‖ by
      simpa only [Real.norm_eq_abs] using (inverseKernel (s.cs ++ ds)).norm_coe_le_norm x).trans
        (inverseKernel_norm_le_amplitude (s.cs ++ ds)))
    (inverseKernel_hasMemory (s.cs ++ ds)) (half_pos (error_pos j))
  let rnext := min (s.r / 4) (error j / (16 * ((T + n + 1 : ℕ) : ℝ)))
  have hr : 0 < rnext := by
    exact lt_min (div_pos s.r_pos (by norm_num))
      (div_pos (error_pos j) (by positivity))
  obtain ⟨Q, hQ1, hQg, hQn, hQp⟩ := exists_large_size j n hr
  exact ⟨{
    ds := ds
    ds_ne_nil := hds
    n := n
    T := T
    rnext := rnext
    Q := Q
    doubling := hd
    upper := hu
    cost_le := hc
    amplitude_le := ha
    lastn_lt := (le_max_left _ _).trans hn
    stage_le_n := (le_max_right _ _).trans hn
    variance_le := hv
    burnin := hT
    rnext_pos := hr
    rnext_quarter := min_le_left _ _
    rnext_small := min_le_right _ _
    one_le_Q := hQ1
    growth_Q := hQg
    large_Q := hQn
    probability_le := hQp }⟩

namespace Step

/-- Install exactly the newly selected size, leaving every other coordinate
unchanged.  The new state retains its unconditional positivity invariants. -/
noncomputable def next {j : ℕ} {s : State} (e : Step j s) : State where
  cs := s.cs ++ e.ds
  q := Function.update s.q j e.Q
  one_le_q := by
    intro i
    change 1 ≤ Function.update s.q j e.Q i
    by_cases hi : i = j
    · subst i
      simpa using e.one_le_Q
    · simpa [Function.update_of_ne hi] using s.one_le_q i
  r := e.rnext
  r_pos := e.rnext_pos
  lastn := e.n
  doubling := e.doubling

end Step

end Cascade.Diagonal
end


/- Supporting development: Cascade.Diagonal -/
section
set_option autoImplicit false

/-
# The actual diagonal cascade

`construction` is a choice-free-in-its-hypotheses, classically selected witness.
Its controllers and temporary sizes are assembled by `Nat.rec` from the finite
choices in `StageChoice`.  Stage `j` starts with `cs j`, retains only spikes
`i < j`, and produces `cs (j+1)`, the observation time `n j`, the uniform
burn-in `T j`, the next budget `r (j+1)`, and finally the size `Q j`.

The final weights are `geometricSpikeEnergy.forSizes Q one_le_Q`.  Finite-prefix
congruence, rather than an assumption about the final law, transfers every
finite-core certificate to these weights.  All kernel tail bounds below use
summable *increments*; they do not use the non-shrinking gap to an amplitude cap.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal BoundedContinuousFunction

namespace Cascade.Diagonal

open InverseCascade
open Controller (Params)

/-- Once coordinate `i` has been installed at step `i`, later updates leave it
unchanged.  In particular this proof never invokes any future choice to make
an earlier finite-core law. -/
theorem update_prefix_eq {q : ℕ → ℕ → ℝ} {Q : ℕ → ℝ}
    (hupdate : ∀ j, q (j + 1) = Function.update (q j) j (Q j))
    (j : ℕ) {i : ℕ} (hij : i < j) : q j i = Q i := by
  induction j with
  | zero => omega
  | succ j ih =>
    rw [hupdate j]
    by_cases hi : i = j
    · subst i
      simp
    · rw [Function.update_of_ne hi]
      exact ih (by omega)

/-- The exported finite-controller/spike schedule.  The core upper bounds and
burn-in fields are stated for the **final** weights, while `q_succ` documents
the noncircular temporary-size construction that produces them. -/
structure Construction where
  cs : ℕ → List Params
  q : ℕ → ℕ → ℝ
  Q : ℕ → ℝ
  n : ℕ → ℕ
  T : ℕ → ℕ
  r : ℕ → ℝ
  cs_zero : cs 0 = []
  q_zero : q 0 = fun _ ↦ 1
  r_zero : r 0 = 1 / 16
  one_le_q : ∀ j i, 1 ≤ q j i
  one_le_Q : ∀ i, 1 ≤ Q i
  q_succ : ∀ j, q (j + 1) = Function.update (q j) j (Q j)
  append : ∀ j, ∃ ds : List Params, ds ≠ [] ∧ cs (j + 1) = cs j ++ ds
  doubling : ∀ j, DoublingMemory (cs j)
  cost_step : ∀ j, cost (cs (j + 1)) ≤ cost (cs j) + error j
  amplitude_step : ∀ j, amplitude (cs (j + 1)) ≤ amplitude (cs j) + r j
  r_pos : ∀ j, 0 < r j
  r_step : ∀ j, r (j + 1) ≤ r j / 4
  r_small : ∀ j, r (j + 1) ≤ error j / (16 * ((T j + n j + 1 : ℕ) : ℝ))
  growth_Q : ∀ j, (4 : ℝ) ^ (j + 1) ≤ Q j
  large_Q : ∀ j, 16 * (n j : ℝ) < Q j
  probability_le : ∀ j, (geometricSpikeEnergy.p j : ℝ) / Q j ^ 2 ≤ r (j + 1)
  n_step : ∀ j, n j + 1 ≤ n (j + 1)
  stage_le_n : ∀ j, j + 1 ≤ n j
  upper : ∀ j, UpperL2 (spikeNoiseStage (geometricSpikeEnergy.forSizes Q one_le_Q) Q j)
    (factor (forward (cs (j + 1)) 0)) (target j)
  variance_le : ∀ j, variance (sumProcess (factor (forward (cs (j + 1)) 0)) (n j))
    (iidLaw ℤ (spikeNoiseStage (geometricSpikeEnergy.forSizes Q one_le_Q) Q j)) ≤
      2 * (n j : ℝ) * target j ^ 2
  burnin : ∀ j, ∀ b ≥ T j, ∀ L : ℕ, ∀ x y : Past,
    TestClose
      (pathSuffixLaw (inverseKernel (cs (j + 1)))
        (inverseKernel (cs (j + 1))).continuous.measurable
        (spikeLawStage (geometricSpikeEnergy.forSizes Q one_le_Q) Q j) b L x)
      (pathSuffixLaw (inverseKernel (cs (j + 1)))
        (inverseKernel (cs (j + 1))).continuous.measurable
        (spikeLawStage (geometricSpikeEnergy.forSizes Q one_le_Q) Q j) b L y) (error j / 2)

namespace Recursion

/-- A single classical choice from the unconditional finite-stage theorem. -/
noncomputable def chooseStep (j : ℕ) (s : State) : Step j s :=
  Classical.choice (nonempty_step j s)

/-- Actual recursive states, starting with no controllers and unit placeholders.
Only the state at `j` is an input to the choice at stage `j`. -/
noncomputable def state : ℕ → State
  | 0 => State.initial
  | j + 1 => (chooseStep j (state j)).next

/-- The stage data include the selected `n`, `T`, next budget, and size. -/
noncomputable def step (j : ℕ) : Step j (state j) := chooseStep j (state j)

@[simp] theorem state_zero : state 0 = State.initial := rfl

@[simp] theorem state_succ (j : ℕ) : state (j + 1) = (step j).next := rfl

end Recursion

/-- **Actual diagonal assembly.** No attenuation, variance, forgetting, or
infinite extension assumption is an input to this definition. -/
noncomputable def construction : Construction := by
  let cs := fun j ↦ (Recursion.state j).cs
  let q := fun j ↦ (Recursion.state j).q
  let Q := fun j ↦ (Recursion.step j).Q
  let n := fun j ↦ (Recursion.step j).n
  let T := fun j ↦ (Recursion.step j).T
  let r := fun j ↦ (Recursion.state j).r
  have hQ : ∀ i, 1 ≤ Q i := fun i ↦ (Recursion.step i).one_le_Q
  have hqupdate : ∀ j, q (j + 1) = Function.update (q j) j (Q j) := fun _ ↦ rfl
  have hnoise (j : ℕ) : (Recursion.state j).coreNoise j =
      spikeNoiseStage (geometricSpikeEnergy.forSizes Q hQ) Q j := by
    apply spikeNoiseFinset_forSizes_congr geometricSpikeEnergy
      (Recursion.state j).one_le_q hQ (Finset.range j)
    intro i hi
    exact update_prefix_eq hqupdate j (Finset.mem_range.mp hi)
  have hspike (j : ℕ) : (Recursion.state j).coreSpike j =
      spikeLawStage (geometricSpikeEnergy.forSizes Q hQ) Q j := by
    apply spikeLawFinset_forSizes_congr geometricSpikeEnergy
      (Recursion.state j).one_le_q hQ (Finset.range j)
    intro i hi
    exact update_prefix_eq hqupdate j (Finset.mem_range.mp hi)
  exact {
    cs := cs
    q := q
    Q := Q
    n := n
    T := T
    r := r
    cs_zero := rfl
    q_zero := rfl
    r_zero := rfl
    one_le_q := fun j ↦ (Recursion.state j).one_le_q
    one_le_Q := hQ
    q_succ := hqupdate
    append := fun j ↦ ⟨(Recursion.step j).ds, (Recursion.step j).ds_ne_nil, rfl⟩
    doubling := fun j ↦ (Recursion.state j).doubling
    cost_step := fun j ↦ (Recursion.step j).cost_le
    amplitude_step := fun j ↦ (Recursion.step j).amplitude_le
    r_pos := fun j ↦ (Recursion.state j).r_pos
    r_step := fun j ↦ (Recursion.step j).rnext_quarter
    r_small := fun j ↦ (Recursion.step j).rnext_small
    growth_Q := fun j ↦ (Recursion.step j).growth_Q
    large_Q := fun j ↦ (Recursion.step j).large_Q
    probability_le := fun j ↦ (Recursion.step j).probability_le
    n_step := fun j ↦ (Recursion.step (j + 1)).lastn_lt
    stage_le_n := fun j ↦ (Recursion.step j).stage_le_n
    upper := fun j ↦ by rw [← hnoise j]; exact (Recursion.step j).upper
    variance_le := fun j ↦ by rw [← hnoise j]; exact (Recursion.step j).variance_le
    burnin := fun j b hb L x y ↦ by
      rw [← hspike j]
      exact (Recursion.step j).burnin b hb L x y }

/-- Existence form for clients that prefer to unpack a structure. -/
theorem nonempty_construction : Nonempty Construction := ⟨construction⟩

namespace Construction

variable (d : Construction)

/- ## Final laws and agreement with the temporary cores -/

/-- The final spike probabilities, determined by the already assembled sizes. -/
noncomputable def w : SpikeWeights := geometricSpikeEnergy.forSizes d.Q d.one_le_Q

/-- The final latent innovation law. -/
noncomputable def latent : Measure ℝ := spikeLaw d.w d.Q

/-- The final Gaussian-smoothed innovation law. -/
noncomputable def noise : Measure ℝ := spikeNoise d.w d.Q

/-- The latent core at stage `j` retains exactly indices `< j`. -/
noncomputable def coreSpike (j : ℕ) : Measure ℝ := spikeLawStage d.w d.Q j

/-- The smoothed finite core, expressed using the final weights. -/
noncomputable def coreNoise (j : ℕ) : Measure ℝ := spikeNoiseStage d.w d.Q j

/-- The forward kernel after the attenuation at stage `j`. -/
noncomputable def forwardStage (j : ℕ) : Correction := forward (d.cs (j + 1)) 0

/-- The finite-memory inverse kernel used to choose the burn-in at stage `j`. -/
noncomputable def inverseStage (j : ℕ) : Correction := inverseKernel (d.cs (j + 1))

instance : IsProbabilityMeasure d.latent := isProbabilityMeasure_spikeLaw _ _
instance : IsProbabilityMeasure d.noise := isProbabilityMeasure_spikeNoise _ _
instance (j : ℕ) : IsProbabilityMeasure (d.coreSpike j) :=
  isProbabilityMeasure_spikeLawStage _ _ _
instance (j : ℕ) : IsProbabilityMeasure (d.coreNoise j) :=
  isProbabilityMeasure_spikeNoiseStage _ _ _

@[simp] theorem noise_eq_gaussianConvolution : d.noise = gaussianConvolution d.latent := rfl

@[simp] theorem coreNoise_eq_gaussianConvolution (j : ℕ) :
    d.coreNoise j = gaussianConvolution (d.coreSpike j) := rfl

/-- All previously installed sizes agree with their final values. -/
theorem q_agrees (j : ℕ) {i : ℕ} (hij : i < j) : d.q j i = d.Q i :=
  update_prefix_eq d.q_succ j hij

/-- Unselected sizes really are still the unit placeholders. -/
theorem q_future (j : ℕ) {i : ℕ} (hji : j ≤ i) : d.q j i = 1 := by
  induction j with
  | zero => rw [d.q_zero]
  | succ j ih =>
    rw [d.q_succ, Function.update_of_ne (show i ≠ j by omega)]
    exact ih (by omega)

theorem q_eq_if (j i : ℕ) : d.q j i = if i < j then d.Q i else 1 := by
  split_ifs with h
  · exact d.q_agrees j h
  · exact d.q_future j (by omega)

/-- Finite-prefix congruence for the latent law, with size-dependent weights. -/
theorem temporary_coreSpike_eq (j : ℕ) :
    spikeLawStage (geometricSpikeEnergy.forSizes (d.q j) (d.one_le_q j)) (d.q j) j =
      d.coreSpike j := by
  apply spikeLawFinset_forSizes_congr geometricSpikeEnergy (d.one_le_q j)
    d.one_le_Q (Finset.range j)
  intro i hi
  exact d.q_agrees j (Finset.mem_range.mp hi)

/-- The same congruence for the actual smoothed innovation law. -/
theorem temporary_coreNoise_eq (j : ℕ) :
    spikeNoiseStage (geometricSpikeEnergy.forSizes (d.q j) (d.one_le_q j)) (d.q j) j =
      d.coreNoise j := by
  apply spikeNoiseFinset_forSizes_congr geometricSpikeEnergy (d.one_le_q j)
    d.one_le_Q (Finset.range j)
  intro i hi
  exact d.q_agrees j (Finset.mem_range.mp hi)

@[simp] theorem coreSpike_zero : d.coreSpike 0 = Measure.dirac 0 :=
  spikeLawStage_zero _ _

@[simp] theorem coreNoise_zero : d.coreNoise 0 = gaussianReal 0 1 :=
  spikeNoiseStage_zero _ _

theorem upper_core (j : ℕ) :
    UpperL2 (d.coreNoise j) (factor (d.forwardStage j)) (target j) := d.upper j

theorem variance_core (j : ℕ) :
    variance (sumProcess (factor (d.forwardStage j)) (d.n j)) (iidLaw ℤ (d.coreNoise j)) ≤
      2 * (d.n j : ℝ) * target j ^ 2 := d.variance_le j

/-- At the chosen burn-in, the same error works for every target length and
arbitrary pasts, not merely for the observation length `n j`. -/
theorem burnin_at (j L : ℕ) (x y : Past) :
    TestClose
      (pathSuffixLaw (d.inverseStage j) (d.inverseStage j).continuous.measurable
        (d.coreSpike j) (d.T j) L x)
      (pathSuffixLaw (d.inverseStage j) (d.inverseStage j).continuous.measurable
        (d.coreSpike j) (d.T j) L y) (error j / 2) :=
  d.burnin j (d.T j) le_rfl L x y

theorem inverseStage_hasMemory (j : ℕ) :
    HasMemory (d.inverseStage j) (memory (d.cs (j + 1))) :=
  inverseKernel_hasMemory _

theorem noise_memLp : MemLp (fun x : ℝ ↦ x) 2 d.noise :=
  memLp_two_spikeNoise_forSizes geometricSpikeEnergy d.Q d.one_le_Q

theorem noise_symmetric : SymmetricLaw d.noise := symmetricLaw_spikeNoise _ _

theorem noise_variance : variance (fun x : ℝ ↦ x) d.noise = 2 :=
  variance_geometricSpikeNoise d.Q d.one_le_Q

/-- Choosing very large sizes changes probabilities, not the prescribed energy. -/
theorem energy_eq (j : ℕ) : (d.w.p j : ℝ) * d.Q j ^ 2 = error j := by
  simp only [w, SpikeWeights.forSizes_energy, geometricSpikeEnergy_p,
    NNReal.coe_pow, NNReal.coe_div, NNReal.coe_one, NNReal.coe_ofNat, error]

/- ## Prefixes, observation times, and positive geometric budgets -/

theorem prefix_succ (j : ℕ) : d.cs j <+: d.cs (j + 1) := by
  obtain ⟨ds, _, heq⟩ := d.append j
  exact ⟨ds, heq.symm⟩

theorem prefix_of_le {i j : ℕ} (hij : i ≤ j) : d.cs i <+: d.cs j :=
  isPrefix_of_le d.cs d.prefix_succ hij

/-- Nonempty appended batches ensure genuinely growing controller lists. -/
theorem length_strictMono : StrictMono (fun j ↦ (d.cs j).length) := by
  apply strictMono_nat_of_lt_succ
  intro j
  obtain ⟨ds, hds, heq⟩ := d.append j
  rw [heq, List.length_append]
  have := List.length_pos_iff.mpr hds
  omega

theorem n_strictMono : StrictMono d.n :=
  strictMono_nat_of_lt_succ fun j ↦ by have := d.n_step j; omega

theorem n_tendsto_atTop : Tendsto d.n atTop atTop := d.n_strictMono.tendsto_atTop

theorem one_le_n (j : ℕ) : 1 ≤ d.n j := (by omega : 1 ≤ j + 1).trans (d.stage_le_n j)

/-- The actual budgets have geometric decay with ratio at most `1/4`. -/
theorem r_add_le_quarter (j k : ℕ) : d.r (k + j) ≤ d.r j * (1 / 4 : ℝ) ^ k := by
  induction k with
  | zero => simp
  | succ k ih =>
    calc
      d.r (k + 1 + j) ≤ d.r (k + j) / 4 := by
        simpa only [Nat.add_right_comm] using d.r_step (k + j)
      _ ≤ (d.r j * (1 / 4 : ℝ) ^ k) / 4 := by linarith
      _ = d.r j * (1 / 4 : ℝ) ^ (k + 1) := by rw [pow_succ]; ring

/-- A slightly looser ratio gives the convenient tail constant `2`. -/
theorem r_add_le_half (j k : ℕ) : d.r (k + j) ≤ d.r j * (1 / 2 : ℝ) ^ k :=
  (d.r_add_le_quarter j k).trans (mul_le_mul_of_nonneg_left
    (pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 1 / 4) (by norm_num) k) (d.r_pos j).le)

theorem r_le_geometric (j : ℕ) : d.r j ≤ (1 / 16 : ℝ) * (1 / 4 : ℝ) ^ j := by
  simpa only [Nat.add_zero, d.r_zero] using d.r_add_le_quarter 0 j

theorem summable_r_tail (j : ℕ) : Summable (fun k ↦ d.r (k + j)) :=
  Summable.of_nonneg_of_le (fun k ↦ (d.r_pos (k + j)).le) (d.r_add_le_half j)
    (summable_geometric_two.mul_left (d.r j))

theorem summable_r : Summable d.r := by simpa using d.summable_r_tail 0

/-- In particular, the tail beginning at `j+1` is at most `2 r(j+1)`. -/
theorem tsum_r_tail_le (j : ℕ) : (∑' k, d.r (k + j)) ≤ 2 * d.r j := by
  calc
    (∑' k, d.r (k + j)) ≤ ∑' k, d.r j * (1 / 2 : ℝ) ^ k :=
      Summable.tsum_le_tsum (d.r_add_le_half j) (d.summable_r_tail j)
        (summable_geometric_two.mul_left (d.r j))
    _ = 2 * d.r j := by rw [tsum_mul_left, tsum_geometric_two]; ring

theorem tsum_r_le : (∑' j, d.r j) ≤ 1 / 8 := by
  have h := d.tsum_r_tail_le 0
  norm_num [d.r_zero] at h
  exact h

theorem r_tendsto_zero : Tendsto d.r atTop (𝓝 0) := d.summable_r.tendsto_atTop_zero

/-- The last finite choice makes the new probability smaller than the next
budget; all later probabilities obey their own still smaller budgets. -/
theorem p_le_r (j : ℕ) : (d.w.p j : ℝ) ≤ d.r (j + 1) := by
  rw [w, SpikeWeights.forSizes_p_coe]
  exact d.probability_le j

theorem summable_p_tail (j : ℕ) : Summable (fun k ↦ (d.w.p (k + j) : ℝ)) :=
  (summable_nat_add_iff j).2 (NNReal.summable_coe.mpr d.w.summable)

/-- The final omitted-spike probability has the same shrinking bound as the
future controller amplitude.  The omitted tail starts at spike `j`. -/
theorem tail_probability_le (j : ℕ) : (∑' k, (d.w.p (k + j) : ℝ)) ≤ 2 * d.r (j + 1) := by
  calc
    (∑' k, (d.w.p (k + j) : ℝ)) ≤ ∑' k, d.r (k + (j + 1)) := by
      apply Summable.tsum_le_tsum _ (d.summable_p_tail j) (d.summable_r_tail (j + 1))
      intro k
      simpa only [Nat.add_assoc] using d.p_le_r (k + j)
    _ ≤ 2 * d.r (j + 1) := d.tsum_r_tail_le (j + 1)

/-- Comparison of the actual final latent law with its finite core. -/
theorem latent_testClose (j : ℕ) :
    TestClose d.latent (d.coreSpike j) (2 * d.r (j + 1)) :=
  (testClose_spikeLaw_stage d.w d.Q j).mono (d.tail_probability_le j)

theorem noise_testClose (j : ℕ) :
    TestClose d.noise (d.coreNoise j) (2 * d.r (j + 1)) :=
  (testClose_spikeNoise_stage d.w d.Q j).mono (d.tail_probability_le j)

/- ## Uniform costs and telescoping amplitudes -/

/-- The unused geometric cost allowance is explicit. -/
theorem cost_add_remaining_le (j : ℕ) : cost (d.cs j) + (1 / 2 : ℝ) ^ j ≤ 1 := by
  induction j with
  | zero => simp [d.cs_zero]
  | succ j ih =>
    have hs := d.cost_step j
    simp only [error, pow_succ] at hs ⊢
    linarith

theorem cost_le_one (j : ℕ) : cost (d.cs j) ≤ 1 := by
  have h := d.cost_add_remaining_le j
  have hp : 0 ≤ (1 / 2 : ℝ) ^ j := by positivity
  linarith

/-- Telescope the **actual** per-stage increments over any finite interval. -/
theorem amplitude_add_le_sum (j k : ℕ) :
    amplitude (d.cs (k + j)) ≤ amplitude (d.cs j) + ∑ i ∈ Finset.range k, d.r (i + j) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Finset.sum_range_succ]
    have hs : amplitude (d.cs (k + 1 + j)) ≤ amplitude (d.cs (k + j)) + d.r (k + j) := by
      simpa only [Nat.add_right_comm] using d.amplitude_step (k + j)
    linarith

/-- Any finite later amplitude increment is bounded by the corresponding
summable budget tail, before taking any kernel limit. -/
theorem amplitude_add_le_tsum (j k : ℕ) :
    amplitude (d.cs (k + j)) ≤ amplitude (d.cs j) + ∑' i, d.r (i + j) :=
  (d.amplitude_add_le_sum j k).trans (add_le_add le_rfl
    ((d.summable_r_tail j).sum_le_tsum (Finset.range k) (fun i _ ↦ (d.r_pos (i + j)).le)))

theorem amplitude_sub_le {i j : ℕ} (hij : i ≤ j) :
    amplitude (d.cs j) - amplitude (d.cs i) ≤ 2 * d.r i := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hij
  have ha := d.amplitude_add_le_tsum i k
  rw [Nat.add_comm k i] at ha
  linarith [d.tsum_r_tail_le i]

theorem amplitude_le_eighth (j : ℕ) : amplitude (d.cs j) ≤ 1 / 8 := by
  have h := d.amplitude_sub_le (Nat.zero_le j)
  norm_num [d.cs_zero, d.r_zero] at h
  exact h

theorem amplitude_le_one (j : ℕ) : amplitude (d.cs j) ≤ 1 :=
  (d.amplitude_le_eighth j).trans (by norm_num)

/- ## Actual bounded-continuous kernel limits and shrinking tails -/

/-- Actual limits of the assembled finite prefixes, with the norm-one interface
used by the process results.  The sharper norm `1/8` is also proved below. -/
noncomputable def kernels : KernelLimit d.cs 1 :=
  Classical.choice (nonempty_kernelLimit d.cs d.prefix_succ d.amplitude_le_one)

noncomputable def K : Correction := d.kernels.K
noncomputable def H : Correction := d.kernels.H

theorem tendsto_forward : Tendsto (fun j ↦ forward (d.cs j) 0) atTop (𝓝 d.K) :=
  d.kernels.tendsto_forward

theorem tendsto_inverse : Tendsto (fun j ↦ inverseKernel (d.cs j)) atTop (𝓝 d.H) :=
  d.kernels.tendsto_inverse

theorem norm_K_le_one : ‖d.K‖ ≤ 1 := d.kernels.norm_K_le

theorem norm_H_le_one : ‖d.H‖ ≤ 1 := d.kernels.norm_H_le

theorem norm_K_le_eighth : ‖d.K‖ ≤ 1 / 8 :=
  le_of_tendsto' d.tendsto_forward.norm fun j ↦
    (forward_zero_norm_le_amplitude (d.cs j)).trans (d.amplitude_le_eighth j)

theorem norm_H_le_eighth : ‖d.H‖ ≤ 1 / 8 :=
  le_of_tendsto' d.tendsto_inverse.norm fun j ↦
    (inverseKernel_norm_le_amplitude (d.cs j)).trans (d.amplitude_le_eighth j)

theorem odd_K : Function.Odd (d.K : Past → ℝ) := d.kernels.odd_K

theorem odd_H : Function.Odd (d.H : Past → ℝ) := d.kernels.odd_H

/-- The finite reconstruction identities pass to these actual limits. -/
theorem reconstruct (x : Past) :
    factor d.K x + d.H (dropPast 1 (Controller.factorHistory d.K x)) = x 0 :=
  d.kernels.reconstruct x

theorem leftInverse :
    Function.LeftInverse (Controller.factorHistory d.H) (Controller.factorHistory d.K) :=
  d.kernels.leftInverse

/-- Prefix norm bounds plus telescoping increments, followed by a limit.
This also applies to any independently instantiated kernel limit of `d.cs`. -/
theorem inverse_tail_of_tendsto {H' : Correction}
    (hH : Tendsto (fun k ↦ inverseKernel (d.cs k)) atTop (𝓝 H')) (j : ℕ) :
    ‖H' - inverseKernel (d.cs j)‖ ≤ 2 * d.r j := by
  apply le_of_tendsto (hH.sub tendsto_const_nhds).norm
  refine eventually_atTop.mpr ⟨j, fun k hjk ↦ ?_⟩
  exact (inverseKernel_norm_sub_le_of_isPrefix (d.prefix_of_le hjk)).trans
    (d.amplitude_sub_le hjk)

/-- The forward limit obeys exactly the same quantitative tail estimate. -/
theorem forward_tail_of_tendsto {K' : Correction}
    (hK : Tendsto (fun k ↦ forward (d.cs k) 0) atTop (𝓝 K')) (j : ℕ) :
    ‖K' - forward (d.cs j) 0‖ ≤ 2 * d.r j := by
  apply le_of_tendsto (hK.sub tendsto_const_nhds).norm
  refine eventually_atTop.mpr ⟨j, fun k hjk ↦ ?_⟩
  exact (forward_norm_sub_le_of_isPrefix (d.prefix_of_le hjk) 0).trans
    (d.amplitude_sub_le hjk)

/-- The stage-`j` inverse is `inverseKernel (cs (j+1))`, not `cs j`. -/
theorem inverse_tail (j : ℕ) : ‖d.H - d.inverseStage j‖ ≤ 2 * d.r (j + 1) :=
  d.inverse_tail_of_tendsto d.tendsto_inverse (j + 1)

theorem forward_tail (j : ℕ) : ‖d.K - d.forwardStage j‖ ≤ 2 * d.r (j + 1) :=
  d.forward_tail_of_tendsto d.tendsto_forward (j + 1)

theorem inverse_tail_pointwise (j : ℕ) (x : Past) :
    |d.H x - d.inverseStage j x| ≤ 2 * d.r (j + 1) := by
  have h := (d.H - d.inverseStage j).norm_coe_le_norm x
  simpa only [BoundedContinuousFunction.sub_apply, Real.norm_eq_abs] using
    h.trans (d.inverse_tail j)

theorem forward_tail_pointwise (j : ℕ) (x : Past) :
    |d.K x - d.forwardStage j x| ≤ 2 * d.r (j + 1) := by
  have h := (d.K - d.forwardStage j).norm_coe_le_norm x
  simpa only [BoundedContinuousFunction.sub_apply, Real.norm_eq_abs] using
    h.trans (d.forward_tail j)

/-- Both finite-law and kernel errors use the same post-burn-in budget. -/
theorem scaled_budget_le (j : ℕ) :
    ((d.T j + d.n j + 1 : ℕ) : ℝ) * d.r (j + 1) ≤ error j / 16 := by
  have h := (le_div_iff₀ (show 0 < 16 * ((d.T j + d.n j + 1 : ℕ) : ℝ) by positivity)).1
    (d.r_small j)
  nlinarith only [h]

/-- The two `2*r(j+1)` errors over a block including burn-in, together with
the `ε/2` forgetting allowance, fit strictly inside the stage error budget. -/
theorem combined_error_le (j : ℕ) :
    ((d.T j + d.n j : ℕ) : ℝ) * (2 * d.r (j + 1) + 2 * d.r (j + 1)) + error j / 2 ≤
      error j := by
  have h := d.scaled_budget_le j
  have hr := d.r_pos (j + 1)
  have he := error_pos j
  push_cast at h ⊢
  nlinarith

/-- A variation certificate for the actual inverse limit, including the
universal square-sum constant. -/
theorem variation_certificate :
    (∀ m, 0 ≤ limitProfile d.cs m) ∧
      HasVariationMajorant d.H (limitProfile d.cs) ∧
      Summable (fun m ↦ limitProfile d.cs m ^ 2) ∧
      (∑' m, limitProfile d.cs m ^ 2) ≤ 24 := by
  simpa only [mul_one] using
    d.kernels.variation_certificate d.prefix_succ d.doubling d.cost_le_one d.amplitude_le_one

theorem hasVariationMajorant : HasVariationMajorant d.H (limitProfile d.cs) :=
  d.variation_certificate.2.1

theorem summable_variation_sq : Summable (fun m ↦ limitProfile d.cs m ^ 2) :=
  d.variation_certificate.2.2.1

/- ## Useful consequences for the subsequent process comparison -/

/-- At the selected observation time, the newly selected spike supplies a
quantitative lower variance scale for the **final** process. -/
theorem selected_variance_lower (j : ℕ) :
    (d.n j : ℝ) * error j / 8 ≤
      variance (sumProcess (factor d.K) (d.n j)) (iidLaw ℤ d.noise) := by
  have ht : error j / 2 ≤ spikeTailEnergy d.noise (16 * (d.n j : ℝ)) := by
    simpa only [geometricSpikeEnergy_p, NNReal.coe_pow, NNReal.coe_div,
      NNReal.coe_one, NNReal.coe_ofNat, error] using
      spikeTailEnergy_forSizes_ge geometricSpikeEnergy d.Q d.one_le_Q j (d.large_Q j)
  have hv := variance_sumProcess_factor_ge_tailEnergy_16n d.noise d.K d.noise_memLp
    d.noise_symmetric d.norm_K_le_one (d.n j) (d.one_le_n j)
  have hm := mul_le_mul_of_nonneg_left ht (Nat.cast_nonneg (d.n j) : (0 : ℝ) ≤ d.n j)
  nlinarith only [hm, hv]

/-- Full-sequence variance divergence is inherited from the proved geometric
spike theorem; no weak-convergence assertion is used here. -/
theorem variance_tendsto_atTop :
    Tendsto (fun n : ℕ ↦ variance (sumProcess (factor d.K) n) (iidLaw ℤ d.noise)) atTop atTop :=
  tendsto_variance_sumProcess_factor_geometricSpikeNoise d.Q d.one_le_Q d.growth_Q d.K
    d.norm_K_le_one

end Construction

/-- **Complete existence interface.** The record contains every finite-stage
choice and certificate, and the actual `KernelLimit` supplies odd bounded
kernels and reconstruction.  The additional conjuncts are the shrinking
post-stage tails and the square-variation certificate. -/
theorem exists_diagonal : ∃ d : Construction, ∃ L : KernelLimit d.cs 1,
    (∀ j, ‖L.H - inverseKernel (d.cs (j + 1))‖ ≤ 2 * d.r (j + 1)) ∧
    (∀ j, ‖L.K - forward (d.cs (j + 1)) 0‖ ≤ 2 * d.r (j + 1)) ∧
    HasVariationMajorant L.H (limitProfile d.cs) ∧
    Summable (fun m ↦ limitProfile d.cs m ^ 2) ∧
    (∑' m, limitProfile d.cs m ^ 2) ≤ 24 :=
  ⟨construction, construction.kernels, construction.inverse_tail, construction.forward_tail,
    construction.hasVariationMajorant, construction.summable_variation_sq,
    construction.variation_certificate.2.2.2⟩

end Cascade.Diagonal
end


/- Supporting development: Cascade.CausalLaw -/
section
set_option autoImplicit false

/-
# The finite conditional law of an actual causal factor

The past at a cut `t` ends at `t - 1`, and future blocks are chronological,
starting at `t`.  An everywhere strict-past inverse identity identifies the
actual factor on a two-sided iid innovation space with the deterministic
recursion driven by the future innovations.  Its joint law with the entire
raw past is a composition-product with `pathKernel`.

No latent decomposition of an actual innovation is chosen.  The Gaussian
convolution is used only to identify the one-step observation law.
-/

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal BoundedContinuousFunction

namespace Cascade.CausalLaw

/-- The output past determined by a raw innovation past (both newest first). -/
def observedPastFromRaw (K : Correction) : Past → Past := Controller.factorHistory K

@[fun_prop] theorem measurable_observedPastFromRaw (K : Correction) :
    Measurable (observedPastFromRaw K) :=
  measurable_pi_lambda _ fun k => (measurable_factor K).comp (measurable_dropPast k)

@[simp] theorem observedPastFromRaw_apply (K : Correction) (p : Past) (k : ℕ) :
    observedPastFromRaw K p k = factor K (dropPast k p) := rfl

/-- A chronological block of actual outputs, with arbitrary integer start time. -/
def outputBlock (K : Correction) (t : ℤ) (n : ℕ) (ω : NoisePath) : Fin n → ℝ :=
  fun i => atTime (factor K) (t + (i : ℕ)) ω

/-- The corresponding chronological block of actual innovations. -/
def noiseBlock (t : ℤ) (n : ℕ) (ω : NoisePath) : Fin n → ℝ :=
  fun i => ω (t + (i : ℕ))

@[simp] theorem outputBlock_zero_start (K : Correction) (n : ℕ) (ω : NoisePath) :
    outputBlock K 0 n ω = fun i : Fin n => atTime (factor K) (i : ℕ) ω := by
  funext i
  simp only [outputBlock, zero_add]

@[simp] theorem noiseBlock_zero_start (n : ℕ) (ω : NoisePath) :
    noiseBlock 0 n ω = fun i : Fin n => ω (i : ℕ) := by
  funext i
  simp only [noiseBlock, zero_add]

/-- Indexing a block after `N` initial outputs shifts its start by exactly `N`.
This works with the chronological suffix maps used by finite-path forgetting. -/
theorem outputBlock_addNat (K : Correction) (t : ℤ) (N T : ℕ) (ω : NoisePath) (i : Fin T) :
    outputBlock K t (T + N) ω (i.addNat N) = outputBlock K (t + (N : ℤ)) T ω i := by
  simp only [outputBlock, Fin.val_addNat, Nat.cast_add]
  exact congrArg (fun s : ℤ => atTime (factor K) s ω) (by omega)

@[fun_prop] theorem measurable_outputBlock (K : Correction) (t : ℤ) (n : ℕ) :
    Measurable (outputBlock K t n) :=
  measurable_pi_lambda _ fun i => measurable_atTime (measurable_factor K) (t + (i : ℕ))

@[fun_prop] theorem measurable_noiseBlock (t : ℤ) (n : ℕ) :
    Measurable (noiseBlock t n) := measurable_reindex _

@[simp] theorem observedPastFromRaw_dropPast (K : Correction) (k : ℕ) (p : Past) :
    observedPastFromRaw K (dropPast k p) = dropPast k (observedPastFromRaw K p) := by
  ext j
  simp only [observedPastFromRaw_apply, dropPast, dropPast_dropPast]

/-- The encoded output past really consists of the outputs at the indicated times. -/
@[simp] theorem observedPastFromRaw_history (K : Correction) (t : ℤ) (ω : NoisePath)
    (k : ℕ) :
    observedPastFromRaw K (history t ω) k = atTime (factor K) (t - (k : ℤ)) ω := by
  simp only [observedPastFromRaw_apply, dropPast_history, atTime]

/-- The hypothesis needed for the causal-law bridge.  It is pointwise on all
histories, not merely almost everywhere for one chosen innovation law. -/
def IsCausalInverse (K : Correction) (H : Past → ℝ) : Prop :=
  ∀ x : Past, factor K x + H (dropPast 1 (Controller.factorHistory K x)) = x 0

/-- Every finite cascade from the zero correction has the required inverse. -/
theorem isCausalInverse_finiteCascade (cs : List Controller.Params) :
    IsCausalInverse (InverseCascade.forward cs 0) (InverseCascade.inverseKernel cs) :=
  InverseCascade.reconstruct_current cs

/-- The actual innovation at time `t` gives exactly the next observed output. -/
theorem actual_step {K : Correction} {H : Past → ℝ} (hInv : IsCausalInverse K H)
    (t : ℤ) (ω : NoisePath) :
    atTime (factor K) t ω = ω t - H (observedPastFromRaw K (history (t - 1) ω)) := by
  have h := hInv (history t ω)
  change factor K (history t ω) + H (dropPast 1 (observedPastFromRaw K (history t ω))) =
    history t ω 0 at h
  rw [← observedPastFromRaw_dropPast, dropPast_history] at h
  simpa only [Nat.cast_one, history, Nat.cast_zero, sub_zero, atTime] using
    eq_sub_iff_add_eq.mpr h

/-- Appending the actual next output updates the encoded observed past. -/
theorem prepend_actual (K : Correction) (t : ℤ) (ω : NoisePath) :
    prepend (atTime (factor K) t ω) (observedPastFromRaw K (history (t - 1) ω)) =
      observedPastFromRaw K (history t ω) := by
  ext k
  cases k with
  | zero => simp [atTime]
  | succ k =>
      simp only [prepend_succ, observedPastFromRaw_history, Nat.cast_add, Nat.cast_one]
      exact congrArg (fun s : ℤ => atTime (factor K) s ω) (by omega)

section IndependentInnovations

variable (ν : Measure ℝ) [IsProbabilityMeasure ν]

/-- Disjoint sets of iid coordinates give independent, possibly infinite, blocks. -/
theorem indepFun_iid_reindex {I A B : Type*} (r : A → I) (s : B → I)
    (hrs : Disjoint (Set.range r) (Set.range s)) :
    IndepFun (fun (ω : I → ℝ) a => ω (r a)) (fun (ω : I → ℝ) b => ω (s b))
      (iidLaw I ν) := by
  have hind := indep_iSup_of_disjoint
    (fun i : I => (measurable_pi_apply i (X := fun _ : I => ℝ)).comap_le)
    (iIndepFun_iid ν I).iIndep hrs
  rw [IndepFun_iff_Indep]
  apply indep_of_indep_of_le_right (indep_of_indep_of_le_left hind ?_) ?_
  all_goals
    simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup,
      MeasurableSpace.comap_comp, Function.comp_def]
    exact iSup_le fun c => le_iSup_of_le _ (le_iSup_of_le ⟨c, rfl⟩ le_rfl)

/-- Splitting an iid function on a sum index gives the product of its two iid laws. -/
theorem measurePreserving_iid_sum_split (A B : Type*) :
    MeasurePreserving
      (fun ω : A ⊕ B → ℝ => ((fun a => ω (.inl a)), (fun b => ω (.inr b))))
      (iidLaw (A ⊕ B) ν) ((iidLaw A ν).prod (iidLaw B ν)) where
  measurable := (measurable_reindex Sum.inl).prodMk (measurable_reindex Sum.inr)
  map_eq := by
    have hi := indepFun_iid_reindex ν (Sum.inl : A → A ⊕ B) Sum.inr (by
      rw [Set.disjoint_left]
      rintro _ ⟨a, rfl⟩ ⟨b, h⟩
      cases h)
    have h := (indepFun_iff_map_prod_eq_prod_map_map
      (measurable_reindex (Sum.inl : A → A ⊕ B)).aemeasurable
      (measurable_reindex (Sum.inr : B → A ⊕ B)).aemeasurable).mp hi
    simpa only [iidLaw_map_reindex ν Sum.inl Sum.inl_injective,
      iidLaw_map_reindex ν Sum.inr Sum.inr_injective] using h

/-- The entire raw past and any finite future innovation block are independent,
with exactly the stated product law.  In particular this includes `n = 0`. -/
theorem measurePreserving_rawPast_noiseBlock (t : ℤ) (n : ℕ) :
    MeasurePreserving (fun ω => (history (t - 1) ω, noiseBlock t n ω))
      (iidLaw ℤ ν) ((iidLaw ℕ ν).prod (iidLaw (Fin n) ν)) := by
  let r : ℕ ⊕ Fin n → ℤ := Sum.elim (fun k => t - 1 - (k : ℤ)) (fun i => t + (i : ℕ))
  have hr : Function.Injective r := by
    intro a b hab
    cases a with
    | inl a =>
        cases b with
        | inl b => congr 1; change t - 1 - (a : ℤ) = t - 1 - (b : ℤ) at hab; omega
        | inr b => change t - 1 - (a : ℤ) = t + (b : ℕ) at hab; omega
    | inr a =>
        cases b with
        | inl b => change t + (a : ℕ) = t - 1 - (b : ℤ) at hab; omega
        | inr b =>
            congr 1
            apply Fin.ext
            change t + (a : ℕ) = t + (b : ℕ) at hab
            omega
  exact (measurePreserving_iid_sum_split ν ℕ (Fin n)).comp
    (measurePreserving_iid_reindex ν r hr)

/-- The measure form of the raw-past/future-innovation independence statement. -/
theorem iidLaw_map_rawPast_noiseBlock (t : ℤ) (n : ℕ) :
    (iidLaw ℤ ν).map (fun ω => (history (t - 1) ω, noiseBlock t n ω)) =
      (iidLaw ℕ ν).prod (iidLaw (Fin n) ν) :=
  (measurePreserving_rawPast_noiseBlock ν t n).map_eq

/-- Separate the first of a finite iid block from its chronological tail. -/
theorem measurePreserving_iid_fin_succ (n : ℕ) :
    MeasurePreserving (fun w : Fin (n + 1) → ℝ => (w 0, fun i : Fin n => w i.succ))
      (iidLaw (Fin (n + 1)) ν) (ν.prod (iidLaw (Fin n) ν)) := by
  simpa only [iidLaw, Measure.infinitePi_eq_pi, MeasurableEquiv.piFinSuccAbove_apply,
    Fin.succAbove_zero] using
    (measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => ν) 0)

end IndependentInnovations

/-- Internal recursive-product representation of the deterministic observed recursion. -/
def recursionPath (H : Past → ℝ) : (n : ℕ) → Past → (Fin n → ℝ) → FinitePath ℝ n
  | 0, _, _ => ()
  | n + 1, x, w =>
      let z := w 0 - H x
      (z, recursionPath H n (prepend z x) (fun i => w i.succ))

/-- The observed recursion driven by an ordinary chronological innovation block. -/
def observedRecursion (H : Past → ℝ) (n : ℕ) (x : Past) (w : Fin n → ℝ) : Fin n → ℝ :=
  FinitePath.toFn n (recursionPath H n x w)

@[fun_prop] theorem measurable_recursionPath {H : Past → ℝ} (hH : Measurable H) (n : ℕ) :
    Measurable (fun p : Past × (Fin n → ℝ) => recursionPath H n p.1 p.2) := by
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
      have hz : Measurable (fun p : Past × (Fin (n + 1) → ℝ) => p.2 0 - H p.1) :=
        ((measurable_pi_apply 0).comp measurable_snd).sub (hH.comp measurable_fst)
      exact hz.prodMk (ih.comp
        ((measurable_prepend.comp (hz.prodMk measurable_fst)).prodMk
          (measurable_pi_lambda _ fun i => (measurable_pi_apply i.succ).comp measurable_snd)))

@[fun_prop] theorem measurable_observedRecursion {H : Past → ℝ} (hH : Measurable H) (n : ℕ) :
    Measurable (fun p : Past × (Fin n → ℝ) => observedRecursion H n p.1 p.2) :=
  (FinitePath.measurable_toFn n).comp (measurable_recursionPath hH n)

@[fun_prop] theorem measurable_recursionPath_fixed {H : Past → ℝ} (hH : Measurable H)
    (n : ℕ) (x : Past) : Measurable (recursionPath H n x) :=
  (measurable_recursionPath hH n).comp (measurable_const.prodMk measurable_id)

@[fun_prop] theorem measurable_observedRecursion_fixed {H : Past → ℝ} (hH : Measurable H)
    (n : ℕ) (x : Past) : Measurable (observedRecursion H n x) :=
  (measurable_observedRecursion hH n).comp (measurable_const.prodMk measurable_id)

/-- Deterministic recursion agrees everywhere with the actual factor outputs. -/
theorem recursionPath_actual {K : Correction} {H : Past → ℝ} (hInv : IsCausalInverse K H)
    (n : ℕ) (t : ℤ) (ω : NoisePath) :
    recursionPath H n (observedPastFromRaw K (history (t - 1) ω)) (noiseBlock t n ω) =
      FinitePath.ofFn n (outputBlock K t n ω) := by
  induction n generalizing t with
  | zero => rfl
  | succ n ih =>
      have hz : noiseBlock t (n + 1) ω 0 - H (observedPastFromRaw K (history (t - 1) ω)) =
          atTime (factor K) t ω := by
        simpa only [noiseBlock, Fin.val_zero, Nat.cast_zero, add_zero] using
          (actual_step hInv t ω).symm
      have hw : (fun i : Fin n => noiseBlock t (n + 1) ω i.succ) = noiseBlock (t + 1) n ω := by
        ext i
        simp only [noiseBlock, Fin.val_succ, Nat.cast_add, Nat.cast_one]
        congr 1
        omega
      have hx : (fun i : Fin n => outputBlock K t (n + 1) ω i.succ) =
          outputBlock K (t + 1) n ω := by
        ext i
        simp only [outputBlock, Fin.val_succ, Nat.cast_add, Nat.cast_one]
        exact congrArg (fun s : ℤ => atTime (factor K) s ω) (by omega)
      simp only [recursionPath, hz, prepend_actual, hw, FinitePath.ofFn]
      rw [hx]
      apply Prod.ext
      · simp only [outputBlock, Fin.val_zero, Nat.cast_zero, add_zero]
      · simpa only [add_sub_cancel_right] using ih (t + 1)

/-- Public, `Fin n`-indexed form of the pathwise bridge. -/
theorem observedRecursion_actual {K : Correction} {H : Past → ℝ} (hInv : IsCausalInverse K H)
    (n : ℕ) (t : ℤ) (ω : NoisePath) :
    observedRecursion H n (observedPastFromRaw K (history (t - 1) ω)) (noiseBlock t n ω) =
      outputBlock K t n ω := by
  rw [observedRecursion, recursionPath_actual hInv, FinitePath.toFn_ofFn]

section RecursionLaw

/-- The deterministic recursion driven by iid innovations has the corresponding
finite Markov path law.  This lemma does not assume Gaussian innovations. -/
theorem recursionPath_map_iid (H : Past → ℝ) (hH : Measurable H)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (κ : Kernel Past ℝ) [IsMarkovKernel κ]
    (hκ : ∀ x, κ x = ν.map (fun z => z - H x)) (n : ℕ) (x : Past) :
    (iidLaw (Fin n) ν).map (recursionPath H n x) =
      finitePathKernel κ observedUpdate measurable_observedUpdate n x := by
  induction n generalizing x with
  | zero =>
      change (iidLaw (Fin 0) ν).map (fun _ => ()) = Measure.dirac ()
      simp only [Measure.map_const, measure_univ, one_smul]
  | succ n ih =>
      refine Measure.ext_of_lintegral _ fun f hf => ?_
      rw [lintegral_map hf
        (measurable_recursionPath_fixed hH (n + 1) x)]
      have hF : Measurable (fun p : ℝ × (Fin n → ℝ) =>
          f (p.1 - H x, recursionPath H n (prepend (p.1 - H x) x) p.2)) :=
        hf.comp ((measurable_fst.sub_const (H x)).prodMk
          ((measurable_recursionPath hH n).comp
            ((measurable_prepend.comp ((measurable_fst.sub_const (H x)).prodMk
              measurable_const)).prodMk measurable_snd)))
      have hG : Measurable (fun z : ℝ =>
          ∫⁻ p, f (z, p) ∂finitePathKernel κ observedUpdate measurable_observedUpdate n
            (prepend z x)) :=
        hf.lintegral_kernel_prod_right'
          (κ := finiteContinuationKernel κ observedUpdate measurable_observedUpdate n x)
      calc
        (∫⁻ w, f (recursionPath H (n + 1) x w) ∂iidLaw (Fin (n + 1)) ν) =
            ∫⁻ p : ℝ × (Fin n → ℝ),
              f (p.1 - H x, recursionPath H n (prepend (p.1 - H x) x) p.2)
                ∂ν.prod (iidLaw (Fin n) ν) :=
          (measurePreserving_iid_fin_succ ν n).lintegral_comp hF
        _ = ∫⁻ z, ∫⁻ w,
              f (z - H x, recursionPath H n (prepend (z - H x) x) w)
                ∂iidLaw (Fin n) ν ∂ν := lintegral_prod _ hF.aemeasurable
        _ = ∫⁻ z, ∫⁻ p, f (z - H x, p)
              ∂finitePathKernel κ observedUpdate measurable_observedUpdate n
                (prepend (z - H x) x) ∂ν := by
          apply lintegral_congr
          intro z
          have hfz : Measurable (fun p : FinitePath ℝ n => f (z - H x, p)) :=
            hf.comp measurable_prodMk_left
          rw [← lintegral_map hfz
            (measurable_recursionPath_fixed hH n (prepend (z - H x) x)), ih]
        _ = ∫⁻ z, ∫⁻ p, f (z, p)
              ∂finitePathKernel κ observedUpdate measurable_observedUpdate n (prepend z x)
                ∂κ x := by
          rw [hκ x]
          exact (lintegral_map hG (measurable_id.sub_const (H x))).symm
        _ = ∫⁻ p, f p ∂finitePathKernel κ observedUpdate measurable_observedUpdate (n + 1) x :=
          (lintegral_finitePathKernel_succ κ observedUpdate measurable_observedUpdate n x hf).symm

/-- The observed one-step law is just the innovation convolution translated
by the negative drift.  Latent variables need not exist on the actual path space. -/
theorem observedStepLaw_eq_map_gaussianConvolution (J : Measure ℝ) [IsProbabilityMeasure J]
    (b : ℝ) : observedStepLaw J b = (gaussianConvolution J).map (fun z => z - b) := by
  rw [observedStepLaw, augmentedStepLaw, gaussianConvolution_eq_map_prod_swap,
    Measure.map_map measurable_snd (measurable_augmentedStepMap b),
    Measure.map_map (by fun_prop : Measurable (fun z : ℝ => z - b))
      (by fun_prop : Measurable (fun p : ℝ × ℝ => p.1 + p.2))]
  rfl

/-- The public finite-path law is the pushforward of an ordinary finite iid
block by the deterministic recursion. -/
theorem observedRecursion_map_iid (H : Past → ℝ) (hH : Measurable H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (n : ℕ) (x : Past) :
    (iidLaw (Fin n) (gaussianConvolution J)).map (observedRecursion H n x) =
      pathLaw H hH J n x := by
  rw [pathLaw_eq_observed_finitePathKernel,
    ← recursionPath_map_iid H hH (gaussianConvolution J) (observedStepKernel H hH J)
      (fun x => by rw [observedStepKernel_apply, observedStepLaw_eq_map_gaussianConvolution]),
    Measure.map_map (FinitePath.measurable_toFn n)
      (measurable_recursionPath_fixed hH n x)]
  rfl

end RecursionLaw

section JointLaw

/-- A jointly measurable deterministic transformation of an independent input
has the composition-product of its pointwise pushforward laws. -/
theorem map_prod_eq_compProd {A B C : Type*}
    [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C]
    (μ : Measure A) [SFinite μ] (ν : Measure B) [SFinite ν]
    (f : A × B → C) (hf : Measurable f) (κ : Kernel A C) [IsSFiniteKernel κ]
    (hκ : ∀ a, ν.map (fun b => f (a, b)) = κ a) :
    (μ.prod ν).map (fun p => (p.1, f p)) = μ ⊗ₘ κ := by
  refine Measure.ext_of_lintegral _ fun g hg => ?_
  have hgf : Measurable (fun p : A × B => g (p.1, f p)) :=
    hg.comp (measurable_fst.prodMk hf)
  rw [lintegral_map hg (measurable_fst.prodMk hf),
    lintegral_prod _ hgf.aemeasurable, Measure.lintegral_compProd hg]
  apply lintegral_congr
  intro a
  rw [← hκ a]
  exact (lintegral_map (show Measurable (fun c => g (a, c)) from
    hg.comp measurable_prodMk_left) (hf.comp measurable_prodMk_left)).symm

/-- Composing with a pulled-back kernel is the same as pushing forward the
mixing measure. -/
theorem comap_comp_eq_comp_map {A B C : Type*}
    [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C]
    (μ : Measure A) (g : A → B) (hg : Measurable g) (κ : Kernel B C) :
    (κ.comap g hg) ∘ₘ μ = κ ∘ₘ (μ.map g) := by
  rw [← Measure.deterministic_comp_eq_map hg, Measure.comp_assoc,
    Kernel.comp_deterministic_eq_comap]

/-- A change of the retained mixing parameter in a composition-product. -/
theorem map_compProd_comap {A B C : Type*}
    [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C]
    (μ : Measure A) [IsFiniteMeasure μ] (g : A → B) (hg : Measurable g)
    (κ : Kernel B C) [IsSFiniteKernel κ] :
    (μ ⊗ₘ κ.comap g hg).map (Prod.map g id) = (μ.map g) ⊗ₘ κ := by
  refine Measure.ext_of_lintegral _ fun f hf => ?_
  have hfg : Measurable (fun p : A × C => f (Prod.map g id p)) :=
    hf.comp (hg.prodMap measurable_id)
  rw [lintegral_map hf (hg.prodMap measurable_id),
    Measure.lintegral_compProd hfg,
    Measure.lintegral_compProd hf,
    lintegral_map (hf.lintegral_kernel_prod_right' (κ := κ)) hg]
  rfl

/-- Conditional finite-output kernel indexed by the *raw* past. -/
noncomputable def rawPastPathKernel (K : Correction) (H : Past → ℝ) (hH : Measurable H)
    (J : Measure ℝ) (n : ℕ) : Kernel Past (Fin n → ℝ) :=
  (pathKernel H hH J n).comap (observedPastFromRaw K) (measurable_observedPastFromRaw K)

instance isMarkovKernel_rawPastPathKernel (K : Correction) (H : Past → ℝ) (hH : Measurable H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (n : ℕ) :
    IsMarkovKernel (rawPastPathKernel K H hH J n) := by
  unfold rawPastPathKernel
  infer_instance

@[simp] theorem rawPastPathKernel_apply (K : Correction) (H : Past → ℝ) (hH : Measurable H)
    (J : Measure ℝ) (n : ℕ) (p : Past) :
    rawPastPathKernel K H hH J n p = pathLaw H hH J n (observedPastFromRaw K p) := rfl

/-- Main causal-law identity.  The whole raw past is retained, so this is a
strong finite conditional-law statement, not just equality of future marginals. -/
theorem jointLaw_eq_compProd {K : Correction} {H : Past → ℝ} (hH : Measurable H)
    (hInv : IsCausalInverse K H) (J : Measure ℝ) [IsProbabilityMeasure J]
    (t : ℤ) (n : ℕ) :
    (iidLaw ℤ (gaussianConvolution J)).map
        (fun ω => (history (t - 1) ω, outputBlock K t n ω)) =
      (iidLaw ℕ (gaussianConvolution J)) ⊗ₘ rawPastPathKernel K H hH J n := by
  let f : Past × (Fin n → ℝ) → (Fin n → ℝ) :=
    fun p => observedRecursion H n (observedPastFromRaw K p.1) p.2
  have hf : Measurable f := (measurable_observedRecursion hH n).comp
    (((measurable_observedPastFromRaw K).comp measurable_fst).prodMk measurable_snd)
  have h := map_prod_eq_compProd (iidLaw ℕ (gaussianConvolution J))
    (iidLaw (Fin n) (gaussianConvolution J)) f hf (rawPastPathKernel K H hH J n)
    (fun p => observedRecursion_map_iid H hH J n (observedPastFromRaw K p))
  rw [← iidLaw_map_rawPast_noiseBlock (gaussianConvolution J) t n,
    Measure.map_map (measurable_fst.prodMk hf)
      ((measurable_history (t - 1)).prodMk (measurable_noiseBlock t n))] at h
  convert h using 1
  congr 1
  funext ω
  exact Prod.ext rfl (observedRecursion_actual hInv n t ω).symm

/-- Measure-preserving packaging of the main identity, convenient for tests. -/
theorem measurePreserving_rawPast_outputBlock {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ) :
    MeasurePreserving (fun ω => (history (t - 1) ω, outputBlock K t n ω))
      (iidLaw ℤ (gaussianConvolution J))
      ((iidLaw ℕ (gaussianConvolution J)) ⊗ₘ rawPastPathKernel K H hH J n) :=
  ⟨(measurable_history (t - 1)).prodMk (measurable_outputBlock K t n),
    jointLaw_eq_compProd hH hInv J t n⟩

/-- All nonnegative measurable joint tests satisfy the iterated integral identity. -/
theorem lintegral_rawPast_outputBlock {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ)
    {f : Past × (Fin n → ℝ) → ℝ≥0∞} (hf : Measurable f) :
    (∫⁻ ω, f (history (t - 1) ω, outputBlock K t n ω) ∂iidLaw ℤ (gaussianConvolution J)) =
      ∫⁻ p, ∫⁻ y, f (p, y) ∂pathLaw H hH J n (observedPastFromRaw K p)
        ∂iidLaw ℕ (gaussianConvolution J) :=
  ((measurePreserving_rawPast_outputBlock hH hInv J t n).lintegral_comp hf).trans
    (Measure.lintegral_compProd hf)

/-- Integrable joint tests: the real-valued version of the conditional-law identity. -/
theorem integral_rawPast_outputBlock_of_integrable {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ)
    {f : Past × (Fin n → ℝ) → ℝ} (hf : Measurable f)
    (hfi : Integrable f ((iidLaw ℕ (gaussianConvolution J)) ⊗ₘ rawPastPathKernel K H hH J n)) :
    (∫ ω, f (history (t - 1) ω, outputBlock K t n ω) ∂iidLaw ℤ (gaussianConvolution J)) =
      ∫ p, ∫ y, f (p, y) ∂pathLaw H hH J n (observedPastFromRaw K p)
        ∂iidLaw ℕ (gaussianConvolution J) := by
  rw [← integral_map
    ((measurable_history (t - 1)).prodMk (measurable_outputBlock K t n)).aemeasurable
    hf.aestronglyMeasurable, jointLaw_eq_compProd hH hInv J t n]
  exact Measure.integral_compProd hfi

/-- In particular, every bounded measurable real-valued joint test satisfies
this identity; no continuity of the test is needed. -/
theorem integral_rawPast_outputBlock {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ)
    {f : Past × (Fin n → ℝ) → ℝ} (hf : Measurable f)
    (C : ℝ) (hC : ∀ z, ‖f z‖ ≤ C) :
    (∫ ω, f (history (t - 1) ω, outputBlock K t n ω) ∂iidLaw ℤ (gaussianConvolution J)) =
      ∫ p, ∫ y, f (p, y) ∂pathLaw H hH J n (observedPastFromRaw K p)
        ∂iidLaw ℕ (gaussianConvolution J) :=
  integral_rawPast_outputBlock_of_integrable hH hInv J t n hf
    (Integrable.of_bound hf.aestronglyMeasurable C (ae_of_all _ hC))

/-- The pure future block is the mixture of the path kernel over the actual
stationary observed-past law. -/
theorem outputBlock_law {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ) :
    (iidLaw ℤ (gaussianConvolution J)).map (outputBlock K t n) =
      (pathKernel H hH J n) ∘ₘ
        ((iidLaw ℕ (gaussianConvolution J)).map (observedPastFromRaw K)) := by
  have h := congrArg Measure.snd (jointLaw_eq_compProd hH hInv J t n)
  rw [Measure.snd_map_prodMk (measurable_history (t - 1)), Measure.snd_compProd] at h
  exact h.trans (comap_comp_eq_comp_map _ _ (measurable_observedPastFromRaw K) _)

/-- One can retain the observed past instead of the raw past. -/
theorem observedPast_jointLaw_eq_compProd {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ) :
    (iidLaw ℤ (gaussianConvolution J)).map
        (fun ω => (observedPastFromRaw K (history (t - 1) ω), outputBlock K t n ω)) =
      ((iidLaw ℕ (gaussianConvolution J)).map (observedPastFromRaw K)) ⊗ₘ
        pathKernel H hH J n := by
  rw [← map_compProd_comap (iidLaw ℕ (gaussianConvolution J))
    (observedPastFromRaw K) (measurable_observedPastFromRaw K) (pathKernel H hH J n)]
  change _ = ((iidLaw ℕ (gaussianConvolution J)) ⊗ₘ rawPastPathKernel K H hH J n).map _
  rw [← jointLaw_eq_compProd hH hInv J t n,
    Measure.map_map ((measurable_observedPastFromRaw K).prodMap measurable_id)
      ((measurable_history (t - 1)).prodMk (measurable_outputBlock K t n))]
  rfl

end JointLaw

section StationaryBurnIn

/-- The actual observed-history law is independent of its integer endpoint. -/
theorem observedPast_law (K : Correction) (ν : Measure ℝ) [IsProbabilityMeasure ν] (t : ℤ) :
    (iidLaw ℤ ν).map (fun ω => observedPastFromRaw K (history t ω)) =
      (iidLaw ℕ ν).map (observedPastFromRaw K) := by
  change (iidLaw ℤ ν).map (observedPastFromRaw K ∘ history t) = _
  rw [← Measure.map_map (measurable_observedPastFromRaw K) (measurable_history t),
    iidLaw_map_history]

/-- Continuing an actual observed past along an actual block gives the actual
past at the end of that block.  No inverse assumption is needed for this identity. -/
theorem continueObservedPast_outputBlock (K : Correction) (n : ℕ) (t : ℤ) (ω : NoisePath) :
    continueObservedPast n (observedPastFromRaw K (history (t - 1) ω)) (outputBlock K t n ω) =
      observedPastFromRaw K (history (t + (n : ℤ) - 1) ω) := by
  induction n generalizing t with
  | zero => simp only [continueObservedPast_zero, Nat.cast_zero, add_zero]
  | succ n ih =>
      have hz : outputBlock K t (n + 1) ω 0 = atTime (factor K) t ω := by
        simp only [outputBlock, Fin.val_zero, Nat.cast_zero, add_zero]
      have htail : (fun i : Fin n => outputBlock K t (n + 1) ω i.succ) =
          outputBlock K (t + 1) n ω := by
        ext i
        simp only [outputBlock, Fin.val_succ, Nat.cast_add, Nat.cast_one]
        exact congrArg (fun s : ℤ => atTime (factor K) s ω) (by omega)
      rw [continueObservedPast_succ, hz, prepend_actual, htail]
      have he : t + ((n + 1 : ℕ) : ℤ) - 1 = (t + 1) + (n : ℤ) - 1 := by
        push_cast
        ring
      rw [he]
      simpa only [add_sub_cancel_right] using ih (t + 1)

/-- The stationary observed-past law is invariant under a finite block of the
path kernel followed by history continuation.  This is the stationary burn-in
identity, valid for every block length including zero. -/
theorem stationary_burnin_law {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (n : ℕ) :
    (((iidLaw ℕ (gaussianConvolution J)).map (observedPastFromRaw K)) ⊗ₘ
        pathKernel H hH J n).map (fun p => continueObservedPast n p.1 p.2) =
      (iidLaw ℕ (gaussianConvolution J)).map (observedPastFromRaw K) := by
  have hm : Measurable (fun ω =>
      (observedPastFromRaw K (history (0 - 1) ω), outputBlock K 0 n ω)) :=
    (((measurable_observedPastFromRaw K).comp (measurable_history (0 - 1))).prodMk
      (measurable_outputBlock K 0 n))
  rw [← observedPast_jointLaw_eq_compProd hH hInv J 0 n,
    Measure.map_map (measurable_continueObservedPast n) hm]
  have he : (fun p : Past × (Fin n → ℝ) => continueObservedPast n p.1 p.2) ∘
        (fun ω => (observedPastFromRaw K (history (0 - 1) ω), outputBlock K 0 n ω)) =
      fun ω => observedPastFromRaw K (history (0 + (n : ℤ) - 1) ω) :=
    funext fun ω => continueObservedPast_outputBlock K n 0 ω
  rw [he, observedPast_law]

end StationaryBurnIn

section PastMeasurability

/-- Earlier innovation histories are measurable functions of a later raw past. -/
theorem history_eq_dropPast_of_le {j t : ℤ} (hjt : j ≤ t) (ω : NoisePath) :
    history j ω = dropPast (t - j).toNat (history t ω) := by
  rw [dropPast_history, Int.toNat_of_nonneg (sub_nonneg.mpr hjt)]
  congr 1
  ring

/-- Every causal observation before a cut is measurable with respect to the
raw past at the cut.  The factor here can be any measurable history function. -/
theorem atTime_comap_le_history {F : Past → ℝ} (hF : Measurable F)
    {j t : ℤ} (hjt : j ≤ t) :
    MeasurableSpace.comap (atTime F j) inferInstance ≤
      MeasurableSpace.comap (history t) inferInstance := by
  have he : atTime F j = (F ∘ dropPast (t - j).toNat) ∘ history t := by
    funext ω
    exact congrArg F (history_eq_dropPast_of_le hjt ω)
  rw [he, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono ((hF.comp (measurable_dropPast _)).comap_le)

/-- Generated sigma-algebras of any collection of earlier output times are
contained in the raw-past sigma-algebra.  This is the usual `sigmaGen` inclusion,
written as an `iSup` so that no specification module is imported. -/
theorem past_sigma_le_history {I : Type*} {F : Past → ℝ} (hF : Measurable F)
    (time : I → ℤ) (s : Set I) (t : ℤ) (hs : ∀ i ∈ s, time i ≤ t) :
    (⨆ i ∈ s, MeasurableSpace.comap (atTime F (time i)) inferInstance) ≤
      MeasurableSpace.comap (history t) inferInstance :=
  iSup_le fun i => iSup_le fun hi => atTime_comap_le_history hF (hs i hi)

/-- In particular, the finite natural-time past through `m` factors through
`history m`. -/
theorem natPast_sigma_le_history {F : Past → ℝ} (hF : Measurable F) (m : ℕ) :
    (⨆ j ∈ Set.Iic m, MeasurableSpace.comap (atTime F (j : ℤ)) inferInstance) ≤
      MeasurableSpace.comap (history (m : ℤ)) inferInstance :=
  past_sigma_le_history hF (fun j : ℕ => (j : ℤ)) (Set.Iic m) m
    (fun j hj => by
      change (j : ℤ) ≤ (m : ℤ)
      exact_mod_cast (show j ≤ m from hj))

/-- Every event in a generated output past is the preimage of a measurable
raw-past event, with literal equality of sets rather than equality modulo null sets. -/
theorem exists_rawPast_event {I : Type*} {F : Past → ℝ} (hF : Measurable F)
    (time : I → ℤ) (s : Set I) (t : ℤ) (hs : ∀ i ∈ s, time i ≤ t)
    {A : Set NoisePath}
    (hA : MeasurableSet[⨆ i ∈ s, MeasurableSpace.comap (atTime F (time i)) inferInstance] A) :
    ∃ B : Set Past, MeasurableSet B ∧ history t ⁻¹' B = A :=
  (past_sigma_le_history hF time s t hs) A hA

end PastMeasurability

section PastEvents

/-- Exact probabilities of joint raw-past and future-output events. -/
theorem rawPast_outputBlock_event {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ)
    {A : Set Past} {B : Set (Fin n → ℝ)} (hA : MeasurableSet A) (hB : MeasurableSet B) :
    (iidLaw ℤ (gaussianConvolution J))
        (history (t - 1) ⁻¹' A ∩ outputBlock K t n ⁻¹' B) =
      ∫⁻ p in A, pathLaw H hH J n (observedPastFromRaw K p) B
        ∂iidLaw ℕ (gaussianConvolution J) := by
  have h := congrArg (fun ρ : Measure (Past × (Fin n → ℝ)) => ρ (A ×ˢ B))
    (jointLaw_eq_compProd hH hInv J t n)
  dsimp only at h
  rw [Measure.map_apply ((measurable_history (t - 1)).prodMk (measurable_outputBlock K t n))
    (hA.prod hB), Measure.compProd_apply_prod hA hB] at h
  exact h

/-- Restricting to a raw-past event restricts only the mixing measure, not the
future kernel.  This holds even for events of probability zero. -/
theorem outputBlock_restrict_rawPast_law {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ)
    {A : Set Past} (hA : MeasurableSet A) :
    ((iidLaw ℤ (gaussianConvolution J)).restrict (history (t - 1) ⁻¹' A)).map
        (outputBlock K t n) =
      (rawPastPathKernel K H hH J n) ∘ₘ ((iidLaw ℕ (gaussianConvolution J)).restrict A) := by
  ext B hB
  rw [Measure.map_apply (measurable_outputBlock K t n) hB,
    Measure.restrict_apply ((measurable_outputBlock K t n) hB),
    Measure.bind_apply hB (Kernel.aemeasurable _), Set.inter_comm]
  exact rawPast_outputBlock_event hH hInv J t n hA hB

/-- Conditional probabilities are mixtures with the conditional raw-past law.
For a positive past event the mixing law is a probability measure. -/
theorem outputBlock_cond_rawPast_law {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ)
    {A : Set Past} (hA : MeasurableSet A) :
    ((iidLaw ℤ (gaussianConvolution J))[|history (t - 1) ⁻¹' A]).map (outputBlock K t n) =
      (rawPastPathKernel K H hH J n) ∘ₘ ((iidLaw ℕ (gaussianConvolution J))[|A]) := by
  rw [ProbabilityTheory.cond, ProbabilityTheory.cond, Measure.map_smul, Measure.comp_smul,
    outputBlock_restrict_rawPast_law hH hInv J t n hA,
    (measurePreserving_history (gaussianConvolution J) (t - 1)).measure_preimage
      hA.nullMeasurableSet]

/-- Pushforward commutes with conditioning on a measurable preimage event. -/
theorem map_cond_preimage {A B : Type*} [MeasurableSpace A] [MeasurableSpace B]
    (μ : Measure A) (g : A → B) (hg : Measurable g) {s : Set B} (hs : MeasurableSet s) :
    (μ[|g ⁻¹' s]).map g = (μ.map g)[|s] := by
  rw [ProbabilityTheory.cond, ProbabilityTheory.cond, Measure.map_smul, ← Measure.restrict_map hg hs, Measure.map_apply hg hs]

/-- For every event measurable in the entire raw past, the conditional future
law is the path-kernel mixture over the actual conditional observed-past law.
Combine `natPast_sigma_le_history` with this theorem for a finite output-past event. -/
theorem outputBlock_cond_law {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ) {A : Set NoisePath}
    (hA : MeasurableSet[MeasurableSpace.comap (history (t - 1)) inferInstance] A) :
    ((iidLaw ℤ (gaussianConvolution J))[|A]).map (outputBlock K t n) =
      (pathKernel H hH J n) ∘ₘ
        (((iidLaw ℤ (gaussianConvolution J))[|A]).map
          (fun ω => observedPastFromRaw K (history (t - 1) ω))) := by
  obtain ⟨B, hB, rfl⟩ := hA
  rw [outputBlock_cond_rawPast_law hH hInv J t n hB]
  change (pathKernel H hH J n).comap (observedPastFromRaw K)
    (measurable_observedPastFromRaw K) ∘ₘ _ = _
  rw [comap_comp_eq_comp_map]
  change _ = (pathKernel H hH J n) ∘ₘ
    (((iidLaw ℤ (gaussianConvolution J))[|history (t - 1) ⁻¹' B]).map
      (observedPastFromRaw K ∘ history (t - 1)))
  rw [← Measure.map_map (measurable_observedPastFromRaw K) (measurable_history (t - 1)),
    map_cond_preimage _ _ (measurable_history (t - 1)) hB, iidLaw_map_history]

/-- The unconditional version with the raw past as mixing parameter. -/
theorem outputBlock_law_rawPast {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ) :
    (iidLaw ℤ (gaussianConvolution J)).map (outputBlock K t n) =
      (rawPastPathKernel K H hH J n) ∘ₘ iidLaw ℕ (gaussianConvolution J) := by
  simpa only [Set.preimage_univ, cond_univ] using
    outputBlock_cond_rawPast_law hH hInv J t n MeasurableSet.univ

end PastEvents

/-- The regular conditional distribution given the raw past is the same explicit
kernel, almost everywhere for the iid raw-past law.  The joint identity above
is stronger and does not depend on any chosen version of `condDistrib`. -/
theorem condDistrib_outputBlock_eq_rawPastPathKernel {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ) :
    condDistrib (outputBlock K t n) (history (t - 1)) (iidLaw ℤ (gaussianConvolution J))
      =ᵐ[iidLaw ℕ (gaussianConvolution J)] rawPastPathKernel K H hH J n := by
  have h := condDistrib_ae_eq_of_measure_eq_compProd_of_measurable
    (μ := iidLaw ℤ (gaussianConvolution J))
    (measurable_history (t - 1)) (measurable_outputBlock K t n)
    (κ := rawPastPathKernel K H hH J n)
    (by rw [iidLaw_map_history]; exact jointLaw_eq_compProd hH hInv J t n)
  simpa only [iidLaw_map_history] using h

/-- Direct finite-natural-past form of the conditional mixture identity.
The next output time after the past through `m` is `m + 1`. -/
theorem outputBlock_cond_law_of_natPast {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (m n : ℕ) {A : Set NoisePath}
    (hA : MeasurableSet[⨆ j ∈ Set.Iic m,
      MeasurableSpace.comap (atTime (factor K) (j : ℤ)) inferInstance] A) :
    ((iidLaw ℤ (gaussianConvolution J))[|A]).map (outputBlock K ((m : ℤ) + 1) n) =
      (pathKernel H hH J n) ∘ₘ
        (((iidLaw ℤ (gaussianConvolution J))[|A]).map
          (fun ω => observedPastFromRaw K (history (m : ℤ) ω))) := by
  have hA' := natPast_sigma_le_history (measurable_factor K) m A hA
  simpa only [add_sub_cancel_right] using
    outputBlock_cond_law hH hInv J ((m : ℤ) + 1) n
      (by simpa only [add_sub_cancel_right] using hA')

section DiameterTransfer

/-- An everywhere diameter bound on a kernel passes to any two probability
mixtures of that kernel, with the same error (not twice the error). -/
theorem testClose_mixtures_of_diameter {A B : Type*} [MeasurableSpace A] [MeasurableSpace B]
    (κ : Kernel A B) [IsMarkovKernel κ] {e : ℝ}
    (hdiam : ∀ x y, TestClose (κ x) (κ y) e)
    (μ ν : Measure A) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν] :
    TestClose (κ ∘ₘ μ) (κ ∘ₘ ν) e := by
  have hx (x : A) : TestClose (κ x) (κ ∘ₘ ν) e := by
    have h := TestClose.mixture (μ := ν) (κ := Kernel.const A (κ x)) (η := κ)
      (ae_of_all _ fun y => hdiam x y)
    simpa only [Measure.const_comp, measure_univ, one_smul] using h
  have h := TestClose.mixture (μ := μ) (κ := κ) (η := Kernel.const A (κ ∘ₘ ν))
    (ae_of_all _ hx)
  simpa only [Measure.const_comp, measure_univ, one_smul] using h

/-- A uniform arbitrary-past diameter estimate transfers to the actual process
conditioned on *any* positive raw-past event.  The observation `ψ` may, for
example, discard a burn-in prefix of the finite block. -/
theorem testClose_cond_outputBlock {B : Type*} [MeasurableSpace B]
    {K : Correction} {H : Past → ℝ} (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ)
    (ψ : (Fin n → ℝ) → B) (hψ : Measurable ψ) {e : ℝ}
    (hdiam : ∀ x y, TestClose ((pathLaw H hH J n x).map ψ) ((pathLaw H hH J n y).map ψ) e)
    {A : Set NoisePath}
    (hA : MeasurableSet[MeasurableSpace.comap (history (t - 1)) inferInstance] A)
    (hApos : 0 < (iidLaw ℤ (gaussianConvolution J)) A) :
    TestClose (((iidLaw ℤ (gaussianConvolution J))[|A]).map (ψ ∘ outputBlock K t n))
      ((iidLaw ℤ (gaussianConvolution J)).map (ψ ∘ outputBlock K t n)) e := by
  obtain ⟨C, hC, rfl⟩ := hA
  have hCpos : 0 < (iidLaw ℕ (gaussianConvolution J)) C := by
    rwa [(measurePreserving_history (gaussianConvolution J) (t - 1)).measure_preimage
      hC.nullMeasurableSet] at hApos
  letI : IsProbabilityMeasure ((iidLaw ℕ (gaussianConvolution J))[|C]) :=
    cond_isProbabilityMeasure hCpos.ne'
  letI : IsMarkovKernel ((rawPastPathKernel K H hH J n).map ψ) :=
    Kernel.IsMarkovKernel.map _ hψ
  rw [← Measure.map_map hψ (measurable_outputBlock K t n),
    ← Measure.map_map hψ (measurable_outputBlock K t n),
    outputBlock_cond_rawPast_law hH hInv J t n hC, outputBlock_law_rawPast hH hInv J t n,
    Measure.map_comp _ _ hψ, Measure.map_comp _ _ hψ]
  apply testClose_mixtures_of_diameter
  intro x y
  rw [Kernel.map_apply _ hψ, Kernel.map_apply _ hψ,
    rawPastPathKernel_apply, rawPastPathKernel_apply]
  exact hdiam (observedPastFromRaw K x) (observedPastFromRaw K y)

/-- Event-probability consequence of the diameter transfer. -/
theorem cond_outputBlock_event_bound {B : Type*} [MeasurableSpace B]
    {K : Correction} {H : Past → ℝ} (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (t : ℤ) (n : ℕ)
    (ψ : (Fin n → ℝ) → B) (hψ : Measurable ψ) {e : ℝ}
    (hdiam : ∀ x y, TestClose ((pathLaw H hH J n x).map ψ) ((pathLaw H hH J n y).map ψ) e)
    {A : Set NoisePath}
    (hA : MeasurableSet[MeasurableSpace.comap (history (t - 1)) inferInstance] A)
    (hApos : 0 < (iidLaw ℤ (gaussianConvolution J)) A) {s : Set B} (hs : MeasurableSet s) :
    |((iidLaw ℤ (gaussianConvolution J))[|A]).real ((ψ ∘ outputBlock K t n) ⁻¹' s) -
      (iidLaw ℤ (gaussianConvolution J)).real ((ψ ∘ outputBlock K t n) ⁻¹' s)| ≤ e := by
  have h := (testClose_cond_outputBlock hH hInv J t n ψ hψ hdiam hA hApos).event hs
  simpa only [Measure.real, Measure.map_apply (hψ.comp (measurable_outputBlock K t n)) hs] using h

/-- Natural-time finite-past version, ready for finite-future mixing estimates. -/
theorem testClose_cond_outputBlock_of_natPast {B : Type*} [MeasurableSpace B]
    {K : Correction} {H : Past → ℝ} (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (m n : ℕ)
    (ψ : (Fin n → ℝ) → B) (hψ : Measurable ψ) {e : ℝ}
    (hdiam : ∀ x y, TestClose ((pathLaw H hH J n x).map ψ) ((pathLaw H hH J n y).map ψ) e)
    {A : Set NoisePath}
    (hA : MeasurableSet[⨆ j ∈ Set.Iic m,
      MeasurableSpace.comap (atTime (factor K) (j : ℤ)) inferInstance] A)
    (hApos : 0 < (iidLaw ℤ (gaussianConvolution J)) A) :
    TestClose
      (((iidLaw ℤ (gaussianConvolution J))[|A]).map (ψ ∘ outputBlock K ((m : ℤ) + 1) n))
      ((iidLaw ℤ (gaussianConvolution J)).map (ψ ∘ outputBlock K ((m : ℤ) + 1) n)) e := by
  apply testClose_cond_outputBlock hH hInv J ((m : ℤ) + 1) n ψ hψ hdiam _ hApos
  simpa only [add_sub_cancel_right] using
    (natPast_sigma_le_history (measurable_factor K) m) A hA

end DiameterTransfer

end Cascade.CausalLaw
end


/- Supporting development: Cascade.BlockComparison -/
section
set_option autoImplicit false

/-
# Comparing actual stationary blocks after a reference burn-in

Both processes below are actual causal factors on their own two-sided iid
innovation spaces. Their innovation laws are Gaussian convolutions of `J` and
`J'`. The inverse identities hold on every history.

First perturb a finite path while keeping its entire initial observed past
fixed. Integrate this estimate over the first process's stationary past law.
Only then change the mixing law, using the reference suffix kernel's uniform
arbitrary-past diameter bound. Starting the actual path at cut `-T` makes its
suffix the block starting at zero. In particular, no assertion about absent
late spikes, or about agreement of the two initial pasts, is used.

All estimates concern bounded measurable tests. Passing to the zero-start
finite sum is a measurable pushforward, with no moment or variance assumption.
-/

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal BoundedContinuousFunction

namespace Cascade.CausalLaw

/-- Dropping a chronological prefix advances the actual block's cut. -/
theorem outputBlock_dropFirst (K : Correction) (t : ℤ) (T n : ℕ) :
    dropFirst T n ∘ outputBlock K t (n + T) = outputBlock K (t + (T : ℤ)) n := by
  funext ω i
  exact outputBlock_addNat K t T n ω i

/-- The actual zero-start block is the suffix-kernel mixture over its own
stationary observed-past law. The full path starts at cut `-T`, whose entire
past has this law; the first `T` outputs, not any past coordinates, are dropped. -/
theorem outputBlock_law_eq_suffix_mixture {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J] (T n : ℕ) :
    (iidLaw ℤ (gaussianConvolution J)).map (outputBlock K 0 n) =
      ((pathKernel H hH J (n + T)).map (dropFirst T n)) ∘ₘ
        ((iidLaw ℕ (gaussianConvolution J)).map (observedPastFromRaw K)) := by
  rw [← Measure.map_comp _ _ (measurable_dropFirst T n),
    ← outputBlock_law hH hInv J (-(T : ℤ)) (n + T),
    Measure.map_map (measurable_dropFirst T n)
      (measurable_outputBlock K (-(T : ℤ)) (n + T)), outputBlock_dropFirst]
  simp only [neg_add_cancel]

/-- Summing the chronological block starting at zero gives precisely
`sumProcess`, including the empty block. There is no time-one offset. -/
theorem outputBlock_sum_eq_sumProcess (K : Correction) (n : ℕ) (ω : NoisePath) :
    (∑ i : Fin n, outputBlock K 0 n ω i) = sumProcess (factor K) n ω := by
  simp only [outputBlock, zero_add, sumProcess]
  exact Fin.sum_univ_eq_sum_range (fun k : ℕ => atTime (factor K) (k : ℤ) ω) n

end Cascade.CausalLaw

namespace Cascade.BlockComparison

open CausalLaw

/-- The finite-coordinate sum is measurable, even though it is not bounded. -/
@[fun_prop] theorem measurable_blockSum (n : ℕ) :
    Measurable (fun p : Fin n → ℝ => ∑ i, p i) := by
  fun_prop

/-- Any comparison of actual zero-start blocks passes to their actual sums.
No probability or integrability hypothesis is needed for this pushforward. -/
theorem testClose_sumProcess_of_outputBlock {K K' : Correction} {ν ν' : Measure ℝ}
    (n : ℕ) {a : ℝ}
    (h : TestClose ((iidLaw ℤ ν).map (outputBlock K 0 n))
      ((iidLaw ℤ ν').map (outputBlock K' 0 n)) a) :
    TestClose ((iidLaw ℤ ν).map (sumProcess (factor K) n))
      ((iidLaw ℤ ν').map (sumProcess (factor K') n)) a := by
  have hh := h.map (measurable_blockSum n)
  rw [Measure.map_map (measurable_blockSum n) (measurable_outputBlock K 0 n),
    Measure.map_map (measurable_blockSum n) (measurable_outputBlock K' 0 n)] at hh
  simpa only [Function.comp_def, outputBlock_sum_eq_sumProcess] using hh

/-- The probabilistic bridge for *arbitrary* probability laws of the initial
observed past. First perturb at the same past, using `TestClose.mixture`
(which is the second marginal of `TestClose.compProd`); then change the past
law by the reference diameter bound. The burn-in error is paid only once. -/
theorem testClose_suffix_mixtures
    (H H' : Past → ℝ) (hH : Measurable H) (hH' : Measurable H')
    {J J' : Measure ℝ} [IsProbabilityMeasure J] [IsProbabilityMeasure J']
    {δ e ε : ℝ} (hcloseJ : TestClose J J' e)
    (hkernel : ∀ x, |H x - H' x| ≤ δ) (T n : ℕ)
    (hburn : ∀ x y : Past,
      TestClose ((pathLaw H' hH' J' (n + T) x).map (dropFirst T n))
        ((pathLaw H' hH' J' (n + T) y).map (dropFirst T n)) ε)
    (μ μ' : Measure Past) [IsProbabilityMeasure μ] [IsProbabilityMeasure μ'] :
    TestClose (((pathKernel H hH J (n + T)).map (dropFirst T n)) ∘ₘ μ)
      (((pathKernel H' hH' J' (n + T)).map (dropFirst T n)) ∘ₘ μ')
      (ε + ((T + n : ℕ) : ℝ) * (δ + e)) := by
  let κ := (pathKernel H hH J (n + T)).map (dropFirst T n)
  let κ' := (pathKernel H' hH' J' (n + T)).map (dropFirst T n)
  letI : IsMarkovKernel κ := Kernel.IsMarkovKernel.map _ (measurable_dropFirst T n)
  letI : IsMarkovKernel κ' := Kernel.IsMarkovKernel.map _ (measurable_dropFirst T n)
  have hpert : TestClose (κ ∘ₘ μ) (κ' ∘ₘ μ) (((n + T : ℕ) : ℝ) * (δ + e)) := by
    apply TestClose.mixture
    apply ae_of_all
    intro x
    dsimp only [κ, κ']
    rw [Kernel.map_apply _ (measurable_dropFirst T n),
      Kernel.map_apply _ (measurable_dropFirst T n)]
    exact (testClose_pathLaw_perturbation H H' hH hH' hkernel hcloseJ (n + T) x).map
      (measurable_dropFirst T n)
  have hdiam : ∀ x y, TestClose (κ' x) (κ' y) ε := by
    intro x y
    dsimp only [κ']
    rw [Kernel.map_apply _ (measurable_dropFirst T n),
      Kernel.map_apply _ (measurable_dropFirst T n)]
    exact hburn x y
  have hmix := testClose_mixtures_of_diameter κ' hdiam μ μ'
  simpa only [Nat.add_comm n T, add_comm (↑(T + n) * (δ + e)) ε] using
    hpert.triangle hmix

/-- **Actual stationary block comparison.** The two inverse identities relate
both actual factors to their respective recursions. The past distributions
may be completely different. Only the reference recursion must forget them. -/
theorem testClose_outputBlock {K K' : Correction} {H H' : Past → ℝ}
    (hH : Measurable H) (hH' : Measurable H')
    (hInv : IsCausalInverse K H) (hInv' : IsCausalInverse K' H')
    {J J' : Measure ℝ} [IsProbabilityMeasure J] [IsProbabilityMeasure J']
    {δ e ε : ℝ} (hcloseJ : TestClose J J' e)
    (hkernel : ∀ x, |H x - H' x| ≤ δ) (T n : ℕ)
    (hburn : ∀ x y : Past,
      TestClose ((pathLaw H' hH' J' (n + T) x).map (dropFirst T n))
        ((pathLaw H' hH' J' (n + T) y).map (dropFirst T n)) ε) :
    TestClose ((iidLaw ℤ (gaussianConvolution J)).map (outputBlock K 0 n))
      ((iidLaw ℤ (gaussianConvolution J')).map (outputBlock K' 0 n))
      (ε + ((T + n : ℕ) : ℝ) * (δ + e)) := by
  letI : IsProbabilityMeasure
      ((iidLaw ℕ (gaussianConvolution J)).map (observedPastFromRaw K)) :=
    Measure.isProbabilityMeasure_map (measurable_observedPastFromRaw K).aemeasurable
  letI : IsProbabilityMeasure
      ((iidLaw ℕ (gaussianConvolution J')).map (observedPastFromRaw K')) :=
    Measure.isProbabilityMeasure_map (measurable_observedPastFromRaw K').aemeasurable
  rw [outputBlock_law_eq_suffix_mixture hH hInv J T n,
    outputBlock_law_eq_suffix_mixture hH' hInv' J' T n]
  exact testClose_suffix_mixtures H H' hH hH' hcloseJ hkernel T n hburn _ _

/-- The same quantitative comparison for the genuine zero-start sum laws. -/
theorem testClose_sumProcess {K K' : Correction} {H H' : Past → ℝ}
    (hH : Measurable H) (hH' : Measurable H')
    (hInv : IsCausalInverse K H) (hInv' : IsCausalInverse K' H')
    {J J' : Measure ℝ} [IsProbabilityMeasure J] [IsProbabilityMeasure J']
    {δ e ε : ℝ} (hcloseJ : TestClose J J' e)
    (hkernel : ∀ x, |H x - H' x| ≤ δ) (T n : ℕ)
    (hburn : ∀ x y : Past,
      TestClose ((pathLaw H' hH' J' (n + T) x).map (dropFirst T n))
        ((pathLaw H' hH' J' (n + T) y).map (dropFirst T n)) ε) :
    TestClose ((iidLaw ℤ (gaussianConvolution J)).map (sumProcess (factor K) n))
      ((iidLaw ℤ (gaussianConvolution J')).map (sumProcess (factor K') n))
      (ε + ((T + n : ℕ) : ℝ) * (δ + e)) :=
  testClose_sumProcess_of_outputBlock n
    (testClose_outputBlock hH hH' hInv hInv' hcloseJ hkernel T n hburn)

/-- Stage-ready quantifier order: one burn-in bound for **all** future lengths
implies both comparisons for every block length, with the same fixed `T`. -/
theorem testClose_outputBlocks_and_sumProcesses {K K' : Correction} {H H' : Past → ℝ}
    (hH : Measurable H) (hH' : Measurable H')
    (hInv : IsCausalInverse K H) (hInv' : IsCausalInverse K' H')
    {J J' : Measure ℝ} [IsProbabilityMeasure J] [IsProbabilityMeasure J']
    {δ e ε : ℝ} (hcloseJ : TestClose J J' e)
    (hkernel : ∀ x, |H x - H' x| ≤ δ) (T : ℕ)
    (hburn : ∀ n : ℕ, ∀ x y : Past,
      TestClose ((pathLaw H' hH' J' (n + T) x).map (dropFirst T n))
        ((pathLaw H' hH' J' (n + T) y).map (dropFirst T n)) ε) :
    ∀ n : ℕ,
      TestClose ((iidLaw ℤ (gaussianConvolution J)).map (outputBlock K 0 n))
        ((iidLaw ℤ (gaussianConvolution J')).map (outputBlock K' 0 n))
        (ε + ((T + n : ℕ) : ℝ) * (δ + e)) ∧
      TestClose ((iidLaw ℤ (gaussianConvolution J)).map (sumProcess (factor K) n))
        ((iidLaw ℤ (gaussianConvolution J')).map (sumProcess (factor K') n))
        (ε + ((T + n : ℕ) : ℝ) * (δ + e)) := by
  intro n
  have h := testClose_outputBlock hH hH' hInv hInv' hcloseJ hkernel T n (hburn n)
  exact ⟨h, testClose_sumProcess_of_outputBlock n h⟩

/-- A bounded measurable finite-memory reference admits a burn-in threshold
chosen before **all** target lengths, comparison factors, and comparison noise
laws. The same threshold works at every later burn-in time. Both actual block
and actual sum comparisons are supplied by this one choice. -/
theorem exists_burnin_comparison_of_hasMemory
    (H' : Past → ℝ) (hH' : Measurable H')
    (J' : Measure ℝ) [IsProbabilityMeasure J']
    {B : ℝ} (hB : 0 ≤ B) (hbound : ∀ x, |H' x| ≤ B)
    {M : ℕ} (hmem : HasMemory H' M) {ε : ℝ} (hε : 0 < ε) :
    ∃ T : ℕ, ∀ b ≥ T, ∀ (n : ℕ) (K K' : Correction)
      (H : Past → ℝ) (_hH : Measurable H)
      (J : Measure ℝ) [IsProbabilityMeasure J] (δ e : ℝ),
      IsCausalInverse K H → IsCausalInverse K' H' →
      TestClose J J' e → (∀ x, |H x - H' x| ≤ δ) →
      TestClose ((iidLaw ℤ (gaussianConvolution J)).map (outputBlock K 0 n))
        ((iidLaw ℤ (gaussianConvolution J')).map (outputBlock K' 0 n))
        (ε + ((b + n : ℕ) : ℝ) * (δ + e)) ∧
      TestClose ((iidLaw ℤ (gaussianConvolution J)).map (sumProcess (factor K) n))
        ((iidLaw ℤ (gaussianConvolution J')).map (sumProcess (factor K') n))
        (ε + ((b + n : ℕ) : ℝ) * (δ + e)) := by
  obtain ⟨T, hT⟩ := exists_burnin_testClose_pathLaw_suffix_of_hasMemory
    H' hH' J' hB hbound hmem hε
  refine ⟨T, ?_⟩
  intro b hb n K K' H hH J hJ δ e hInv hInv' hcloseJ hkernel
  have h := testClose_outputBlock hH hH' hInv hInv' hcloseJ hkernel b n (hT b hb n)
  exact ⟨h, testClose_sumProcess_of_outputBlock n h⟩

/-- Bounded-continuous reference version: measurability and boundedness are
automatic. In particular the only additional forgetting hypothesis is finite
memory; no assumption is imposed on the comparison drift's memory. -/
theorem exists_burnin_comparison_of_bcf_hasMemory
    (H' : Correction) (J' : Measure ℝ) [IsProbabilityMeasure J']
    {M : ℕ} (hmem : HasMemory H' M) {ε : ℝ} (hε : 0 < ε) :
    ∃ T : ℕ, ∀ b ≥ T, ∀ (n : ℕ) (K K' : Correction)
      (H : Past → ℝ) (_hH : Measurable H)
      (J : Measure ℝ) [IsProbabilityMeasure J] (δ e : ℝ),
      IsCausalInverse K H → IsCausalInverse K' H' →
      TestClose J J' e → (∀ x, |H x - H' x| ≤ δ) →
      TestClose ((iidLaw ℤ (gaussianConvolution J)).map (outputBlock K 0 n))
        ((iidLaw ℤ (gaussianConvolution J')).map (outputBlock K' 0 n))
        (ε + ((b + n : ℕ) : ℝ) * (δ + e)) ∧
      TestClose ((iidLaw ℤ (gaussianConvolution J)).map (sumProcess (factor K) n))
        ((iidLaw ℤ (gaussianConvolution J')).map (sumProcess (factor K') n))
        (ε + ((b + n : ℕ) : ℝ) * (δ + e)) :=
  exists_burnin_comparison_of_hasMemory H' H'.continuous.measurable J'
    (norm_nonneg H') (fun x => by
      simpa only [Real.norm_eq_abs] using H'.norm_coe_le_norm x) hmem hε

/-- The numerical budget used by a geometric stage construction. -/
theorem comparison_error_le (T n : ℕ) {δ e r ε : ℝ}
    (hr0 : 0 ≤ r) (hδ : δ ≤ 2 * r) (he : e ≤ 2 * r)
    (hr : r ≤ ε / (16 * ((T + n + 1 : ℕ) : ℝ))) :
    ε / 2 + ((T + n : ℕ) : ℝ) * (δ + e) ≤ ε := by
  have hbudget := (le_div_iff₀
    (show 0 < 16 * ((T + n + 1 : ℕ) : ℝ) by positivity)).mp hr
  have hsum : δ + e ≤ 4 * r := by linarith
  have hcost := mul_le_mul_of_nonneg_left hsum (Nat.cast_nonneg (T + n) : (0 : ℝ) ≤ _)
  have hnonneg := mul_nonneg (Nat.cast_nonneg (T + n) : (0 : ℝ) ≤ _) hr0
  rw [Nat.cast_add, Nat.cast_one] at hbudget
  nlinarith only [hbudget, hcost, hnonneg, hr0]

/-- With burn-in error `ε/2` and the two perturbations at most `2*r`, the
stage budget implies an actual block error at most `ε`. Nonnegativity of `r`
follows from the noise comparison, so it is not an extra assumption. -/
theorem testClose_outputBlock_of_geometric_budget
    {K K' : Correction} {H H' : Past → ℝ}
    (hH : Measurable H) (hH' : Measurable H')
    (hInv : IsCausalInverse K H) (hInv' : IsCausalInverse K' H')
    {J J' : Measure ℝ} [IsProbabilityMeasure J] [IsProbabilityMeasure J']
    {δ e r ε : ℝ} (hcloseJ : TestClose J J' e)
    (hkernel : ∀ x, |H x - H' x| ≤ δ) (T n : ℕ)
    (hburn : ∀ x y : Past,
      TestClose ((pathLaw H' hH' J' (n + T) x).map (dropFirst T n))
        ((pathLaw H' hH' J' (n + T) y).map (dropFirst T n)) (ε / 2))
    (hδ : δ ≤ 2 * r) (he : e ≤ 2 * r)
    (hr : r ≤ ε / (16 * ((T + n + 1 : ℕ) : ℝ))) :
    TestClose ((iidLaw ℤ (gaussianConvolution J)).map (outputBlock K 0 n))
      ((iidLaw ℤ (gaussianConvolution J')).map (outputBlock K' 0 n)) ε := by
  have hr0 : 0 ≤ r := by
    have he0 := hcloseJ.nonneg
    linarith
  exact (testClose_outputBlock hH hH' hInv hInv' hcloseJ hkernel T n hburn).mono
    (comparison_error_le T n hr0 hδ he hr)

/-- The geometric budget also compares the genuine sum laws, without any
additional moments and with exactly the same `ε`. -/
theorem testClose_sumProcess_of_geometric_budget
    {K K' : Correction} {H H' : Past → ℝ}
    (hH : Measurable H) (hH' : Measurable H')
    (hInv : IsCausalInverse K H) (hInv' : IsCausalInverse K' H')
    {J J' : Measure ℝ} [IsProbabilityMeasure J] [IsProbabilityMeasure J']
    {δ e r ε : ℝ} (hcloseJ : TestClose J J' e)
    (hkernel : ∀ x, |H x - H' x| ≤ δ) (T n : ℕ)
    (hburn : ∀ x y : Past,
      TestClose ((pathLaw H' hH' J' (n + T) x).map (dropFirst T n))
        ((pathLaw H' hH' J' (n + T) y).map (dropFirst T n)) (ε / 2))
    (hδ : δ ≤ 2 * r) (he : e ≤ 2 * r)
    (hr : r ≤ ε / (16 * ((T + n + 1 : ℕ) : ℝ))) :
    TestClose ((iidLaw ℤ (gaussianConvolution J)).map (sumProcess (factor K) n))
      ((iidLaw ℤ (gaussianConvolution J')).map (sumProcess (factor K') n)) ε :=
  testClose_sumProcess_of_outputBlock n
    (testClose_outputBlock_of_geometric_budget hH hH' hInv hInv' hcloseJ hkernel
      T n hburn hδ he hr)

end Cascade.BlockComparison
end


/- Supporting development: Cascade.SpecBridge -/
section
set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Topology

namespace IbragimovIosifescuConjectureForMixingSequences

variable {Ω : Type*} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ) (μ : Measure Ω) [IsProbabilityMeasure μ]

/-- If a cofinal subsequence of the normalized partial sums converges in probability to zero,
then the normalized partial sums cannot converge weakly to the standard Gaussian law. -/
lemma no_gaussian_limit_of_subseq_zero
    (hX : ∀ n, Measurable (X n))
    (n_j : ℕ → ℕ) (hn_j : Tendsto n_j atTop atTop)
    (hzero : TendstoInMeasure μ (fun j ↦ normalizedPartialSum X μ (n_j j)) atTop
      (fun _ ↦ (0 : ℝ))) :
    ¬ Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) := by
  intro hclt
  have hdist := hzero.tendstoInDistribution
    (fun j ↦ (measurable_normalizedPartialSum X μ hX (n_j j)).aemeasurable)
  have heq := tendsto_nhds_unique (hclt.comp hn_j) hdist.tendsto
  have hgauss : gaussianReal 0 1 = Measure.dirac (0 : ℝ) := by
    have hmeas := congrArg (fun ν : ProbabilityMeasure ℝ ↦ (ν : Measure ℝ)) heq
    simpa [Measure.map_const] using hmeas
  letI : NoAtoms (gaussianReal 0 1) := noAtoms_gaussianReal (by norm_num)
  have hsingleton := congrArg (fun ν : Measure ℝ ↦ ν ({0} : Set ℝ)) hgauss
  simp at hsingleton

/-- Tail-probability form of `no_gaussian_limit_of_subseq_zero`, with the strict inequality
`ε < |S_n / σ_n|` and the usual `ℝ≥0∞`-valued measure. -/
lemma no_gaussian_limit_of_subseq_zero_of_tail_prob
    (hX : ∀ n, Measurable (X n))
    (n_j : ℕ → ℕ) (hn_j : Tendsto n_j atTop atTop)
    (hzero : ∀ ε : ℝ, 0 < ε →
      Tendsto (fun j ↦ μ {ω | ε < |normalizedPartialSum X μ (n_j j) ω|})
        atTop (𝓝 0)) :
    ¬ Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) := by
  apply no_gaussian_limit_of_subseq_zero X μ hX n_j hn_j
  rw [tendstoInMeasure_iff_norm]
  intro ε hε
  simp only [sub_zero, Real.norm_eq_abs]
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
    (hzero (ε / 2) (by positivity)) (fun _ ↦ zero_le _) ?_
  intro j
  apply measure_mono
  intro ω hω
  exact lt_of_lt_of_le (half_lt_self hε) hω

/-- Real-valued tail-probability form of `no_gaussian_limit_of_subseq_zero`. -/
lemma no_gaussian_limit_of_subseq_zero_of_tail_prob_real
    (hX : ∀ n, Measurable (X n))
    (n_j : ℕ → ℕ) (hn_j : Tendsto n_j atTop atTop)
    (hzero : ∀ ε : ℝ, 0 < ε →
      Tendsto (fun j ↦ μ.real {ω | ε < |normalizedPartialSum X μ (n_j j) ω|})
        atTop (𝓝 0)) :
    ¬ Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) := by
  apply no_gaussian_limit_of_subseq_zero_of_tail_prob X μ hX n_j hn_j
  intro ε hε
  apply (ENNReal.tendsto_toReal_zero_iff (fun _ ↦ measure_ne_top μ _)).mp
  exact hzero ε hε

end IbragimovIosifescuConjectureForMixingSequences
end


/- Supporting development: Cascade.Escape -/
section
set_option autoImplicit false

/-
# Escape of variance-normalized sums

A law close in `TestClose` to a centered, square-integrable core has small
normalized tails whenever the core variance is small compared with a positive
lower bound for the target variance.  The target need not be centered, and its
`MemLp` hypothesis is unnecessary once a positive variance lower bound is given.

The sequence results allow the core probability measure to change at every
stage.  The final bridge uses only `Cascade.SpecBridge`, not the original
conjecture or any purported proof of it.
-/

open MeasureTheory ProbabilityTheory Filter Topology

namespace Cascade.Escape

/-- The real event used to test closeness of the unnormalized laws. -/
theorem measurableSet_normalizedTail (a V : ℝ) :
    MeasurableSet {x : ℝ | a < |x / Real.sqrt V|} :=
  measurableSet_lt measurable_const (measurable_id.div_const _).abs

section Chebyshev

variable {Ω : Type*} [MeasurableSpace Ω] {ν : Measure Ω} [IsFiniteMeasure ν]
  {G : Ω → ℝ}

/-- Strict-tail, real-probability Chebyshev inequality for a centered core. -/
theorem real_tail_le_variance_div_sq (hG : MemLp G 2 ν)
    (hzero : (∫ ω, G ω ∂ν) = 0) {c : ℝ} (hc : 0 < c) :
    ν.real {ω | c < |G ω|} ≤ variance G ν / c ^ 2 := by
  have hcheb : ν {ω | c ≤ |G ω|} ≤ ENNReal.ofReal (variance G ν / c ^ 2) := by
    simpa only [hzero, sub_zero] using meas_ge_le_variance_div_sq hG hc
  have htail : ν {ω | c < |G ω|} ≤ ENNReal.ofReal (variance G ν / c ^ 2) :=
    (measure_mono (show {ω | c < |G ω|} ⊆ {ω | c ≤ |G ω|} by
      intro ω hω
      change c ≤ |G ω|
      exact le_of_lt hω)).trans hcheb
  calc
    _ ≤ (ENNReal.ofReal (variance G ν / c ^ 2)).toReal :=
      ENNReal.toReal_mono ENNReal.ofReal_ne_top htail
    _ = _ := ENNReal.toReal_ofReal (div_nonneg (variance_nonneg G ν) (sq_nonneg c))

/-- Normalize a centered core by any positive variance scale `V`. -/
theorem real_normalized_tail_le (hG : MemLp G 2 ν)
    (hzero : (∫ ω, G ω ∂ν) = 0) {V a : ℝ} (hV : 0 < V) (ha : 0 < a) :
    ν.real {ω | a < |G ω / Real.sqrt V|} ≤ variance G ν / (a ^ 2 * V) := by
  have hs : 0 < Real.sqrt V := Real.sqrt_pos.2 hV
  have hevent : {ω | a < |G ω / Real.sqrt V|} =
      {ω | a * Real.sqrt V < |G ω|} := by
    ext ω
    simp only [Set.mem_setOf_eq, abs_div, abs_of_pos hs]
    exact lt_div_iff₀ hs
  rw [hevent]
  simpa only [mul_pow, Real.sq_sqrt hV.le] using
    real_tail_le_variance_div_sq hG hzero (mul_pos ha hs)

end Chebyshev

section Comparison

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
  {μ : Measure Ω} {ν : Measure Ω'} [IsProbabilityMeasure ν]
  {F : Ω → ℝ} {G : Ω' → ℝ}

/-- Test closeness transfers the core's Chebyshev bound to the target, with
constant one.  No moment or centering hypothesis on `F` is needed in addition
to the positive variance lower bound. -/
theorem normalized_tail_le [IsProbabilityMeasure μ] (hF : Measurable F) (hG : Measurable G)
    (hG2 : MemLp G 2 ν) (hzero : (∫ ω, G ω ∂ν) = 0)
    {e vL a : ℝ} (hclose : TestClose (μ.map F) (ν.map G) e)
    (hvL : 0 < vL) (hVar : vL ≤ variance F μ) (ha : 0 < a) :
    μ.real {ω | a < |F ω / Real.sqrt (variance F μ)|} ≤
      e + variance G ν / (a ^ 2 * vL) := by
  have hV : 0 < variance F μ := hvL.trans_le hVar
  have hs := measurableSet_normalizedTail a (variance F μ)
  have hdiff := hclose.event hs
  rw [map_measureReal_apply hF hs, map_measureReal_apply hG hs] at hdiff
  change |μ.real {ω | a < |F ω / Real.sqrt (variance F μ)|} -
    ν.real {ω | a < |G ω / Real.sqrt (variance F μ)|}| ≤ e at hdiff
  have hcomp : μ.real {ω | a < |F ω / Real.sqrt (variance F μ)|} ≤
      e + ν.real {ω | a < |G ω / Real.sqrt (variance F μ)|} := by
    have h := (le_abs_self _).trans hdiff
    linarith
  calc
    _ ≤ e + ν.real {ω | a < |G ω / Real.sqrt (variance F μ)|} := hcomp
    _ ≤ e + variance G ν / (a ^ 2 * variance F μ) :=
      add_le_add le_rfl (real_normalized_tail_le hG2 hzero hV ha)
    _ ≤ _ := add_le_add le_rfl
      (div_le_div_of_nonneg_left (variance_nonneg G ν)
        (mul_pos (sq_pos_of_pos ha) hvL)
        (mul_le_mul_of_nonneg_left hVar (sq_nonneg a)))

/-- Version with a direct upper bound `u` for the core variance and a positive
lower bound `κ` for the target variance.  Nonnegativity of `u` follows from
`hcore` and is not an extra assumption. -/
theorem normalized_tail_le_of_variance_le [IsProbabilityMeasure μ]
    (hF : Measurable F) (hG : Measurable G)
    (hG2 : MemLp G 2 ν) (hzero : (∫ ω, G ω ∂ν) = 0)
    {e u κ a : ℝ} (hclose : TestClose (μ.map F) (ν.map G) e)
    (hκ : 0 < κ) (hVar : κ ≤ variance F μ) (hcore : variance G ν ≤ u)
    (ha : 0 < a) :
    μ.real {ω | a < |F ω / Real.sqrt (variance F μ)|} ≤ e + u / (a ^ 2 * κ) :=
  (normalized_tail_le hF hG hG2 hzero hclose hκ hVar ha).trans
    (add_le_add le_rfl (div_le_div_of_nonneg_right hcore
      (mul_nonneg (sq_nonneg a) hκ.le)))

end Comparison

section Sequences

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
  {μ : Measure Ω} [IsProbabilityMeasure μ]
  {ν : ℕ → Measure Ω'} [∀ j, IsProbabilityMeasure (ν j)]
  {F : ℕ → Ω → ℝ} {G : ℕ → Ω' → ℝ}

/-- Escape along a sequence, using direct core variance upper bounds.  In
particular, the core law `ν j` need not be the same at different stages. -/
theorem tendsto_normalized_tail_of_testClose_of_variance_le
    (hF : ∀ j, Measurable (F j)) (hG : ∀ j, Measurable (G j))
    (hG2 : ∀ j, MemLp (G j) 2 (ν j)) (hzero : ∀ j, (∫ ω, G j ω ∂ν j) = 0)
    {e vL u : ℕ → ℝ}
    (hclose : ∀ j, TestClose (μ.map (F j)) ((ν j).map (G j)) (e j))
    (hvL : ∀ j, 0 < vL j) (hVar : ∀ j, vL j ≤ variance (F j) μ)
    (hcore : ∀ j, variance (G j) (ν j) ≤ u j)
    (he : Tendsto e atTop (𝓝 0))
    (hratio : Tendsto (fun j ↦ u j / vL j) atTop (𝓝 0))
    {a : ℝ} (ha : 0 < a) :
    Tendsto (fun j ↦ μ.real {ω | a < |F j ω / Real.sqrt (variance (F j) μ)|})
      atTop (𝓝 0) := by
  have hupper : Tendsto (fun j ↦ e j + u j / (a ^ 2 * vL j)) atTop (𝓝 0) := by
    simpa only [div_div, mul_comm, zero_div, add_zero] using
      he.add (hratio.div_const (a ^ 2))
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hupper
    (fun _ ↦ measureReal_nonneg)
    (fun j ↦ normalized_tail_le_of_variance_le (hF j) (hG j) (hG2 j) (hzero j)
      (hclose j) (hvL j) (hVar j) (hcore j) ha)

/-- If the law errors and the core-to-target-lower-variance ratios tend to
zero, every positive strict normalized tail tends to zero. -/
theorem tendsto_normalized_tail_of_testClose
    (hF : ∀ j, Measurable (F j)) (hG : ∀ j, Measurable (G j))
    (hG2 : ∀ j, MemLp (G j) 2 (ν j)) (hzero : ∀ j, (∫ ω, G j ω ∂ν j) = 0)
    {e vL : ℕ → ℝ}
    (hclose : ∀ j, TestClose (μ.map (F j)) ((ν j).map (G j)) (e j))
    (hvL : ∀ j, 0 < vL j) (hVar : ∀ j, vL j ≤ variance (F j) μ)
    (he : Tendsto e atTop (𝓝 0))
    (hratio : Tendsto (fun j ↦ variance (G j) (ν j) / vL j) atTop (𝓝 0))
    {a : ℝ} (ha : 0 < a) :
    Tendsto (fun j ↦ μ.real {ω | a < |F j ω / Real.sqrt (variance (F j) μ)|})
      atTop (𝓝 0) :=
  tendsto_normalized_tail_of_testClose_of_variance_le hF hG hG2 hzero hclose hvL hVar
    (fun _ ↦ le_rfl) he hratio ha

/-- The same escape statement as convergence in probability to zero. -/
theorem tendstoInMeasure_normalized_of_testClose
    (hF : ∀ j, Measurable (F j)) (hG : ∀ j, Measurable (G j))
    (hG2 : ∀ j, MemLp (G j) 2 (ν j)) (hzero : ∀ j, (∫ ω, G j ω ∂ν j) = 0)
    {e vL : ℕ → ℝ}
    (hclose : ∀ j, TestClose (μ.map (F j)) ((ν j).map (G j)) (e j))
    (hvL : ∀ j, 0 < vL j) (hVar : ∀ j, vL j ≤ variance (F j) μ)
    (he : Tendsto e atTop (𝓝 0))
    (hratio : Tendsto (fun j ↦ variance (G j) (ν j) / vL j) atTop (𝓝 0)) :
    TendstoInMeasure μ (fun j ω ↦ F j ω / Real.sqrt (variance (F j) μ)) atTop
      (fun _ ↦ (0 : ℝ)) := by
  rw [tendstoInMeasure_iff_measureReal_norm]
  intro a ha
  simp only [sub_zero, Real.norm_eq_abs]
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
    (tendsto_normalized_tail_of_testClose hF hG hG2 hzero hclose hvL hVar he hratio
      (half_pos ha)) (fun _ ↦ measureReal_nonneg) ?_
  intro j
  refine measureReal_mono ?_ (measure_ne_top μ _)
  intro ω hω
  change a / 2 < |F j ω / Real.sqrt (variance (F j) μ)|
  exact lt_of_lt_of_le (half_lt_self ha) hω

end Sequences

section GeometricBounds

/-- The squared stage target, in the exponent convention of the variance bound. -/
theorem geometric_target_sq (j : ℕ) :
    ((1 / 2 : ℝ) ^ (2 * (j + 1))) ^ 2 = (1 / 2 : ℝ) ^ (4 * (j + 1)) := by
  rw [← pow_mul]
  congr 1
  omega

/-- The observation length cancels from the prescribed upper/lower variance
ratio.  Thus no rate of growth of `n` is needed for the escape estimate. -/
theorem geometric_variance_ratio_eq (j n : ℕ) (hn : 1 ≤ n) :
    (2 * (n : ℝ) * (1 / 2 : ℝ) ^ (4 * (j + 1))) /
        ((n : ℝ) * (1 / 2 : ℝ) ^ (j + 1) / 8) =
      16 * (1 / 2 : ℝ) ^ (3 * (j + 1)) := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (show n ≠ 0 by omega)
  have hw0 : (1 / 2 : ℝ) ^ (j + 1) ≠ 0 := by positivity
  have hp : (1 / 2 : ℝ) ^ (4 * (j + 1)) =
      (1 / 2 : ℝ) ^ (3 * (j + 1)) * (1 / 2 : ℝ) ^ (j + 1) := by
    rw [← pow_add]
    congr 1
    omega
  rw [hp]
  field_simp
  ring

/-- The stage comparison errors tend to zero. -/
theorem tendsto_geometric_error :
    Tendsto (fun j : ℕ ↦ (1 / 2 : ℝ) ^ (j + 1)) atTop (𝓝 0) :=
  (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
    (by norm_num : (1 / 2 : ℝ) < 1)).comp (tendsto_add_atTop_nat 1)

/-- The upper/lower variance ratios tend to zero geometrically. -/
theorem tendsto_geometric_ratio :
    Tendsto (fun j : ℕ ↦ 16 * (1 / 2 : ℝ) ^ (3 * (j + 1))) atTop (𝓝 0) := by
  have h : Tendsto (fun j : ℕ ↦ (16 : ℝ) * ((1 / 2 : ℝ) ^ (j + 1)) ^ 3)
      atTop (𝓝 0) := by
    simpa using (tendsto_geometric_error.pow 3).const_mul (16 : ℝ)
  simpa only [← pow_mul, Nat.mul_comm] using h

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
  {μ : Measure Ω} [IsProbabilityMeasure μ]
  {ν : ℕ → Measure Ω'} [∀ j, IsProbabilityMeasure (ν j)]
  {F : ℕ → Ω → ℝ} {G : ℕ → Ω' → ℝ}

/-- Ready-to-use escape criterion for the geometric diagonal bounds:
error `2⁻⁽ʲ⁺¹⁾`, target variance at least `n * 2⁻⁽ʲ⁺¹⁾ / 8`, and core
variance at most `2 * n * 2⁻⁴⁽ʲ⁺¹⁾`.  A smaller `TestClose` error can be
increased to the displayed one with `TestClose.mono`. -/
theorem tendsto_normalized_tail_of_geometric_bounds
    (hF : ∀ j, Measurable (F j)) (hG : ∀ j, Measurable (G j))
    (hG2 : ∀ j, MemLp (G j) 2 (ν j)) (hzero : ∀ j, (∫ ω, G j ω ∂ν j) = 0)
    (n : ℕ → ℕ) (hn : ∀ j, 1 ≤ n j)
    (hclose : ∀ j, TestClose (μ.map (F j)) ((ν j).map (G j))
      ((1 / 2 : ℝ) ^ (j + 1)))
    (hVar : ∀ j, (n j : ℝ) * (1 / 2 : ℝ) ^ (j + 1) / 8 ≤ variance (F j) μ)
    (hcore : ∀ j, variance (G j) (ν j) ≤
      2 * (n j : ℝ) * (1 / 2 : ℝ) ^ (4 * (j + 1)))
    {a : ℝ} (ha : 0 < a) :
    Tendsto (fun j ↦ μ.real {ω | a < |F j ω / Real.sqrt (variance (F j) μ)|})
      atTop (𝓝 0) := by
  have hpos (j : ℕ) : 0 < (n j : ℝ) * (1 / 2 : ℝ) ^ (j + 1) / 8 := by
    have hn0 : (0 : ℝ) < n j := by exact_mod_cast (show 0 < n j by have := hn j; omega)
    positivity
  have hratio : Tendsto
      (fun j ↦ (2 * (n j : ℝ) * (1 / 2 : ℝ) ^ (4 * (j + 1))) /
        ((n j : ℝ) * (1 / 2 : ℝ) ^ (j + 1) / 8)) atTop (𝓝 0) :=
    (tendsto_congr (fun j ↦ geometric_variance_ratio_eq j (n j) (hn j))).2
      tendsto_geometric_ratio
  exact tendsto_normalized_tail_of_testClose_of_variance_le hF hG hG2 hzero hclose
    hpos hVar hcore tendsto_geometric_error hratio ha

end GeometricBounds

section NonGaussian

open IbragimovIosifescuConjectureForMixingSequences

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
  {μ : Measure Ω} [IsProbabilityMeasure μ]
  {ν : ℕ → Measure Ω'} [∀ j, IsProbabilityMeasure (ν j)]
  {X : ℕ → Ω → ℝ} {G : ℕ → Ω' → ℝ}

/-- A cofinal family of partial sums satisfying the generic escape criterion
precludes convergence of all normalized partial-sum laws to `N(0,1)`.
This is exactly the conclusion exported by `SpecBridge`. -/
theorem no_gaussian_limit_of_testClose
    (hX : ∀ k, Measurable (X k)) (n : ℕ → ℕ) (hn : Tendsto n atTop atTop)
    (hG : ∀ j, Measurable (G j)) (hG2 : ∀ j, MemLp (G j) 2 (ν j))
    (hzero : ∀ j, (∫ ω, G j ω ∂ν j) = 0)
    {e vL : ℕ → ℝ}
    (hclose : ∀ j, TestClose (μ.map (partialSum X (n j))) ((ν j).map (G j)) (e j))
    (hvL : ∀ j, 0 < vL j) (hVar : ∀ j, vL j ≤ variance (partialSum X (n j)) μ)
    (he : Tendsto e atTop (𝓝 0))
    (hratio : Tendsto (fun j ↦ variance (G j) (ν j) / vL j) atTop (𝓝 0)) :
    ¬ Tendsto (β := ProbabilityMeasure ℝ)
      (fun k ↦ ⟨μ.map (normalizedPartialSum X μ k), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX k).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) := by
  apply no_gaussian_limit_of_subseq_zero_of_tail_prob_real X μ hX n hn
  intro a ha
  have hF : ∀ j, Measurable (partialSum X (n j)) :=
    fun j ↦ Finset.measurable_sum _ (fun k _ ↦ hX k)
  simpa only [normalizedPartialSum, partialSumStdDev] using
    tendsto_normalized_tail_of_testClose hF hG hG2 hzero hclose hvL hVar he hratio ha

/-- Closed non-Gaussian corollary for the actual geometric scale choices.
The core measures may vary with `j`; cofinality is required only to pass from
the escaping selected sums to failure of the full-sequence Gaussian limit. -/
theorem no_gaussian_limit_of_geometric_bounds
    (hX : ∀ k, Measurable (X k)) (n : ℕ → ℕ) (hn : Tendsto n atTop atTop)
    (hnpos : ∀ j, 1 ≤ n j)
    (hG : ∀ j, Measurable (G j)) (hG2 : ∀ j, MemLp (G j) 2 (ν j))
    (hzero : ∀ j, (∫ ω, G j ω ∂ν j) = 0)
    (hclose : ∀ j, TestClose (μ.map (partialSum X (n j))) ((ν j).map (G j))
      ((1 / 2 : ℝ) ^ (j + 1)))
    (hVar : ∀ j, (n j : ℝ) * (1 / 2 : ℝ) ^ (j + 1) / 8 ≤
      variance (partialSum X (n j)) μ)
    (hcore : ∀ j, variance (G j) (ν j) ≤
      2 * (n j : ℝ) * (1 / 2 : ℝ) ^ (4 * (j + 1))) :
    ¬ Tendsto (β := ProbabilityMeasure ℝ)
      (fun k ↦ ⟨μ.map (normalizedPartialSum X μ k), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX k).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) := by
  apply no_gaussian_limit_of_subseq_zero_of_tail_prob_real X μ hX n hn
  intro a ha
  have hF : ∀ j, Measurable (partialSum X (n j)) :=
    fun j ↦ Finset.measurable_sum _ (fun k _ ↦ hX k)
  simpa only [normalizedPartialSum, partialSumStdDev] using
    tendsto_normalized_tail_of_geometric_bounds hF hG hG2 hzero n hnpos hclose hVar hcore ha

end NonGaussian

end Cascade.Escape
end


/- Supporting development: Cascade.PhiMixing -/
section
set_option autoImplicit false

/-
# From uniform finite-future forgetting to the actual φ-mixing coefficients

Finite initial future blocks form an increasing family of σ-algebras. Their
union is a set algebra generating the entire future σ-algebra in `SpecDefs`.
Approximation in the sum of two finite measures extends a uniform event bound
on these blocks to every event in the infinite future, without losing any of
the bound. We then transfer uniform forgetting of causal path laws to the
actual coefficients of the stationary causal factor.

Only the definition-only specification module is imported.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal symmDiff

namespace Cascade

open IbragimovIosifescuConjectureForMixingSequences

section IncreasingSigmaAlgebras

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- A uniform difference bound on an increasing family of σ-algebras holds on
its supremum. The approximating set is chosen using `μ + ν`, so both measures
are approximated simultaneously. In particular there is no factor-two loss. -/
theorem event_bound_iSup_of_monotone (μ ν : Measure Ω)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    {f : ℕ → MeasurableSpace Ω} (hf : Monotone f) (hle : ∀ n, f n ≤ mΩ)
    {e : ℝ}
    (hbound : ∀ n (s : Set Ω), MeasurableSet[f n] s → |ν.real s - μ.real s| ≤ e)
    {s : Set Ω} (hs : MeasurableSet[⨆ n, f n] s) :
    |ν.real s - μ.real s| ≤ e := by
  let 𝒜 : Set (Set Ω) := ⋃ n, {t | MeasurableSet[f n] t}
  have h𝒜 : IsSetAlgebra 𝒜 := by
    constructor
    · exact Set.mem_iUnion.mpr ⟨0, @MeasurableSet.empty Ω (f 0)⟩
    · rintro t ht
      obtain ⟨n, hn⟩ := Set.mem_iUnion.mp ht
      exact Set.mem_iUnion.mpr ⟨n, hn.compl⟩
    · rintro t u ht hu
      obtain ⟨n, hn⟩ := Set.mem_iUnion.mp ht
      obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hu
      exact Set.mem_iUnion.mpr ⟨max n k,
        ((hf (le_max_left n k)) t hn).union ((hf (le_max_right n k)) u hk)⟩
  have hsup : (⨆ n, f n) ≤ mΩ := iSup_le hle
  have hdense := @Measure.MeasureDense.of_generateFrom_isSetAlgebra_finite
    Ω (⨆ n, f n) ((μ + ν).trim hsup) 𝒜 inferInstance h𝒜
      (MeasurableSpace.generateFrom_iUnion_measurableSet f).symm
  refine le_of_forall_pos_le_add fun δ hδ => ?_
  obtain ⟨t, ht, hst⟩ := @Measure.MeasureDense.approx Ω (⨆ n, f n)
    ((μ + ν).trim hsup) 𝒜 hdense s hs (by finiteness) δ hδ
  obtain ⟨n, hn⟩ := Set.mem_iUnion.mp ht
  have ht' : MeasurableSet[⨆ n, f n] t := (le_iSup f n) t hn
  rw [trim_measurableSet_eq hsup (hs.symmDiff ht')] at hst
  have herr : μ.real (s ∆ t) + ν.real (s ∆ t) < δ := by
    rw [← measureReal_add_apply]
    exact ENNReal.toReal_lt_of_lt_ofReal hst
  have hsΩ : MeasurableSet s := hsup s hs
  have htΩ : MeasurableSet t := hle n t hn
  have hμ := abs_measureReal_sub_le_measureReal_symmDiff
    (μ := μ) hsΩ.nullMeasurableSet htΩ.nullMeasurableSet
  have hν := abs_measureReal_sub_le_measureReal_symmDiff
    (μ := ν) hsΩ.nullMeasurableSet htΩ.nullMeasurableSet
  have hfin := hbound n t hn
  have htri := (abs_sub_le (ν.real s) (ν.real t) (μ.real s)).trans
    (add_le_add le_rfl (abs_sub_le (ν.real t) (μ.real t) (μ.real s)))
  rw [abs_sub_comm (μ.real t) (μ.real s)] at htri
  linarith

end IncreasingSigmaAlgebras

section FutureSigmaAlgebras

variable {Ω : Type*} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ)

/-- The chronological initial block of length `T` in the future beginning at `k`. -/
def futureBlock (k T : ℕ) (ω : Ω) : Fin T → ℝ := fun i => X (k + (i : ℕ)) ω

@[fun_prop] theorem measurable_futureBlock (hX : ∀ n, Measurable (X n)) (k T : ℕ) :
    Measurable (futureBlock X k T) :=
  measurable_pi_lambda _ fun i => hX (k + (i : ℕ))

/-- Every generated coordinate σ-algebra is contained in the ambient one. -/
theorem sigmaGen_le (hX : ∀ n, Measurable (X n)) (s : Set ℕ) :
    sigmaGen X s ≤ ‹MeasurableSpace Ω› :=
  iSup_le fun j => iSup_le fun _ => (hX j).comap_le

omit [MeasurableSpace Ω] in
/-- Finite initial future blocks give increasing σ-algebras. -/
theorem monotone_futureBlock_comap (k : ℕ) :
    Monotone (fun T => MeasurableSpace.comap (futureBlock X k T) inferInstance) := by
  intro S T hST
  change MeasurableSpace.comap
    ((fun (p : Fin T → ℝ) (i : Fin S) => p ⟨i.val, lt_of_lt_of_le i.isLt hST⟩) ∘
      futureBlock X k T) inferInstance ≤ _
  rw [← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono
    (measurable_pi_lambda _ fun i : Fin S =>
      measurable_pi_apply (⟨i.val, lt_of_lt_of_le i.isLt hST⟩ : Fin T)).comap_le

omit [MeasurableSpace Ω] in
/-- A finite future block is measurable in the full future σ-algebra. -/
theorem futureBlock_comap_le_sigmaGen (k T : ℕ) :
    MeasurableSpace.comap (futureBlock X k T) inferInstance ≤
      sigmaGen X (Set.Ici k) := by
  letI : MeasurableSpace Ω := sigmaGen X (Set.Ici k)
  apply Measurable.comap_le
  apply measurable_pi_lambda
  intro i
  apply Measurable.of_comap_le
  exact le_iSup_of_le (k + (i : ℕ))
    (le_iSup_of_le (show k + (i : ℕ) ∈ Set.Ici k by simp) le_rfl)

omit [MeasurableSpace Ω] in
/-- The specification's *entire* infinite future is exactly the supremum of
its finite initial-block σ-algebras. No completion or almost-everywhere change
of the future event is involved in this identity. -/
theorem sigmaGen_future_eq_iSup (k : ℕ) :
    sigmaGen X (Set.Ici k) =
      ⨆ T, MeasurableSpace.comap (futureBlock X k T) inferInstance := by
  apply le_antisymm
  · refine iSup_le fun j => iSup_le fun hj => ?_
    let i : Fin (j - k + 1) := ⟨j - k, by omega⟩
    have heq : X j = (fun p : Fin (j - k + 1) → ℝ => p i) ∘
        futureBlock X k (j - k + 1) := by
      funext ω
      simp only [Function.comp_apply, futureBlock, i, Nat.add_sub_of_le (show k ≤ j from hj)]
    rw [heq, ← MeasurableSpace.comap_comp]
    exact (MeasurableSpace.comap_mono (measurable_pi_apply i).comap_le).trans
      (le_iSup (fun T => MeasurableSpace.comap (futureBlock X k T) inferInstance) (j - k + 1))
  · exact iSup_le (futureBlock_comap_le_sigmaGen X k)

/-- Bounds on all finite initial future cylinders extend, with exactly the
same error, to every event in the infinite future σ-algebra. -/
theorem event_bound_future_of_finite (hX : ∀ n, Measurable (X n))
    (μ ν : Measure Ω) [IsFiniteMeasure μ] [IsFiniteMeasure ν] (k : ℕ) {e : ℝ}
    (hbound : ∀ T (s : Set (Fin T → ℝ)), MeasurableSet s →
      |ν.real (futureBlock X k T ⁻¹' s) - μ.real (futureBlock X k T ⁻¹' s)| ≤ e)
    {s : Set Ω} (hs : MeasurableSet[sigmaGen X (Set.Ici k)] s) :
    |ν.real s - μ.real s| ≤ e := by
  rw [sigmaGen_future_eq_iSup X k] at hs
  apply event_bound_iSup_of_monotone μ ν (monotone_futureBlock_comap X k)
    (fun T => (measurable_futureBlock X hX k T).comap_le) (s := s) _ hs
  rintro T s ⟨C, hC, rfl⟩
  exact hbound T C hC

end FutureSigmaAlgebras

section PhiCoefficients

variable {Ω : Type*} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ)
    (μ : Measure Ω) [IsProbabilityMeasure μ]

private theorem phi_values_contain_zero (n : ℕ) :
    (0 : ℝ) ∈ {r : ℝ | ∃ (m : ℕ) (A B : Set Ω),
      MeasurableSet[sigmaGen X (Set.Iic m)] A ∧ 0 < μ A ∧
      MeasurableSet[sigmaGen X (Set.Ici (m + n))] B ∧
      r = |(μ[|A]).real B - μ.real B|} := by
  refine ⟨0, Set.univ, ∅, ?_, ?_, ?_, ?_⟩
  · exact @MeasurableSet.univ Ω (sigmaGen X (Set.Iic 0))
  · simp
  · exact @MeasurableSet.empty Ω (sigmaGen X (Set.Ici (0 + n)))
  · simp

/-- The actual real-valued supremum defining φ is well-defined and belongs to
`[0,1]`. This also supplies its lower bound when taking the limit at infinity. -/
theorem phiMixingCoeff_mem_Icc (n : ℕ) : phiMixingCoeff X μ n ∈ Set.Icc (0 : ℝ) 1 := by
  have h1 : ∀ r ∈ {r : ℝ | ∃ (m : ℕ) (A B : Set Ω),
      MeasurableSet[sigmaGen X (Set.Iic m)] A ∧ 0 < μ A ∧
      MeasurableSet[sigmaGen X (Set.Ici (m + n))] B ∧
      r = |(μ[|A]).real B - μ.real B|}, r ≤ 1 := by
    rintro r ⟨m, A, B, hA, hpos, hB, rfl⟩
    have h0a : 0 ≤ (μ[|A]).real B := measureReal_nonneg
    have h1a : (μ[|A]).real B ≤ 1 := measureReal_le_one
    have h0b : 0 ≤ μ.real B := measureReal_nonneg
    have h1b : μ.real B ≤ 1 := measureReal_le_one
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  exact ⟨le_csSup ⟨1, h1⟩ (phi_values_contain_zero X μ n),
    csSup_le ⟨0, phi_values_contain_zero X μ n⟩ h1⟩

/-- Uniform conditional bounds for finite initial future blocks bound the
specification's coefficient, whose supremum runs over *all* infinite-future
events. The conditioning event is allowed to be any positive finite-past event. -/
theorem phiMixingCoeff_le_of_finite_cond (hX : ∀ n, Measurable (X n))
    (n : ℕ) {e : ℝ}
    (hfinite : ∀ (m : ℕ) (A : Set Ω),
      MeasurableSet[sigmaGen X (Set.Iic m)] A → 0 < μ A →
      ∀ (T : ℕ) (s : Set (Fin T → ℝ)), MeasurableSet s →
        |(μ[|A]).real (futureBlock X (m + n) T ⁻¹' s) -
          μ.real (futureBlock X (m + n) T ⁻¹' s)| ≤ e) :
    phiMixingCoeff X μ n ≤ e := by
  apply csSup_le ⟨0, phi_values_contain_zero X μ n⟩
  rintro r ⟨m, A, B, hA, hpos, hB, rfl⟩
  letI : IsProbabilityMeasure (μ[|A]) := cond_isProbabilityMeasure hpos.ne'
  exact event_bound_future_of_finite X hX μ (μ[|A]) (m + n)
    (hfinite m A hA hpos) hB

/-- A general φ-mixing criterion with only finite-dimensional conditional-law
hypotheses. Crucially the threshold is uniform in the past, the conditioning
event, and the length and event of the finite future block. -/
theorem isPhiMixing_of_uniform_finite_cond (hX : ∀ n, Measurable (X n))
    (hfinite : ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n ≥ N,
      ∀ (m : ℕ) (A : Set Ω),
        MeasurableSet[sigmaGen X (Set.Iic m)] A → 0 < μ A →
        ∀ (T : ℕ) (s : Set (Fin T → ℝ)), MeasurableSet s →
          |(μ[|A]).real (futureBlock X (m + n) T ⁻¹' s) -
            μ.real (futureBlock X (m + n) T ⁻¹' s)| ≤ ε) :
    IsPhiMixing X μ := by
  rw [IsPhiMixing, Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ := hfinite (ε / 2) (half_pos hε)
  refine ⟨N, fun n hn => ?_⟩
  have hb := phiMixingCoeff_le_of_finite_cond X μ hX n (hN n hn)
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (phiMixingCoeff_mem_Icc X μ n).1]
  exact hb.trans_lt (half_lt_self hε)

end PhiCoefficients

/-- **The causal factor is φ-mixing in the exact specification.** A measurable,
bounded strict-past causal inverse with a square-summable variation majorant
suffices, for every probability innovation law convolved with the Gaussian.

The forgetting threshold is chosen before the past event or any finite future
block. A lag of `n` leaves `n - 1` outputs to discard after time `m`, and the
infinite-future extension is supplied by
`isPhiMixing_of_uniform_finite_cond`. No moment assumptions on `J` are needed. -/
theorem isPhiMixing_of_causalInverse {K : Correction} {H : Past → ℝ}
    (hH : Measurable H) (hInv : CausalLaw.IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J]
    {B : ℝ} (hbound : ∀ x, |H x| ≤ B)
    {d : ℕ → ℝ} (hvar : HasVariationMajorant H d)
    (hsum : Summable (fun j => d j ^ 2)) :
    IbragimovIosifescuConjectureForMixingSequences.IsPhiMixing
      (fun n => atTime (factor K) (n : ℤ)) (iidLaw ℤ (gaussianConvolution J)) := by
  have hB : 0 ≤ B := (abs_nonneg (H 0)).trans (hbound 0)
  have hX (n : ℕ) : Measurable (atTime (factor K) (n : ℤ)) :=
    measurable_atTime (measurable_factor K) (n : ℤ)
  apply isPhiMixing_of_uniform_finite_cond _ _ hX
  intro ε hε
  obtain ⟨N, hN⟩ := exists_burnin_testClose_pathLaw_suffix H hH J hB hbound hvar hsum hε
  refine ⟨N + 1, fun n hn m A hA hpos T s hs => ?_⟩
  have hdiam := hN (n - 1) (by omega) T
  have hclose := CausalLaw.testClose_cond_outputBlock_of_natPast hH hInv J m
    (T + (n - 1)) (dropFirst (n - 1) T) (measurable_dropFirst (n - 1) T)
    hdiam hA hpos
  have heq : dropFirst (n - 1) T ∘ CausalLaw.outputBlock K ((m : ℤ) + 1) (T + (n - 1)) =
      futureBlock (fun j => atTime (factor K) (j : ℤ)) (m + n) T := by
    funext ω i
    change CausalLaw.outputBlock K ((m : ℤ) + 1) (T + (n - 1)) ω (i.addNat (n - 1)) =
      atTime (factor K) ((m + n + (i : ℕ) : ℕ) : ℤ) ω
    rw [CausalLaw.outputBlock_addNat]
    simp only [CausalLaw.outputBlock, Nat.cast_add]
    exact congrArg (fun t : ℤ => atTime (factor K) t ω) (by omega)
  rw [heq] at hclose
  simpa only [Measure.real, Measure.map_apply (measurable_futureBlock _ hX (m + n) T) hs]
    using hclose.event hs

/-- Bounded-continuous inverse version: its norm supplies the drift bound,
so only the inverse identity and square-summable variation majorant remain. -/
theorem isPhiMixing_of_causalInverse_correction (K H : Correction)
    (hInv : CausalLaw.IsCausalInverse K H)
    (J : Measure ℝ) [IsProbabilityMeasure J]
    {d : ℕ → ℝ} (hvar : HasVariationMajorant H d)
    (hsum : Summable (fun j => d j ^ 2)) :
    IbragimovIosifescuConjectureForMixingSequences.IsPhiMixing
      (fun n => atTime (factor K) (n : ℤ)) (iidLaw ℤ (gaussianConvolution J)) :=
  isPhiMixing_of_causalInverse H.continuous.measurable hInv J (B := ‖H‖)
    (fun x => by simpa only [Real.norm_eq_abs] using H.norm_coe_le_norm x) hvar hsum

end Cascade
end


/- Supporting development: Cascade.LiftCounterexample -/
section
set_option autoImplicit false

/-
# Transport of counterexamples across measurable equivalences and universe lifts

This file only uses the definition-only specification and its elementary bridge.  In particular,
none of its statements or proofs refers to the original conjecture theorem.

For `e : Ω' ≃ᵐ Ω`, the transported process is `X n ∘ e` and its measure is `μ.map e.symm`.
We prove exact preservation of the generated σ-algebras, φ-mixing coefficients, moments and
normalized partial-sum laws.  Specializing to `MeasurableEquiv.ulift` moves a counterexample on
`Type 0` to any requested universe, with the canonical measurable space on `ULift`.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

noncomputable section

universe u v w

namespace IbragimovIosifescuConjectureForMixingSequences

section Transport

variable {Ω : Type v} {Ω' : Type w} [MeasurableSpace Ω] [MeasurableSpace Ω']

/-- The process on the domain of a measurable equivalence. -/
def transportProcess (X : ℕ → Ω → ℝ) (e : Ω' ≃ᵐ Ω) : ℕ → Ω' → ℝ :=
  fun n ↦ X n ∘ e

/-- The probability law on the domain of a measurable equivalence. -/
def transportMeasure (μ : Measure Ω) (e : Ω' ≃ᵐ Ω) : Measure Ω' :=
  μ.map e.symm

variable (X : ℕ → Ω → ℝ) (μ : Measure Ω) (e : Ω' ≃ᵐ Ω)

@[simp] theorem transportProcess_apply (n : ℕ) (ω : Ω') :
    transportProcess X e n ω = X n (e ω) := rfl

instance isProbabilityMeasure_transportMeasure [IsProbabilityMeasure μ] :
    IsProbabilityMeasure (transportMeasure μ e) :=
  Measure.isProbabilityMeasure_map e.symm.measurable.aemeasurable

/-- Measurability is preserved in both directions. -/
theorem measurable_transportProcess_iff (n : ℕ) :
    Measurable (transportProcess X e n) ↔ Measurable (X n) :=
  e.measurable_comp_iff

theorem measurable_transportProcess (hX : ∀ n, Measurable (X n)) :
    ∀ n, Measurable (transportProcess X e n) :=
  fun n ↦ (measurable_transportProcess_iff X e n).2 (hX n)

omit [MeasurableSpace Ω] [MeasurableSpace Ω'] in
/-- This σ-algebra identity needs no measurability assumption on the process or the map. -/
theorem sigmaGen_comp (f : Ω' → Ω) (s : Set ℕ) :
    sigmaGen (fun n ↦ X n ∘ f) s = (sigmaGen X s).comap f := by
  simp only [sigmaGen, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]

theorem sigmaGen_transport (s : Set ℕ) :
    sigmaGen (transportProcess X e) s = (sigmaGen X s).comap e :=
  sigmaGen_comp X e s

/-- Events in a transported generated σ-algebra correspond exactly to original events. -/
theorem measurableSet_sigmaGen_transport_iff (s : Set ℕ) (A : Set Ω') :
    MeasurableSet[sigmaGen (transportProcess X e) s] A ↔
      MeasurableSet[sigmaGen X s] (e.symm ⁻¹' A) := by
  rw [sigmaGen_transport, MeasurableSpace.measurableSet_comap]
  constructor
  · rintro ⟨B, hB, rfl⟩
    simpa only [MeasurableEquiv.symm_preimage_preimage] using hB
  · intro hA
    exact ⟨e.symm ⁻¹' A, hA, e.symm.symm_preimage_preimage A⟩

/-- Unlike the usual `Measure.map_apply`, this holds on all sets. -/
@[simp] theorem transportMeasure_apply (A : Set Ω') :
    transportMeasure μ e A = μ (e.symm ⁻¹' A) :=
  e.symm.map_apply A

@[simp] theorem transportMeasure_real (A : Set Ω') :
    (transportMeasure μ e).real A = μ.real (e.symm ⁻¹' A) := by
  simp only [measureReal_def, transportMeasure_apply]

/-- Conditioning commutes with the equivalence, even for nonmeasurable sets. -/
theorem cond_transportMeasure (A : Set Ω') :
    (transportMeasure μ e)[|A] = transportMeasure (μ[|e.symm ⁻¹' A]) e := by
  simp only [transportMeasure, ProbabilityTheory.cond, e.symm.map_apply, e.symm.restrict_map,
    Measure.map_smul]

@[simp] theorem cond_transportMeasure_apply (A B : Set Ω') :
    (transportMeasure μ e)[B | A] = μ[e.symm ⁻¹' B | e.symm ⁻¹' A] := by
  rw [cond_transportMeasure, transportMeasure_apply]

@[simp] theorem cond_transportMeasure_real (A B : Set Ω') :
    ((transportMeasure μ e)[|A]).real B = (μ[|e.symm ⁻¹' A]).real (e.symm ⁻¹' B) := by
  simp only [measureReal_def, cond_transportMeasure_apply]

/-- Exact equality of φ-mixing coefficients. No probability or measurability assumption is needed:
the equivalence gives a bijection of all admissible pairs of events. -/
theorem phiMixingCoeff_transport (n : ℕ) :
    phiMixingCoeff (transportProcess X e) (transportMeasure μ e) n = phiMixingCoeff X μ n := by
  unfold phiMixingCoeff
  congr 1
  ext r
  constructor
  · rintro ⟨m, A, B, hA, hpos, hB, hr⟩
    refine ⟨m, e.symm ⁻¹' A, e.symm ⁻¹' B,
      (measurableSet_sigmaGen_transport_iff X e _ _).1 hA, ?_,
      (measurableSet_sigmaGen_transport_iff X e _ _).1 hB, ?_⟩
    · simpa only [transportMeasure_apply] using hpos
    · simpa only [cond_transportMeasure_real, transportMeasure_real] using hr
  · rintro ⟨m, A, B, hA, hpos, hB, hr⟩
    refine ⟨m, e ⁻¹' A, e ⁻¹' B, ?_, ?_, ?_, ?_⟩
    · exact (measurableSet_sigmaGen_transport_iff X e _ _).2 (by simpa using hA)
    · simpa only [transportMeasure_apply, MeasurableEquiv.symm_preimage_preimage] using hpos
    · exact (measurableSet_sigmaGen_transport_iff X e _ _).2 (by simpa using hB)
    · simpa only [cond_transportMeasure_real, transportMeasure_real,
        MeasurableEquiv.symm_preimage_preimage] using hr

theorem isPhiMixing_transport_iff :
    IsPhiMixing (transportProcess X e) (transportMeasure μ e) ↔ IsPhiMixing X μ := by
  unfold IsPhiMixing
  rw [funext (phiMixingCoeff_transport X μ e)]

section Laws

variable {E : Type*} [MeasurableSpace E]

/-- Almost-everywhere measurability also transports without any completeness assumptions. -/
theorem aemeasurable_comp_transportMeasure_iff (f : Ω → E) :
    AEMeasurable (f ∘ e) (transportMeasure μ e) ↔ AEMeasurable f μ := by
  simpa only [transportMeasure, Function.comp_def, MeasurableEquiv.apply_symm_apply] using
    (aemeasurable_map_equiv_iff e.symm (μ := μ) (f := f ∘ e))

/-- The law of any random variable is unchanged. The statement remains valid without
measurability, since both sides are then the same default zero measure. -/
theorem map_comp_transportMeasure (f : Ω → E) :
    (transportMeasure μ e).map (f ∘ e) = μ.map f := by
  by_cases hf : AEMeasurable f μ
  · have hfe := (aemeasurable_comp_transportMeasure_iff μ e f).2 hf
    simpa only [transportMeasure, Function.comp_def, MeasurableEquiv.apply_symm_apply] using
      hfe.map_map_of_aemeasurable e.symm.measurable.aemeasurable
  · rw [Measure.map_of_not_aemeasurable hf,
      Measure.map_of_not_aemeasurable
        ((aemeasurable_comp_transportMeasure_iff μ e f).not.mpr hf)]

theorem identDistrib_transport {f g : Ω → E} (h : IdentDistrib f g μ μ) :
    IdentDistrib (f ∘ e) (g ∘ e) (transportMeasure μ e) (transportMeasure μ e) where
  aemeasurable_fst := (aemeasurable_comp_transportMeasure_iff μ e f).2 h.aemeasurable_fst
  aemeasurable_snd := (aemeasurable_comp_transportMeasure_iff μ e g).2 h.aemeasurable_snd
  map_eq := by rw [map_comp_transportMeasure, map_comp_transportMeasure]; exact h.map_eq

end Laws

/-- Strict stationarity transports using just the almost-everywhere measurability that is
already part of `IdentDistrib`. -/
theorem isStrictlyStationary_transport (h : IsStrictlyStationary X μ) :
    IsStrictlyStationary (transportProcess X e) (transportMeasure μ e) :=
  fun k ↦ identDistrib_transport μ e (h k)

theorem memLp_comp_transportMeasure_iff (f : Ω → ℝ) (p : ℝ≥0∞) :
    MemLp (f ∘ e) p (transportMeasure μ e) ↔ MemLp f p μ := by
  simpa only [transportMeasure, Function.comp_def, MeasurableEquiv.apply_symm_apply] using
    (e.symm.memLp_map_measure_iff (μ := μ) (g := f ∘ e) (p := p))

theorem integral_comp_transportMeasure (f : Ω → ℝ) :
    (∫ ω, f (e ω) ∂transportMeasure μ e) = ∫ ω, f ω ∂μ := by
  simpa only [transportMeasure, MeasurableEquiv.apply_symm_apply] using
    (integral_map_equiv e.symm (fun ω ↦ f (e ω)) (μ := μ))

theorem variance_comp_transportMeasure (f : Ω → ℝ) :
    variance (f ∘ e) (transportMeasure μ e) = variance f μ := by
  simpa only [transportMeasure, Function.comp_def, MeasurableEquiv.apply_symm_apply] using
    (variance_map_equiv (f ∘ e) e.symm (μ := μ))

@[simp] theorem partialSum_transport (n : ℕ) :
    partialSum (transportProcess X e) n = partialSum X n ∘ e := rfl

@[simp] theorem variance_partialSum_transport (n : ℕ) :
    variance (partialSum (transportProcess X e) n) (transportMeasure μ e) =
      variance (partialSum X n) μ := by
  rw [partialSum_transport, variance_comp_transportMeasure]

@[simp] theorem partialSumStdDev_transport (n : ℕ) :
    partialSumStdDev (transportProcess X e) (transportMeasure μ e) n =
      partialSumStdDev X μ n := by
  simp only [partialSumStdDev, variance_partialSum_transport]

@[simp] theorem normalizedPartialSum_transport (n : ℕ) :
    normalizedPartialSum (transportProcess X e) (transportMeasure μ e) n =
      normalizedPartialSum X μ n ∘ e := by
  funext ω
  simp only [normalizedPartialSum, partialSum_transport, partialSumStdDev_transport,
    Function.comp_apply]

/-- Equality of the normalized laws, including the degenerate/zero-variance cases. -/
@[simp] theorem map_normalizedPartialSum_transport (n : ℕ) :
    (transportMeasure μ e).map
        (normalizedPartialSum (transportProcess X e) (transportMeasure μ e) n) =
      μ.map (normalizedPartialSum X μ n) := by
  rw [normalizedPartialSum_transport, map_comp_transportMeasure]

/-- The normalized laws agree as probability measures, not just as measures. -/
theorem probabilityMeasure_normalizedPartialSum_transport [IsProbabilityMeasure μ]
    (hX : ∀ n, Measurable (X n)) (n : ℕ) :
    (⟨(transportMeasure μ e).map
        (normalizedPartialSum (transportProcess X e) (transportMeasure μ e) n),
      Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum _ _ (measurable_transportProcess X e hX) n).aemeasurable⟩ :
      ProbabilityMeasure ℝ) =
    ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
      (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩ := by
  apply Subtype.ext
  exact map_normalizedPartialSum_transport X μ e n

/-- In particular, convergence to the Gaussian law is equivalent after transport. -/
theorem gaussian_limit_transport_iff [IsProbabilityMeasure μ]
    (hX : ∀ n, Measurable (X n)) :
    Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨(transportMeasure μ e).map
        (normalizedPartialSum (transportProcess X e) (transportMeasure μ e) n),
        Measure.isProbabilityMeasure_map
          (measurable_normalizedPartialSum _ _ (measurable_transportProcess X e hX) n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) ↔
    Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) := by
  simp only [probabilityMeasure_normalizedPartialSum_transport X μ e hX]

end Transport

section Lift

variable {Ω : Type v} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ) (μ : Measure Ω)

/-- The same process on `ULift`, with its canonical measurable space. -/
def liftProcess : ℕ → ULift.{u} Ω → ℝ := fun n ω ↦ X n ω.down

/-- The pushforward under `ULift.up`; no replacement of the canonical measurable space is used. -/
def liftMeasure : Measure (ULift.{u} Ω) := μ.map ULift.up

omit [MeasurableSpace Ω] in
@[simp] theorem liftProcess_apply (n : ℕ) (ω : ULift.{u} Ω) :
    liftProcess X n ω = X n ω.down := rfl

theorem liftMeasure_eq_map_up :
    (liftMeasure μ : Measure (ULift.{u} Ω)) = μ.map ULift.up := rfl

instance isProbabilityMeasure_liftMeasure [IsProbabilityMeasure μ] :
    IsProbabilityMeasure (liftMeasure μ : Measure (ULift.{u} Ω)) :=
  Measure.isProbabilityMeasure_map measurable_up.aemeasurable

theorem measurable_liftProcess (hX : ∀ n, Measurable (X n)) :
    ∀ n, Measurable (liftProcess X n : ULift.{u} Ω → ℝ) :=
  measurable_transportProcess X MeasurableEquiv.ulift hX

theorem sigmaGen_lift (s : Set ℕ) :
    sigmaGen (liftProcess X : ℕ → ULift.{u} Ω → ℝ) s =
      (sigmaGen X s).comap ULift.down :=
  sigmaGen_transport X MeasurableEquiv.ulift s

theorem measurableSet_sigmaGen_lift_iff (s : Set ℕ) (A : Set (ULift.{u} Ω)) :
    MeasurableSet[sigmaGen (liftProcess X) s] A ↔
      MeasurableSet[sigmaGen X s] (ULift.up ⁻¹' A) :=
  measurableSet_sigmaGen_transport_iff X MeasurableEquiv.ulift s A

@[simp] theorem liftMeasure_apply (A : Set (ULift.{u} Ω)) :
    liftMeasure μ A = μ (ULift.up ⁻¹' A) :=
  transportMeasure_apply μ MeasurableEquiv.ulift A

theorem isStrictlyStationary_lift (h : IsStrictlyStationary X μ) :
    IsStrictlyStationary (liftProcess X : ℕ → ULift.{u} Ω → ℝ) (liftMeasure μ) :=
  isStrictlyStationary_transport X μ MeasurableEquiv.ulift h

theorem memLp_liftProcess_iff (n : ℕ) (p : ℝ≥0∞) :
    MemLp (liftProcess X n : ULift.{u} Ω → ℝ) p (liftMeasure μ) ↔ MemLp (X n) p μ :=
  memLp_comp_transportMeasure_iff μ MeasurableEquiv.ulift (X n) p

@[simp] theorem integral_liftProcess (n : ℕ) :
    (∫ ω : ULift.{u} Ω, liftProcess X n ω ∂liftMeasure μ) = μ[X n] :=
  integral_comp_transportMeasure μ MeasurableEquiv.ulift (X n)

omit [MeasurableSpace Ω] in
@[simp] theorem partialSum_lift (n : ℕ) :
    partialSum (liftProcess X : ℕ → ULift.{u} Ω → ℝ) n = partialSum X n ∘ ULift.down := rfl

@[simp] theorem variance_partialSum_lift (n : ℕ) :
    variance (partialSum (liftProcess X : ℕ → ULift.{u} Ω → ℝ) n) (liftMeasure μ) =
      variance (partialSum X n) μ :=
  variance_partialSum_transport X μ MeasurableEquiv.ulift n

@[simp] theorem partialSumStdDev_lift (n : ℕ) :
    partialSumStdDev (liftProcess X : ℕ → ULift.{u} Ω → ℝ) (liftMeasure μ) n =
      partialSumStdDev X μ n :=
  partialSumStdDev_transport X μ MeasurableEquiv.ulift n

@[simp] theorem normalizedPartialSum_lift (n : ℕ) :
    normalizedPartialSum (liftProcess X : ℕ → ULift.{u} Ω → ℝ) (liftMeasure μ) n =
      normalizedPartialSum X μ n ∘ ULift.down :=
  normalizedPartialSum_transport X μ MeasurableEquiv.ulift n

@[simp] theorem map_normalizedPartialSum_lift (n : ℕ) :
    (liftMeasure μ).map
        (normalizedPartialSum (liftProcess X : ℕ → ULift.{u} Ω → ℝ) (liftMeasure μ) n) =
      μ.map (normalizedPartialSum X μ n) :=
  map_normalizedPartialSum_transport X μ MeasurableEquiv.ulift n

@[simp] theorem phiMixingCoeff_lift (n : ℕ) :
    phiMixingCoeff (liftProcess X : ℕ → ULift.{u} Ω → ℝ) (liftMeasure μ) n =
      phiMixingCoeff X μ n :=
  phiMixingCoeff_transport X μ MeasurableEquiv.ulift n

theorem isPhiMixing_lift_iff :
    IsPhiMixing (liftProcess X : ℕ → ULift.{u} Ω → ℝ) (liftMeasure μ) ↔ IsPhiMixing X μ :=
  isPhiMixing_transport_iff X μ MeasurableEquiv.ulift

theorem gaussian_limit_lift_iff [IsProbabilityMeasure μ] (hX : ∀ n, Measurable (X n)) :
    Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨(liftMeasure μ).map
        (normalizedPartialSum (liftProcess X : ℕ → ULift.{u} Ω → ℝ) (liftMeasure μ) n),
        Measure.isProbabilityMeasure_map
          (measurable_normalizedPartialSum _ _ (measurable_liftProcess X hX) n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) ↔
    Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩) :=
  gaussian_limit_transport_iff X μ MeasurableEquiv.ulift hX

end Lift

/- Packaging a counterexample and refuting the universe-polymorphic assertion. -/

/-- Exactly the hypotheses of the CLT assertion together with the negation of its conclusion.
The probability-measure instance is a parameter, so this is a proposition about a specified
process and law, rather than a choice of a new sample space. -/
structure Counterexample {Ω : Type v} [MeasurableSpace Ω]
    (X : ℕ → Ω → ℝ) (μ : Measure Ω) [IsProbabilityMeasure μ] : Prop where
  measurable : ∀ n, Measurable (X n)
  stationary : IsStrictlyStationary X μ
  mixing : IsPhiMixing X μ
  memLp_two : MemLp (X 0) 2 μ
  mean_zero : μ[X 0] = 0
  variance_tendsto : Tendsto (fun n ↦ variance (partialSum X n) μ) atTop atTop
  not_gaussian : ¬ Tendsto (β := ProbabilityMeasure ℝ)
    (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
      (measurable_normalizedPartialSum X μ measurable n).aemeasurable⟩)
    atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩)

section Counterexamples

variable {Ω : Type v} [MeasurableSpace Ω]
  {X : ℕ → Ω → ℝ} {μ : Measure Ω} [IsProbabilityMeasure μ]

/-- A counterexample transports across any measurable equivalence, including all its hypotheses
and the failure of Gaussian convergence. -/
theorem Counterexample.transport (h : Counterexample X μ)
    {Ω' : Type w} [MeasurableSpace Ω'] (e : Ω' ≃ᵐ Ω) :
    Counterexample (transportProcess X e) (transportMeasure μ e) where
  measurable := measurable_transportProcess X e h.measurable
  stationary := isStrictlyStationary_transport X μ e h.stationary
  mixing := (isPhiMixing_transport_iff X μ e).2 h.mixing
  memLp_two := (memLp_comp_transportMeasure_iff μ e (X 0) 2).2 h.memLp_two
  mean_zero := (integral_comp_transportMeasure μ e (X 0)).trans h.mean_zero
  variance_tendsto := by
    simpa only [variance_partialSum_transport] using h.variance_tendsto
  not_gaussian := fun hlim ↦ h.not_gaussian ((gaussian_limit_transport_iff X μ e h.measurable).1 hlim)

/-- The explicit lifted counterexample on `ULift.{u} Ω`. -/
theorem Counterexample.lift (h : Counterexample X μ) :
    Counterexample (liftProcess X : ℕ → ULift.{u} Ω → ℝ) (liftMeasure μ) :=
  h.transport MeasurableEquiv.ulift

end Counterexamples

/-- Starting with the unbundled hypotheses and failure of the CLT, construct a counterexample
on the canonical `ULift` measurable space. The witnesses are exactly `μ.map ULift.up` and
`fun n ω ↦ X n ω.down`; the probability measure is bundled only to simplify the existential. -/
theorem exists_counterexample_lift {Ω : Type v} [MeasurableSpace Ω]
    (X : ℕ → Ω → ℝ) (μ : Measure Ω) [IsProbabilityMeasure μ]
    (hX : ∀ n, Measurable (X n))
    (h_stat : IsStrictlyStationary X μ) (h_mix : IsPhiMixing X μ)
    (h_L2 : MemLp (X 0) 2 μ) (h_mean : μ[X 0] = 0)
    (h_var : Tendsto (fun n ↦ variance (partialSum X n) μ) atTop atTop)
    (h_not_gaussian : ¬ Tendsto (β := ProbabilityMeasure ℝ)
      (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
        (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩)
      atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩)) :
    ∃ (μup : ProbabilityMeasure (ULift.{u} Ω)) (Xup : ℕ → ULift.{u} Ω → ℝ),
      Counterexample Xup (μup : Measure (ULift.{u} Ω)) := by
  have h : Counterexample X μ := ⟨hX, h_stat, h_mix, h_L2, h_mean, h_var, h_not_gaussian⟩
  exact ⟨⟨liftMeasure μ, inferInstance⟩, liftProcess X, h.lift⟩

/-- A counterexample on `Type 0` refutes the unrestricted CLT assertion at *any* universe.
The assertion is written out explicitly, rather than obtained from or referring to the admitted
conjecture constant. Thus this theorem can be used directly in the final `.disproof` proof. -/
theorem not_unrestricted_clt_of_counterexample {Ω₀ : Type} [MeasurableSpace Ω₀]
    {X₀ : ℕ → Ω₀ → ℝ} {μ₀ : Measure Ω₀} [IsProbabilityMeasure μ₀]
    (h : Counterexample X₀ μ₀) :
    ¬ (∀ {Ω : Type u} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ) (μ : Measure Ω)
      [IsProbabilityMeasure μ] (hX : ∀ n, Measurable (X n)),
      IsStrictlyStationary X μ → IsPhiMixing X μ → MemLp (X 0) 2 μ → μ[X 0] = 0 →
      Tendsto (fun n ↦ variance (partialSum X n) μ) atTop atTop →
      Tendsto (β := ProbabilityMeasure ℝ)
        (fun n ↦ ⟨μ.map (normalizedPartialSum X μ n), Measure.isProbabilityMeasure_map
          (measurable_normalizedPartialSum X μ hX n).aemeasurable⟩)
        atTop (𝓝 ⟨gaussianReal 0 1, inferInstance⟩)) := by
  intro hclt
  have hup : Counterexample (liftProcess X₀ : ℕ → ULift.{u} Ω₀ → ℝ) (liftMeasure μ₀) := h.lift
  exact hup.not_gaussian (hclt (liftProcess X₀) (liftMeasure μ₀) hup.measurable hup.stationary
    hup.mixing hup.memLp_two hup.mean_zero hup.variance_tendsto)

end IbragimovIosifescuConjectureForMixingSequences
end


/- Supporting development: Cascade.Main -/
section
set_option autoImplicit false

/-
# A stationary φ-mixing counterexample with finite second moment

The bounded causal inverse kernels are limits of finite cascades with summable
square-variation cost. The independently chosen rare spikes preserve finite
second moment while forcing variance to escape along the selected times.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open IbragimovIosifescuConjectureForMixingSequences

namespace Cascade

namespace Diagonal.Construction

/-- At the selected times the actual sum law is close to its attenuated finite core. -/
theorem sum_law_close (d : Construction) (j : ℕ) :
    TestClose
      ((iidLaw ℤ d.noise).map (sumProcess (factor d.K) (d.n j)))
      ((iidLaw ℤ (d.coreNoise j)).map
        (sumProcess (factor (d.forwardStage j)) (d.n j))) (error j) := by
  exact BlockComparison.testClose_sumProcess_of_geometric_budget
    d.H.continuous.measurable (d.inverseStage j).continuous.measurable
    d.reconstruct (CausalLaw.isCausalInverse_finiteCascade (d.cs (j + 1)))
    (d.latent_testClose j) (d.inverse_tail_pointwise j)
    (d.T j) (d.n j) (d.burnin_at j (d.n j)) le_rfl le_rfl (d.r_small j)

private theorem measurable_main_sum (K : Correction) (n : ℕ) :
    Measurable (sumProcess (factor K) n) :=
  Finset.measurable_sum _ (fun t _ ↦ measurable_atTime (measurable_factor K) (t : ℤ))

private theorem main_core_centered (d : Construction) (j : ℕ) :
    (∫ ω, sumProcess (factor (d.forwardStage j)) (d.n j) ω
      ∂iidLaw ℤ (d.coreNoise j)) = 0 :=
  integral_sumProcess_factor_eq_zero (d.coreNoise j) (d.forwardStage j)
    (symmetricLaw_spikeNoiseStage _ _ _)
    (InverseCascade.forward_odd _ 0 (by intro x; simp)) (d.n j)

/-- All hypotheses of the specified conjecture hold, but its Gaussian conclusion fails. -/
theorem counterexample (d : Construction) :
    Counterexample (fun n ↦ atTime (factor d.K) (n : ℤ)) (iidLaw ℤ d.noise) := by
  have hX : ∀ n : ℕ, Measurable (atTime (factor d.K) (n : ℤ)) :=
    fun n ↦ measurable_atTime (measurable_factor d.K) (n : ℤ)
  refine ⟨hX, atTime_factor_stationary d.noise d.K, ?_, ?_, ?_, ?_, ?_⟩
  · exact isPhiMixing_of_causalInverse_correction d.K d.H d.reconstruct d.latent
      d.hasVariationMajorant d.summable_variation_sq
  · exact memLp_atTime_factor d.noise d.K d.noise_memLp 0
  · exact integral_atTime_factor_eq_zero d.noise d.K d.noise_symmetric d.odd_K 0
  · exact d.variance_tendsto_atTop
  · exact Escape.no_gaussian_limit_of_geometric_bounds
      (ν := fun j ↦ iidLaw ℤ (d.coreNoise j)) hX
      d.n d.n_tendsto_atTop d.one_le_n
      (fun j ↦ measurable_main_sum (d.forwardStage j) (d.n j))
      (fun j ↦ (d.upper_core j).memLp (d.n j)) (main_core_centered d)
      (fun j ↦ by simpa only [error] using d.sum_law_close j)
      (fun j ↦ by simpa only [error] using d.selected_variance_lower j)
      (fun j ↦ by
        simpa only [target, Escape.geometric_target_sq] using d.variance_core j)

end Diagonal.Construction

/-- The construction supplies an unconditional Type-0 counterexample. -/
theorem explicit_counterexample :
    Counterexample
      (fun n ↦ atTime (factor Diagonal.construction.K) (n : ℤ))
      (iidLaw ℤ Diagonal.construction.noise) :=
  Diagonal.construction.counterexample

end Cascade
